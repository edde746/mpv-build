-// Warm the next event while the OSD is static. Keep its first image for
-// background atlas upload and composition, not as a result for a later PTS.
-// A timestamp-matched render validates the content; osd_dedup_items reuses
-// the prepared atlas when its pixels match. While warming, requests coalesce
-// and a change that falls due meanwhile waits, so it must fit before
-// anything on screen ends.
-#define OSD_PREFETCH_MIN_LEAD 0.2
-#define OSD_PREFETCH_MAX_LEAD 15.0
-#define OSD_PREFETCH_STATIC_RENDERS 3
-
-struct osd_prefetch {
-    bool valid;            // a slot holds the next event's first frame
-    double event_start;    // that event's start (video pts)
-    uint64_t epoch;
-    int slot;
-    double attempted_start; // last event start warmed
-    double max_event_s;    // slowest render per event starting, seen so far
-    int unchanged_streak;  // consecutive renders that changed nothing
-    uint32_t count;
-};
-
-// A worst-case guess of what rendering a frame where `events` events start
-// takes: the slowest per-event rate seen so far, with a floor before any
-// heavy sign has been measured. Typesetting is hundreds of events per
-// shot, a dialogue line is one.
-static double osd_prefetch_estimate(const struct osd_prefetch *p, int events)
-{
-    double per_event = p->max_event_s > 0.001 ? p->max_event_s : 0.001;
-    double estimate = 1.25 * per_event * (events > 1 ? events : 1);
-    if (estimate < 0.05)
-        estimate = 0.05;
-    if (estimate > 1.5)
-        estimate = 1.5;
-    return estimate;
-}
-
-// Whether to render next_start's first frame now, playing at pts. Something
-// on screen ending before that start must not wait for the render, so the
-// render's estimate has to fit before it, with margin. The start itself may
-// be overrun: the following timestamp-matched render still benefits from
-// warm caches. Only an attempt that cannot finish within twice its lead is
-// skipped.
-//  eligible: playing, the last request was a real frame, nothing pending,
-//            a slot is free
-static bool osd_prefetch_plan(const struct osd_prefetch *p, double pts,
-                              double next_start, int next_events,
-                              double visible_end, double horizon,
-                              bool eligible)
-{
-    if (!eligible || p->valid || p->unchanged_streak < OSD_PREFETCH_STATIC_RENDERS)
-        return false;
-    if (!(next_start > pts) || !(next_start <= horizon)) // rejects NAN
-        return false;
-    double lead = next_start - pts;
-    if (lead < OSD_PREFETCH_MIN_LEAD || lead > OSD_PREFETCH_MAX_LEAD)
-        return false;
-    if (fabs(next_start - p->attempted_start) < 0.002) // same event, another frame
-        return false;
-    double estimate = osd_prefetch_estimate(p, next_events);
-    if (visible_end > pts && visible_end < next_start &&
-        visible_end - pts < estimate + 0.15)
-        return false;
-    return 2 * lead >= estimate;
-}
-
-static void osd_prefetch_store(struct osd_prefetch *p, double event_start,
-                               int events, uint64_t epoch, int slot,
-                               double render_s)
-{
-    p->valid = slot >= 0;
-    p->event_start = event_start;
-    p->epoch = epoch;
-    p->slot = slot;
-    p->attempted_start = event_start;
-    p->count++;
-    double per_event = render_s / (events > 1 ? events : 1);
-    if (per_event > p->max_event_s)
-        p->max_event_s = per_event;
-}
-
-// Called after servicing a request. Keep the prepared image available to
-// the GPU and pixel deduplication through the first timestamp-matched render
-// at/after its start, then release the staging slot for the next event.
-static void osd_prefetch_retire(struct osd_prefetch *p, double pts, uint64_t epoch)
-{
-    if (epoch != p->epoch || pts >= p->event_start)
-        p->valid = false;
-}
-
-static void osd_prefetch_observe_render(struct osd_prefetch *p, bool changed)
-{
-    p->unchanged_streak = changed ? 0 : p->unchanged_streak + 1;
-}
