-#define OSD_CADENCE_SAMPLES 8
-#define OSD_CADENCE_MIN_SAMPLES 4
-#define OSD_CADENCE_MAX_DELTA 0.25  // seconds; longer gaps are not a cadence
-#define OSD_SPEC_TOLERANCE 0.004    // seconds; a request matches a pre-render
-
-// Median of at most OSD_MEDIAN_MAX samples: the middle one, or the mean of
-// the middle two. Insertion sort; the rings here are far smaller than a sort
-// would pay for, and no caller's ring is larger than this.
-#define OSD_MEDIAN_MAX 8
-
-static int64_t median_ns(const int64_t *v, int n)
-{
-    int64_t sorted[OSD_MEDIAN_MAX];
-    for (int i = 0; i < n; i++)
-        sorted[i] = v[i];
-    for (int i = 1; i < n; i++) {
-        int64_t key = sorted[i];
-        int j = i - 1;
-        while (j >= 0 && sorted[j] > key) {
-            sorted[j + 1] = sorted[j];
-            j--;
-        }
-        sorted[j + 1] = key;
-    }
-    return n & 1 ? sorted[n / 2] : (sorted[n / 2 - 1] + sorted[n / 2]) / 2;
-}
-
-// The same statistic in seconds, for the media-pts cadence. Its deltas are
-// container timestamps, so nanosecond rounding loses nothing.
-static double median_seconds(const double *v, int n)
-{
-    int64_t ns[OSD_MEDIAN_MAX];
-    for (int i = 0; i < n; i++)
-        ns[i] = llround(v[i] * 1e9);
-    return median_ns(ns, n) / 1e9;
-}
-
-// Media-pts cadence of the frames admitted for preparation: median of the
-// last eight consecutive deltas, trusted after four. A frame_id gap, a
-// non-positive delta (seek,
-// backwards step) or a delta longer than OSD_CADENCE_MAX_DELTA starts over.
-struct osd_cadence {
-    double deltas[OSD_CADENCE_SAMPLES];
-    int count;
-    int next;
-    bool have_last;
-    uint64_t last_frame_id;
-    double last_pts;
-};
-
-static void osd_cadence_reset(struct osd_cadence *c)
-{
-    *c = (struct osd_cadence){0};
-}
-
-static void osd_cadence_observe(struct osd_cadence *c, uint64_t frame_id,
-                                double pts)
-{
-    if (c->have_last) {
-        double delta = pts - c->last_pts;
-        if (frame_id != c->last_frame_id + 1 || !(delta > 0) ||
-            delta > OSD_CADENCE_MAX_DELTA)
-        {
-            osd_cadence_reset(c);
-        } else {
-            c->deltas[c->next] = delta;
-            c->next = (c->next + 1) % OSD_CADENCE_SAMPLES;
-            if (c->count < OSD_CADENCE_SAMPLES)
-                c->count++;
-        }
-    }
-    c->have_last = true;
-    c->last_frame_id = frame_id;
-    c->last_pts = pts;
-}
-
-// Median delta in seconds, 0 until enough consecutive frames were seen.
-static double osd_cadence_delta(const struct osd_cadence *c)
-{
-    if (c->count < OSD_CADENCE_MIN_SAMPLES)
-        return 0;
-    return median_seconds(c->deltas, c->count);
-}
