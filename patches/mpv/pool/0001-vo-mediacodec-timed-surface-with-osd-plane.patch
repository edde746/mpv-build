+
+    ANativeWindow *osd_window;
+    bool osd_missing_logged;
+
+    // OSD thread owns the draw cache and the Surface; the VO thread files
+    // requests under osd_lock, latest wins.
+    mp_thread osd_thread;
+    bool osd_thread_created;
+    mp_mutex osd_lock;
+    mp_cond osd_wakeup;
+    bool osd_terminate;
+    bool osd_requested;
+    bool osd_request_full;
+    double osd_request_pts;
+    int64_t osd_request_deadline; // mp_time_ns(), 0 = post immediately
