+    mp_thread vsync_thread;
+    bool vsync_thread_created;
+    mp_mutex vsync_lock;
+    bool vsync_terminate;
+    int64_t vsync_sample; // CLOCK_MONOTONIC
+
+    // VO thread only
+    struct mediacodec_timing timing;
+    int64_t queue_period;
+    int64_t queue_period_changed;
+    int64_t queue_offset;
+    struct m_config_cache *geometry_cache;
+
+    int64_t osd_surface;
+};
+
+static int64_t monotonic_now_ns(void)
+{
+    struct timespec ts;
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0)
+        return 0;
+    return ts.tv_sec * INT64_C(1000000000) + ts.tv_nsec;
+}
+
+// API 24-28 delivers a long; rebuild the upper bits on 32-bit ABIs.
+static int64_t restore_frame_time(long frame_time)
+{
+    if (sizeof(long) >= sizeof(int64_t))
+        return frame_time;
+
+    int64_t now = monotonic_now_ns();
+    if (!now)
+        return 0;
+    int32_t delta = (int32_t)((uint32_t)frame_time - (uint32_t)now);
+    return now + delta;
+}
+
+static void post_vsync_callback(struct vo *vo, bool delayed);
+
+static void record_vsync(struct vo *vo, int64_t frame_time)
+{
+    struct priv *p = vo->priv;
+
+    mp_mutex_lock(&p->vsync_lock);
+    p->vsync_sample = frame_time;
+    bool terminate = p->vsync_terminate;
+    mp_mutex_unlock(&p->vsync_lock);
+
+    if (!terminate)
+        post_vsync_callback(vo, true);
+}
+
+static void vsync_callback(long frame_time, void *arg)
+{
+    record_vsync(arg, restore_frame_time(frame_time));
+}
+
+static void vsync_callback64(int64_t frame_time, void *arg)
+{
+    record_vsync(arg, frame_time);
+}
+
+static void post_vsync_callback(struct vo *vo, bool delayed)
+{
+    struct priv *p = vo->priv;
+    const uint32_t delay_ms = delayed ? 500 : 0;
+
+    if (p->post_frame_callback_delayed64) {
+        if (delay_ms) {
+            p->post_frame_callback_delayed64(
+                p->choreographer, vsync_callback64, vo, delay_ms);
+        } else {
+            p->post_frame_callback64(p->choreographer, vsync_callback64, vo);
+        }
+    } else if (delay_ms) {
+        p->post_frame_callback_delayed(
+            p->choreographer, vsync_callback, vo, delay_ms);
+    } else {
+        p->post_frame_callback(p->choreographer, vsync_callback, vo);
+    }
+}
+
+static MP_THREAD_VOID vsync_thread(void *arg)
+{
+    struct vo *vo = arg;
+    struct priv *p = vo->priv;
+    mp_thread_set_name("vo/vsync");
+
+    ALooper *looper = ALooper_prepare(0);
+    AChoreographer *choreographer =
+        looper ? p->get_choreographer() : NULL;
+    if (!looper || !choreographer) {
+        MP_WARN(vo, "Choreographer unavailable; timed release will not be "
+                    "vsync-snapped.\n");
+        MP_THREAD_RETURN();
+    }
+
+    ALooper_acquire(looper);
+    mp_mutex_lock(&p->vsync_lock);
+    p->vsync_looper = looper;
+    p->choreographer = choreographer;
+    bool terminate = p->vsync_terminate;
+    mp_mutex_unlock(&p->vsync_lock);
+
+    if (!terminate)
+        post_vsync_callback(vo, false);
+
+    while (!terminate) {
+        if (ALooper_pollOnce(-1, NULL, NULL, NULL) == ALOOPER_POLL_ERROR)
+            break;
+        mp_mutex_lock(&p->vsync_lock);
+        terminate = p->vsync_terminate;
+        mp_mutex_unlock(&p->vsync_lock);
+    }
+
+    mp_mutex_lock(&p->vsync_lock);
+    p->vsync_looper = NULL;
+    p->choreographer = NULL;
+    p->vsync_sample = 0;
+    mp_mutex_unlock(&p->vsync_lock);
+    ALooper_release(looper);
+    MP_THREAD_RETURN();
+}
+
+static void init_vsync_sampler(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    p->choreographer_lib = dlopen("libandroid.so", RTLD_NOW | RTLD_LOCAL);
+    if (!p->choreographer_lib)
+        return;
+
+    p->get_choreographer =
+        dlsym(p->choreographer_lib, "AChoreographer_getInstance");
+    p->post_frame_callback =
+        dlsym(p->choreographer_lib, "AChoreographer_postFrameCallback");
+    p->post_frame_callback_delayed =
+        dlsym(p->choreographer_lib, "AChoreographer_postFrameCallbackDelayed");
+    p->post_frame_callback64 =
+        dlsym(p->choreographer_lib, "AChoreographer_postFrameCallback64");
+    p->post_frame_callback_delayed64 =
+        dlsym(p->choreographer_lib, "AChoreographer_postFrameCallbackDelayed64");
+
+    bool have64 = p->post_frame_callback64 &&
+                  p->post_frame_callback_delayed64;
+    bool have_legacy = p->post_frame_callback &&
+                       p->post_frame_callback_delayed;
+    if (!p->get_choreographer || (!have64 && !have_legacy)) {
+        dlclose(p->choreographer_lib);
+        p->choreographer_lib = NULL;
+        return;
+    }
+    if (!have64) {
+        p->post_frame_callback64 = NULL;
+        p->post_frame_callback_delayed64 = NULL;
+    }
+
+    mp_mutex_init(&p->vsync_lock);
+    if (mp_thread_create(&p->vsync_thread, vsync_thread, vo)) {
+        MP_WARN(vo, "Failed to start the Choreographer sampler; timed release "
+                    "will not be vsync-snapped.\n");
+        mp_mutex_destroy(&p->vsync_lock);
+        dlclose(p->choreographer_lib);
+        p->choreographer_lib = NULL;
+        return;
+    }
+    p->vsync_thread_created = true;
+}
+
+static AVBufferRef *create_mediacodec_device_ref(struct vo *vo)
+{
+    if (vo->opts->WinID == 0 || vo->opts->WinID == -1)
+        return NULL;
+
+    AVBufferRef *device_ref = av_hwdevice_ctx_alloc(AV_HWDEVICE_TYPE_MEDIACODEC);
+    if (!device_ref)
+        return NULL;
+
+    AVHWDeviceContext *ctx = (void *)device_ref->data;
+    AVMediaCodecDeviceContext *hwctx = ctx->hwctx;
+    hwctx->surface = (void *)(intptr_t)(vo->opts->WinID);
+
+    if (av_hwdevice_ctx_init(device_ref) < 0)
+        av_buffer_unref(&device_ref);
+
+    return device_ref;
+}
+
+static MP_THREAD_VOID osd_thread(void *arg);
+
+static void geometry_wakeup(void *ctx)
+{
+    vo_wakeup(ctx);
+}
+
+static int preinit(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    p->osd_pts = MP_NOPTS_VALUE;
+    p->geometry_cache = m_config_cache_alloc(p, vo->global, &mediacodec_conf);
+    struct mediacodec_opts *opts = p->geometry_cache->opts;
+    if (!mediacodec_geometry_parse(opts->video_rect, &p->osd_geometry))
+        MP_WARN(vo, "Invalid --vo-mediacodec-video-rect; ignoring geometry.\n");
+    m_config_cache_set_wakeup_cb(p->geometry_cache, geometry_wakeup, vo);
+    vo->hwdec_devs = hwdec_devices_create();
+    p->hwctx = (struct mp_hwdec_ctx){
+        .driver_name = "mediacodec",
+        .av_device_ref = create_mediacodec_device_ref(vo),
+        .hw_imgfmt = IMGFMT_MEDIACODEC,
+    };
+
+    if (!p->hwctx.av_device_ref) {
+        MP_ERR(vo, "Failed to create hwdevice_ctx; --wid must be a Surface.\n");
+        return -1;
+    }
+
+    hwdec_devices_add(vo->hwdec_devs, &p->hwctx);
+    init_vsync_sampler(vo);
+
+    if (p->osd_surface && p->osd_surface != -1) {
+        JNIEnv *env = mp_jni_get_env(vo->log);
+        if (env) {
+            p->osd_window = ANativeWindow_fromSurface(env,
+                    (jobject)(intptr_t)p->osd_surface);
+        }
+        if (p->osd_window) {
+            ANativeWindow_setBuffersGeometry(p->osd_window, 0, 0,
+                                             WINDOW_FORMAT_RGBA_8888);
+            mp_mutex_init(&p->osd_lock);
+            mp_cond_init(&p->osd_wakeup);
+            if (mp_thread_create(&p->osd_thread, osd_thread, vo)) {
+                MP_ERR(vo, "Failed to start the OSD thread; "
+                           "subtitles/OSD will not render.\n");
+                mp_cond_destroy(&p->osd_wakeup);
+                mp_mutex_destroy(&p->osd_lock);
+                ANativeWindow_release(p->osd_window);
+                p->osd_window = NULL;
+            } else {
+                p->osd_thread_created = true;
+            }
+        } else {
+            MP_ERR(vo, "Failed to wrap the OSD surface; "
+                       "subtitles/OSD will not render.\n");
+        }
+    }
+
+    // vo.c would otherwise wait until frame->pts before calling flip_page.
+    vo_set_queue_params(vo, MP_TIME_MS_TO_NS(50), 1);
+
+    return 0;
+}
+
+// mp_time_ns() -> CLOCK_MONOTONIC (System.nanoTime, MediaCodec's domain).
+static int64_t mp_time_to_monotonic_ns(int64_t mp_time)
+{
+    int64_t mono_now = monotonic_now_ns();
+    return mono_now ? mp_time - mp_time_ns() + mono_now : 0;
+}
+
+#define VSYNC_SAMPLE_MAX_AGE_NS MP_TIME_S_TO_NS(1)
+#define TIMED_RELEASE_MAX_AHEAD_NS MP_TIME_MS_TO_NS(500)
+
+struct release_target {
+    int64_t timestamp; // CLOCK_MONOTONIC passed to MediaCodec
+    int64_t osd_deadline; // mp_time_ns() at which the OSD may be posted
+};
+
+static int64_t read_vsync_sample(struct priv *p)
+{
+    if (!p->vsync_thread_created)
+        return 0;
+
+    mp_mutex_lock(&p->vsync_lock);
+    int64_t sample = p->vsync_sample;
+    mp_mutex_unlock(&p->vsync_lock);
+    return sample;
+}
+
+static bool vsync_sample_is_fresh(struct priv *p, int64_t sample,
+                                  int64_t mono_now)
+{
+    return sample >= p->queue_period_changed &&
+           sample >= mono_now - VSYNC_SAMPLE_MAX_AGE_NS &&
+           sample <= mono_now + p->queue_period;
+}
+
+static int64_t display_period(struct vo *vo)
+{
+    double period = vo_get_vsync_interval(vo);
+    if (!isfinite(period) || period < 1e9 / 240.0 || period > 1e9 / 20.0)
+        return 0;
+    return llround(period);
+}
+
+// Release about two vsyncs early (MediaCodec's SurfaceView guidance); 50 ms
+// when the display period is unknown.
+static void update_queue_timing(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    int64_t mono_now = monotonic_now_ns();
+    int64_t period = display_period(vo);
+
+    if (period != p->queue_period) {
+        mediacodec_timing_reset(&p->timing);
+        p->queue_period = period;
+        p->queue_period_changed = mono_now;
+    }
+
+    int64_t offset = period > 0 ? 2 * period : MP_TIME_MS_TO_NS(50);
+    if (offset == p->queue_offset)
+        return;
+
+    p->queue_offset = offset;
+    vo_set_queue_params(vo, offset, 1);
+    if (period) {
+        MP_VERBOSE(vo, "Timed release: %.3f Hz, queue %.1f ms ahead.\n",
+                   1e9 / period, offset / 1e6);
+    }
+}
+
+// Stabilize frame cadence, then snap with hysteresis and release 80% of a
+// period before the chosen vsync so SurfaceView can latch the buffer in time.
+// The policy lives in mediacodec_timing_release so the host regression can
+// drive it with an injected clock.
+static struct release_target get_release_target(struct vo *vo, int64_t pts)
+{
+    struct priv *p = vo->priv;
+    struct release_target result = {0};
+    if (pts <= 0) {
+        mediacodec_timing_reset(&p->timing);
+        return result;
+    }
+
+    int64_t mono_now = monotonic_now_ns();
+    int64_t raw_target = mp_time_to_monotonic_ns(pts);
+    int64_t sample = p->queue_period > 0 ? read_vsync_sample(p) : 0;
+    if (sample && !vsync_sample_is_fresh(p, sample, mono_now))
+        sample = 0;
+
+    result.timestamp = mediacodec_timing_release(
+        &p->timing, raw_target, mono_now, p->cur_frame_id, p->cur_duration,
+        sample, p->queue_period, TIMED_RELEASE_MAX_AHEAD_NS);
+    if (result.timestamp)
+        result.osd_deadline = pts + (result.timestamp - raw_target);
+    return result;
+}
+
+// premultiplied BGRA -> RGBA_8888
+static void copy_bgra_to_rgba(uint8_t *dst, ptrdiff_t dst_stride,
+                              const uint8_t *src, ptrdiff_t src_stride,
+                              int w, int h)
+{
+    for (int y = 0; y < h; y++) {
+        uint32_t *d = (uint32_t *)(dst + y * dst_stride);
+        const uint32_t *s = (const uint32_t *)(src + y * src_stride);
+        for (int x = 0; x < w; x++) {
+            uint32_t c = s[x];
+            d[x] = (c & 0xFF00FF00u) | ((c >> 16) & 0xFFu) | ((c & 0xFFu) << 16);
+        }
+    }
+}
+
+static bool wait_to_post_osd(struct priv *p, int64_t deadline,
+                             uint64_t epoch)
+{
+    mp_mutex_lock(&p->osd_lock);
+    while (!p->osd_terminate && p->osd_epoch == epoch &&
+           deadline > mp_time_ns())
+    {
+        mp_cond_timedwait_until(&p->osd_wakeup, &p->osd_lock, deadline);
+    }
+    bool current = !p->osd_terminate && p->osd_epoch == epoch;
+    mp_mutex_unlock(&p->osd_lock);
+    return current;
+}
+
+static bool osd_pass(struct vo *vo, struct mp_draw_sub_cache **cache,
+                     int *last_w, int *last_h, bool *force_full, double pts,
+                     int64_t deadline, uint64_t epoch,
+                     struct mediacodec_geometry geometry)
+{
+    struct priv *p = vo->priv;
+    bool resized = false;
+
+    int w = ANativeWindow_getWidth(p->osd_window);
+    int h = ANativeWindow_getHeight(p->osd_window);
+    if (w <= 0 || h <= 0)
+        return false;
+
+    if (w != *last_w || h != *last_h) {
+        *last_w = w;
+        *last_h = h;
+        *force_full = true;
+    }
+
+    struct mp_osd_res res = mediacodec_osd_geometry(geometry, w, h);
+
+    struct sub_bitmap_list *sbs =
+        osd_render(vo->osd, res, pts, 0, mp_draw_sub_formats);
+    if (!sbs)
+        return false;
+
+    if (!*cache)
+        *cache = mp_draw_sub_alloc(NULL, vo->global);
+
+    struct mp_rect act_rc[1], mod_rc[64];
+    int num_act_rc = 0, num_mod_rc = 0;
+    struct mp_image *osd = mp_draw_sub_overlay(*cache, sbs,
+            act_rc, MP_ARRAY_SIZE(act_rc), &num_act_rc,
+            mod_rc, MP_ARRAY_SIZE(mod_rc), &num_mod_rc);
+    if (!osd)
+        goto done;
+    if (!num_mod_rc && !*force_full)
+        goto done; // OSD unchanged; keep the currently posted buffer
+
+    struct mp_rect dirty = {0, 0, w, h};
+    if (!*force_full) {
+        dirty = mod_rc[0];
+        for (int n = 1; n < num_mod_rc; n++)
+            mp_rect_union(&dirty, &mod_rc[n]);
+    }
+
+    // Post no earlier than the video's adjusted timestamp.
+    if (!wait_to_post_osd(p, deadline, epoch))
+        goto done;
+
+    // ANativeWindow_lock grows bounds to everything that must be repainted.
+    ARect bounds = {dirty.x0, dirty.y0, dirty.x1, dirty.y1};
+    ANativeWindow_Buffer buffer;
+    if (ANativeWindow_lock(p->osd_window, &buffer, &bounds) != 0) {
+        MP_WARN(vo, "Failed to lock the OSD surface.\n");
+        *force_full = true;
+        goto done;
+    }
+
+    if (buffer.format != WINDOW_FORMAT_RGBA_8888) {
+        MP_ERR(vo, "Unexpected OSD buffer format %d.\n", buffer.format);
+        *force_full = true;
+        ANativeWindow_unlockAndPost(p->osd_window);
+        goto done;
+    }
+
+    // A resize can race getWidth/getHeight. Render for the actual locked buffer,
+    // not a guessed scale or the dimensions of the previous Surface generation.
+    resized = buffer.width != w || buffer.height != h;
+    *force_full = resized;
+    if (resized) {
+        talloc_free(sbs);
+        res = mediacodec_osd_geometry(geometry, buffer.width, buffer.height);
+        sbs = osd_render(vo->osd, res, pts, 0, mp_draw_sub_formats);
+        osd = sbs ? mp_draw_sub_overlay(*cache, sbs,
+            act_rc, MP_ARRAY_SIZE(act_rc), &num_act_rc,
+            mod_rc, MP_ARRAY_SIZE(mod_rc), &num_mod_rc) : NULL;
+    }
+
+    int x0 = MPCLAMP(bounds.left, 0, buffer.width);
+    int y0 = MPCLAMP(bounds.top, 0, buffer.height);
+    int x1 = MPCLAMP(bounds.right, x0, buffer.width);
+    int y1 = MPCLAMP(bounds.bottom, y0, buffer.height);
+
+    ptrdiff_t dst_stride = (ptrdiff_t)buffer.stride * 4;
+    uint8_t *dst = (uint8_t *)buffer.bits + y0 * dst_stride + x0 * 4;
+
+    int ow = osd ? MPCLAMP(osd->w - x0, 0, x1 - x0) : 0;
+    int oh = osd ? MPCLAMP(osd->h - y0, 0, y1 - y0) : 0;
+    if (ow > 0 && oh > 0) {
+        copy_bgra_to_rgba(dst, dst_stride,
+                          (uint8_t *)osd->planes[0] +
+                              (ptrdiff_t)y0 * osd->stride[0] + (ptrdiff_t)x0 * 4,
+                          osd->stride[0], ow, oh);
+    }
+    for (int y = 0; y < y1 - y0; y++) {
+        uint8_t *row = dst + y * dst_stride;
+        int filled = y < oh ? ow : 0;
+        if (filled < x1 - x0)
+            memset(row + (ptrdiff_t)filled * 4, 0, ((ptrdiff_t)(x1 - x0) - filled) * 4);
+    }
+    // The VO thread files its requests under osd_lock from flip_page, so
+    // nothing slow may run under that lock: unlockAndPost is a binder/BLAST
+    // round trip that can wait out a whole vsync during a SurfaceView
+    // relayout, and a stale full-canvas clear is tens of megabytes at 4K.
+    // Only the stale check needs the lock; this thread is the sole poster and
+    // uninit joins it before releasing the window, so the post itself
+    // synchronizes with nothing. An epoch bump that lands between the check
+    // and the post shows one stale frame, which the full repaint the bumper
+    // already filed replaces.
+    mp_mutex_lock(&p->osd_lock);
+    bool stale = p->osd_terminate || p->osd_epoch != epoch;
+    mp_mutex_unlock(&p->osd_lock);
+    if (stale) {
+        for (int y = 0; y < y1 - y0; y++)
+            memset(dst + y * dst_stride, 0, ((ptrdiff_t)x1 - x0) * 4);
+    }
+
+    ANativeWindow_unlockAndPost(p->osd_window);
+done:
+    talloc_free(sbs);
+    return resized;
+}
+
+static MP_THREAD_VOID osd_thread(void *arg)
+{
+    struct vo *vo = arg;
+    struct priv *p = vo->priv;
+    mp_thread_set_name("vo/osd");
+
+    struct mp_draw_sub_cache *cache = NULL;
+    int last_w = 0, last_h = 0;
+    bool force_full = true;
+
+    mp_mutex_lock(&p->osd_lock);
+    while (!p->osd_terminate) {
+        if (!p->osd_requested) {
+            mp_cond_wait(&p->osd_wakeup, &p->osd_lock);
+            continue;
+        }
+        double pts = p->osd_request_pts;
+        int64_t deadline = p->osd_request_deadline;
+        uint64_t epoch = p->osd_request_epoch;
+        struct mediacodec_geometry geometry = p->osd_geometry;
+        force_full |= p->osd_request_full;
+        p->osd_requested = false;
+        p->osd_request_full = false;
+        mp_mutex_unlock(&p->osd_lock);
+
+        bool resized = osd_pass(vo, &cache, &last_w, &last_h, &force_full,
+                                pts, deadline, epoch, geometry);
+
+        mp_mutex_lock(&p->osd_lock);
+        // A raced resize may have expanded beyond the originally dirty bounds.
+        // Repaint the whole new buffer immediately, including while paused.
+        if (resized && !p->osd_requested && p->osd_epoch == epoch) {
+            p->osd_request_pts = pts;
+            p->osd_request_deadline = 0;
+            p->osd_request_epoch = epoch;
+            p->osd_request_full = true;
+            p->osd_requested = true;
+        }
+    }
+    mp_mutex_unlock(&p->osd_lock);
+
+    talloc_free(cache);
+    MP_THREAD_RETURN();
+}
+
+static void draw_osd(struct vo *vo, int64_t deadline)
+{
+    struct priv *p = vo->priv;
+    if (!p->osd_window) {
+        if (!p->osd_missing_logged) {
+            MP_WARN(vo, "No OSD surface (--vo-mediacodec-osd-surface); "
+                        "subtitles/OSD are not rendered.\n");
+            p->osd_missing_logged = true;
+        }
+        return;
+    }
+
+    mp_mutex_lock(&p->osd_lock);
+    p->osd_request_pts = p->osd_pts;
+    p->osd_request_deadline = deadline;
+    p->osd_request_epoch = p->osd_epoch;
+    p->osd_requested = true;
+    mp_cond_signal(&p->osd_wakeup);
+    mp_mutex_unlock(&p->osd_lock);
+}
+
+static void invalidate_osd(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (!p->osd_thread_created)
+        return;
+
+    mp_mutex_lock(&p->osd_lock);
+    p->osd_epoch++;
+    p->osd_request_pts = p->osd_pts;
+    p->osd_request_deadline = 0;
+    p->osd_request_epoch = p->osd_epoch;
+    p->osd_request_full = true;
+    p->osd_requested = true;
+    mp_cond_signal(&p->osd_wakeup);
+    mp_mutex_unlock(&p->osd_lock);
+}
+
+static void update_geometry(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (!m_config_cache_update(p->geometry_cache))
+        return;
+    struct mediacodec_opts *opts = p->geometry_cache->opts;
+    struct mediacodec_geometry geometry;
+    if (!mediacodec_geometry_parse(opts->video_rect, &geometry)) {
+        MP_WARN(vo, "Invalid --vo-mediacodec-video-rect; keeping previous geometry.\n");
+        return;
+    }
+    if (!p->osd_thread_created)
+        return;
+    mp_mutex_lock(&p->osd_lock);
+    bool changed = !mediacodec_geometry_equal(p->osd_geometry, geometry);
+    if (changed) {
+        p->osd_geometry = geometry;
+        // Publish the new geometry and invalidate in-flight work atomically.
+        p->osd_epoch++;
+        p->osd_request_pts = p->osd_pts;
+        p->osd_request_deadline = 0;
+        p->osd_request_epoch = p->osd_epoch;
+        p->osd_request_full = true;
+        p->osd_requested = true;
+        mp_cond_signal(&p->osd_wakeup);
+    }
+    mp_mutex_unlock(&p->osd_lock);
+    if (changed)
+        vo->want_redraw = true;
+}
+
+static bool draw_frame(struct vo *vo, struct vo_frame *frame)
+{
+    struct priv *p = vo->priv;
+
+    if (!frame->redraw && !frame->repeat) {
+        update_queue_timing(vo);
+        mp_image_unrefp(&p->cur_image);
+        p->cur_image = frame->current ? mp_image_new_ref(frame->current) : NULL;
+        p->cur_pts = frame->pts;
+        p->cur_frame_id = p->cur_image ? frame->frame_id : 0;
+        p->cur_duration = p->cur_image ? frame->duration : 0;
+        if (!p->cur_image)
+            mediacodec_timing_reset(&p->timing);
+        p->osd_pts = p->cur_image ? p->cur_image->pts : MP_NOPTS_VALUE;
+    }
+
+    return VO_TRUE;
+}
+
+static void flip_page(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    struct release_target target = {0};
+    // Repeats and OSD redraws have no new codec buffer or cadence sample.
+    if (p->cur_image) {
+        target = get_release_target(vo, p->cur_pts);
+
+        // Hand the frame to the codec first: the OSD request needs nothing
+        // from the release, and filing it takes osd_lock, which the OSD
+        // thread may hold for a moment. The release timestamp is what keeps
+        // the two in step, not their submission order.
+        AVMediaCodecBuffer *buffer = (AVMediaCodecBuffer *)p->cur_image->planes[3];
+        int ret = target.timestamp
+                ? av_mediacodec_render_buffer_at_time(buffer, target.timestamp)
+                : av_mediacodec_release_buffer(buffer, 1);
+        mp_image_unrefp(&p->cur_image);
+        p->cur_pts = 0;
+        p->cur_frame_id = 0;
+        p->cur_duration = 0;
+
+        if (ret < 0)
+            MP_WARN(vo, "Failed to release MediaCodec output buffer (%d).\n", ret);
+    }
+
+    draw_osd(vo, target.osd_deadline);
+}
+
+static int query_format(struct vo *vo, int format)
+{
+    return format == IMGFMT_MEDIACODEC;
+}
+
+static int control(struct vo *vo, uint32_t request, void *data)
+{
+    struct priv *p = vo->priv;
+    switch (request) {
+    case VOCTRL_CHECK_EVENTS:
+        update_geometry(vo);
+        return VO_TRUE;
+    case VOCTRL_RESET:
+        mp_image_unrefp(&p->cur_image);
+        p->cur_pts = 0;
+        p->cur_frame_id = 0;
+        p->cur_duration = 0;
+        mediacodec_timing_reset(&p->timing);
+        p->osd_pts = MP_NOPTS_VALUE;
+        invalidate_osd(vo);
+        return VO_TRUE;
+    default:
+        return VO_NOTIMPL;
+    }
+}
+
+static int reconfig(struct vo *vo, struct mp_image_params *params)
+{
+    struct priv *p = vo->priv;
+    mp_image_unrefp(&p->cur_image);
+    p->cur_pts = 0;
+    p->cur_frame_id = 0;
+    p->cur_duration = 0;
+    mediacodec_timing_reset(&p->timing);
+    p->osd_pts = MP_NOPTS_VALUE;
+    invalidate_osd(vo);
+
+    return 0;
+}
+
+static void uninit(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    talloc_free(p->geometry_cache);
+    p->geometry_cache = NULL;
+    mp_image_unrefp(&p->cur_image);
+
+    if (p->osd_thread_created) {
+        mp_mutex_lock(&p->osd_lock);
+        p->osd_terminate = true;
+        p->osd_epoch++;
+        mp_cond_signal(&p->osd_wakeup);
+        mp_mutex_unlock(&p->osd_lock);
+    }
+    if (p->vsync_thread_created) {
+        mp_mutex_lock(&p->vsync_lock);
+        p->vsync_terminate = true;
+        if (p->vsync_looper)
+            ALooper_wake(p->vsync_looper);
+        mp_mutex_unlock(&p->vsync_lock);
+    }
+
+    if (p->osd_thread_created) {
+        mp_thread_join(p->osd_thread);
+        mp_cond_destroy(&p->osd_wakeup);
+        mp_mutex_destroy(&p->osd_lock);
+    }
+    if (p->vsync_thread_created) {
+        mp_thread_join(p->vsync_thread);
+        mp_mutex_destroy(&p->vsync_lock);
+    }
+    if (p->choreographer_lib)
+        dlclose(p->choreographer_lib);
+
+    if (p->osd_window)
+        ANativeWindow_release(p->osd_window);
+
+    hwdec_devices_remove(vo->hwdec_devs, &p->hwctx);
+    av_buffer_unref(&p->hwctx.av_device_ref);
+}
+
+#define OPT_BASE_STRUCT struct priv
+
+const struct vo_driver video_out_mediacodec = {
+    .description = "Android (Timed MediaCodec Surface with OSD plane)",
+    .name = "mediacodec",
+    .preinit = preinit,
+    .query_format = query_format,
+    .control = control,
+    .draw_frame = draw_frame,
+    .flip_page = flip_page,
+    .reconfig = reconfig,
+    .uninit = uninit,
+    .priv_size = sizeof(struct priv),
+    .options = (const struct m_option[]){
+        {"osd-surface", OPT_INT64(osd_surface)},
+        {0}
+    },
+    .options_prefix = "vo-mediacodec",
+    .global_opts = &mediacodec_conf,
+};
