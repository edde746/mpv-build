+// --- mediacodec timing core
+
+struct mediacodec_timing {
+    uint64_t frame_id;
+    int64_t target_ns;
+    double frame_duration_ns;
+    int64_t vsync_hysteresis_offset_ns;
+};
+
+static void mediacodec_timing_reset(struct mediacodec_timing *timing)
+{
+    *timing = (struct mediacodec_timing){0};
+}
+
+static int64_t mediacodec_timing_predict(struct mediacodec_timing *timing,
+                                        int64_t raw_target_ns, uint64_t frame_id,
+                                        double frame_duration_ns)
+{
+    if (!frame_id || !isfinite(frame_duration_ns) || frame_duration_ns <= 0) {
+        mediacodec_timing_reset(timing);
+        return raw_target_ns;
+    }
+
+    int64_t target_ns = raw_target_ns;
+    bool predicted = false;
+    if (timing->frame_id && frame_id > timing->frame_id &&
+        fabs(frame_duration_ns - timing->frame_duration_ns) <= 1000000.0)
+    {
+        // vo_frame.duration already accounts for playback speed. The ID gap
+        // includes frames dropped by the VO, unlike a local frame counter.
+        double elapsed_ns = (frame_id - timing->frame_id) * frame_duration_ns;
+        // Bound the conversion and addition even after a very large ID gap.
+        if (elapsed_ns < 0x1p63) {
+            int64_t elapsed = (int64_t)elapsed_ns;
+            if (timing->target_ns <= INT64_MAX - elapsed) {
+                int64_t candidate = timing->target_ns + elapsed;
+                uint64_t deviation = candidate >= raw_target_ns
+                    ? (uint64_t)candidate - (uint64_t)raw_target_ns
+                    : (uint64_t)raw_target_ns - (uint64_t)candidate;
+                if (deviation <= 20000000) {
+                    target_ns = candidate;
+                    predicted = true;
+                }
+            }
+        }
+    }
+
+    if (!predicted)
+        mediacodec_timing_reset(timing);
+    timing->frame_id = frame_id;
+    timing->target_ns = target_ns;
+    timing->frame_duration_ns = frame_duration_ns;
+    return target_ns;
+}
+
+static int64_t mediacodec_timing_snap(struct mediacodec_timing *timing,
+                                     int64_t target_ns, int64_t sample_ns,
+                                     int64_t period_ns)
+{
+    if (period_ns <= 0) {
+        timing->vsync_hysteresis_offset_ns = 0;
+        return target_ns;
+    }
+
+    int64_t delta = target_ns - sample_ns;
+    int64_t count = delta / period_ns;
+    if (delta < 0 && delta % period_ns)
+        count--;
+    int64_t before = sample_ns + count * period_ns;
+    int64_t after = before + period_ns;
+    int64_t before_diff = target_ns - before;
+    int64_t after_diff = after - target_ns;
+    int64_t diff = after_diff >= before_diff
+                 ? after_diff - before_diff : before_diff - after_diff;
+
+    // Media3 1.11: retain the last ambiguous choice across clear matches
+    // (e.g. 60 fps on 90 Hz), but clear it in the intervening range.
+    if (diff < period_ns / 2) {
+        int64_t range = period_ns / 4;
+        if (diff < range) {
+            if (!timing->vsync_hysteresis_offset_ns)
+                timing->vsync_hysteresis_offset_ns =
+                    after_diff < before_diff ? -range : range;
+        } else {
+            timing->vsync_hysteresis_offset_ns = 0;
+        }
+    }
+
+    return after_diff + timing->vsync_hysteresis_offset_ns < before_diff
+         ? after : before;
+}
+
+// Release timestamp, on now_ns's clock, for a frame due at raw_target_ns;
+// 0 releases untimed, i.e. at the next vsync. sample_ns is a vsync timestamp
+// on that clock, or 0 when none is fresh; period_ns is the display period, or
+// 0 when unknown. The surface presents a buffer at the first vsync at or after
+// its timestamp, so a timestamp in the near past still lands on the chosen
+// vsync: once cadence correction and snapping chose a vsync, the release is
+// that vsync minus 80% of a period even when the VO thread runs late. The
+// unsnapped target must never substitute for it: for half of all frames it
+// lies past its grid line and would round up to the following vsync. A late
+// raw deadline releases untimed but still advances the cadence anchor, so the
+// next frame predicts from cadence rather than a jittered raw deadline and
+// keeps its hysteresis choice (Media3 adjusts frames it then drops the same
+// way); only an unknown clock or a deadline beyond max_ahead_ns is a
+// discontinuity that resets.
+static int64_t mediacodec_timing_release(struct mediacodec_timing *timing,
+                                         int64_t raw_target_ns, int64_t now_ns,
+                                         uint64_t frame_id,
+                                         double frame_duration_ns,
+                                         int64_t sample_ns, int64_t period_ns,
+                                         int64_t max_ahead_ns)
+{
+    if (now_ns <= 0 || raw_target_ns > now_ns + max_ahead_ns) {
+        mediacodec_timing_reset(timing);
+        return 0;
+    }
+
+    int64_t target_ns = mediacodec_timing_predict(timing, raw_target_ns,
+                                                  frame_id, frame_duration_ns);
+    if (raw_target_ns <= now_ns)
+        return 0;
+    if (period_ns <= 0 || !sample_ns)
+        return target_ns;
+
+    int64_t snapped = mediacodec_timing_snap(timing, target_ns, sample_ns,
+                                             period_ns);
+    return snapped - period_ns * 8 / 10;
+}
+
+// --- end mediacodec timing core
