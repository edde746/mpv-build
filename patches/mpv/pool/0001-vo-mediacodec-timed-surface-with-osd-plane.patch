+
+    // Choreographer vsync sampler
+    void *choreographer_lib;
+    mp_get_choreographer_fn get_choreographer;
+    mp_post_frame_callback_fn post_frame_callback;
+    mp_post_frame_callback_delayed_fn post_frame_callback_delayed;
+    mp_post_frame_callback64_fn post_frame_callback64;
+    mp_post_frame_callback_delayed64_fn post_frame_callback_delayed64;
+    AChoreographer *choreographer;
