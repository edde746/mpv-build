Subject: [PATCH] vo_mediacodec: split a late frame's wait between the core and the VO thread

The frame-timing lines 0129 adds showed where a late frame's time went on an
Amlogic S928X box playing 1080i50 at 25 Hz: 71 of 77 late frames left the
decoder 12-253 ms before their deadline and reached this VO's preparation
after it (Plezy #2485). The wait sits between the decoder hand-off and the
VO, and the line cannot yet say whose it is: the core queues a frame only
after the VO has taken the previous one out of its one-frame queue, and the
VO thread then has to run to see it.

Stamp each vo_frame, in mp_time_ns() units, with when the VO last took a
frame out of its queue before this one was queued, when the core queued this
one, and when the VO thread first ran its render pass with it queued; the
frame-timing line reports them as freed, handoff and wake, on the same
CLOCK_MONOTONIC scale as the other stages. Diagnostics only.

Its vo_mediacodec.c side is folded into
0100-vo-mediacodec-timed-surface-with-osd-plane, which carries that
whole file.

diff --git a/video/out/vo.c b/video/out/vo.c
index 8dd5b68..ec04b0c 100644
--- a/video/out/vo.c
+++ b/video/out/vo.c
@@ -160,6 +160,7 @@ struct vo_internal {
 
     int64_t flip_queue_offset; // queue flip events at most this much in advance
     int64_t timing_offset;     // same (but from options; not VO configured)
+    int64_t slot_free_ns;      // when render_frame last took frame_queued
 
     int64_t delayed_count;
     int64_t drop_count;
@@ -882,6 +883,8 @@ void vo_queue_frame(struct vo *vo, struct vo_frame *frame)
            (!in->current_frame || in->current_frame->num_vsyncs < 1));
     in->hasframe = true;
     frame->frame_id = ++(in->current_frame_id);
+    frame->slot_free_ns = in->slot_free_ns;
+    frame->queued_ns = mp_time_ns();
     in->frame_queued = frame;
     in->wakeup_pts = frame->display_synced
                    ? 0 : frame->pts + MPMAX(frame->duration, 0);
@@ -960,10 +963,13 @@ static bool render_frame(struct vo *vo)
     struct vo_frame *frame = NULL;
     bool more_frames = false;
 
+    int64_t woke = mp_time_ns();
     update_display_fps(vo);
 
     mp_mutex_lock(&in->lock);
 
+    if (in->frame_queued && !in->frame_queued->woke_ns)
+        in->frame_queued->woke_ns = woke;
     if (!prepare_queued_frame(vo))
         goto done;
 
@@ -971,6 +977,7 @@ static bool render_frame(struct vo *vo)
         talloc_free(in->current_frame);
         in->current_frame = in->frame_queued;
         in->frame_queued = NULL;
+        in->slot_free_ns = mp_time_ns();
     } else if (in->paused || !in->current_frame || !in->hasframe ||
                (in->current_frame->display_synced && in->current_frame->num_vsyncs < 1) ||
                !in->current_frame->display_synced)
diff --git a/video/out/vo.h b/video/out/vo.h
index 17d96c4..9d340f7 100644
--- a/video/out/vo.h
+++ b/video/out/vo.h
@@ -288,6 +288,11 @@ struct vo_frame {
     // drops or reconfigs will keep the guarantee.
     // The ID is never 0 (unless num_frames==0). IDs are strictly monotonous.
     uint64_t frame_id;
+    // Diagnostics, mp_time_ns() units, 0 unknown: when the VO last took a
+    // frame out of its queue before this one was queued (the slot this one
+    // took), when the core queued this one, and when the VO thread first ran
+    // its render pass with this one queued.
+    int64_t slot_free_ns, queued_ns, woke_ns;
 };
 
 // Presentation feedback. See get_vsync() for how backends should fill this
