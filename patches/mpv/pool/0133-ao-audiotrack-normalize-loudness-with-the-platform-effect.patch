+// --audiotrack-normalize: loudness normalization by a platform audio effect on
+// the track's audio session, approximating loudnorm=I=-14:TP=-3:LRA=4 (the
+// same effect and parameters as Plezy's ExoPlayer backend). The effect runs
+// in AudioFlinger's mixer, so it costs the player nothing. loudnorm in --af
+// runs on the core thread at f64/192 kHz; on 32-bit TV boxes that pass took
+// long enough to make the video frames the same thread hands to
+// vo_mediacodec late.
+//
+// API 28+: DynamicsProcessing, one full-band compressor as a slow AGC with
+// makeup gain toward -14 LUFS, then a limiter at the -3 dB peak ceiling. Older
+// platforms, or a device without its effect HAL: LoudnessEnhancer, a fixed
+// boost with built-in limiting. Effects only process mixed PCM; bitstream
+// tracks are left alone.
+#define NORM_EFFECT_PRIORITY 0
+#define NORM_FRAME_DURATION_MS 10.0f
+#define NORM_MBC_CUTOFF_HZ 20000.0f
+#define NORM_MBC_ATTACK_MS 30.0f
+#define NORM_MBC_RELEASE_MS 300.0f
+#define NORM_MBC_RATIO 4.0f
+#define NORM_MBC_THRESHOLD_DB (-34.0f)
+#define NORM_MBC_KNEE_DB 6.0f
+#define NORM_MBC_NOISE_GATE_DB (-90.0f) // effectively off
+#define NORM_MBC_EXPANDER_RATIO 1.0f    // no downward expansion
+#define NORM_MBC_POST_GAIN_DB 15.0f
+#define NORM_LIMITER_ATTACK_MS 1.0f
+#define NORM_LIMITER_RELEASE_MS 60.0f
+#define NORM_LIMITER_RATIO 10.0f
+#define NORM_LIMITER_THRESHOLD_DB (-3.0f)
+#define NORM_LOUDNESS_ENHANCER_GAIN_MB 900 // +9 dB
+
+// A failed effect means a fallback, not a broken AO: clear and log the
+// pending exception, if any, at warn level.
+static bool normalizer_failed(struct ao *ao, JNIEnv *env)
+{
+    if (!(*env)->ExceptionCheck(env))
+        return false;
+    jthrowable exception = (*env)->ExceptionOccurred(env);
+    (*env)->ExceptionClear(env);
+    char *message = NULL;
+    if (mp_jni_exception_get_summary(env, exception, &message, ao->log) >= 0)
+        MP_WARN(ao, "normalization: %s\n", message);
+    talloc_free(message);
+    MP_JNI_LOCAL_FREEP(&exception);
+    return true;
+}
+
+// Enables a freshly created effect; releases it and returns NULL on failure.
+static jobject normalizer_enable(struct ao *ao, JNIEnv *env, jobject effect)
+{
+    if (!effect)
+        return NULL;
+    jint ret = MP_JNI_CALL_INT(effect, AudioEffect.setEnabled, JNI_TRUE);
+    if (!normalizer_failed(ao, env) && ret == 0) // AudioEffect.SUCCESS
+        return effect;
+    MP_WARN(ao, "normalization: effect could not be enabled (%d)\n", (int)ret);
+    MP_JNI_CALL_VOID(effect, AudioEffect.release);
+    normalizer_failed(ao, env);
+    MP_JNI_LOCAL_FREEP(&effect);
+    return NULL;
+}
+
+static jobject normalizer_new_dynamics_processing(struct ao *ao, JNIEnv *env,
+                                                  jint session, int channels)
+{
+    if (!DynamicsProcessing.clazz || !DynamicsProcessingConfigBuilder.clazz ||
+        !DynamicsProcessingChannel.clazz || !DynamicsProcessingMbc.clazz ||
+        !DynamicsProcessingMbcBand.clazz || !DynamicsProcessingLimiter.clazz)
+        return NULL;
+
+    jobject band = NULL, mbc = NULL, limiter = NULL, channel = NULL;
+    jobject builder = NULL, config = NULL, tmp = NULL, effect = NULL;
+
+    band = MP_JNI_NEW(DynamicsProcessingMbcBand.clazz, DynamicsProcessingMbcBand.ctor,
+                      JNI_TRUE, NORM_MBC_CUTOFF_HZ, NORM_MBC_ATTACK_MS,
+                      NORM_MBC_RELEASE_MS, NORM_MBC_RATIO, NORM_MBC_THRESHOLD_DB,
+                      NORM_MBC_KNEE_DB, NORM_MBC_NOISE_GATE_DB,
+                      NORM_MBC_EXPANDER_RATIO, 0.0f /* preGain */,
+                      NORM_MBC_POST_GAIN_DB);
+    if (normalizer_failed(ao, env) || !band)
+        goto done;
+    mbc = MP_JNI_NEW(DynamicsProcessingMbc.clazz, DynamicsProcessingMbc.ctor,
+                     JNI_TRUE, JNI_TRUE, (jint)1);
+    if (normalizer_failed(ao, env) || !mbc)
+        goto done;
+    MP_JNI_CALL_VOID(mbc, DynamicsProcessingMbc.setBand, (jint)0, band);
+    if (normalizer_failed(ao, env))
+        goto done;
+    limiter = MP_JNI_NEW(DynamicsProcessingLimiter.clazz, DynamicsProcessingLimiter.ctor,
+                         JNI_TRUE, JNI_TRUE, (jint)0 /* linkGroup */,
+                         NORM_LIMITER_ATTACK_MS, NORM_LIMITER_RELEASE_MS,
+                         NORM_LIMITER_RATIO, NORM_LIMITER_THRESHOLD_DB,
+                         0.0f /* postGain */);
+    if (normalizer_failed(ao, env) || !limiter)
+        goto done;
+    // inputGain, preEq (off), one MBC band, postEq (off), limiter
+    channel = MP_JNI_NEW(DynamicsProcessingChannel.clazz, DynamicsProcessingChannel.ctor,
+                         0.0f, JNI_FALSE, (jint)0, JNI_TRUE, (jint)1,
+                         JNI_FALSE, (jint)0, JNI_TRUE);
+    if (normalizer_failed(ao, env) || !channel)
+        goto done;
+    MP_JNI_CALL_VOID(channel, DynamicsProcessingChannel.setMbc, mbc);
+    if (normalizer_failed(ao, env))
+        goto done;
+    MP_JNI_CALL_VOID(channel, DynamicsProcessingChannel.setLimiter, limiter);
+    if (normalizer_failed(ao, env))
+        goto done;
+    builder = MP_JNI_NEW(DynamicsProcessingConfigBuilder.clazz,
+                         DynamicsProcessingConfigBuilder.ctor,
+                         DynamicsProcessing.VARIANT_FAVOR_FREQUENCY_RESOLUTION,
+                         (jint)channels, JNI_FALSE, (jint)0, JNI_TRUE, (jint)1,
+                         JNI_FALSE, (jint)0, JNI_TRUE);
+    if (normalizer_failed(ao, env) || !builder)
+        goto done;
+    tmp = MP_JNI_CALL_OBJECT(builder, DynamicsProcessingConfigBuilder.setPreferredFrameDuration,
+                             NORM_FRAME_DURATION_MS);
+    MP_JNI_LOCAL_FREEP(&tmp);
+    if (normalizer_failed(ao, env))
+        goto done;
+    tmp = MP_JNI_CALL_OBJECT(builder, DynamicsProcessingConfigBuilder.setAllChannelsTo, channel);
+    MP_JNI_LOCAL_FREEP(&tmp);
+    if (normalizer_failed(ao, env))
+        goto done;
+    config = MP_JNI_CALL_OBJECT(builder, DynamicsProcessingConfigBuilder.build);
+    if (normalizer_failed(ao, env) || !config)
+        goto done;
+    effect = MP_JNI_NEW(DynamicsProcessing.clazz, DynamicsProcessing.ctor,
+                        (jint)NORM_EFFECT_PRIORITY, session, config);
+    if (normalizer_failed(ao, env))
+        MP_JNI_LOCAL_FREEP(&effect);
+
+done:
+    MP_JNI_LOCAL_FREEP(&config);
+    MP_JNI_LOCAL_FREEP(&builder);
+    MP_JNI_LOCAL_FREEP(&channel);
+    MP_JNI_LOCAL_FREEP(&limiter);
+    MP_JNI_LOCAL_FREEP(&mbc);
+    MP_JNI_LOCAL_FREEP(&band);
+    return normalizer_enable(ao, env, effect);
+}
+
+static jobject normalizer_new_loudness_enhancer(struct ao *ao, JNIEnv *env,
+                                                jint session)
+{
+    if (!LoudnessEnhancer.clazz)
+        return NULL;
+    jobject effect = MP_JNI_NEW(LoudnessEnhancer.clazz, LoudnessEnhancer.ctor, session);
+    if (normalizer_failed(ao, env) || !effect) {
+        MP_JNI_LOCAL_FREEP(&effect);
+        return NULL;
+    }
+    MP_JNI_CALL_VOID(effect, LoudnessEnhancer.setTargetGain,
+                     (jint)NORM_LOUDNESS_ENHANCER_GAIN_MB);
+    if (normalizer_failed(ao, env)) {
+        MP_JNI_CALL_VOID(effect, AudioEffect.release);
+        normalizer_failed(ao, env);
+        MP_JNI_LOCAL_FREEP(&effect);
+        return NULL;
+    }
+    return normalizer_enable(ao, env, effect);
+}
+
+// Called for every new track (p->audiotrack set), which with the default
+// --audiotrack-session-id=0 is also a new audio session.
+static void AudioTrack_attachNormalizer(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    JNIEnv *env = MP_JNI_GET_ENV(ao);
+
+    if (!p->cfg_normalize || af_fmt_is_spdif(ao->format) || !AudioEffect.clazz)
+        return;
+
+    jint session = MP_JNI_CALL_INT(p->audiotrack, AudioTrack.getAudioSessionId);
+    if (normalizer_failed(ao, env) || session <= 0) {
+        MP_WARN(ao, "normalization: track has no audio session (%d)\n", (int)session);
+        return;
+    }
+
+    const char *engine = "DynamicsProcessing";
+    jobject effect = normalizer_new_dynamics_processing(ao, env, session,
+                                                        ao->channels.num);
+    if (!effect) {
+        engine = "LoudnessEnhancer";
+        effect = normalizer_new_loudness_enhancer(ao, env, session);
+    }
+    if (!effect) {
+        MP_WARN(ao, "normalization: no loudness effect available\n");
+        return;
+    }
+
+    p->normalizer = (*env)->NewGlobalRef(env, effect);
+    if (!p->normalizer) {
+        MP_JNI_CALL_VOID(effect, AudioEffect.release);
+        normalizer_failed(ao, env);
+    }
+    MP_JNI_LOCAL_FREEP(&effect);
+    if (p->normalizer) {
+        MP_INFO(ao, "normalization: %s on session %d (%d channels)\n",
+                engine, (int)session, ao->channels.num);
+    }
+}
+
+static void AudioTrack_releaseNormalizer(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    if (!p->normalizer)
+        return;
+    JNIEnv *env = MP_JNI_GET_ENV(ao);
+    MP_JNI_CALL_VOID(p->normalizer, AudioEffect.release);
+    MP_JNI_EXCEPTION_LOG(ao);
+    MP_JNI_GLOBAL_FREEP(&p->normalizer);
+}
