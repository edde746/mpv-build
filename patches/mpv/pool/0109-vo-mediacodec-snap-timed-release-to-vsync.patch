+// ExoPlayer's VideoFrameReleaseHelper snaps to the nearest vsync, then places
+// the Surface timestamp 80% of a period before it. SurfaceView presents at the
+// vsync at or after the timestamp, away from the boundary where small clock or
+// scheduling errors would alternate between adjacent vsyncs.
+static struct release_target get_release_target(struct vo *vo, int64_t pts)
+{
+    struct priv *p = vo->priv;
+    struct release_target result = {0};
+    if (pts <= 0)
+        return result;
+
+    int64_t mono_now = monotonic_now_ns();
+    int64_t target = mp_time_to_monotonic_ns(pts);
+    if (mono_now <= 0 || target <= mono_now ||
+        target > mono_now + TIMED_RELEASE_MAX_AHEAD_NS)
+        return result;
+
+    if (p->queue_period > 0) {
+        int64_t sample = read_vsync_sample(p);
+        if (vsync_sample_is_fresh(p, sample, mono_now)) {
+            int64_t snapped =
+                closest_vsync(target, sample, p->queue_period);
+            int64_t release = snapped - p->queue_period * 8 / 10;
+            if (release > mono_now &&
+                release <= mono_now + TIMED_RELEASE_MAX_AHEAD_NS)
+            {
+                result.timestamp = release;
+            }
+        }
+    }
+
+    if (!result.timestamp)
+        result.timestamp = target;
+
+    int64_t mp_now = mp_time_ns();
+    result.osd_deadline = mp_now + result.timestamp - monotonic_now_ns();
+    return result;
 }
 
