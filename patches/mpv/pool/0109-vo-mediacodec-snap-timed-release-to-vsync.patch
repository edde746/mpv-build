+static int64_t monotonic_now_ns(void)
+{
+    struct timespec ts;
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0)
+        return 0;
+    return ts.tv_sec * INT64_C(1000000000) + ts.tv_nsec;
+}
+
+// API 24-28 exposes a long frame timestamp. Reconstruct its upper bits on
+// 32-bit ABIs from the current monotonic clock; callbacks arrive well within
+// the +/-2.1 second range in which the nearest modulo-2^32 value is unique.
+static int64_t restore_frame_time(long frame_time)
+{
+    if (sizeof(long) >= sizeof(int64_t))
+        return frame_time;
+
+    int64_t now = monotonic_now_ns();
+    int32_t delta = (int32_t)((uint32_t)frame_time - (uint32_t)now);
+    return now + delta;
+}
