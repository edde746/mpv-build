+static void post_vsync_callback(struct vo *vo, bool delayed);
+
+static void record_vsync(struct vo *vo, int64_t frame_time)
+{
+    struct priv *p = vo->priv;
+
+    mp_mutex_lock(&p->vsync_lock);
+    p->vsync_sample = frame_time;
+    bool terminate = p->vsync_terminate;
+    mp_mutex_unlock(&p->vsync_lock);
+
+    if (!terminate)
+        post_vsync_callback(vo, true);
+}
+
+static void vsync_callback(long frame_time, void *arg)
+{
+    record_vsync(arg, restore_frame_time(frame_time));
+}
+
+static void vsync_callback64(int64_t frame_time, void *arg)
+{
+    record_vsync(arg, frame_time);
+}
+
+static void post_vsync_callback(struct vo *vo, bool delayed)
+{
+    struct priv *p = vo->priv;
+    const uint32_t delay_ms = delayed ? 500 : 0;
+
+    if (p->post_frame_callback_delayed64) {
+        if (delay_ms) {
+            p->post_frame_callback_delayed64(
+                p->choreographer, vsync_callback64, vo, delay_ms);
+        } else {
+            p->post_frame_callback64(p->choreographer, vsync_callback64, vo);
+        }
+    } else if (delay_ms) {
+        p->post_frame_callback_delayed(
+            p->choreographer, vsync_callback, vo, delay_ms);
+    } else {
+        p->post_frame_callback(p->choreographer, vsync_callback, vo);
+    }
+}
+
+static MP_THREAD_VOID vsync_thread(void *arg)
+{
+    struct vo *vo = arg;
+    struct priv *p = vo->priv;
+    mp_thread_set_name("vo/vsync");
+
+    ALooper *looper = ALooper_prepare(0);
+    AChoreographer *choreographer =
+        looper ? p->get_choreographer() : NULL;
+    if (!looper || !choreographer) {
+        MP_WARN(vo, "Choreographer unavailable; timed release will not be "
+                    "vsync-snapped.\n");
+        MP_THREAD_RETURN();
+    }
+
+    ALooper_acquire(looper);
+    mp_mutex_lock(&p->vsync_lock);
+    p->vsync_looper = looper;
+    p->choreographer = choreographer;
+    bool terminate = p->vsync_terminate;
+    mp_mutex_unlock(&p->vsync_lock);
+
+    if (!terminate)
+        post_vsync_callback(vo, false);
+
+    while (!terminate) {
+        if (ALooper_pollOnce(-1, NULL, NULL, NULL) == ALOOPER_POLL_ERROR)
+            break;
+        mp_mutex_lock(&p->vsync_lock);
+        terminate = p->vsync_terminate;
+        mp_mutex_unlock(&p->vsync_lock);
+    }
+
+    mp_mutex_lock(&p->vsync_lock);
+    p->vsync_looper = NULL;
+    p->choreographer = NULL;
+    p->vsync_sample = 0;
+    mp_mutex_unlock(&p->vsync_lock);
+    ALooper_release(looper);
+    MP_THREAD_RETURN();
+}
