+static void init_vsync_sampler(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    p->choreographer_lib = dlopen("libandroid.so", RTLD_NOW | RTLD_LOCAL);
+    if (!p->choreographer_lib)
+        return;
+
+    p->get_choreographer =
+        dlsym(p->choreographer_lib, "AChoreographer_getInstance");
+    p->post_frame_callback =
+        dlsym(p->choreographer_lib, "AChoreographer_postFrameCallback");
+    p->post_frame_callback_delayed =
+        dlsym(p->choreographer_lib, "AChoreographer_postFrameCallbackDelayed");
+    p->post_frame_callback64 =
+        dlsym(p->choreographer_lib, "AChoreographer_postFrameCallback64");
+    p->post_frame_callback_delayed64 =
+        dlsym(p->choreographer_lib, "AChoreographer_postFrameCallbackDelayed64");
+
+    bool have64 = p->post_frame_callback64 &&
+                  p->post_frame_callback_delayed64;
+    bool have_legacy = p->post_frame_callback &&
+                       p->post_frame_callback_delayed;
+    if (!p->get_choreographer || (!have64 && !have_legacy)) {
+        dlclose(p->choreographer_lib);
+        p->choreographer_lib = NULL;
+        return;
+    }
+    if (!have64) {
+        p->post_frame_callback64 = NULL;
+        p->post_frame_callback_delayed64 = NULL;
+    }
+
+    mp_mutex_init(&p->vsync_lock);
+    if (mp_thread_create(&p->vsync_thread, vsync_thread, vo)) {
+        MP_WARN(vo, "Failed to start the Choreographer sampler; timed release "
+                    "will not be vsync-snapped.\n");
+        mp_mutex_destroy(&p->vsync_lock);
+        dlclose(p->choreographer_lib);
+        p->choreographer_lib = NULL;
+        return;
+    }
+    p->vsync_thread_created = true;
+}
