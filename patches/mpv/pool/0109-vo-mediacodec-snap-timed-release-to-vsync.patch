+// MediaCodec's SurfaceView contract recommends releasing about two vsyncs
+// before presentation. Use a bounded 50 ms lead without display timing, as
+// established in preinit; missing/stale phase disables snapping, not timed
+// submission. display_period bounds a known mode's lead to at most 100 ms.
+static void update_queue_timing(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    int64_t mono_now = monotonic_now_ns();
+    int64_t period = display_period(vo);
+
+    if (period != p->queue_period) {
+        p->queue_period = period;
+        p->queue_period_changed = mono_now;
+    }
+
+    int64_t offset = period > 0 ? 2 * period : MP_TIME_MS_TO_NS(50);
+    if (offset == p->queue_offset)
+        return;
