 // --- end avf host present stamp ---
 
+// --- avf host refresh stamp (host-testable; keep freestanding) ---
+// Where in a refresh interval a host stamp goes (plezy#3073). After a flush
+// (a seek) the video layer and the OSD layer can settle on different
+// refreshes for samples stamped late in a refresh interval, and stay a
+// refresh apart until the next pause or seek. On tvOS with the stamps held
+// at one place in the interval, the subtitles were a refresh late for a
+// whole stretch after a seek in 18 of 38 stretches at 75% (24 Hz), 6 and 3
+// of 20 at 75% and 90% (50 Hz), and in none of 27 at 30% (24 Hz) or of 60
+// at 10-50% (50 Hz). A stamp is mpv's target time, so where it falls in the
+// interval is set anew at every pause and seek. A stamp moves to the nearest
+// point 30% of the way through an interval, by at most half a refresh
+// either way. A period of 0 (no vsync seen) leaves the target as it is.
+static int64_t avf_host_refresh_stamp_ns(int64_t target_ns, int64_t vsync_ns,
+                                         int64_t period_ns)
+{
+    if (period_ns <= 0)
+        return target_ns;
+    int64_t base_ns = vsync_ns + period_ns * 3 / 10;
+    int64_t offset_ns = target_ns - base_ns;
+    int64_t n = offset_ns / period_ns;
+    int64_t rest_ns = offset_ns % period_ns;
+    if (rest_ns < 0) {
+        rest_ns += period_ns;
+        n--;
+    }
+    if (rest_ns >= period_ns - rest_ns)
+        n++;
+    return base_ns + n * period_ns;
+}
+// --- end avf host refresh stamp ---
+
 // --- avf media stamp (host-testable; keep freestanding) ---
 // Media stamps never go back either. On media time a frame's sample is
 // stamped with its timestamp, and a reset's flush leaves the samples
@@ -5050,6 +5092,7 @@ static int preinit(struct vo *vo)
     atomic_init(&p->pending_layer_geometry_sync, false);
     atomic_init(&p->layer_geometry_dirty, false);
     atomic_init(&p->shader_layer_stale, false);
+    atomic_init(&p->refresh_vsync_ns, 0);
     atomic_init(&p->refresh_period_ns, 0);
 
     // Everything the main thread has to do for a new VO, in one trip to it:
@@ -5688,6 +5731,9 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
     p->next_pts = pts;
