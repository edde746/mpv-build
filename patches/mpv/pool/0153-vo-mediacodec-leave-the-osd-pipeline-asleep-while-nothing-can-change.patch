     if (render_ns > MP_TIME_MS_TO_NS(100)) {
@@ -571,6 +574,20 @@ static void osd_mark_served(struct osd_ahead *s, const struct osd_request *req)
         mp_cond_broadcast(&s->wakeup);
 }
 
+// Locked. A static OSD (osd_request.static_id) is settled once a render made
+// for a request that carried its id is queued or on screen: until the id or
+// the epoch moves, another render returns the same and posts nothing. Only a
+// render on demand settles it. A pre-render may be older than the change the
+// id stands for, and a result that was not queued leaves a repaint owed.
+static void osd_settle(struct osd_ahead *s, const struct osd_render_state *rs,
+                       const struct osd_request *req, bool rendered)
+{
+    bool settled = rendered && req->static_id && !rs->force_full &&
+                   req->epoch == s->epoch;
+    s->settled_id = settled ? req->static_id : 0;
+    s->settled_epoch = req->epoch;
+}
+
 static void osd_service_request(struct osd_ahead *s, struct osd_render_state *rs,
                                 struct osd_request req)
 {
@@ -579,6 +596,7 @@ static void osd_service_request(struct osd_ahead *s, struct osd_render_state *rs
     mp_mutex_lock(&s->lock);
     if (req.epoch != s->epoch) {
         rs->force_full = true;
+        osd_settle(s, rs, &req, false);
         mp_mutex_unlock(&s->lock);
         return;
     }
@@ -595,6 +613,7 @@ static void osd_service_request(struct osd_ahead *s, struct osd_render_state *rs
             spec_slot = osd_repeat_slot(s, rs, &req);
         bool queued = spec_slot >= 0 && osd_post_result(s, rs, spec_slot, &req);
         osd_prefetch_retire(&s->prefetch, req.pts, req.epoch);
+        osd_settle(s, rs, &req, false);
         osd_mark_served(s, &req);
         mp_mutex_unlock(&s->lock);
         rs->last = req;
@@ -604,8 +623,10 @@ static void osd_service_request(struct osd_ahead *s, struct osd_render_state *rs
     // Admission reserves queue capacity and consuming speculation frees its
     // slot; an active frame and event prefetch cannot exhaust the working slots.
     int slot = osd_free_slot(s);
-    if (slot < 0)
+    if (slot < 0) {
+        osd_settle(s, rs, &req, false);
         osd_mark_served(s, &req);
+    }
     mp_mutex_unlock(&s->lock);
     if (slot < 0) {
         rs->last = req;
@@ -618,6 +639,7 @@ static void osd_service_request(struct osd_ahead *s, struct osd_render_state *rs
     int post_slot = posted ? slot : osd_repeat_slot(s, rs, &req);
     bool queued = post_slot >= 0 && osd_post_result(s, rs, post_slot, &req);
     osd_prefetch_retire(&s->prefetch, req.pts, req.epoch);
+    osd_settle(s, rs, &req, rs->rendered);
     osd_mark_served(s, &req);
     mp_mutex_unlock(&s->lock);
     rs->last = req;
@@ -701,6 +723,10 @@ static MP_THREAD_VOID osd_render_thread(void *arg)
             continue;
         }
         rs.planned_seq = rs.last.seq;
+        // A static OSD has no next frame to render ahead and no event to
+        // warm; its next request renders on demand, which settles it.
+        if (rs.last.static_id)
+            continue;
         int spec_slot = osd_free_slot(s);
         bool eligible = !s->paused && rs.last.seq && rs.last.epoch == s->epoch &&
                         spec_slot >= 0 && !s->spec.valid;
@@ -796,6 +822,13 @@ void osd_ahead_invalidate(struct osd_ahead *s, double pts)
     });
 }
 
+// Locked.
+bool osd_ahead_is_settled(const struct osd_ahead *s, uint64_t static_id)
+{
+    return static_id && !s->requested && !s->repeat_unchanged &&
+           s->settled_id == static_id && s->settled_epoch == s->epoch;
+}
+
 // Locked.
 void osd_ahead_publish_release(struct osd_ahead *s, struct osd_release release)
 {
--- a/video/out/osd_ahead.h
+++ b/video/out/osd_ahead.h
@@ -138,6 +138,10 @@ struct osd_request {
     uint64_t seq;    // frame sequence, 0 for an unpinned repaint
     uint64_t epoch;
     bool full;
+    // osd_get_static_id() read before filing, or anything else that stays the
+    // same exactly while every pts renders the same; 0 when the OSD may
+    // change from one frame to the next.
+    uint64_t static_id;
 };
 
 // --- end osd ahead types
@@ -204,6 +208,10 @@ struct osd_ahead {
     // repeat_unchanged).
     uint64_t served_seq, served_epoch;
     bool served_waiter;         // broadcast wakeup when a request is served
+    // render -> VO: the static_id of the last request, once a render made
+    // for it is queued or on screen, else 0; and that request's epoch. See
+    // osd_ahead_is_settled.
+    uint64_t settled_id, settled_epoch;
 
     struct osd_ahead_stats stats;
     struct osd_spec spec;       // render (counters read by the VO thread)
@@ -234,6 +242,11 @@ void osd_ahead_destroy(struct osd_ahead *s);
 void osd_ahead_file_request(struct osd_ahead *s, struct osd_request req);
 // Locked. Discard everything in flight and repaint at pts.
 void osd_ahead_invalidate(struct osd_ahead *s, double pts);
+// Locked. Whether a request with this static_id would render what the last
+// one did and post nothing: the VO can leave it unfiled, and need not publish
+// that frame's release. False for 0, and while the pipeline repeats
+// unchanged frames.
+bool osd_ahead_is_settled(const struct osd_ahead *s, uint64_t static_id);
 // Locked. Publish when the frame with release.seq is shown.
 void osd_ahead_publish_release(struct osd_ahead *s, struct osd_release release);
 
--- a/video/out/vo_mediacodec.c
+++ b/video/out/vo_mediacodec.c
@@ -813,6 +813,11 @@ struct priv {
     // VO thread only
     struct osd_cadence cadence;
     uint64_t frame_seq;
+    // Whether the prepared and the current frame filed an OSD request, and
+    // the OSD window's size with the count of its changes (osd_static_id).
+    bool prepared_filed, cur_filed;
+    int osd_static_w, osd_static_h;
+    uint32_t osd_static_sizes;
     uint32_t stats_frames;
     struct stats_cadence osd_stats;
     struct present_stats present;
@@ -3092,9 +3097,39 @@ static void update_opts(struct vo *vo)
         vo->want_redraw = true;
 }
 
+// What the OSD plane shows for as long as this stays the same, or 0 when it
+// can change from one frame to the next: osd_get_static_id() for the window's
+// size, since a canvas of another size is another render. Both counts fit:
+// the size changes with the surface, the OSD with an option or a command.
+// The window is only asked while the answer can settle the pipeline: up to
+// API 30 a SurfaceView's buffer queue lives in SurfaceFlinger and each of the
+// two getters is a binder call. With a subtitle decoder attached, or a plane
+// presented on every frame (--vo-mediacodec-osd-vsync-delay), every frame is
+// requested whatever the id, the render pass reads the size itself, and a
+// request without an id is rendered ahead as it always was.
+static uint64_t osd_static_id(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    uint64_t id = p->osd_vsync_delay > 0 ? 0 : osd_get_static_id(vo->osd);
+    if (!id)
+        return 0;
+    int w = ANativeWindow_getWidth(p->osd_window);
+    int h = ANativeWindow_getHeight(p->osd_window);
+    if (w != p->osd_static_w || h != p->osd_static_h) {
+        p->osd_static_w = w;
+        p->osd_static_h = h;
+        p->osd_static_sizes++;
+    }
+    return w > 0 && h > 0 ? id << 24 | (p->osd_static_sizes & 0xFFFFFF) : 0;
+}
+
 // Preparation does not own or submit the decoder image. The core can discard
 // a queued frame on seek/drop while this bounded OSD request is in flight.
-static uint64_t prepare_osd(struct vo *vo, struct vo_frame *frame, bool synthetic)
+// *filed: whether a request went to the OSD pipeline. With no subtitle track
+// and nothing new on the OSD, a render returns what the last one did, so the
+// frame leaves the render and present threads asleep.
+static uint64_t prepare_osd(struct vo *vo, struct vo_frame *frame, bool synthetic,
+                            bool *filed)
 {
     struct priv *p = vo->priv;
     uint64_t seq = ++p->frame_seq;
@@ -3105,15 +3140,21 @@ static uint64_t prepare_osd(struct vo *vo, struct vo_frame *frame, bool syntheti
         else
             osd_cadence_observe(&p->cadence, frame->frame_id, pts);
     }
+    *filed = false;
     if (p->osd_threads_created) {
+        uint64_t static_id = osd_static_id(vo);
         mp_mutex_lock(&p->osd.lock);
-        osd_ahead_file_request(&p->osd, (struct osd_request){
-            .pts = pts,
-            .delta = synthetic ? 0 : osd_cadence_delta(&p->cadence),
-            .seq = seq,
-            .epoch = p->osd.epoch,
-        });
-        p->osd.stats.frames++;
+        if (!osd_ahead_is_settled(&p->osd, static_id)) {
+            osd_ahead_file_request(&p->osd, (struct osd_request){
+                .pts = pts,
+                .delta = synthetic ? 0 : osd_cadence_delta(&p->cadence),
+                .seq = seq,
+                .epoch = p->osd.epoch,
+                .static_id = static_id,
+            });
+            p->osd.stats.frames++;
+            *filed = true;
+        }
         mp_mutex_unlock(&p->osd.lock);
     }
     return seq;
@@ -3179,7 +3220,7 @@ static int64_t prepare_frame(struct vo *vo, struct vo_frame *frame)
     if (!p->prepared_seq || p->prepared_frame_id != frame->frame_id ||
         p->prepared_epoch != p->osd.epoch)
     {
-        p->prepared_seq = prepare_osd(vo, frame, false);
+        p->prepared_seq = prepare_osd(vo, frame, false, &p->prepared_filed);
         p->prepared_frame_id = frame->frame_id;
         p->prepared_epoch = p->osd.epoch;
     }
@@ -3220,11 +3261,12 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
         p->prepared_frame_id == frame->frame_id)
     {
         p->cur_seq = p->prepared_seq;
+        p->cur_filed = p->prepared_filed;
         p->cur_seen_ns = p->prepared_seen_ns;
     } else {
         if (!synthetic)
             update_queue_timing(vo, frame->duration);
-        p->cur_seq = prepare_osd(vo, frame, synthetic);
+        p->cur_seq = prepare_osd(vo, frame, synthetic, &p->cur_filed);
         p->cur_seen_ns = monotonic_now_ns();
     }
     return VO_TRUE;
@@ -3392,13 +3434,16 @@ static void flip_page(struct vo *vo)
         return;
 
     // The release timestamp is what keeps the OSD in step with the video;
-    // the present stage waits for it before it schedules the swap.
-    mp_mutex_lock(&p->osd.lock);
-    osd_ahead_publish_release(&p->osd, (struct osd_release){
-        .seq = p->cur_seq, .timestamp = target.timestamp, .vsync = target.vsync,
-        .period = p->queue_period,
-    });
-    mp_mutex_unlock(&p->osd.lock);
+    // the present stage waits for it before it schedules the swap. A frame
+    // that filed no request has no result waiting for one.
+    if (p->cur_filed) {
+        mp_mutex_lock(&p->osd.lock);
+        osd_ahead_publish_release(&p->osd, (struct osd_release){
+            .seq = p->cur_seq, .timestamp = target.timestamp, .vsync = target.vsync,
+            .period = p->queue_period,
+        });
+        mp_mutex_unlock(&p->osd.lock);
+    }
 
     stats_tick(vo);
 }
