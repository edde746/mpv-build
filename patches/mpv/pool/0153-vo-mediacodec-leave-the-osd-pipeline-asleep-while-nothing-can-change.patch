 };
 
+// Called locked, by whatever changes what the next osd_render() returns for
+// the objects that are not subtitles, or which subtitle decoder is attached.
+static inline void osd_note_change(struct osd_state *osd)
+{
+    osd->want_redraw_notification = true;
+    osd->change_count++;
+}
+
