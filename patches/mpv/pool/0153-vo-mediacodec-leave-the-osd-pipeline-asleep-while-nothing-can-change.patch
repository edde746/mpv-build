 }
 
@@ -328,6 +328,20 @@ void osd_get_sub_schedule(struct osd_state *osd, double pts, double after,
     mp_mutex_unlock(&osd->lock);
 }
 
+// For a VO that renders the OSD per video frame: nonzero while osd_render()
+// returns the same for every pts, and the same value for as long as it does,
+// so one render per value is enough. 0 while a subtitle decoder is attached:
+// what it draws moves with the video pts. The other objects only change
+// through osd_note_change().
+uint64_t osd_get_static_id(struct osd_state *osd)
+{
+    mp_mutex_lock(&osd->lock);
+    bool subs = osd->objs[OSDTYPE_SUB]->sub || osd->objs[OSDTYPE_SUB2]->sub;
+    uint64_t id = subs ? 0 : osd->change_count + 1;
+    mp_mutex_unlock(&osd->lock);
+    return id;
+}
