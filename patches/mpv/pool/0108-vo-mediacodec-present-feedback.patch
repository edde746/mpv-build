     if (p->osd_threads_created) {
         mp_mutex_lock(&p->osd_lock);
@@ -3480,6 +3612,8 @@ static void uninit(struct vo *vo)
     p->opts_cache = NULL;
     mp_image_unrefp(&p->cur_image);
 
+    if (present_feedback_on(p))
+        present_log_stats(vo, "final");
     osd_uninit(vo);
 
