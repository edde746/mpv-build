+// Record what this release aimed at, then take in what the codec has
+// rendered since the previous flip. A report for an intent that reset_video
+// dropped lands in unmatched, by design.
+static void present_feedback(struct vo *vo, AVMediaCodecBuffer *buffer,
+                             int64_t vsync)
+{
+    struct priv *p = vo->priv;
+    const char *source = av_mediacodec_rendered_source(buffer);
+    if (!p->present_source || strcmp(source, p->present_source)) {
+        p->present_source = source;
+        MP_VERBOSE(vo, "video-present feedback: %s\n", source);
+    }
+    present_record(&p->present, av_mediacodec_buffer_get_pts(buffer), vsync);
+    AVMediaCodecRendered reports[16];
+    int n;
+    while ((n = av_mediacodec_drain_rendered(buffer, reports,
+                                             MP_ARRAY_SIZE(reports))) > 0)
+    {
+        for (int i = 0; i < n; i++) {
+            present_observe(&p->present, reports[i].media_time_us,
+                            reports[i].system_nano, p->queue_period);
+        }
+    }
+}
+
 static void flip_page(struct vo *vo)
 {
     struct priv *p = vo->priv;
@@ -3379,6 +3509,7 @@ static void flip_page(struct vo *vo)
             : av_mediacodec_release_buffer(buffer, 1);
     if (ret >= 0)
