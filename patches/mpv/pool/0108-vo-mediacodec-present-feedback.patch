+
+static void present_log_stats(struct vo *vo, const char *why)
+{
+    struct priv *p = vo->priv;
+    const struct present_stats *s = &p->present;
+    MP_VERBOSE(vo, "video-present %s hist=%u,%u,%u,%u,%u lastMs=%s worstMs=%s "
+               "measured=%u untimed=%u unmatched=%u overrun=%u\n",
+               why, s->hist[0], s->hist[1], s->hist[2], s->hist[3], s->hist[4],
+               s->measured ? mp_tprintf(16, "%d", (int)(s->err_last_ns / 1000000)) : "n/a",
+               s->measured ? mp_tprintf(16, "%d", (int)(s->err_worst_ns / 1000000)) : "n/a",
+               s->measured, s->untimed, s->unmatched, s->overrun);
+}
+
