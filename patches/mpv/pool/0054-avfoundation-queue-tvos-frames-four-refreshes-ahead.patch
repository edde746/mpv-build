+// --- avf queue lead (host-testable; keep freestanding) ---
+// How far ahead of their frame's time samples go to the layers. On tvOS a
+// layer shows a sample on the refresh its stamp asks for only when it has
+// the sample about three refreshes before that refresh, and a refresh later
+// otherwise. The video layer's limit and the OSD layer's differ, between 2.9
+// and 3.3 refreshes, and a frame enqueued in between showed its subtitles a
+// refresh before or after its picture (plezy#3073). At 24 Hz queue-lead-ms's
+// 128 ms is 3.1 refreshes, frames reached the layers 2.8 to 3.9 refreshes
+// ahead depending on where their stamps fell in the refresh, and that was
+// set anew at every pause and seek. The lead is at least
+// AVF_QUEUE_LEAD_REFRESHES refreshes, past both limits with a flip some
+// milliseconds late; a period of 0 (refresh unknown) keeps option_ns.
+#define AVF_QUEUE_LEAD_REFRESHES 4
+static int64_t avf_queue_lead_ns(int64_t option_ns, int64_t period_ns)
+{
+    int64_t refreshes_ns = AVF_QUEUE_LEAD_REFRESHES * period_ns;
+    return refreshes_ns > option_ns ? refreshes_ns : option_ns;
+}
+// --- end avf queue lead ---
+
+// Apply the queue lead for queue-lead-ms and the display's refresh, which a
+// display mode switch changes during playback. The display link's period
+// wobbles by nanoseconds from one vsync to the next, a mode switch moves it
+// by milliseconds, and queue-lead-ms moves in milliseconds.
+static void update_queue_lead(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    int64_t lead_ns = avf_queue_lead_ns(MP_TIME_MS_TO_NS(p->opts->queue_lead_ms),
+                                        atomic_load(&p->refresh_period_ns));
+    if (llabs(lead_ns - p->queue_lead_ns) < MP_TIME_MS_TO_NS(1))
+        return;
+    p->queue_lead_ns = lead_ns;
+    vo_set_queue_params(vo, lead_ns, 1);
+    MP_VERBOSE(vo, "Queue lead %.1f ms\n", lead_ns / 1e6);
+}
+
 // --- avf host timebase drift (host-testable; keep freestanding) ---
