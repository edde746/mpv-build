+// --- avf osd color (host-testable; keep freestanding) ---
+// Subtitle colours are the video's RGB: VSFilter blends subtitles into the
+// picture before it is converted for the display, typesetters match signs
+// and masks to the picture in that RGB, and sd_ass's colour compat converts
+// a script's colours to the video's matrix. The compositor converts each
+// sample from the colour it carries and shows an untagged overlay buffer as
+// it is: Apple's BT.709 transfer lifted the video's midtones and not the
+// subtitle's (128 shows as 139 on an sRGB display), and a wide gamut display
+// took the subtitle's values as its own primaries, so a mask matched to the
+// picture showed as a patch over it. Overlay samples carry the colour of the
+// video under them instead.
+
+// The attachments that say which colour an RGB buffer's values are in. The
+// YCbCr matrix stays the video's: an overlay buffer is RGB.
+#define AVF_OSD_COLOR_KEYS {            \
+    kCVImageBufferCGColorSpaceKey,      \
+    kCVImageBufferICCProfileKey,        \
+    kCVImageBufferColorPrimariesKey,    \
+    kCVImageBufferTransferFunctionKey,  \
+    kCVImageBufferGammaLevelKey,        \
+}
+
+// The colour an overlay buffer takes from video, the buffer of the frame it
+// is shown over: video's colour attachments, or NULL (untagged) when it has
+// none or is hdr (PQ, HLG, Dolby Vision), whose transfer would put subtitle
+// white at the signal's peak.
+static CFDictionaryRef avf_osd_color_create(CVPixelBufferRef video, bool hdr)
+{
+    if (hdr)
+        return NULL;
+    const CFStringRef keys[] = AVF_OSD_COLOR_KEYS;
+    CFMutableDictionaryRef color = NULL;
+    for (size_t i = 0; i < sizeof(keys) / sizeof(keys[0]); i++) {
+        CFTypeRef value = CVBufferGetAttachment(video, keys[i], NULL);
+        if (!value)
+            continue;
+        if (!color) {
+            color = CFDictionaryCreateMutable(NULL, sizeof(keys) / sizeof(keys[0]),
+                &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        }
+        CFDictionarySetValue(color, keys[i], value);
+    }
+    return color;
+}
+
+// Give the overlay buffer pixbuf color (avf_osd_color_create's; NULL: none),
+// dropping any other colour it was given before. Only attachments that differ
+// are touched: a pool buffer keeps what it was given, and setting or
+// removing one on an IOSurface-backed buffer is a kernel round trip.
+static void avf_osd_color_apply(CFDictionaryRef color, CVPixelBufferRef pixbuf)
+{
+    const CFStringRef keys[] = AVF_OSD_COLOR_KEYS;
+    for (size_t i = 0; i < sizeof(keys) / sizeof(keys[0]); i++) {
+        CFTypeRef want = color ? CFDictionaryGetValue(color, keys[i]) : NULL;
+        CFTypeRef have = CVBufferGetAttachment(pixbuf, keys[i], NULL);
+        if (want == have || (want && have && CFEqual(want, have)))
+            continue;
+        if (want) {
+            CVBufferSetAttachment(pixbuf, keys[i], want,
+                                  kCVAttachmentMode_ShouldPropagate);
+        } else {
+            CVBufferRemoveAttachment(pixbuf, keys[i]);
+        }
+    }
+}
+// --- end avf osd color ---
+
+// The OSD's colour (osd_color) for the frame mpi, whose buffer as decoded or
+// uploaded is pixbuf. Taken again only when mpi's params change.
+static void update_osd_color(struct priv *p, struct mp_image *mpi,
+                             CVPixelBufferRef pixbuf)
+{
+    if (mp_image_params_static_equal(&mpi->params, &p->osd_color_params))
+        return;
+    p->osd_color_params = mpi->params;
+    if (p->osd_color)
+        CFRelease(p->osd_color);
+    p->osd_color = avf_osd_color_create(pixbuf,
+        pl_color_transfer_is_hdr(mpi->params.color.transfer) ||
+        mpi->params.repr.sys == PL_COLOR_SYSTEM_DOLBYVISION);
+}
