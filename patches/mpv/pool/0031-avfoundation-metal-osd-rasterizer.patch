+    // Inline OSD layer buffers are rasterized on the GPU when avfoundation-
+    // osd-gpu is set; the CPU path stays as the fallback. VO thread only.
+    struct avf_metal_osd metal_osd;
+    bool metal_osd_ready;
+    bool metal_osd_failed;          // setup failed: CPU for this VO
+    bool metal_osd_draw_error_logged;
+
