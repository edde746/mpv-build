+// --- avf metal osd core ---
+//
+// Rasterizes an OSD part list into a BGRA pixel buffer on the GPU. The parts'
+// bitmaps (libass coverage masks, or premultiplied BGRA for bitmap subtitles)
+// are copied into an atlas texture and each part is drawn as a textured quad
+// with premultiplied source-over blending, the same composition
+// blend_libass_bgra() and blend_bgra_over_bgra() perform on the CPU. The first
+// render pass clears the whole target, so a recycled pool buffer needs no CPU
+// clear. The draw blocks until the GPU finished: the caller enqueues the buffer
+// right after, and a sample buffer carries no GPU fence.
+//
+// The atlas is packed here rather than reusing mpv's: that one is laid out for
+// area, not for a texture size limit (15368 pixels wide for a 4K sign), and
+// copying only the parts is less than copying its bounding box. Its memory is
+// capped; parts beyond one atlas are drawn in further passes, in order.
+//
+// Freestanding apart from the sub_bitmaps fields it reads, so the host harness
+// (scripts/test_avf_metal_osd.sh) compiles it verbatim.
+
+static const char avf_metal_osd_shader[] =
+    "#include <metal_stdlib>\n"
+    "using namespace metal;\n"
+    "struct Part { float4 dst; float4 src; float4 color; };\n"
+    "struct Frag { float4 pos [[position]]; float2 uv; float4 color [[flat]];\n"
+    "              float4 src [[flat]]; };\n"
+    "vertex Frag osd_vertex(uint vid [[vertex_id]], uint iid [[instance_id]],\n"
+    "                       const device Part *parts [[buffer(0)]],\n"
+    "                       constant float2 &size [[buffer(1)]])\n"
+    "{\n"
+    "    Part p = parts[iid];\n"
+    "    float2 t = float2(float(vid & 1), float(vid >> 1));\n"
+    "    float2 xy = mix(p.dst.xy, p.dst.zw, t);\n"
+    "    Frag o;\n"
+    "    o.pos = float4(xy.x / size.x * 2.0 - 1.0, 1.0 - xy.y / size.y * 2.0, 0.0, 1.0);\n"
+    "    o.uv = mix(p.src.xy, p.src.zw, t);\n"
+    "    o.color = p.color;\n"
+    "    o.src = p.src;\n"
+    "    return o;\n"
+    "}\n"
+    // libass bitmaps are drawn 1:1, so a coverage texel is read, not filtered.
+    "fragment float4 osd_mask_fragment(Frag in [[stage_in]],\n"
+    "                                  texture2d<float, access::read> atlas [[texture(0)]])\n"
+    "{\n"
+    "    uint2 texel = uint2(clamp(in.uv, in.src.xy, in.src.zw - 1.0));\n"
+    "    float a = atlas.read(texel).r * in.color.a;\n"
+    "    return float4(in.color.rgb * a, a);\n"
+    "}\n"
+    // Bitmap subtitles are scaled. Clamping to the part's own texel centers
+    // keeps bilinear filtering from reading its atlas neighbors.
+    "fragment float4 osd_bgra_fragment(Frag in [[stage_in]],\n"
+    "                                  texture2d<float> atlas [[texture(0)]])\n"
+    "{\n"
+    "    constexpr sampler s(coord::pixel, filter::linear, address::clamp_to_edge);\n"
+    "    return atlas.sample(s, clamp(in.uv, in.src.xy + 0.5, in.src.zw - 0.5));\n"
+    "}\n";
+
+// One instance of the quad; layout matches the shader's Part.
+struct avf_metal_osd_part {
+    float dst[4];   // x0, y0, x1, y1 in target pixels
+    float src[4];   // x0, y0, x1, y1 in atlas pixels
+    float color[4]; // straight RGB plus opacity; coverage atlases only
+};
+
+// Atlases live in linear, CPU-written buffers, so the upload is row copies. On
+// an Apple TV 4K (A15) a full-screen 4K sign uploaded through replaceRegion
+// cost two-thirds more for the same GPU time.
+struct avf_metal_osd_atlas {
+    id<MTLBuffer> buffer;
+    id<MTLTexture> texture; // views buffer
+    size_t stride;
+};
+
+struct avf_metal_osd {
+    id<MTLDevice> device;
+    id<MTLCommandQueue> queue;
+    id<MTLRenderPipelineState> mask_pipeline;
+    id<MTLRenderPipelineState> bgra_pipeline;
+    CVMetalTextureCacheRef texture_cache;
+    struct avf_metal_osd_atlas atlas[2]; // [0] R8 coverage, [1] BGRA; grow-only
+    id<MTLBuffer> parts;                 // grow-only
+};
+
+struct avf_metal_osd_timing {
+    int64_t upload_ns; // atlas and part upload (CPU)
+    int64_t gpu_ns;    // encode, submit and wait
+    int64_t exec_ns;   // of gpu_ns, GPU execution (command buffer timestamps)
+};
+
+static int64_t avf_metal_osd_now_ns(void)
+{
+    return (int64_t)clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+}
+
+static id<MTLRenderPipelineState> avf_metal_osd_pipeline(id<MTLDevice> device,
+                                                          id<MTLLibrary> library,
+                                                          NSString *fragment,
+                                                          NSError **error)
+{
+    id<MTLFunction> vs = [library newFunctionWithName:@"osd_vertex"];
+    id<MTLFunction> fs = [library newFunctionWithName:fragment];
+    MTLRenderPipelineDescriptor *desc = [[MTLRenderPipelineDescriptor alloc] init];
+    desc.vertexFunction = vs;
+    desc.fragmentFunction = fs;
+    MTLRenderPipelineColorAttachmentDescriptor *color = desc.colorAttachments[0];
+    color.pixelFormat = MTLPixelFormatBGRA8Unorm;
+    color.blendingEnabled = YES;
+    color.rgbBlendOperation = MTLBlendOperationAdd;
+    color.alphaBlendOperation = MTLBlendOperationAdd;
+    color.sourceRGBBlendFactor = MTLBlendFactorOne;
+    color.sourceAlphaBlendFactor = MTLBlendFactorOne;
+    color.destinationRGBBlendFactor = MTLBlendFactorOneMinusSourceAlpha;
+    color.destinationAlphaBlendFactor = MTLBlendFactorOneMinusSourceAlpha;
+    id<MTLRenderPipelineState> state = nil;
+    if (vs && fs)
+        state = [device newRenderPipelineStateWithDescriptor:desc error:error];
+    [desc release];
+    [vs release];
+    [fs release];
+    return state;
+}
+
+static void avf_metal_osd_uninit(struct avf_metal_osd *m)
+{
+    [m->parts release];
+    for (int i = 0; i < 2; i++) {
+        [m->atlas[i].texture release];
+        [m->atlas[i].buffer release];
+    }
+    if (m->texture_cache)
+        CFRelease(m->texture_cache);
+    [m->bgra_pipeline release];
+    [m->mask_pipeline release];
+    [m->queue release];
+    [m->device release];
+    *m = (struct avf_metal_osd){0};
+}
+
+static bool avf_metal_osd_init(struct avf_metal_osd *m, char *err, size_t err_size)
+{
+    @autoreleasepool {
+        *m = (struct avf_metal_osd){0};
+        m->device = MTLCreateSystemDefaultDevice();
+        if (!m->device) {
+            snprintf(err, err_size, "no Metal device");
+            return false;
+        }
+        m->queue = [m->device newCommandQueue];
+        NSError *error = nil;
+        id<MTLLibrary> library =
+            [m->device newLibraryWithSource:@(avf_metal_osd_shader) options:nil error:&error];
+        if (library) {
+            m->mask_pipeline = avf_metal_osd_pipeline(m->device, library,
+                                                      @"osd_mask_fragment", &error);
+            if (m->mask_pipeline) {
+                m->bgra_pipeline = avf_metal_osd_pipeline(m->device, library,
+                                                          @"osd_bgra_fragment", &error);
+            }
+            [library release];
+        }
+        if (CVMetalTextureCacheCreate(kCFAllocatorDefault, NULL, m->device, NULL,
+                                      &m->texture_cache) != kCVReturnSuccess)
+            m->texture_cache = NULL;
+        if (!m->queue || !m->mask_pipeline || !m->bgra_pipeline || !m->texture_cache) {
+            snprintf(err, err_size, "%s", error ? error.localizedDescription.UTF8String
+                                                : "Metal setup failed");
+            avf_metal_osd_uninit(m);
+            return false;
+        }
+        return true;
+    }
+}
+
+// Drop texture-cache entries for pool buffers that have since been freed.
+static void avf_metal_osd_flush(struct avf_metal_osd *m)
+{
+    if (m->texture_cache)
+        CVMetalTextureCacheFlush(m->texture_cache, 0);
+}
+
+// Atlas geometry per slot. Width holds any part of a 4K OSD (two coverage
+// masks per shelf); the row cap bounds memory to 32-36 MiB per slot. A frame
+// whose parts do not fit is drawn in several passes.
+static int avf_metal_osd_atlas_w(int slot)
+{
+    return slot ? 4096 : 8192;
+}
+
+static int avf_metal_osd_atlas_max_h(int slot)
+{
+    return slot ? 2304 : 4096;
+}
+
+// The slot's atlas texture, at least h rows tall (h within the cap).
+static id<MTLTexture> avf_metal_osd_atlas_texture(struct avf_metal_osd *m, int slot,
+                                                  MTLPixelFormat format, int bpp, int h)
+{
+    struct avf_metal_osd_atlas *a = &m->atlas[slot];
+    if (a->texture && (int)a->texture.height >= h)
+        return a->texture;
+
+    // Round up so a slowly growing atlas does not reallocate every frame.
+    int th = MPMAX(h, a->texture ? (int)a->texture.height : 0);
+    th = MPMIN((th + 255) & ~255, avf_metal_osd_atlas_max_h(slot));
+    int tw = avf_metal_osd_atlas_w(slot);
+    size_t align = [m->device minimumLinearTextureAlignmentForPixelFormat:format];
+    size_t stride = ((size_t)tw * bpp + align - 1) / align * align;
+
+    [a->texture release];
+    [a->buffer release];
+    *a = (struct avf_metal_osd_atlas){
+        .buffer = [m->device newBufferWithLength:stride * th
+                                         options:MTLResourceStorageModeShared],
+        .stride = stride,
+    };
+    if (!a->buffer)
+        return nil;
+    MTLTextureDescriptor *desc =
+        [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:format
+                                                           width:tw
+                                                          height:th
+                                                       mipmapped:NO];
+    desc.usage = MTLTextureUsageShaderRead;
+    desc.storageMode = MTLStorageModeShared;
+    a->texture = [a->buffer newTextureWithDescriptor:desc offset:0 bytesPerRow:stride];
+    return a->texture;
+}
+
+static void avf_metal_osd_copy_part(struct avf_metal_osd_atlas *a, int bpp,
+                                    struct sub_bitmap *sb, int x, int y)
+{
+    uint8_t *dst = (uint8_t *)a->buffer.contents + (size_t)y * a->stride + (size_t)x * bpp;
+    size_t row = (size_t)sb->w * bpp;
+    for (int r = 0; r < sb->h; r++) {
+        memcpy(dst + (size_t)r * a->stride,
+               (const uint8_t *)sb->bitmap + (ptrdiff_t)r * sb->stride, row);
+    }
+}
+
+// Advance the shelf walk to a cw x ch cell: *x/*y become its position.
+static void avf_metal_osd_shelf(int atlas_w, int cw, int ch, int *x, int *y, int *row_h)
+{
+    if (*x + cw > atlas_w) {
+        *x = 0;
+        *y += *row_h;
+        *row_h = 0;
+    }
+    *row_h = MPMAX(*row_h, ch);
+}
+
+// Run one render pass over parts [first, first + n) of the part buffer, after
+// clearing the target or on top of what earlier passes drew.
+static bool avf_metal_osd_pass(struct avf_metal_osd *m, id<MTLTexture> target, bool clear,
+                               id<MTLRenderPipelineState> pipeline, id<MTLTexture> atlas,
+                               int first, int n, int64_t *exec_ns,
+                               char *err, size_t err_size)
+{
+    MTLRenderPassDescriptor *pass = [MTLRenderPassDescriptor renderPassDescriptor];
+    pass.colorAttachments[0].texture = target;
+    pass.colorAttachments[0].loadAction = clear ? MTLLoadActionClear : MTLLoadActionLoad;
+    pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+    pass.colorAttachments[0].clearColor = MTLClearColorMake(0, 0, 0, 0);
+
+    id<MTLCommandBuffer> cmd = [m->queue commandBuffer];
+    id<MTLRenderCommandEncoder> enc = [cmd renderCommandEncoderWithDescriptor:pass];
+    if (n > 0) {
+        float size[2] = {(float)target.width, (float)target.height};
+        [enc setRenderPipelineState:pipeline];
+        [enc setVertexBuffer:m->parts
+                      offset:(NSUInteger)first * sizeof(struct avf_metal_osd_part)
+                     atIndex:0];
+        [enc setVertexBytes:size length:sizeof(size) atIndex:1];
+        [enc setFragmentTexture:atlas atIndex:0];
+        // Instances rasterize and blend in submission order, which is the
+        // part order the CPU composition uses.
+        [enc drawPrimitives:MTLPrimitiveTypeTriangleStrip
+                vertexStart:0
+                vertexCount:4
+              instanceCount:n];
+    }
+    [enc endEncoding];
+    [cmd commit];
+    [cmd waitUntilCompleted];
+    *exec_ns += (int64_t)((cmd.GPUEndTime - cmd.GPUStartTime) * 1e9);
+    if (cmd.status != MTLCommandBufferStatusCompleted) {
+        snprintf(err, err_size, "command buffer failed: %s",
+                 cmd.error ? cmd.error.localizedDescription.UTF8String : "unknown error");
+        return false;
+    }
+    return true;
+}
+
+// Render imgs (NULL or no parts: clear only) into target, replacing all of its
+// contents. target must be an IOSurface-backed, Metal-compatible 32BGRA buffer.
+static bool avf_metal_osd_draw(struct avf_metal_osd *m, CVPixelBufferRef target,
+                               struct sub_bitmaps *imgs,
+                               struct avf_metal_osd_timing *timing,
+                               char *err, size_t err_size)
+{
+    @autoreleasepool {
+        int64_t t0 = avf_metal_osd_now_ns();
+        int64_t pass_ns = 0, exec_ns = 0;
+        bool ok = false;
+
+        CVMetalTextureRef target_ref = NULL;
+        if (CVMetalTextureCacheCreateTextureFromImage(
+                kCFAllocatorDefault, m->texture_cache, target, NULL,
+                MTLPixelFormatBGRA8Unorm, CVPixelBufferGetWidth(target),
+                CVPixelBufferGetHeight(target), 0, &target_ref) != kCVReturnSuccess ||
+            !target_ref)
+        {
+            snprintf(err, err_size, "cannot wrap the OSD buffer as a render target");
+            return false;
+        }
+        id<MTLTexture> rt = CVMetalTextureGetTexture(target_ref);
+
+        if (!imgs || imgs->num_parts <= 0) {
+            int64_t t = avf_metal_osd_now_ns();
+            ok = avf_metal_osd_pass(m, rt, true, nil, nil, 0, 0, &exec_ns, err, err_size);
+            pass_ns += avf_metal_osd_now_ns() - t;
+            goto done;
+        }
+
+        int slot;
+        if (imgs->format == SUBBITMAP_LIBASS) {
+            slot = 0;
+        } else if (imgs->format == SUBBITMAP_BGRA) {
+            slot = 1;
+        } else {
+            snprintf(err, err_size, "unsupported OSD format %d", (int)imgs->format);
+            goto done;
+        }
+        int bpp = slot ? 4 : 1;
+        int atlas_w = avf_metal_osd_atlas_w(slot);
+        int max_h = avf_metal_osd_atlas_max_h(slot);
+        id<MTLRenderPipelineState> pipeline = slot ? m->bgra_pipeline : m->mask_pipeline;
+
+        // Layout pass: the shelf walk alone sizes the atlas, up to its cap.
+        int x = 0, y = 0, row_h = 0;
+        for (int i = 0; i < imgs->num_parts; i++) {
+            struct sub_bitmap *sb = &imgs->parts[i];
+            if (!sb->bitmap || sb->w <= 0 || sb->h <= 0)
+                continue;
+            int cw = sb->w, ch = sb->h;
+            if (cw > atlas_w || ch > max_h) {
+                snprintf(err, err_size, "part %dx%d larger than the atlas", sb->w, sb->h);
+                goto done;
+            }
+            avf_metal_osd_shelf(atlas_w, cw, ch, &x, &y, &row_h);
+            x += cw;
+        }
+        id<MTLTexture> atlas = avf_metal_osd_atlas_texture(
+            m, slot, slot ? MTLPixelFormatBGRA8Unorm : MTLPixelFormatR8Unorm, bpp,
+            MPMIN(y + row_h, max_h));
+        if (!atlas) {
+            snprintf(err, err_size, "atlas allocation failed");
+            goto done;
+        }
+        int atlas_h = (int)atlas.height;
+
+        size_t bytes = (size_t)imgs->num_parts * sizeof(struct avf_metal_osd_part);
+        if (!m->parts || m->parts.length < bytes) {
+            [m->parts release];
+            m->parts = [m->device newBufferWithLength:MPMAX(bytes * 2, (size_t)4096)
+                                              options:MTLResourceStorageModeShared];
+            if (!m->parts) {
+                snprintf(err, err_size, "part buffer allocation failed");
+                goto done;
+            }
+        }
+
+        // Placement pass: copy each part and write its quad, in part order.
+        // When the atlas is full, draw what it holds and refill it.
+        struct avf_metal_osd_part *out = m->parts.contents;
+        int count = 0, first = 0;
+        bool clear = true;
+        x = y = row_h = 0;
+        for (int i = 0; i < imgs->num_parts; i++) {
+            struct sub_bitmap *sb = &imgs->parts[i];
+            if (!sb->bitmap || sb->w <= 0 || sb->h <= 0)
+                continue;
+            int cw = sb->w, ch = sb->h;
+            int nx = x, ny = y, nrow_h = row_h;
+            avf_metal_osd_shelf(atlas_w, cw, ch, &nx, &ny, &nrow_h);
+            if (ny + ch > atlas_h) {
+                int64_t t = avf_metal_osd_now_ns();
+                ok = avf_metal_osd_pass(m, rt, clear, pipeline, atlas, first, count - first,
+                                        &exec_ns, err, err_size);
+                pass_ns += avf_metal_osd_now_ns() - t;
+                if (!ok)
+                    goto done;
+                clear = false;
+                first = count;
+                nx = ny = 0;
+                nrow_h = ch;
+            }
+            x = nx;
+            y = ny;
+            row_h = nrow_h;
+            avf_metal_osd_copy_part(&m->atlas[slot], bpp, sb, x, y);
+            int dw = sb->dw > 0 ? sb->dw : sb->w;
+            int dh = sb->dh > 0 ? sb->dh : sb->h;
+            uint32_t c = sb->libass.color;
+            out[count++] = (struct avf_metal_osd_part){
+                .dst = {sb->x, sb->y, sb->x + dw, sb->y + dh},
+                .src = {x, y, x + sb->w, y + sb->h},
+                .color = {((c >> 24) & 0xff) / 255.0f, ((c >> 16) & 0xff) / 255.0f,
+                          ((c >> 8) & 0xff) / 255.0f, (0xff - (c & 0xff)) / 255.0f},
+            };
+            x += cw;
+        }
+        int64_t t = avf_metal_osd_now_ns();
+        ok = avf_metal_osd_pass(m, rt, clear, pipeline, atlas, first, count - first,
+                                &exec_ns, err, err_size);
+        pass_ns += avf_metal_osd_now_ns() - t;
+
+    done:
+        CFRelease(target_ref);
+        if (timing) {
+            int64_t total = avf_metal_osd_now_ns() - t0;
+            timing->upload_ns = total - pass_ns;
+            timing->gpu_ns = pass_ns;
+            timing->exec_ns = exec_ns;
+        }
+        return ok;
+    }
+}
+// --- end avf metal osd core ---
+
