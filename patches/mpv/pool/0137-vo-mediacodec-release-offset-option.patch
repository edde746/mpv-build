Subject: [PATCH] vo_mediacodec: set where a timed release's timestamp falls with --vo-mediacodec-release-offset

On a MediaTek projector with motion processing on (Plezy #2654), 24 fps
on a 60 Hz mode stutters under mpv and not under ExoPlayer, though both
hand MediaCodec frames in the same 2/3 vsync cadence. SurfaceFlinger's
per-frame latency dump puts the difference in the timestamps: mpv's sit
a quarter of the way into the period before their vsync, Media3's about
halfway (the same 80% rule, applied to a vsync sample that lands later
on this device). The projector re-times the frames itself: it showed
mpv's 25.7/57.6 ms apart and Media3's 36.5/46.9 ms. For the first 0.3 s
of the ExoPlayer capture, its timestamps fell late in the period and
came out 30.2/53.1 ms.

--vo-mediacodec-release-offset=<10..90> sets how far before the chosen
vsync the timestamp falls, in percent of a period; the default, 80, is
Media3's VSYNC_OFFSET_PERCENTAGE. Only the timestamp moves: the vsync,
the cadence and the present intent stay where they were, the OSD plane
takes the same timestamp, and admission counts the codec's lead back
from the moved timestamp. The "Timed release" line reports the offset.

diff --git a/DOCS/man/vo.rst b/DOCS/man/vo.rst
index 56b4ea8..40903a1 100644
--- a/DOCS/man/vo.rst
+++ b/DOCS/man/vo.rst
@@ -807,6 +807,16 @@ Available video output drivers are:
     decoder's ``rendered_feedback`` AVOption off, or a platform without
     them) only ``slot`` and ``lead`` are known.
 
+    ``--vo-mediacodec-release-offset=<10..90>`` (default 80) sets how far
+    before its vsync a timed release's presentation timestamp falls, in
+    percent of a display period, as Media3's ``VSYNC_OFFSET_PERCENTAGE``
+    does. SurfaceFlinger presents the frame at the same vsync whatever the
+    value; a display that re-times frames itself, such as a TV's motion
+    processing, can space them differently depending on where in the period
+    the timestamp falls. The OSD plane takes the same timestamp. On
+    platforms whose frame-rendered reports carry the latch (Tensor,
+    MediaTek), the present trace's ``err`` moves with the offset.
+
 ``mediacodec_embed`` (Android)
     Renders ``IMGFMT_MEDIACODEC`` frames directly to an ``android.view.Surface``.
     Requires ``--hwdec=mediacodec`` for hardware decoding, along with
diff --git a/video/out/vo_mediacodec.c b/video/out/vo_mediacodec.c
index 165e9d0..b7c9d94 100644
--- a/video/out/vo_mediacodec.c
+++ b/video/out/vo_mediacodec.c
@@ -334,26 +334,37 @@ static int64_t mediacodec_phase_filter(struct mediacodec_phase *phase,
     return sample_ns;
 }
 
+// Media3's VSYNC_OFFSET_PERCENTAGE: a timed release carries its vsync minus
+// this percentage of a period, before that vsync and after the previous one.
+// --vo-mediacodec-release-offset moves the timestamp within that interval.
+// A display that re-times frames itself can space them by where in the
+// period the timestamp falls: under motion processing, a MediaTek projector
+// (Plezy #2654) showed 24p on 60 Hz 25.7/57.6 ms apart from mpv's timestamps
+// a quarter of the way into the period, and 36.5/46.9 ms apart from Media3's
+// halfway in.
+#define MEDIACODEC_RELEASE_OFFSET_DEFAULT 80
+
 // Release timestamp, on now_ns's clock, for a frame due at raw_target_ns;
 // 0 releases untimed, i.e. at the next vsync. sample_ns is a vsync timestamp
 // on that clock, or 0 when none is fresh; period_ns is the display period, or
 // 0 when unknown. The surface presents a buffer at the first vsync at or after
 // its timestamp, so a timestamp in the near past still lands on the chosen
 // vsync: once cadence correction and snapping chose a vsync, the release is
-// that vsync minus 80% of a period even when the VO thread runs late. The
-// unsnapped target must never substitute for it: for half of all frames it
-// lies past its grid line and would round up to the following vsync. A late
-// raw deadline releases untimed but still advances the cadence anchor, so the
-// next frame predicts from cadence rather than a jittered raw deadline and
-// keeps its hysteresis choice (Media3 adjusts frames it then drops the same
-// way); only an unknown clock or a deadline beyond max_ahead_ns is a
-// discontinuity that resets.
+// that vsync minus release_offset percent of a period even when the VO thread
+// runs late. The unsnapped target must never substitute for it: for half of
+// all frames it lies past its grid line and would round up to the following
+// vsync. A late raw deadline releases untimed but still advances the cadence
+// anchor, so the next frame predicts from cadence rather than a jittered raw
+// deadline and keeps its hysteresis choice (Media3 adjusts frames it then
+// drops the same way); only an unknown clock or a deadline beyond
+// max_ahead_ns is a discontinuity that resets.
 static int64_t mediacodec_timing_release(struct mediacodec_timing *timing,
                                          int64_t raw_target_ns, int64_t now_ns,
                                          uint64_t frame_id,
                                          double frame_duration_ns,
                                          int64_t sample_ns, int64_t period_ns,
-                                         int64_t max_ahead_ns)
+                                         int64_t max_ahead_ns,
+                                         int release_offset)
 {
     if (now_ns <= 0 || raw_target_ns > now_ns + max_ahead_ns) {
         mediacodec_timing_reset(timing);
@@ -369,7 +380,7 @@ static int64_t mediacodec_timing_release(struct mediacodec_timing *timing,
 
     int64_t snapped = mediacodec_timing_snap(timing, target_ns, sample_ns,
                                              period_ns);
-    return snapped - period_ns * 8 / 10;
+    return snapped - period_ns * release_offset / 100;
 }
 
 // How far before its release timestamp a frame is handed to the codec:
@@ -392,7 +403,8 @@ static int64_t mediacodec_timing_release(struct mediacodec_timing *timing,
 static int64_t mediacodec_timing_preview(const struct mediacodec_timing *timing,
                                         int64_t raw_target_ns, uint64_t frame_id,
                                         double frame_duration_ns,
-                                        int64_t sample_ns, int64_t period_ns)
+                                        int64_t sample_ns, int64_t period_ns,
+                                        int release_offset)
 {
     struct mediacodec_timing scratch = *timing;
     int64_t target_ns = mediacodec_timing_predict(&scratch, raw_target_ns,
@@ -400,12 +412,13 @@ static int64_t mediacodec_timing_preview(const struct mediacodec_timing *timing,
     if (period_ns <= 0 || !sample_ns)
         return target_ns;
     return mediacodec_timing_snap(&scratch, target_ns, sample_ns, period_ns)
-         - period_ns * 8 / 10;
+         - period_ns * release_offset / 100;
 }
 
 // OSD work needs the current/next render plus composition time, and the core
 // has to wake early enough that the codec window is still reachable: one
-// codec lead, the 80% pull-back, and the cadence-correction bound.
+// codec lead, a period for the release offset's pull-back, and the
+// cadence-correction bound.
 static int64_t mediacodec_prepare_lead(int64_t period_ns, double duration_ns)
 {
     int64_t lead = MEDIACODEC_CODEC_LEAD_NS + period_ns + 20000000;
@@ -476,10 +489,10 @@ struct present_intent {
 
 // Where a report lands relative to its vsync says which clock the platform
 // reports, not whether the frame was shown on time: Tensor and MediaTek
-// report the latch of the intended vsync, 0.8 of a period early, for every
-// frame; Amlogic latches one or two vsyncs before the timestamp and reports
-// that, alternating by frame. Which class a device is in is what the
-// histogram below names.
+// report the latch of the intended vsync, the release offset (0.8 of a
+// period by default) early, for every frame; Amlogic latches one or two
+// vsyncs before the timestamp and reports that, alternating by frame. Which
+// class a device is in is what the histogram below names.
 
 // What the viewer can see is a hold: the time between two consecutive
 // frames' reports, in vsyncs. A frame of duration d on a display of period p
@@ -816,6 +829,7 @@ struct mediacodec_opts {
     int osd_vsync_delay;
     int64_t osd_surface;
     bool present_trace;
+    int release_offset;
 };
 
 #define OPT_BASE_STRUCT struct mediacodec_opts
@@ -827,10 +841,15 @@ static const struct m_sub_options mediacodec_conf = {
         {"vo-mediacodec-osd-vsync-delay", OPT_INT(osd_vsync_delay),
             M_RANGE(0, 3)},
         {"vo-mediacodec-present-trace", OPT_BOOL(present_trace)},
+        {"vo-mediacodec-release-offset", OPT_INT(release_offset),
+            M_RANGE(10, 90)},
         {0},
     },
     .size = sizeof(struct mediacodec_opts),
-    .defaults = &(const struct mediacodec_opts){.video_rect = ""},
+    .defaults = &(const struct mediacodec_opts){
+        .video_rect = "",
+        .release_offset = MEDIACODEC_RELEASE_OFFSET_DEFAULT,
+    },
 };
 #undef OPT_BASE_STRUCT
 
@@ -899,6 +918,8 @@ struct priv {
     // targeted, for the trace's slot when no reports arrive.
     bool present_trace;
     int64_t trace_vsync;
+    // --vo-mediacodec-release-offset, in percent of a period.
+    int release_offset;
     // When the VO first saw the prepared and the current frame
     // (CLOCK_MONOTONIC), the core's hand-off stamps of the current frame
     // (struct vo_frame, mp_time_ns()), and how many releases
@@ -2895,6 +2916,7 @@ static int preinit(struct vo *vo)
         MP_WARN(vo, "Invalid --vo-mediacodec-video-rect; ignoring geometry.\n");
     p->osd_vsync_delay = opts->osd_vsync_delay;
     p->present_trace = opts->present_trace;
+    p->release_offset = opts->release_offset;
     m_config_cache_set_wakeup_cb(p->opts_cache, opts_wakeup, vo);
     vo->hwdec_devs = hwdec_devices_create();
     p->hwctx = (struct mp_hwdec_ctx){
@@ -3060,13 +3082,16 @@ static void update_queue_timing(struct vo *vo, double frame_duration)
     p->queue_offset = offset;
     vo_set_queue_params(vo, offset, 1);
     if (period) {
-        MP_VERBOSE(vo, "Timed release: %.3f Hz, prepare %.1f ms, codec %.1f ms ahead.\n",
-                   1e9 / period, offset / 1e6, MEDIACODEC_CODEC_LEAD_NS / 1e6);
+        MP_VERBOSE(vo, "Timed release: %.3f Hz, prepare %.1f ms, codec %.1f ms "
+                       "ahead, offset %d%%.\n",
+                   1e9 / period, offset / 1e6, MEDIACODEC_CODEC_LEAD_NS / 1e6,
+                   p->release_offset);
     }
 }
 
-// Stabilize frame cadence, then snap with hysteresis and release 80% of a
-// period before the chosen vsync so SurfaceView can latch the buffer in time.
+// Stabilize frame cadence, then snap with hysteresis and release
+// --vo-mediacodec-release-offset percent of a period (80 by default) before
+// the chosen vsync so SurfaceView can latch the buffer in time.
 // The policy lives in mediacodec_timing_release so the host regression can
 // drive it with an injected clock.
 static struct release_target get_release_target(struct vo *vo, int64_t pts)
@@ -3084,9 +3109,11 @@ static struct release_target get_release_target(struct vo *vo, int64_t pts)
 
     result.timestamp = mediacodec_timing_release(
         &p->timing, raw_target, mono_now, p->cur_frame_id, p->cur_duration,
-        sample, p->queue_period, mediacodec_release_horizon(p->queue_period));
+        sample, p->queue_period, mediacodec_release_horizon(p->queue_period),
+        p->release_offset);
     if (result.timestamp && sample && raw_target > mono_now)
-        result.vsync = result.timestamp + p->queue_period * 8 / 10;
+        result.vsync = result.timestamp +
+                       p->queue_period * p->release_offset / 100;
     result.late = mono_now > 0 && raw_target <= mono_now;
     result.deadline = raw_target;
     result.now = mono_now;
@@ -3100,6 +3127,7 @@ static void update_opts(struct vo *vo)
         return;
     struct mediacodec_opts *opts = p->opts_cache->opts;
     p->present_trace = opts->present_trace;
+    p->release_offset = opts->release_offset;
     struct mediacodec_geometry geometry;
     bool geometry_ok = mediacodec_geometry_parse(opts->video_rect, &geometry);
     if (!geometry_ok)
@@ -3181,11 +3209,11 @@ static int64_t submit_deadline(struct vo *vo, struct vo_frame *frame)
 
     int64_t timestamp = mediacodec_timing_preview(
         &p->timing, mp_time_to_monotonic_ns(frame->pts), frame->frame_id,
-        frame->duration, sample, p->queue_period);
+        frame->duration, sample, p->queue_period, p->release_offset);
     // The lead is measured against the timestamp, never against the raw
-    // deadline: the 80% pull-back alone puts the timestamp most of a period
-    // ahead of it, and clamping there is what leaves the codec short. The
-    // hold is bounded by construction, at exactly one lead.
+    // deadline: the release offset's pull-back alone puts the timestamp most
+    // of a period ahead of it, and clamping there is what leaves the codec
+    // short. The hold is bounded by construction, at exactly one lead.
     int64_t deadline = monotonic_to_mp_time_ns(timestamp) - MEDIACODEC_CODEC_LEAD_NS;
     return deadline > 0 ? deadline : raw_deadline;
 }
@@ -3287,8 +3315,9 @@ static const char *trace_ms(char buf[16], int64_t ns)
 
 // One line per frame while --vo-mediacodec-present-trace is on: slot and
 // held in vsyncs (2.00 and 3.00 alternating for 24p on 60 Hz), err in
-// vsyncs from the targeted vsync (-0.80 for a frame on time on Tensor and
-// MediaTek, which report the latch), lead in ms.
+// vsyncs from the targeted vsync (minus the release offset, -0.80 by default,
+// for a frame on time on Tensor and MediaTek, which report the latch), lead
+// in ms.
 static void present_trace_log(struct vo *vo, const struct present_trace *t)
 {
     struct priv *p = vo->priv;
