+static int present_err_compare(const void *a, const void *b)
+{
+    int64_t x = *(const int64_t *)a, y = *(const int64_t *)b;
+    return x < y ? -1 : x > y;
+}
+
+// The steady-state report error on this device: the median of the recent
+// reports, once there are enough of them to be one. Robust to a few misses.
+static bool present_reference(const struct present_stats *s, int64_t *ref)
+{
+    if (s->err_count < PRESENT_REFERENCE_SAMPLES / 2)
+        return false;
+    int64_t sorted[PRESENT_REFERENCE_SAMPLES];
+    unsigned n = s->err_count < PRESENT_REFERENCE_SAMPLES
+               ? s->err_count : PRESENT_REFERENCE_SAMPLES;
+    memcpy(sorted, s->err_recent, n * sizeof(sorted[0]));
+    qsort(sorted, n, sizeof(sorted[0]), present_err_compare);
+    *ref = sorted[n / 2];
+    return true;
+}
