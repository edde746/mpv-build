     case VOCTRL_UPDATE_RENDER_OPTS:
         update_opts(vo);
         return VO_TRUE;
+    case VOCTRL_SET_WINDOW_ID:
+        return set_window_id(vo, *(int64_t *)data);
     case VOCTRL_RESET:
         reset_video(vo);
         return VO_TRUE;
