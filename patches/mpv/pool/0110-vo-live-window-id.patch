+// Move the decoder's output to another Surface in place. Nothing of the vo
+// itself is bound to the window: timed release goes through the codec, the
+// OSD has its own plane, and the geometry is the embedder's. Only where the
+// platform cannot repoint a running decoder does the core rebuild instead.
+static int set_window_id(struct vo *vo, int64_t wid)
+{
+    struct priv *p = vo->priv;
+    if (wid == 0 || wid == -1)
+        return VO_NOTIMPL;
+    int ret = av_mediacodec_hwdevice_set_surface(p->hwctx.av_device_ref,
+                                                 (void *)(uintptr_t)wid);
+    if (ret == AVERROR(ENOSYS)) {
+        MP_VERBOSE(vo, "Platform cannot repoint the decoder; rebuilding.\n");
+        return VO_NOTIMPL;
+    }
+    if (ret < 0) {
+        MP_WARN(vo, "Repointing the decoder at the new Surface failed (%s); "
+                    "rebuilding.\n", av_err2str(ret));
+        return VO_NOTIMPL;
+    }
+    MP_VERBOSE(vo, "Video Surface replaced in place.\n");
+    return VO_TRUE;
+}
+
 static int control(struct vo *vo, uint32_t request, void *data)
 {
     switch (request) {
