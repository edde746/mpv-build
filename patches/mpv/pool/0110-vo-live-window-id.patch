diff --git a/player/command.c b/player/command.c
index e75d144..fe22c09 100644
--- a/player/command.c
+++ b/player/command.c
@@ -7982,6 +7982,19 @@ void mp_option_run_callback(struct MPContext *mpctx, struct mp_option_callback *
         mpctx->ipc_ctx = mp_init_ipc(mpctx->clients, mpctx->global);
     }
 
+    if (opt_ptr == &opts->vo->WinID && mpctx->video_out &&
+        vo_control(mpctx->video_out, VOCTRL_SET_WINDOW_ID, &opts->vo->WinID) == VO_TRUE)
+    {
+        // The VO moved to the new window itself; nothing to rebuild.
+        flags &= ~(uint64_t)UPDATE_VO;
+        // Except the paused picture: it went to the old window, and a VO
+        // that hands its frames to the window cannot present it again. The
+        // rebuild below re-decoded it with its seek; do the same, paused only,
+        // since playback brings the next frame to the new window by itself.
+        if (opts->pause && mpctx->current_track[0][STREAM_VIDEO])
+            queue_seek(mpctx, MPSEEK_RELATIVE, 0.0, MPSEEK_EXACT, 0);
+    }
+
     if (flags & UPDATE_VO && mpctx->video_out) {
         struct track *track = mpctx->current_track[0][STREAM_VIDEO];
         uninit_video_out(mpctx);
