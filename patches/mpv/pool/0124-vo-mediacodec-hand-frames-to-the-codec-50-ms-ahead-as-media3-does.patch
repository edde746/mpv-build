-// How far before the presentation timestamp the buffer has to reach the
-// codec. MediaCodec.releaseOutputBuffer(int, long) asks for about two display
-// periods, and does not return the buffer to the decoder until the timestamp
-// passes, so the lead is capped. An unknown period keeps a fixed budget.
-static int64_t mediacodec_codec_lead(int64_t period_ns)
-{
-    if (period_ns <= 0)
-        return 50000000;
-    int64_t lead = 2 * period_ns;
