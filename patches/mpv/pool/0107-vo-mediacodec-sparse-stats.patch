+static void osd_log_stats(struct vo *vo, const char *why)
+{
+    struct priv *p = vo->priv;
+    if (!p->osd_threads_created)
+        return;
+    mp_mutex_lock(&p->osd_lock);
+    struct osd_shared s = p->osd;
+    mp_mutex_unlock(&p->osd_lock);
+    osd_log_stats_snapshot(vo, why, &s);
+}
+
+// What an OSD statistics line exists to catch: a swap that missed its vsync,
+// a result dropped or orphaned, a present the display did not confirm, a
+// pre-render horizon miss, or a confirmed present off its vsync.
+static uint64_t osd_failures(const struct osd_shared *s)
+{
+    return (uint64_t)s->late + s->stale + s->present_invalid +
+           s->present_dropped + s->spec.horizon_skips +
+           s->present_hist[0] + s->present_hist[1] +
+           s->present_hist[3] + s->present_hist[4];
+}
+
+// One tick per OSD_STATS_INTERVAL_FRAMES flips; each line decides its own
+// cadence through stats_due.
+static void stats_tick(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (++p->stats_frames < OSD_STATS_INTERVAL_FRAMES)
+        return;
+    p->stats_frames = 0;
+    if (p->osd_threads_created) {
+        mp_mutex_lock(&p->osd_lock);
+        struct osd_shared s = p->osd;
+        mp_mutex_unlock(&p->osd_lock);
+        const char *why = stats_due(&p->osd_stats, osd_failures(&s));
+        if (why)
+            osd_log_stats_snapshot(vo, why, &s);
+    }
+}
