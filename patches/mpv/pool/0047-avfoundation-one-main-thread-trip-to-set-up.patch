-        .hw_imgfmt = IMGFMT_VIDEOTOOLBOX,
-    };
-    hwdec_devices_add(vo->hwdec_devs, &p->hwctx);
+        // Observed before it is read, so that no change goes unseen.
+        [displayLayer addObserver:observer
+                       forKeyPath:@"bounds"
+                          options:NSKeyValueObservingOptionOld |
+                                  NSKeyValueObservingOptionNew
+                          context:NULL];
+        [displayLayer addObserver:observer
+                       forKeyPath:@"contentsScale"
+                          options:NSKeyValueObservingOptionOld |
+                                  NSKeyValueObservingOptionNew
+                          context:NULL];
+        [displayLayer addObserver:observer
+                       forKeyPath:@"videoGravity"
+                          options:NSKeyValueObservingOptionOld |
+                                  NSKeyValueObservingOptionNew
+                          context:NULL];
+        read_layer_geometry(displayLayer, &width, &height, &gravity);
+
+        if (inline_osd)
+            create_osd_layer(vo, displayLayer, timebase);
 
-    atomic_init(&p->pending_presentation_resync, false);
-    atomic_init(&p->app_inactive, false);
 #if TARGET_OS_IPHONE
-    dispatch_main_sync_safe(^{
         atomic_store(&p->app_inactive, UIApplication.sharedApplication.applicationState !=
                                        UIApplicationStateActive);
         NSNotificationCenter *nc = [NSNotificationCenter defaultCenter];
@@ -4419,35 +4478,30 @@ static int preinit(struct vo *vo)
                 vo_wakeup(vo);
             }
         }] retain];
-    });
 #endif
+    });
+    [displayLayer release];
+    p->layer_geometry_observer = observer;
+    set_layer_geometry(vo, width, height, gravity);
 
-    atomic_init(&p->pending_layer_geometry_sync, false);
-    atomic_init(&p->shader_layer_stale, false);
-    {
-        MPVLayerGeometryObserver *observer = [[MPVLayerGeometryObserver alloc] init];
-        observer->vo = vo;
-        AVSampleBufferDisplayLayer *observedLayer = [p->displayLayer retain];
-        dispatch_main_sync_safe(^{
-            [observedLayer addObserver:observer
-                            forKeyPath:@"bounds"
-                               options:NSKeyValueObservingOptionOld |
-                                       NSKeyValueObservingOptionNew
-                               context:NULL];
-            [observedLayer addObserver:observer
-                            forKeyPath:@"contentsScale"
-                               options:NSKeyValueObservingOptionOld |
-                                       NSKeyValueObservingOptionNew
-                               context:NULL];
-            [observedLayer addObserver:observer
-                            forKeyPath:@"videoGravity"
-                               options:NSKeyValueObservingOptionOld |
-                                       NSKeyValueObservingOptionNew
-                               context:NULL];
-        });
-        [observedLayer release];
-        p->layer_geometry_observer = observer;
-    }
+    vo_set_queue_params(vo, MP_TIME_MS_TO_NS(p->opts->queue_lead_ms), 1);
+    vo_set_queue_slack(vo, MP_TIME_MS_TO_NS(p->opts->queue_slack_ms));
+    p->ready_queue = dispatch_queue_create("avfoundation ready",
+        dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL,
+                                                QOS_CLASS_USER_INTERACTIVE, 0));
+
+    if (p->opts->composite_osd && !ensure_ci_compositor(vo))
+        MP_WARN(vo, "Core Image fallback compositor unavailable\n");
+
+    ahead_start(vo);
+
+    vo->hwdec_devs = hwdec_devices_create();
+    p->hwctx = (struct mp_hwdec_ctx){
+        .driver_name = "avfoundation",
+        .av_device_ref = create_videotoolbox_device_ref(vo),
+        .hw_imgfmt = IMGFMT_VIDEOTOOLBOX,
+    };
+    hwdec_devices_add(vo->hwdec_devs, &p->hwctx);
 
     return 0;
 }
