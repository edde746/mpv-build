+        // paused; the frame in the track is lost to concealment either way.
+        // Forget the burst, so the tail is skipped as garbage when it does
+        // come instead of being written after the silence.
+        MP_VERBOSE(ao, "stream silence: a cut frame precedes the silence\n");
+        p->raw_state = RAW_SYNC_PA;
