@@ -776,6 +776,11 @@ void reload_audio_output(struct MPContext *mpctx)
     if (ao_c) {
         reset_audio_state(mpctx);
         mp_output_chain_reset_harder(ao_c->filter);
+        // A frame the chain already handed over for the old AO would stay in
