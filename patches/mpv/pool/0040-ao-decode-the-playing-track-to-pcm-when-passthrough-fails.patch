diff --git a/player/audio.c b/player/audio.c
index c7e5650..e581066 100644
--- a/player/audio.c
+++ b/player/audio.c
@@ -355,6 +355,17 @@ static void ao_chain_set_ao(struct ao_chain *ao_c, struct ao *ao)
     mp_filter_wakeup(ao_c->ao_filter);
 }
 
+// Switch the chain's track from passthrough to decoding. The caller resets
+// the output chain. Returns false if the decoder could not be reinitialized.
+static bool fall_back_to_pcm(struct MPContext *mpctx, struct ao_chain *ao_c)
+{
+    MP_VERBOSE(mpctx, "Falling back to PCM output.\n");
+    ao_c->spdif_passthrough = false;
+    ao_c->spdif_failed = true;
+    mp_decoder_wrapper_set_spdif_flag(ao_c->track->dec, false);
+    return mp_decoder_wrapper_reinit(ao_c->track->dec);
+}
+
 static int reinit_audio_filters_and_output(struct MPContext *mpctx)
 {
     struct MPOpts *opts = mpctx->opts;
@@ -467,11 +478,7 @@ static int reinit_audio_filters_and_output(struct MPContext *mpctx)
     if (!mpctx->ao) {
         // If spdif was used, try to fallback to PCM.
         if (spdif_fallback && ao_c->track && ao_c->track->dec) {
-            MP_VERBOSE(mpctx, "Falling back to PCM output.\n");
-            ao_c->spdif_passthrough = false;
-            ao_c->spdif_failed = true;
-            mp_decoder_wrapper_set_spdif_flag(ao_c->track->dec, false);
-            if (!mp_decoder_wrapper_reinit(ao_c->track->dec))
+            if (!fall_back_to_pcm(mpctx, ao_c))
                 goto init_error;
             reset_audio_state(mpctx);
             mp_output_chain_reset_harder(ao_c->filter);
@@ -871,12 +878,45 @@ void audio_start_ao(struct MPContext *mpctx)
     mp_wakeup_core(mpctx);
 }
 
+static void handle_ao_events(struct MPContext *mpctx)
+{
+    if (!mpctx->ao)
+        return;
+    int events = ao_query_and_reset_events(mpctx->ao,
+                    AO_EVENT_RELOAD | AO_EVENT_PASSTHROUGH_FAILED);
+    if (!events)
+        return;
+
+    // A failure belongs to this AO, which can outlive the chain it failed
+    // for: gapless file changes and track switches keep it open. Only the
+    // passthrough chain it is attached to falls back; any other chain gets a
+    // fresh AO and tries passthrough itself. Decide before the reload
+    // detaches the AO. A chain still allowed passthrough has not failed
+    // before, so the reload's own spdif retry leaves it alone.
+    struct ao_chain *ao_c = mpctx->ao_chain;
+    bool fall_back = (events & AO_EVENT_PASSTHROUGH_FAILED) && ao_c &&
+                     ao_c->ao == mpctx->ao && ao_c->spdif_passthrough &&
+                     ao_c->track && ao_c->track->dec;
+
+    reload_audio_output(mpctx);
+    if (!fall_back)
+        return;
+
+    if (!fall_back_to_pcm(mpctx, ao_c)) {
+        MP_ERR(mpctx, "Error reinitializing audio.\n");
+        error_on_track(mpctx, ao_c->track);
+        return;
+    }
+    // The failed AO took audio it never played; the decoder would resume past
+    // it. Decode again from where playback is.
+    issue_refresh_seek(mpctx, MPSEEK_EXACT);
+}
+
 void fill_audio_out_buffers(struct MPContext *mpctx)
 {
     struct MPOpts *opts = mpctx->opts;
 
-    if (mpctx->ao && ao_query_and_reset_events(mpctx->ao, AO_EVENT_RELOAD))
-        reload_audio_output(mpctx);
+    handle_ao_events(mpctx);
 
     update_throttle(mpctx);
 
