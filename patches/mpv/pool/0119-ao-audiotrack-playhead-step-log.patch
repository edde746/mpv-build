+// Diagnostic for the passthrough clock, where the smoothed playhead is the
+// only audio clock the core has. A step is the smoothed estimate moving
+// against real time: (estimate - clock) drifting more than
+// PLAYHEAD_STEP_MS from where it was at the anchor -- the same quantity
+// the core sees as its audio clock jumping, whether the HAL's head stalled,
+// jumped, or the smoother reset. Writes do not enter it, and the head's
+// HAL-period sawtooth is averaged out by the smoother before it is read.
+//
+// A line names the raw getPlaybackHeadPosition, written_frames and the
+// smoothed estimate, how far the estimate and the raw head moved against the
+// clock since the anchor, how many of the polls since then the drift limiter
+// clamped and how often the smoothing window was reset, and a getTimestamp
+// probe (framePosition, nanoTime, whether framePosition advanced since the
+// previous probe). The probe is observation only: the passthrough clock
+// never reads p->timestamp, so filling it here feeds nothing.
+//
+// Rate limited per session: no two lines within PLAYHEAD_STEP_MIN_NS, and at
+// most PLAYHEAD_STEP_MAX_LINES lines. A suppressed step keeps its anchor, so
+// the next line reports the whole movement since the previous one.
+#define PLAYHEAD_STEP_MS 20
+#define PLAYHEAD_STEP_MIN_NS MP_TIME_S_TO_NS(5)
+#define PLAYHEAD_STEP_MAX_LINES 120
+
+static void AudioTrack_observePlayheadStep(struct ao *ao, uint32_t estimate)
+{
+    struct priv *p = ao->priv;
+    if (!estimate) { // not started, or just flushed
+        p->step_anchored = false;
+        return;
+    }
+    int64_t now = mp_time_ns();
+    double clock = MP_TIME_NS_TO_S(now) * ao->samplerate;
+    double est_offset = (double)p->smooth_reported - clock;
+    double head_offset = (double)p->smooth_head - clock;
+    if (!p->step_anchored) {
+        p->step_anchored = true;
+        p->step_anchor_ns = now;
+        p->step_est_offset = est_offset;
+        p->step_head_offset = head_offset;
+        p->step_polls = p->step_limited = p->step_resets = 0;
+        return;
+    }
+    p->step_polls++;
+    double est_step = est_offset - p->step_est_offset;
+    if (fabs(est_step) <= ao->samplerate * PLAYHEAD_STEP_MS / 1000.0)
+        return;
+    if (p->step_lines >= PLAYHEAD_STEP_MAX_LINES ||
+        (p->step_logged_ns && now - p->step_logged_ns < PLAYHEAD_STEP_MIN_NS))
+        return;
+
+    JNIEnv *env = MP_JNI_GET_ENV(ao);
+    bool ts_ok = MP_JNI_CALL_BOOL(p->audiotrack, AudioTrack.getTimestamp, p->timestamp);
+    uint32_t fpos = 0;
+    int64_t nano = 0;
+    int advancing = -1; // no previous probe to compare with
+    if (ts_ok) {
+        fpos = 0xFFFFFFFFL & MP_JNI_GET_LONG(p->timestamp, AudioTimestamp.framePosition);
+        nano = MP_JNI_GET_LONG(p->timestamp, AudioTimestamp.nanoTime);
+        if (p->step_probed)
+            advancing = fpos != p->step_probe_fpos;
+        p->step_probed = true;
+        p->step_probe_fpos = fpos;
+        p->step_probe_nano = nano;
+    }
+    double ms = 1000.0 / ao->samplerate;
+    MP_VERBOSE(ao, "playhead step: est=%+dms head=%+dms over %dms; raw=%u written=%u "
+               "smoothed=%u polls=%u limited=%u resets=%u ts=%d fpos=%u nano=%lld "
+               "tsAgeMs=%d tsAdvancing=%d\n",
+               (int)lround(est_step * ms),
+               (int)lround((head_offset - p->step_head_offset) * ms),
+               (int)((now - p->step_anchor_ns) / 1000000),
+               p->last_head_raw, p->written_frames, estimate,
+               p->step_polls, p->step_limited, p->step_resets,
+               ts_ok, fpos, (long long)nano,
+               ts_ok && nano ? (int)((mp_raw_time_ns() - nano) / 1000000) : -1,
+               advancing);
+    p->step_logged_ns = now;
+    p->step_lines++;
+    if (p->step_lines == PLAYHEAD_STEP_MAX_LINES)
+        MP_VERBOSE(ao, "playhead step: line budget spent, further steps go unlogged\n");
+    p->step_anchored = false; // re-anchor on the next poll
+}
