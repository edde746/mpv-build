+// A bar of margin canvas pixels in surface pixels, rounded outward: a scaled
+// plane must never leave a sliver of background, and a pixel of black over
+// the picture edge is invisible. Negative margins (cover, zoom) have no bar.
+static int osd_gl_bar(int margin, int surface, int canvas)
+{
+    if (margin <= 0 || surface <= 0 || canvas <= 0)
+        return 0;
+    int64_t bar = ((int64_t)margin * surface + canvas - 1) / canvas;
+    return bar < surface ? (int)bar : surface;
+}
+
+// The OSD plane sits below the app window but spans the whole player, so
+// Android punches the entire container out of the window canvas and the
+// window's black background never reaches the letterbox. Whatever this plane
+// leaves transparent outside the picture scans out as the compositor's own
+// background, which the MediaTek TV pipeline (Google TV Streamer, Fire TV
+// 4K Max) renders above black while the display is in HDR/Dolby Vision
+// mode: gray bars on an OLED. Fill the margins opaque black on this plane.
+// That adds no layer, so the HWC keeps the picture on the video plane - an
+// extra layer, even a non-overlapping solid color, demotes it to GPU
+// composition and drops the HDR output - and subtitles placed in the margins
+// draw over the fill in the same buffer.
+static void osd_gl_fill_letterbox(struct osd_gl *g, const struct osd_slot *slot,
+                                  int sw, int sh)
+{
+    int top = osd_gl_bar(slot->mt, sh, slot->canvas_h);
+    int bottom = osd_gl_bar(slot->mb, sh, slot->canvas_h);
+    int left = osd_gl_bar(slot->ml, sw, slot->canvas_w);
+    int right = osd_gl_bar(slot->mr, sw, slot->canvas_w);
+    if (!top && !bottom && !left && !right)
+        return;
+    struct GL *gl = g->gl;
+    gl->ClearColor(0, 0, 0, 1);
+    gl->Enable(GL_SCISSOR_TEST);
+    // Scissor origin is the bottom-left of the surface.
+    if (top) {
+        gl->Scissor(0, sh - top, sw, top);
+        gl->Clear(GL_COLOR_BUFFER_BIT);
+    }
+    if (bottom) {
+        gl->Scissor(0, 0, sw, bottom);
+        gl->Clear(GL_COLOR_BUFFER_BIT);
+    }
+    if (left) {
+        gl->Scissor(0, 0, left, sh);
+        gl->Clear(GL_COLOR_BUFFER_BIT);
+    }
+    if (right) {
+        gl->Scissor(sw - right, 0, right, sh);
+        gl->Clear(GL_COLOR_BUFFER_BIT);
+    }
+    gl->Disable(GL_SCISSOR_TEST);
+    gl->ClearColor(0, 0, 0, 0);
+}
