     return until > now ? until : 0;
 }
 
+// With --avfoundation-osd-queue-lead-ms a subtitle change does not go to the
+// OSD layer with its frame's video sample (queue-lead-ms ahead) but only when
+// its frame is near: until then it is the frame's bitmap list, a fraction of
+// the display-sized canvas the layer's queue would hold for it. flip_page
+// runs once per frame, so a change is drawn and enqueued at the last flip
+// that still leaves the lead before its frame: when waiting for the next
+// one, a frame spacing later, would leave less. Should no flip come (the
+// last frames of a file), a timer looks again that much later.
+#define AVF_OSD_PENDING_SLACK_NS INT64_C(10000000)
+
+static bool avf_osd_change_due(int64_t now, int64_t frame_host_ns,
+                               int64_t frame_spacing_ns, int64_t lead_ns)
+{
+    return frame_host_ns - (now + frame_spacing_ns) < lead_ns;
+}
