+// --- deferred subtitle changes (--avfoundation-osd-queue-lead-ms)
+
+static bool osd_changes_deferred(struct priv *p)
+{
+    return p->opts->osd_queue_lead_ms > 0 && p->ahead.started &&
+           should_use_inline_osd_layer(p);
+}
+
+static void drop_pending_osd(struct priv *p)
+{
+    for (int i = 0; i < p->osd_pending_count; i++)
+        talloc_free(p->osd_pending[i].list);
+    p->osd_pending_count = 0;
+    p->osd_filed_subtitle = false;
+    p->osd_filed_change_id = 0;
+}
+
+// Draw and enqueue the pending changes that are due, oldest first; all of
+// them when flush (a pause: no later flip will come for them).
+static void present_pending_osd(struct vo *vo, bool flush)
+{
+    struct priv *p = vo->priv;
+    if (!p->osd_pending_count)
+        return;
+
+    int64_t lead = MP_TIME_MS_TO_NS(p->opts->osd_queue_lead_ms);
+    int64_t spacing = p->osd_frame_spacing_ns ? p->osd_frame_spacing_ns
+                                              : MP_TIME_MS_TO_NS(42);
+    int done = 0;
+    while (done < p->osd_pending_count) {
+        struct osd_pending *e = &p->osd_pending[done];
+        if (!flush && !avf_osd_change_due(mp_time_ns(), e->host_ns, spacing, lead))
+            break;
+        // A layer that takes nothing right now gets it at the next look.
+        if (!p->osdLayer || !sample_buffer_renderer_is_ready(p->osdLayer))
+            break;
+        if (e->list) {
+            apply_osd_list(vo, &e->canvas, e->list);
+        } else if (p->has_subtitle || p->cachedSubtitleBuffer) {
+            p->perf.empty++;
+            drop_displayed_subtitle(p);
+        }
+        bool needed = false;
+        CMSampleBufferRef buf = create_osd_sample_buffer(vo, e->pts_ns, &needed);
+        if (buf) {
+            bool has_subtitle = p->has_subtitle && p->cachedSubtitleBuffer;
+            int64_t t = mp_time_ns();
+            bool enqueued = enqueue_osd_sample(vo, buf);
+            p->perf.enqueue_ns += mp_time_ns() - t;
+            CFRelease(buf);
+            if (!enqueued) {
+                // Drawn but not taken: it stays pending, and stays drawn.
+                p->perf.enq_drops++;
+                break;
+            }
+            p->osd_needs_enqueue = false;
+            if (has_subtitle)
+                p->osd_layer_dirty = true;
+            int64_t margin = e->host_ns - mp_time_ns();
+            if (!p->perf.enq_count || margin < p->perf.lead_min_ns)
+                p->perf.lead_min_ns = margin;
+            p->perf.lead_sum_ns += margin;
+            p->perf.enq_count++;
+        }
+        talloc_free(e->list);
+        done++;
+    }
+    if (done) {
+        p->osd_pending_count -= done;
+        memmove(&p->osd_pending[0], &p->osd_pending[done],
+                sizeof(p->osd_pending[0]) * p->osd_pending_count);
+    }
+    // Each flip pushes the timer on, so it only fires when flips stop.
+    if (p->osd_pending_timer) {
+        dispatch_source_set_timer(p->osd_pending_timer,
+            p->osd_pending_count
+                ? dispatch_time(DISPATCH_TIME_NOW, spacing + AVF_OSD_PENDING_SLACK_NS)
+                : DISPATCH_TIME_FOREVER,
+            DISPATCH_TIME_FOREVER, NSEC_PER_MSEC);
+    }
+}
+
+// What list, rendered on canvas for the frame about to be flipped, changes
+// against the newest change filed waits until that frame is near.
+static void file_osd_list(struct vo *vo, const struct avf_osd_canvas *canvas,
+                          struct sub_bitmap_list *list)
+{
+    struct priv *p = vo->priv;
+
+    int parts = 0;
+    for (int n = 0; n < list->num_items; n++)
+        parts += list->items[n]->num_parts;
+    if (!parts) {
+        if (!p->osd_filed_subtitle)
+            return;
+        p->osd_filed_subtitle = false;
+        p->osd_filed_change_id = 0;
+    } else if (list->change_id && list->change_id == p->osd_filed_change_id &&
+               p->osd_filed_subtitle && osd_canvas_equal(canvas, &p->osd_filed_canvas))
+    {
+        p->perf.skipped++;
+        return;
+    } else {
+        p->osd_filed_subtitle = true;
+        p->osd_filed_change_id = list->change_id;
+        p->osd_filed_canvas = *canvas;
+    }
+
+    // More waiting than there is room for: the oldest go to the layer early.
+    if (p->osd_pending_count == (int)MP_ARRAY_SIZE(p->osd_pending))
+        present_pending_osd(vo, true);
+    if (p->osd_pending_count == (int)MP_ARRAY_SIZE(p->osd_pending)) {
+        talloc_free(p->osd_pending[0].list);
+        memmove(&p->osd_pending[0], &p->osd_pending[1],
+                sizeof(p->osd_pending[0]) * --p->osd_pending_count);
+    }
+
+    // The slot the list comes from is rendered into again before then: keep
+    // the items (their layout and a reference on their atlas).
+    struct sub_bitmap_list *copy = NULL;
+    if (parts) {
+        copy = talloc_zero(NULL, struct sub_bitmap_list);
+        copy->change_id = list->change_id;
+        copy->w = list->w;
+        copy->h = list->h;
+        for (int n = 0; n < list->num_items; n++) {
+            struct sub_bitmaps *item = osd_clone_item(list->items[n]);
+            talloc_steal(copy, item);
+            MP_TARRAY_APPEND(copy, copy->items, copy->num_items, item);
+        }
+    }
+    p->osd_pending[p->osd_pending_count++] = (struct osd_pending){
+        .list = copy,
+        .canvas = *canvas,
+        .pts_ns = sample_presentation_pts_ns(p),
+        .host_ns = p->next_present_host_ns,
+    };
+
+    if (!p->osd_pending_timer) {
+        p->osd_pending_timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0,
+            dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0));
+        dispatch_source_set_timer(p->osd_pending_timer, DISPATCH_TIME_FOREVER,
+                                  DISPATCH_TIME_FOREVER, NSEC_PER_MSEC);
+        dispatch_source_set_event_handler(p->osd_pending_timer, ^{
+            atomic_store(&p->osd_pending_timer_fired, true);
+            vo_wakeup(vo);
+        });
+        dispatch_resume(p->osd_pending_timer);
+    }
+}
+
