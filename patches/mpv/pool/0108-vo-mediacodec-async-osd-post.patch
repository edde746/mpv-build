+static MP_THREAD_VOID osd_thread(void *arg)
+{
+    struct vo *vo = arg;
+    struct priv *p = vo->priv;
+    mp_thread_set_name("vo/osd");
+
+    struct mp_draw_sub_cache *cache = NULL;
+    int last_w = 0, last_h = 0;
+    bool force_full = true;
+
+    mp_mutex_lock(&p->osd_lock);
+    while (!p->osd_terminate) {
+        if (!p->osd_requested) {
+            mp_cond_wait(&p->osd_wakeup, &p->osd_lock);
+            continue;
+        }
+        double pts = p->osd_request_pts;
+        force_full |= p->osd_request_full;
+        p->osd_requested = false;
+        p->osd_request_full = false;
+        mp_mutex_unlock(&p->osd_lock);
+
+        osd_pass(vo, &cache, &last_w, &last_h, &force_full, pts);
+
+        mp_mutex_lock(&p->osd_lock);
+    }
+    mp_mutex_unlock(&p->osd_lock);
+
+    talloc_free(cache);
+    MP_THREAD_RETURN();
+}
+
+// Called on every flip: hand the OSD thread the pts to render for. Latest
+// request wins; a pass that is already running picks the next one up.
+static void draw_osd(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (!p->osd_window) {
+        if (!p->osd_missing_logged) {
+            MP_WARN(vo, "No OSD surface (--vo-mediacodec-osd-surface); "
+                        "subtitles/OSD are not rendered.\n");
+            p->osd_missing_logged = true;
+        }
+        return;
+    }
+
+    mp_mutex_lock(&p->osd_lock);
+    p->osd_request_pts = p->cur_image ? p->cur_image->pts : 0;
+    p->osd_requested = true;
+    mp_cond_signal(&p->osd_wakeup);
+    mp_mutex_unlock(&p->osd_lock);
+}
