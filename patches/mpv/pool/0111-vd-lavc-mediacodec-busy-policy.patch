diff --git a/filters/f_decoder_wrapper.h b/filters/f_decoder_wrapper.h
index a352dc0..9af0058 100644
--- a/filters/f_decoder_wrapper.h
+++ b/filters/f_decoder_wrapper.h
@@ -107,11 +107,28 @@ extern const struct mp_decoder_fns vd_lavc;
 extern const struct mp_decoder_fns ad_lavc;
 extern const struct mp_decoder_fns ad_spdif;
 
+// How a decoder that answers EAGAIN on both send and receive is to be
+// treated. libavcodec's contract forbids that answer, so by default it is a
+// warning and an immediate retry; a decoder that is known to give it while
+// its hardware is busy is either polled (it bounded its own wait) or left
+// alone until it wakes the filter itself. Once the EOF packet has been
+// accepted the send port is closed, so a receive answered EAGAIN with
+// nothing left to send is that same both-port answer and gets the same
+// treatment: nothing else would ever call the decoder again.
+enum lavc_busy_policy {
+    LAVC_BUSY_UNEXPECTED = 0,
+    LAVC_BUSY_POLL,
+    LAVC_BUSY_WAKEUP,
+};
+
 // Convenience wrapper for lavc based decoders. Treat lavc_state as private;
-// init to all-0 on init and resets.
+// init to all-0 on init and resets, except busy_policy, which the decoder
+// sets once it knows its codec.
 struct lavc_state {
     bool eof_returned;
     bool packets_sent;
+    bool eof_sent;  // the EOF packet was accepted; cleared when EOF comes back
+    enum lavc_busy_policy busy_policy;
 };
 void lavc_process(struct mp_filter *f, struct lavc_state *state,
                   int (*send)(struct mp_filter *f, struct demux_packet *pkt),
