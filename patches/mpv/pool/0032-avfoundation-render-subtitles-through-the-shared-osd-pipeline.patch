+// Draw every item of list into one overlay buffer: the frame's subtitles and
+// OSD share the inline layer, so one item must not replace another. NULL
+// when nothing could be drawn.
+static CVPixelBufferRef render_subtitle_list_pixel_buffer(struct vo *vo,
+                                                          struct sub_bitmap_list *list)
+{
+    struct priv *p = vo->priv;
+    int w = p->osd_w;
+    int h = p->osd_h;
+
+    CVPixelBufferRef pixbuf = create_empty_osd_pixel_buffer(vo);
+    if (!pixbuf)
+        return NULL;
+
+    CVPixelBufferLockBaseAddress(pixbuf, 0);
+    void *base = CVPixelBufferGetBaseAddress(pixbuf);
+    size_t stride = CVPixelBufferGetBytesPerRow(pixbuf);
+    if (!base || !stride) {
+        CVPixelBufferUnlockBaseAddress(pixbuf, 0);
+        CVPixelBufferRelease(pixbuf);
+        return NULL;
+    }
+
+    CGContextRef context = NULL;
+    bool drawn = false;
+    for (int n = 0; n < list->num_items; n++) {
+        struct sub_bitmaps *imgs = list->items[n];
+        if (!imgs->num_parts)
+            continue;
+        int64_t t = mp_time_ns();
+        if (draw_subtitle_bitmaps_direct(p, base, stride, w, h, imgs)) {
+            p->perf.blend_ns += mp_time_ns() - t;
+            drawn = true;
+            continue;
+        }
+        if (!context) {
+            CGColorSpaceRef colorSpace = CGColorSpaceCreateDeviceRGB();
+            context = colorSpace ? CGBitmapContextCreate(
+                base, w, h, 8, stride, colorSpace,
+                kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Little
+            ) : NULL;
+            if (colorSpace)
+                CGColorSpaceRelease(colorSpace);
+            if (!context)
+                continue;
+        }
+        draw_subtitle_bitmaps(context, imgs, h);
+        p->perf.cg_ns += mp_time_ns() - t;
+        drawn = true;
+    }
+    if (context)
+        CGContextRelease(context);
+
+    CVPixelBufferUnlockBaseAddress(pixbuf, 0);
+    if (!drawn) {
+        CVPixelBufferRelease(pixbuf);
+        return NULL;
+    }
+    return pixbuf;
+}
