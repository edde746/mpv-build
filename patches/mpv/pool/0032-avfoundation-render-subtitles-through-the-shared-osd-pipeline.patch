+        return;
+    mp_mutex_lock(&s->lock);
+    struct osd_ahead_stats st = s->stats;
+    struct osd_spec spec = s->spec;
+    uint32_t prefetch = s->prefetch.count;
+    mp_mutex_unlock(&s->lock);
+    int nw = MPMAX(p->ahead_perf.waited, 1);
+    MP_VERBOSE(vo, "osd-ahead: presented=%d waited=%d (avg %.2fms max %.2fms) "
+               "gave_up=%d behind=%d dropped=%d late=%d (max %d frames) | "
+               "renders=%u/%u maxMs=%d hist=%u,%u,%u,%u,%u spec=%u/%u/%u "
+               "horizonSkips=%u prefetch=%u coalesced=%u stale=%u\n",
+               p->ahead_perf.presented, p->ahead_perf.waited,
+               p->ahead_perf.wait_ns / nw / 1e6, p->ahead_perf.wait_max_ns / 1e6,
+               p->ahead_perf.gave_up, p->ahead_perf.behind, p->ahead_perf.dropped,
+               p->ahead_perf.late, p->ahead_perf.max_late,
+               st.renders_changed, st.renders, (int)(st.render_ns_max / 1000000),
+               st.render_hist[0], st.render_hist[1], st.render_hist[2],
+               st.render_hist[3], st.render_hist[4],
+               spec.hits, spec.misses, spec.skips, spec.horizon_skips, prefetch,
+               st.coalesced, st.stale);
+    memset(&p->ahead_perf, 0, sizeof(p->ahead_perf));
+}
