+typedef AChoreographer *(*mp_get_choreographer_fn)(void);
+typedef void (*mp_post_frame_callback_fn)(
+    AChoreographer *, AChoreographer_frameCallback, void *);
+typedef void (*mp_post_frame_callback_delayed_fn)(
+    AChoreographer *, AChoreographer_frameCallback, void *, long);
+typedef void (*mp_post_frame_callback64_fn)(
+    AChoreographer *, AChoreographer_frameCallback64, void *);
+typedef void (*mp_post_frame_callback_delayed64_fn)(
+    AChoreographer *, AChoreographer_frameCallback64, void *, uint32_t);
+// API 30. Declared locally: the NDK typedef is guarded by __ANDROID_API__.
+typedef void (*mp_refresh_rate_callback)(int64_t vsync_period_ns, void *data);
+typedef void (*mp_register_refresh_rate_callback_fn)(
+    AChoreographer *, mp_refresh_rate_callback, void *);
+// API 33: a vsync callback carries SurfaceFlinger's frame timelines.
+typedef void (*mp_post_vsync_callback_fn)(
+    AChoreographer *, AChoreographer_vsyncCallback, void *);
+typedef int64_t (*mp_frame_data_time_fn)(const AChoreographerFrameCallbackData *);
+typedef size_t (*mp_frame_data_count_fn)(const AChoreographerFrameCallbackData *);
