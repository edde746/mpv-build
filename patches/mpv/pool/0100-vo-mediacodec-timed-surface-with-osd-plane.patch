+// --- mediacodec geometry core
+
+struct mediacodec_geometry {
+    int viewport_w, viewport_h;
+    struct mp_rect video;
+};
+
+// Strict, allocation-free parsing. Do not publish any part of an invalid tuple.
+static bool mediacodec_geometry_parse(const char *text,
+                                      struct mediacodec_geometry *out)
+{
+    struct mediacodec_geometry next = {0};
+    if (text && text[0]) {
+        int values[6];
+        for (int n = 0; n < 6; n++) {
+            bool negative = *text == '-';
+            if (*text == '-' || *text == '+')
+                text++;
+            if (*text < '0' || *text > '9')
+                return false;
+            int64_t value = 0;
+            do {
+                value = value * 10 + (*text++ - '0');
+                if (value > (int64_t)INT_MAX + negative)
+                    return false;
+            } while (*text >= '0' && *text <= '9');
+            values[n] = negative ? -value : value;
+            if (n < 5 ? *text++ != ',' : *text != '\0')
+                return false;
+        }
+        if (values[0] <= 0 || values[1] <= 0 ||
+            values[4] <= values[2] || values[5] <= values[3])
+            return false;
+        next = (struct mediacodec_geometry){
+            values[0], values[1],
+            {values[2], values[3], values[4], values[5]},
+        };
+    }
+    *out = next;
+    return true;
+}
+
+static bool mediacodec_geometry_equal(struct mediacodec_geometry a,
+                                      struct mediacodec_geometry b)
+{
+    return a.viewport_w == b.viewport_w && a.viewport_h == b.viewport_h &&
+           a.video.x0 == b.video.x0 && a.video.y0 == b.video.y0 &&
+           a.video.x1 == b.video.x1 && a.video.y1 == b.video.y1;
+}
+
+static int64_t mediacodec_scale_edge(int edge, int size, int reference)
+{
+    int64_t scaled = (int64_t)edge * size;
+    // Round signed edges, not margins or video size, to the nearest pixel.
+    return (scaled + (scaled < 0 ? -reference / 2 : reference / 2)) / reference;
+}
+
+static struct mp_osd_res mediacodec_osd_geometry(
+    struct mediacodec_geometry geometry, int w, int h)
+{
+    struct mp_osd_res res = {.w = w, .h = h, .display_par = 1};
+    if (!geometry.viewport_w || !geometry.viewport_h || w <= 0 || h <= 0)
+        return res;
+
+    // The two buffer dimensions can have different even-rounding errors.
+    int64_t left = mediacodec_scale_edge(geometry.video.x0, w, geometry.viewport_w);
+    int64_t right = mediacodec_scale_edge(geometry.video.x1, w, geometry.viewport_w);
+    int64_t top = mediacodec_scale_edge(geometry.video.y0, h, geometry.viewport_h);
+    int64_t bottom = mediacodec_scale_edge(geometry.video.y1, h, geometry.viewport_h);
+    // Keep libass/mpv's signed-int canvas arithmetic representable. A tiny
+    // rectangle may also collapse at reduced OSD resolution; use the safe canvas.
+    if (left < INT_MIN || left > INT_MAX || w - right < INT_MIN ||
+        w - right > INT_MAX || top < INT_MIN || top > INT_MAX ||
+        h - bottom < INT_MIN || h - bottom > INT_MAX ||
+        w - left > INT_MAX || h - top > INT_MAX ||
+        right <= left || right - left > INT_MAX ||
+        bottom <= top || bottom - top > INT_MAX ||
+        right < INT_MIN || right > INT_MAX ||
+        bottom < INT_MIN || bottom > INT_MAX)
+        return res;
+    res.ml = left;
+    res.mr = w - right;
+    res.mt = top;
+    res.mb = h - bottom;
+    return res;
+}
