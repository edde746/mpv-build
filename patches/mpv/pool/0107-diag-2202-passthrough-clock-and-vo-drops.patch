+static void AudioTrack_diagSample(struct ao *ao, uint32_t raw, uint32_t smooth,
+                                  double delay)
+{
+    struct priv *p = ao->priv;
+    int64_t now = mp_time_ns();
+    double end_ns = now + delay * 1e9;
+    if (p->diag_last_ns) {
+        double dt_ms = (now - p->diag_last_ns) / 1e6;
+        int32_t step = (int32_t)(raw - p->diag_last_raw);
+        double dev_ms = step * 1000.0 / ao->samplerate - dt_ms;
+        uint32_t wrote = p->written_frames - p->diag_last_written;
+        double jump_ms = (end_ns - p->diag_last_end_ns) / 1e6 -
+                         wrote * 1000.0 / ao->samplerate;
+        if (!p->diag_n) {
+            p->diag_step_min = p->diag_step_max = step;
+            p->diag_dev_min = p->diag_dev_max = dev_ms;
+            p->diag_jump_min = p->diag_jump_max = jump_ms;
+            p->diag_window_ns = now;
+        } else {
+            p->diag_step_min = MPMIN(p->diag_step_min, step);
+            p->diag_step_max = MPMAX(p->diag_step_max, step);
+            p->diag_dev_min = MPMIN(p->diag_dev_min, dev_ms);
+            p->diag_dev_max = MPMAX(p->diag_dev_max, dev_ms);
+            p->diag_jump_min = MPMIN(p->diag_jump_min, jump_ms);
+            p->diag_jump_max = MPMAX(p->diag_jump_max, jump_ms);
+        }
+        p->diag_n++;
+        if (fabs(dev_ms) > 15 || fabs(jump_ms) > 15) {
+            MP_VERBOSE(ao, "clock2202 anomaly: raw step %d frames in %.1f ms "
+                       "(dev %+.1f ms), raw=%u smooth=%u written=%u "
+                       "delay=%.1f ms jump=%+.1f ms\n",
+                       step, dt_ms, dev_ms, raw, smooth, p->written_frames,
+                       delay * 1e3, jump_ms);
+        }
+        if (now - p->diag_window_ns >= MP_TIME_S_TO_NS(10)) {
+            MP_VERBOSE(ao, "clock2202 10s: n=%d raw step %d..%d frames, "
+                       "dev %+.1f..%+.1f ms, jump %+.1f..%+.1f ms, "
+                       "delay=%.1f ms, raw-smooth=%d\n",
+                       p->diag_n, p->diag_step_min, p->diag_step_max,
+                       p->diag_dev_min, p->diag_dev_max,
+                       p->diag_jump_min, p->diag_jump_max, delay * 1e3,
+                       (int32_t)(raw - smooth));
+            p->diag_n = 0;
+        }
+    }
+    p->diag_last_ns = now;
+    p->diag_last_raw = raw;
+    p->diag_last_written = p->written_frames;
+    p->diag_last_end_ns = end_ns;
+}
