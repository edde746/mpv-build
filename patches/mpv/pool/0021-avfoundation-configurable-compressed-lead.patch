-// Total window: history + the time-bounded lead (~1.5 MB at the highest
-// legal EAC3 rate) + slack.
-#define AVP_ES_RING_BYTES    (6 * 1024 * 1024)
+// Byte budget per second of lead when sizing the ES window: the highest
