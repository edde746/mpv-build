@@ -532,11 +542,21 @@ static void feed_avp(struct ao *ao)
     }
     if (++p->avp_heartbeat % 100 == 0) {
         CMTime t = [p->item currentTime];
+        int64_t write_head = p->es_head + p->es_len;
+        int64_t reader_gap = -1;
