+// Unwraps IEC 61937 (LE words from libavformat's spdif muxer) back into the
+// codec byte stream; parser state persists across calls. Full-carrier DTS
+// arrives without a preamble, so the frame header supplies its length.
+// dst needs len + sizeof(raw_dts_header) bytes.
+static int AudioTrack_unwrapIEC61937(struct ao *ao, uint8_t *dst,
+                                     const uint8_t *src, int len)
+{
+    struct priv *p = ao->priv;
+    int out = 0;
+
+    for (int i = 0; i < len;) {
+        if (!p->raw_have_byte) {
+            p->raw_byte = src[i++];
+            p->raw_have_byte = true;
+        }
+        if (i == len)
+            break;
+        const uint8_t lo = p->raw_byte, hi = src[i++];
+        p->raw_have_byte = false;
+
+        if (p->raw_state == RAW_PAYLOAD) {
+            // Payload words are byte-swapped; a lone final byte rides high.
+            dst[out++] = hi;
+            if (--p->raw_payload_left > 0) {
+                dst[out++] = lo;
+                p->raw_payload_left--;
+            }
+            if (p->raw_payload_left == 0)
+                p->raw_state = RAW_SYNC_PA;
+            continue;
+        }
+
+        if (p->raw_state == RAW_DTS_HEADER) {
+            uint8_t *h = p->raw_dts_header;
+            h[p->raw_dts_header_len++] = hi;
+            h[p->raw_dts_header_len++] = lo;
+            if (p->raw_dts_header_len < sizeof(p->raw_dts_header))
+                continue;
+
+            int blocks = 0;
+            if (h[0] == 0x7f && h[1] == 0xfe && h[2] == 0x80 && h[3] == 0x01)
+                blocks = (((h[4] << 8 | h[5]) >> 2) & 0x7f) + 1;
+            else if (h[0] == 0x1f && h[1] == 0xff && h[2] == 0xe8 && h[3] == 0x00)
+                blocks = ((h[5] & 7) << 4 | (h[6] & 0x3f) >> 2) + 1;
+
+            p->raw_state = RAW_SYNC_PA;
+            p->raw_dts_header_len = 0;
+            if (blocks == 16 || blocks == 32 || blocks == 64) {
+                memcpy(dst + out, h, sizeof(p->raw_dts_header));
+                out += sizeof(p->raw_dts_header);
+                p->raw_payload_left = blocks * 128 - sizeof(p->raw_dts_header);
+                p->raw_state = RAW_PAYLOAD;
+            }
+            continue;
+        }
+
+        const uint16_t word = lo | (hi << 8);
+        switch (p->raw_state) {
+        case RAW_SYNC_PA:
+            if (word == 0xf872)
+                p->raw_state = RAW_SYNC_PB;
+            else if (ao->format == AF_FORMAT_S_DTS &&
+                     (word == 0x7ffe || word == 0x1fff)) {
+                p->raw_dts_header[0] = hi;
+                p->raw_dts_header[1] = lo;
+                p->raw_dts_header_len = 2;
+                p->raw_state = RAW_DTS_HEADER;
+            }
+            break;
+        case RAW_SYNC_PB:
+            if (word == 0x4e1f)
+                p->raw_state = RAW_PC;
+            else
+                p->raw_state = word == 0xf872 ? RAW_SYNC_PB : RAW_SYNC_PA;
+            break;
+        case RAW_PC:
+            p->raw_data_type = word & 0x7f;
+            p->raw_state = RAW_PD;
+            break;
+        case RAW_PD:
+            switch (p->raw_data_type) {
+            case IEC61937_AC3:
+            case IEC61937_DTS1:
+            case IEC61937_DTS2:
+            case IEC61937_DTS3:
+                p->raw_payload_left = word >> 3; // Pd in bits
+                break;
+            case IEC61937_EAC3:
+                p->raw_payload_left = word; // Pd in bytes
+                break;
+            default:
+                MP_WARN(ao, "unexpected IEC 61937 data type 0x%x\n",
+                        p->raw_data_type);
+                p->raw_payload_left = 0;
+                break;
+            }
+            p->raw_state = p->raw_payload_left > 0 ? RAW_PAYLOAD : RAW_SYNC_PA;
+            break;
+        }
+    }
+
+    return out;
+}
