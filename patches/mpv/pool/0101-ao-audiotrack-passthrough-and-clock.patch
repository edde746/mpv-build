+static jint raw_encoding_for_format(int format, int *rate_mult)
+{
+    *rate_mult = 1;
+    switch (format) {
+    case AF_FORMAT_S_AC3:
+        return AudioFormat.ENCODING_AC3;
+    case AF_FORMAT_S_EAC3:
+        // 192 kHz IEC carrier vs 48 kHz codec frames
+        *rate_mult = 4;
+        return AudioFormat.ENCODING_E_AC3;
+    case AF_FORMAT_S_DTS:
+        return AudioFormat.ENCODING_DTS;
+    default:
+        return 0;
+    }
+}
