+static void AudioTrack_resetPlayheadSmoothing(struct priv *p)
+{
+    p->smooth_count = 0;
+    p->smooth_next = 0;
+    p->smooth_sampled = 0;
+    p->smooth_last_head = 0;
+    p->smooth_head = 0;
+    p->smooth_reported = 0;
+    p->smooth_reported_ns = 0;
+}
+
+// A direct/offload track's playback head advances in HAL-period steps (8192
+// frames at 192 kHz), larger than a 24p frame. Like media3's
+// AudioTrackPositionTracker: average the last (head - clock) offsets, bound
+// the estimate by what was written, and limit drift between reports to 10%
+// of elapsed time.
+static uint32_t AudioTrack_smoothPlayhead(struct ao *ao, uint32_t head)
+{
+    struct priv *p = ao->priv;
+    if (!head) // not started, or just flushed: nothing to average yet
+        return head;
+
+    int64_t now = mp_time_ns();
+    double clock = MP_TIME_NS_TO_S(now) * ao->samplerate;
+
+    p->smooth_head += (int32_t)(head - p->smooth_last_head);
+    p->smooth_last_head = head;
+
+    if (!p->smooth_count ||
+        now - p->smooth_sampled >= MP_TIME_MS_TO_NS(30))
+    {
+        p->smooth_offset[p->smooth_next] = p->smooth_head - clock;
+        p->smooth_next = (p->smooth_next + 1) % MP_ARRAY_SIZE(p->smooth_offset);
+        p->smooth_count = MPMIN(p->smooth_count + 1,
+                                MP_ARRAY_SIZE(p->smooth_offset));
+        p->smooth_sampled = now;
+    }
+
+    double sum = 0;
+    for (int n = 0; n < p->smooth_count; n++)
+        sum += p->smooth_offset[n];
+    int64_t est = llround(clock + sum / p->smooth_count);
+
+    if (p->smooth_reported_ns) {
+        double elapsed = MP_TIME_NS_TO_S(now - p->smooth_reported_ns) *
+                         ao->samplerate;
+        int64_t expected = p->smooth_reported + llround(elapsed);
+        int64_t drift = est - expected;
+        if (drift && llabs(drift) < ao->samplerate) {
+            int64_t allowed = llround(elapsed * 0.1);
+            est = MPCLAMP(est, expected - allowed, expected + allowed);
+        }
+    }
+    p->smooth_reported = est;
+    p->smooth_reported_ns = now;
+
+    int32_t over = (int32_t)((uint32_t)est - p->written_frames);
+    if (over > 0) {
+        est -= over;
+        p->smooth_count = 0;
+        p->smooth_next = 0;
+        p->smooth_sampled = 0;
+        p->smooth_reported_ns = 0;
+    }
+    return (uint32_t)est;
+}
