+static jint AudioTrack_getRoutedDeviceId(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    JNIEnv *env = MP_JNI_GET_ENV(ao);
+    if (!AudioTrack.getRoutedDevice || !AudioDeviceInfo.getId || !p->audiotrack)
+        return 0;
+    jobject device = MP_JNI_CALL_OBJECT(p->audiotrack, AudioTrack.getRoutedDevice);
+    if (MP_JNI_EXCEPTION_LOG(ao) < 0 || !device)
+        return 0;
+    jint id = MP_JNI_CALL_INT(device, AudioDeviceInfo.getId);
+    if (MP_JNI_EXCEPTION_LOG(ao) < 0)
+        id = 0;
+    MP_JNI_LOCAL_FREEP(&device);
+    return id;
+}
+
+// See the routing comment in priv: reload the AO when the route changes
+// under a live passthrough track.
+static void AudioTrack_checkRouteChange(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    if (!p->cfg_route_reload || p->routing_reload_requested)
+        return;
+    if (!p->raw_passthrough && p->format != AudioFormat.ENCODING_IEC61937)
+        return;
+    int64_t now = mp_time_ns();
+    if (p->routing_checked && now - p->routing_checked < MP_TIME_MS_TO_NS(250))
+        return;
+    p->routing_checked = now;
+    jint id = AudioTrack_getRoutedDeviceId(ao);
+    if (!id) {
+        // Unrouted is not a change by itself: a track that has not started
+        // has no route yet, and a device mid-renegotiation reports none.
+        // Remember the loss; the next rebind decides.
+        if (p->routed_device)
+            p->routing_lost = true;
+        return;
+    }
+    if (!p->routed_device) {
+        p->routed_device = id;
+        return;
+    }
+    if (id != p->routed_device || p->routing_lost) {
+        MP_WARN(ao, "audio route changed under a passthrough track "
+                "(device %d -> %d), reloading AO\n",
+                (int)p->routed_device, (int)id);
+        p->routing_reload_requested = true;
+        ao_request_reload(ao);
+    }
+}
+
