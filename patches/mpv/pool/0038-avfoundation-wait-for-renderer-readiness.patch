From: edde746 <86283021+edde746@users.noreply.github.com>
Date: Tue, 13 Oct 2026 13:00:00 +0200
Subject: [PATCH] vo_avfoundation: wait for renderer readiness instead of
 polling it

When the display layer's renderer was not ready for more media data,
wait_until_ready_for_more_media_data() slept 1 ms at a time and asked
isReadyForMoreMediaData again until the renderer was ready or the
frame's deadline passed. About half the frames meet a full renderer: on
a 4K HDR10 HEVC file the VO reported 56-72 ready-waits per 5 s averaging
5.8-7.0 ms, so the VO thread woke about 80 times a second only to poll,
and the player process ran at 136-147 wakeups/s where AVPlayer runs at
31. At speed=2 nearly every frame waits, about 22 ms each, and the
player ran at 828 wakeups/s.

Arm requestMediaDataWhenReadyOnQueue: for the wait instead. The renderer
runs the block once it is ready, at once if it already is, so readiness
that arrives between the check and the request is not missed, and the
block signals a semaphore the VO thread sleeps on. Each wait sleeps at
most 20 ms and never past the frame's give-up time, and the loop
re-checks readiness, recovery and the deadline after every wait as
before, so deadline drops and layer recovery keep their behaviour.

The block disarms the request itself, because a block that returns
without enqueueing is run again at once (1.5 million times in 300 ms in
a standalone test). stopRequestingMediaData drops the renderer's
reference to the block while the block is still running, so a block
only the renderer holds reads its captured semaphore from freed memory
after the stop: a standalone loop doing that crashes in
dispatch_semaphore_signal within a second. The wait therefore holds its
own copy of the block, which runs on a private serial queue, and drains
that queue after stopping the request before releasing the copy; that
also covers an invocation that began just before a timed-out wait
stopped the request. The same loop then ran 16,500 waits under
MallocScribble and Guard Malloc without a fault.

A renderer that fails without becoming ready need not run the block, so
a wait can now reach the deadline without having seen a failure the 1
ms poll would have caught. Check for a failed layer before declaring the
deadline missed, so such a frame is recovered and enqueued rather than
dropped.

MPVBuildBench cell, 1280x720 pt window, 45 s measured, wakeups/s of the
player process, every run without a dropped frame:

  hevc-4k-hdr10.mp4, 4 alternating pairs       136-147 -> 85.1-85.4
  hevc-4k-hdr10-90m.mp4 at speed=2                 828 -> 85

With the patch the VO still reports 38-51 ready-waits per 5 s averaging
6.2-7.7 ms on the first file, and 124-129 averaging 32-33 ms at speed=2,
with no deadline drops.
---
diff --git a/video/out/vo_avfoundation.m b/video/out/vo_avfoundation.m
index 76dfa5f..d2736e7 100644
--- a/video/out/vo_avfoundation.m
+++ b/video/out/vo_avfoundation.m
@@ -442,6 +442,10 @@ static double avf_servo_rate(int64_t error_ns, double nominal_rate,
     // image buffer stops matching (dimensions/format/attachments).
     CMVideoFormatDescriptionRef video_format_desc;
 
+    // Serial queue the renderer runs its readiness block on; see
+    // wait_for_renderer_ready().
+    dispatch_queue_t ready_queue;
+
     // Frame counter for periodic maintenance
     int frame_count;
     int not_ready_drop_count;
@@ -1359,6 +1363,47 @@ static void record_deadline_drop(struct vo *vo)
     p->diag_drop_count++;
 }
 
+// Sleep until the renderer announces it is ready for more media data, or
+// until `until`. The announcement comes from requestMediaDataWhenReadyOnQueue:,
+// which runs the block once the renderer is (or becomes) ready, so the wait
+// costs one wakeup instead of one per millisecond of isReadyForMoreMediaData
+// polling. The 20 ms slice is a backstop for a renderer that fails without
+// ever becoming ready; the caller re-checks readiness and recovery after every
+// return.
+//
+// The block disarms the request itself, because a block that returns without
+// enqueueing is run again at once. Disarming drops the renderer's reference to
+// the block while the block is still running, so this function holds its own
+// copy, and before releasing it drains the private serial queue the block runs
+// on: a timed-out wait may stop the request while an invocation that began
+// just before is still running.
+static void wait_for_renderer_ready(struct priv *p, int64_t until)
+{
+    int64_t timeout = MPMIN(until - mp_time_ns(), MP_TIME_MS_TO_NS(20));
+    if (timeout <= 0)
+        return;
+
+    id<AVQueuedSampleBufferRendering> renderer =
+        active_sample_buffer_renderer(p->displayLayer);
+    if (!renderer || !p->ready_queue) {
+        mp_sleep_ns(MPMIN(timeout, MP_TIME_MS_TO_NS(1)));
+        return;
+    }
+
+    dispatch_semaphore_t ready = dispatch_semaphore_create(0);
+    dispatch_block_t on_ready = [^{
+        [renderer stopRequestingMediaData];
+        dispatch_semaphore_signal(ready);
+    } copy];
+    [renderer requestMediaDataWhenReadyOnQueue:p->ready_queue
+                                    usingBlock:on_ready];
+    dispatch_semaphore_wait(ready, dispatch_time(DISPATCH_TIME_NOW, timeout));
+    [renderer stopRequestingMediaData];
+    dispatch_sync(p->ready_queue, ^{});
+    [on_ready release];
+    dispatch_release(ready);
+}
+
 static bool wait_until_ready_for_more_media_data(struct vo *vo, int64_t present_host_ns)
 {
     struct priv *p = vo->priv;
@@ -1389,11 +1434,9 @@ static bool wait_until_ready_for_more_media_data(struct vo *vo, int64_t present_
     }
 
     while (!sample_buffer_renderer_is_ready(p->displayLayer)) {
-        if (mp_time_ns() >= give_up) {
-            MP_VERBOSE(vo, "Display layer not ready at PTS deadline; dropping frame\n");
-            record_deadline_drop(vo);
-            return false;
-        }
+        // Check for a failed layer before the deadline: a renderer that fails
+        // without becoming ready need not run the readiness block, so a wait
+        // can end at the deadline without having seen the failure.
         if (display_layer_needs_recovery(p->displayLayer)) {
             recover_display_layer(vo, "not-ready wait", false);
             if (display_layer_needs_recovery(p->displayLayer)) {
@@ -1405,7 +1448,12 @@ static bool wait_until_ready_for_more_media_data(struct vo *vo, int64_t present_
             }
             continue;
         }
-        mp_sleep_ns(MP_TIME_MS_TO_NS(1));
+        if (mp_time_ns() >= give_up) {
+            MP_VERBOSE(vo, "Display layer not ready at PTS deadline; dropping frame\n");
+            record_deadline_drop(vo);
+            return false;
+        }
+        wait_for_renderer_ready(p, give_up);
     }
 
     p->not_ready_drop_count = 0;
@@ -3821,6 +3869,9 @@ static int preinit(struct vo *vo)
     });
     [displayLayer release];
     vo_set_queue_params(vo, MP_TIME_MS_TO_NS(p->opts->queue_lead_ms), 1);
+    p->ready_queue = dispatch_queue_create("avfoundation ready",
+        dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL,
+                                                QOS_CLASS_USER_INTERACTIVE, 0));
     update_avfoundation_geometry(vo);
 
     if (p->opts->composite_osd && !ensure_ci_compositor(vo))
@@ -4411,6 +4462,11 @@ static void uninit(struct vo *vo)
     [p->mtlDevice release];
     p->mtlDevice = nil;
 
+    if (p->ready_queue) {
+        dispatch_release(p->ready_queue);
+        p->ready_queue = NULL;
+    }
+
     [p->displayLayer release];
     p->displayLayer = nil;
 
