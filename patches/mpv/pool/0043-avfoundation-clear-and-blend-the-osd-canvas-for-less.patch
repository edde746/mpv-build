+// --- avf osd dirty set (host-testable; keep freestanding)
+// What one overlay buffer had drawn into it, as a few rects rather than
+// their union: a sign at the top and dialogue at the bottom would otherwise
+// clear the whole canvas between them. Rects merge only when clearing the
+// merged box costs no more than clearing both, so the set never clears more
+// than the parts covered plus their overlaps; once full, the merge that
+// grows the cleared area least makes room.
+#define AVF_OSD_DIRTY_MAX 16
+
+struct avf_dirty_set {
+    int num;  // -1: contents unknown, clear everything
+    struct mp_rect r[AVF_OSD_DIRTY_MAX];
+};
+
+static int64_t avf_rect_area(struct mp_rect r)
+{
+    return (int64_t)(r.x1 - r.x0) * (r.y1 - r.y0);
+}
+
+static struct mp_rect avf_rect_bounds(struct mp_rect a, struct mp_rect b)
+{
+    return (struct mp_rect){MPMIN(a.x0, b.x0), MPMIN(a.y0, b.y0),
+                            MPMAX(a.x1, b.x1), MPMAX(a.y1, b.y1)};
+}
+
+static void avf_dirty_add(struct avf_dirty_set *s, struct mp_rect r)
+{
+    if (s->num < 0 || r.x1 <= r.x0 || r.y1 <= r.y0)
+        return;
+    for (;;) {
+        // Absorb every rect that is cheaper to clear as one box with r; the
+        // grown box may reach further ones, so rescan after each merge.
+        for (int i = 0; i < s->num; i++) {
+            struct mp_rect u = avf_rect_bounds(s->r[i], r);
+            if (avf_rect_area(u) <= avf_rect_area(s->r[i]) + avf_rect_area(r)) {
+                r = u;
+                s->r[i] = s->r[--s->num];
+                i = -1;
+            }
+        }
+        if (s->num < AVF_OSD_DIRTY_MAX)
+            break;
+        int best = 0;
+        int64_t best_cost = INT64_MAX;
+        for (int i = 0; i < s->num; i++) {
+            int64_t cost = avf_rect_area(avf_rect_bounds(s->r[i], r)) -
+                           avf_rect_area(s->r[i]);
+            if (cost < best_cost) {
+                best_cost = cost;
+                best = i;
+            }
+        }
+        r = avf_rect_bounds(s->r[best], r);
+        s->r[best] = s->r[--s->num];
+    }
+    s->r[s->num++] = r;
+}
+
+// Pixels a clear of s touches on a w x h canvas.
+static int64_t avf_dirty_pixels(const struct avf_dirty_set *s, int w, int h)
+{
+    if (s->num < 0)
+        return (int64_t)w * h;
+    int64_t px = 0;
+    for (int i = 0; i < s->num; i++) {
+        struct mp_rect r = s->r[i];
+        int x0 = MPCLAMP(r.x0, 0, w), x1 = MPCLAMP(r.x1, 0, w);
+        int y0 = MPCLAMP(r.y0, 0, h), y1 = MPCLAMP(r.y1, 0, h);
+        if (x1 > x0 && y1 > y0)
+            px += (int64_t)(x1 - x0) * (y1 - y0);
+    }
+    return px;
+}
