+// The core rate named by a DTS-HD packet's leading core frame, or 0.
+static int dtshd_core_rate(const uint8_t *pkt, int len)
+{
+    // DTS core SFREQ codes (libavcodec dca.h); 0 marks the reserved ones.
+    static const int rates[16] = {
+        0, 8000, 16000, 32000, 0, 0, 11025, 22050,
+        44100, 0, 0, 12000, 24000, 48000, 96000, 192000,
+    };
+    if (len < 9 || pkt[0] != 0x7f || pkt[1] != 0xfe || pkt[2] != 0x80 || pkt[3] != 0x01)
+        return 0;
+    return rates[(pkt[8] >> 2) & 0xf];
+}
+
+static void AudioTrack_recreateOrFail(struct ao *ao);
+
+// ad_spdif does not expose the codec rate, so a raw DTS-HD track opens at
+// 48 kHz and the first unwrapped packet's core header confirms it. Another
+// rate that still divides the carrier reopens the track at that rate. The
+// replacement resets the clock, as any replacement does, but keeps the
+// unwrapped packet and the parser position the reset would drop: the caller
+// returns without writing, and the worker re-enters under the new generation
+// with the packet still pending. A rate the carrier cannot clock keeps the
+// track as opened, with a warning. p->lock held.
+static void AudioTrack_adoptDtsHdRate(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    p->raw_rate_verified = true;
+    const int rate = dtshd_core_rate(p->rawbuf, p->raw_pending);
+    if (!rate) {
+        MP_WARN(ao, "DTS-HD packet has no core header; keeping the raw track at %d Hz\n",
+                p->samplerate);
+        return;
+    }
+    if (rate == p->samplerate)
+        return;
+    if (ao->samplerate % rate) {
+        MP_WARN(ao, "%d Hz DTS-HD core does not divide the %d Hz carrier; "
+                "keeping the raw track at %d Hz\n",
+                rate, ao->samplerate, p->samplerate);
+        return;
+    }
+    MP_VERBOSE(ao, "DTS-HD core is %d Hz; reopening the raw track at that rate\n",
+               rate);
+    const int state = p->raw_state, data_type = p->raw_data_type,
+              header_len = p->raw_dts_header_len, pending = p->raw_pending,
+              input_len = p->raw_input_len, payload_left = p->raw_payload_left;
+    const uint8_t byte = p->raw_byte;
+    const bool have_byte = p->raw_have_byte;
+    p->samplerate = rate;
+    p->raw_rate_mult = ao->samplerate / rate;
+    AudioTrack_recreateOrFail(ao);
+    p->raw_state = state;
+    p->raw_data_type = data_type;
+    p->raw_dts_header_len = header_len;
+    p->raw_pending = pending;
+    p->raw_input_len = input_len;
+    p->raw_payload_left = payload_left;
+    p->raw_byte = byte;
+    p->raw_have_byte = have_byte;
+}
