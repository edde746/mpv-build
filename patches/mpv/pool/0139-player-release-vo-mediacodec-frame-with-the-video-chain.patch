Subject: [PATCH] player: release vo_mediacodec's last frame with the video chain so the next file's decoder can open

On a Sony Bravia with a MediaTek MT5895 (Plezy #2755), every episode
change loses HDR10 and Dolby Vision: the next file's MediaCodec decoder
fails to configure (0xfffffff4, out of resources), mpv falls back to
mediacodec-copy and software, the plane rejects the format, and the
embedder moves the file to a GL VO that outputs SDR. Restarting the
player plays the same file on the plane in HDR.

The previous file's decoder is still alive when the next one opens.
vo.c keeps the last frame it showed so it can redraw it, and a
MediaCodec frame holds its codec: libavcodec deletes the codec with its
last output buffer. That frame is only replaced by the next file's
first frame, which the next decoder can only produce once it has opened.
The MT5895 has no resources for a second decoder of the same kind, so
the next one fails; once the plane VO and its frame are destroyed, the
same file's decoder opens.

vo_mediacodec does not need that frame: a redraw repaints the OSD only,
and the buffer behind it is gone once released. It now declares
VO_CAP_FRAMES_HOLD_DECODER, and uninit_video_chain() then drops vo.c's
frames on the VO thread (vo_release_frames) after the decoder is
uninitialized, so the codec is deleted before the next file opens one.
Until the next file's first frame, redraws have no picture, as before a
session's first frame. GL VOs keep the frame for redraws as before.

diff --git a/player/video.c b/player/video.c
index ab5d9eb..bdc230c 100644
--- a/player/video.c
+++ b/player/video.c
@@ -158,10 +158,17 @@ static void vo_chain_uninit(struct vo_chain *vo_c)
 void uninit_video_chain(struct MPContext *mpctx)
 {
     if (mpctx->vo_chain) {
+        struct vo *vo = mpctx->vo_chain->vo;
         reset_video_state(mpctx);
         vo_chain_uninit(mpctx->vo_chain);
         mpctx->vo_chain = NULL;
 
+        // The VO still holds the last frame it showed, and with it this
+        // chain's decoder. Let it go now instead of at the next file's first
+        // frame, which that file's decoder can only produce once it opened.
+        if (vo->driver->caps & VO_CAP_FRAMES_HOLD_DECODER)
+            vo_release_frames(vo);
+
         mpctx->video_status = STATUS_EOF;
 
         mp_notify(mpctx, MPV_EVENT_VIDEO_RECONFIG, NULL);
diff --git a/video/out/vo.c b/video/out/vo.c
index ec04b0c..dd774a0 100644
--- a/video/out/vo.c
+++ b/video/out/vo.c
@@ -1337,6 +1337,31 @@ void vo_seek_reset(struct vo *vo)
     mp_mutex_unlock(&in->lock);
 }
 
+static void run_release_frames(void *p)
+{
+    struct vo *vo = p;
+    struct vo_internal *in = vo->in;
+
+    mp_mutex_lock(&in->lock);
+    struct vo_frame *frame = in->current_frame;
+    in->current_frame = NULL;
+    forget_frames(vo);
+    mp_mutex_unlock(&in->lock);
+
+    // Unlocked: with VO_CAP_FRAMES_HOLD_DECODER, this may delete the decoder.
+    talloc_free(frame);
+}
+
+// Drop every frame vo.c holds, the one kept for redraws included. It runs on
+// the VO thread between render passes, so no frame is mid-draw either. Frames
+// the driver keeps of its own are not touched. Until the next frame is
+// queued, redraws have no picture (vo_frame.current == NULL), as before the
+// first frame.
+void vo_release_frames(struct vo *vo)
+{
+    mp_dispatch_run(vo->in->dispatch, run_release_frames, vo);
+}
+
 // Whether at least 1 frame was queued or rendered since last seek or reconfig.
 bool vo_has_frame(struct vo *vo)
 {
diff --git a/video/out/vo.h b/video/out/vo.h
index 916a23c..11f2fc7 100644
--- a/video/out/vo.h
+++ b/video/out/vo.h
@@ -219,6 +219,11 @@ enum {
     // (vo_mediacodec): a failed output conversion waits for that --vo change
     // instead of failing the video track (see vo-format-rejected).
     VO_CAP_CLIENT_FALLBACK = 1 << 8,
+    // Each frame keeps the decoder that made it alive, and the VO does not
+    // need the last frame to redraw (vo_mediacodec). The core drops that
+    // frame with the video chain (vo_release_frames), so the next decoder
+    // never opens while the old one still holds the hardware.
+    VO_CAP_FRAMES_HOLD_DECODER = 1 << 9,
 };
 
 enum {
@@ -568,6 +573,7 @@ bool vo_has_frame(struct vo *vo);
 void vo_redraw(struct vo *vo);
 bool vo_want_redraw(struct vo *vo);
 void vo_seek_reset(struct vo *vo);
+void vo_release_frames(struct vo *vo);
 void vo_destroy(struct vo *vo);
 void vo_set_paused(struct vo *vo, bool paused);
 int64_t vo_get_drop_count(struct vo *vo);
diff --git a/video/out/vo_mediacodec.c b/video/out/vo_mediacodec.c
index ab98fb6..eaca622 100644
--- a/video/out/vo_mediacodec.c
+++ b/video/out/vo_mediacodec.c
@@ -3538,7 +3538,16 @@ const struct vo_driver video_out_mediacodec = {
     // query_format takes MediaCodec buffers only. A stream decoded any other
     // way is the embedder's cue to switch to a GL VO, so CLIENT_FALLBACK
     // holds the chain for that switch instead of dropping the video track.
-    .caps = VO_CAP_FRAMEDROP | VO_CAP_OWN_TIMING | VO_CAP_CLIENT_FALLBACK,
+    //
+    // Each frame is a MediaCodec output buffer, and the codec is deleted
+    // with its last buffer; redraws repaint the OSD only (draw_frame), so
+    // the frame vo.c keeps for them shows nothing once released. Some
+    // decoders run one instance at a time (MediaTek MT5895 HEVC and DV,
+    // Plezy #2755): FRAMES_HOLD_DECODER drops that frame with the video
+    // chain, or the next file's decoder fails to open behind it and the
+    // file falls back to a GL VO.
+    .caps = VO_CAP_FRAMEDROP | VO_CAP_OWN_TIMING | VO_CAP_CLIENT_FALLBACK |
+            VO_CAP_FRAMES_HOLD_DECODER,
     .preinit = preinit,
     .query_format = query_format,
     .prepare_frame = prepare_frame,
