+#if TARGET_OS_TV
+// Keeps priv's refresh fields on the display's vsyncs, on the main thread. A
+// display link's timestamp is its last vsync in CACurrentMediaTime(), which
+// is mach_absolute_time() as mp_time_ns() is.
+@interface MPVRefreshClock : NSObject {
+@public
+    struct priv *p;
+}
+@end
+
+@implementation MPVRefreshClock
+- (void)tick:(CADisplayLink *)link
+{
+    int64_t vsync_ns = mp_time_ns() +
+        (int64_t)((link.timestamp - CACurrentMediaTime()) * 1e9);
+    atomic_store(&p->refresh_period_ns,
+                 (int64_t)((link.targetTimestamp - link.timestamp) * 1e9));
+    atomic_store(&p->refresh_vsync_ns, vsync_ns);
+}
+@end
+#endif
