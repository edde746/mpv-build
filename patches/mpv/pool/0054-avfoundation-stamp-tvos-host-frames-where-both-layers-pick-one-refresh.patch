+// --- avf host refresh stamp (host-testable; keep freestanding) ---
+// Where in a refresh interval a host stamp goes (plezy#3073). The video layer
+// and the OSD layer each pick the refresh that shows a sample from its stamp,
+// and on tvOS with the refresh matched to the frame rate their cut-offs
+// differ and wander: stamps 73-89% of the way from one vsync to the next put
+// the subtitles a refresh before or after the picture, steadily or every few
+// frames, and at 24p a stamp keeps its place in the interval until a pause
+// or seek. A stamp moves to the nearest point 30% of the way through an
+// interval, the farthest from those cut-offs, by at most half a refresh
+// either way. A period of 0 (no vsync seen) leaves the target as it is.
+static int64_t avf_host_refresh_stamp_ns(int64_t target_ns, int64_t vsync_ns,
+                                         int64_t period_ns)
+{
+    if (period_ns <= 0)
+        return target_ns;
+    int64_t base_ns = vsync_ns + period_ns * 3 / 10;
+    int64_t offset_ns = target_ns - base_ns;
+    int64_t n = offset_ns / period_ns;
+    int64_t rest_ns = offset_ns % period_ns;
+    if (rest_ns < 0) {
+        rest_ns += period_ns;
+        n--;
+    }
+    if (rest_ns >= period_ns - rest_ns)
+        n++;
+    return base_ns + n * period_ns;
+}
+// --- end avf host refresh stamp ---
+
