+// Called locked. Block until no render holds the decoder. Every caller that
+// reads or mutates sd while a render may be in flight goes through this;
+// the exceptions are sub_read_packets and the two per-frame controls, which
+// defer instead so the playloop never waits on libass.
+static void wait_render_done(struct dec_sub *sub)
+{
+    while (sub->rendering)
+        mp_cond_wait(&sub->render_done, &sub->lock);
