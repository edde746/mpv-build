+
+// Called locked, not rendering. Hand the decoder everything that queued up
+// while it was busy, in arrival order.
+static void apply_pending(struct dec_sub *sub)
+{
+    mp_assert(!sub->rendering);
+    for (int n = 0; n < sub->num_pending_pkts; n++) {
+        sub->sd->driver->decode(sub->sd, sub->pending_pkts[n]);
+        demux_packet_pool_push(sub->packet_pool, sub->pending_pkts[n]);
+    }
+    sub->num_pending_pkts = 0;
+    if (sub->have_pending_video_params && sub->sd->driver->control) {
+        sub->sd->driver->control(sub->sd, SD_CTRL_SET_VIDEO_PARAMS,
+                                 &sub->pending_video_params);
+    }
+    sub->have_pending_video_params = false;
+    if (sub->have_pending_animated_check && sub->sd->driver->control) {
+        sub->sd->driver->control(sub->sd, SD_CTRL_SET_ANIMATED_CHECK,
+                                 &sub->pending_animated_check);
+    }
+    sub->have_pending_animated_check = false;
+}
