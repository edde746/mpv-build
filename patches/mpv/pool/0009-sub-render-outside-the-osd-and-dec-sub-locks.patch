+// Called locked. Block while a subtitle object is rendering with the lock
+// released; callers that change which dec_sub an object points at (or free
+// the whole state) must not overtake that render.
+static void wait_sub_render_done(struct osd_state *osd)
+{
+    while (osd->sub_render_busy)
+        mp_cond_wait(&osd->sub_render_done, &osd->lock);
+}
+
 void osd_free(struct osd_state *osd)
 {
     if (!osd)
         return;
+    mp_mutex_lock(&osd->lock);
+    wait_sub_render_done(osd);
+    mp_mutex_unlock(&osd->lock);
     osd_destroy_backend(osd);
     talloc_free(osd->objs[OSDTYPE_EXTERNAL2]->external2);
+    mp_cond_destroy(&osd->sub_render_done);
     mp_mutex_destroy(&osd->lock);
     talloc_free(osd);
 }
