+
+// Events the renderer raises when its device goes away or changes. Whether
+// the session passes them on is up to it; the device notifications below
+// cover the same cases.
+static bool device_event(MediaEventType type)
+{
+    switch (type) {
+    case MEAudioSessionDeviceRemoved:
+    case MEAudioSessionDisconnected:
+    case MEAudioSessionFormatChanged:
+    case MEStreamSinkDeviceChanged:
+    case MESinkInvalidated:
+    case ME_STREAM_SINK_FORMAT_INVALIDATED:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static HRESULT STDMETHODCALLTYPE callback_Invoke(IMFAsyncCallback *iface,
+                                                 IMFAsyncResult *result)
+{
+    struct mf_core *c = CORE_OF(iface, callback);
+
+    AcquireSRWLockExclusive(&c->lock);
+    IMFMediaSession *session = c->session;
+    if (session)
+        IMFMediaSession_AddRef(session);
+    ReleaseSRWLockExclusive(&c->lock);
+    if (!session)
+        return S_OK;
+
+    IMFMediaEvent *event = NULL;
+    MediaEventType type = MEUnknown;
+    HRESULT status = S_OK;
+    UINT32 topo = 0;
+    HRESULT hr = IMFMediaSession_EndGetEvent(session, result, &event);
+    if (SUCCEEDED(hr)) {
+        IMFMediaEvent_GetType(event, &type);
+        IMFMediaEvent_GetStatus(event, &status);
+        IMFMediaEvent_GetUINT32(event, &MF_EVENT_TOPOLOGY_STATUS, &topo);
+        IMFMediaEvent_Release(event);
+    }
+
+    AcquireSRWLockExclusive(&c->lock);
+    bool more = true;
+    if (FAILED(hr)) {
+        // Without the events nothing below can be told any more.
+        if (hr != MF_E_SHUTDOWN)
+            fail_locked(c, "Lost the session's events", hr);
+        more = false;
+    } else {
+        if (c->ao)
+            MP_DBG(c->ao, "Session event %d: %s\n", (int)type,
+                   mp_HRESULT_to_str(status));
+        if (type == MESessionClosed) {
+            more = false;       // whatever its status: uninit waits for it
+        } else if (type == MEAudioSessionExclusiveModeOverride ||
+                   type == MEAudioSessionServerShutdown) {
+            fail_locked(c, "The audio device was taken away",
+                        FAILED(status) ? status : E_FAIL);
+        } else if (device_event(type)) {
+            device_trouble_locked(c, "The renderer lost its device");
+        } else if (FAILED(status) || type == MEError) {
+            fail_locked(c, "The session failed", FAILED(status) ? status : E_FAIL);
+        } else if (type == MESessionTopologyStatus) {
+            if (topo == MF_TOPOSTATUS_READY)
+                c->topology_ready = true;
+        } else if (type == MESessionStarted) {
+            c->started_events++;
+            if (c->ao)
+                ao_wakeup(c->ao);
+        }
+    }
+    c->events_done = !more;
+    WakeAllConditionVariable(&c->changed);
+    ReleaseSRWLockExclusive(&c->lock);
+
+    if (more) {
+        hr = IMFMediaSession_BeginGetEvent(session, iface, NULL);
+        if (FAILED(hr)) {
+            AcquireSRWLockExclusive(&c->lock);
+            if (hr != MF_E_SHUTDOWN)
+                fail_locked(c, "Lost the session's events", hr);
+            c->events_done = true;
+            WakeAllConditionVariable(&c->changed);
+            ReleaseSRWLockExclusive(&c->lock);
+        }
+    }
+    IMFMediaSession_Release(session);
+    return S_OK;
+}
+
