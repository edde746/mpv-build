+/*
+ * Plays E-AC-3 with the decoder Windows ships instead of FFmpeg's, which is
+ * the only way a Dolby Atmos (JOC) track reaches the system as objects.
+ *
+ * ao_wasapi hands E-AC-3 passthrough to this AO (ao->redirect) when the device
+ * refuses the bitstream, together with the device it was opened for. The AO
+ * gets the IEC 61937 stream mpv would send to a receiver (--audio-spdif=eac3),
+ * takes the access units back out of the bursts and serves them to a Media
+ * Foundation session from a media source of its own:
+ *
+ *     this source -> decoder the topology loader picks -> audio renderer
+ *
+ * With a spatial sound format active on the endpoint (Dolby Atmos for
+ * Headphones, for home theater, for built-in speakers) the Dolby decoder MFT
+ * negotiates MFAudioFormat_Float_SpatialObjects with the renderer. A decoder
+ * driven by hand cannot do that: the spatial samples come from an allocator
+ * the pipeline provides. Where no decoder offers that type, init fails and
+ * mpv decodes the track itself.
+ *
+ * Once playing, a failure (an error from the session, a Start or resume that
+ * fails, a session that never starts, a renderer that stops taking audio)
+ * asks the player to decode the track instead (ao_request_pcm_fallback()): a
+ * reload would reopen the same stream, and a failure that only shows after
+ * init() would repeat without end. A change of device (another default, the
+ * device gone, a new device format) asks for a reload, which tries passthrough
+ * again on whatever device is current.
+ *
+ * The session's presentation clock is the audio clock: timestamps restart at
+ * zero with every start after a reset.
+ */
+
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wchar.h>
+
+#include <windows.h>
+#include <mfapi.h>
+#include <mfidl.h>
+#include <mfobjects.h>
+#include <mferror.h>
+#include <mftransform.h>
+
+#include "audio/format.h"
+#include "common/common.h"
+#include "common/msg.h"
+#include "options/m_option.h"
+#include "osdep/threads.h"
+#include "osdep/timer.h"
+#include "osdep/windows_utils.h"
+#include "ao.h"
+#include "ao_wasapi.h"
+#include "internal.h"
+
+// --- bursts
+// IEC 61937 E-AC-3 bursts as libavformat's spdif muxer writes them, for
+// --audio-spdif=eac3: stereo 16 bit frames, little-endian. A burst starts
+// with Pa Pb Pc Pd = 0xF872 0x4E1F <data type> <payload length in bytes>,
+// carries the payload as big-endian words in little-endian ones, and is
+// zero-padded to BURST_FRAMES frames. Plain C, so that the host harness
+// (scripts/test_ao_mediafoundation_bursts.sh) compiles this region alone.
+
+#define BURST_FRAMES 6144
+#define BURST_HEADER 8
+#define BURST_TYPE_EAC3 0x15
+
+struct bursts {
+    uint8_t *pending;                   // bytes of a burst that is not complete yet
+    size_t len, cap;
+    int64_t offset;                     // where pending[0] is in the stream, bytes
+    uint8_t *payload;                   // one payload, unswapped
+    size_t payload_cap;
+    bool skipped_other;                 // passed over a burst that is not E-AC-3
+};
+
+// Called with each complete E-AC-3 payload and the stream offset (bytes) of
+// its burst. Returns false to stop (out of memory).
+typedef bool (*burst_cb)(void *ctx, const uint8_t *payload, size_t size,
+                         int64_t offset);
+
+static void bursts_reset(struct bursts *b)
+{
+    b->len = 0;
+    b->offset = 0;
+}
+
+static void bursts_free(struct bursts *b)
+{
+    free(b->pending);
+    free(b->payload);
+    *b = (struct bursts){0};
+}
+
+// Append size bytes and hand every burst they complete to cb. max_payload is
+// the most a burst can carry (its frames minus the preamble, in bytes).
+static bool bursts_feed(struct bursts *b, const uint8_t *data, size_t size,
+                        size_t max_payload, burst_cb cb, void *ctx)
+{
+    if (b->len + size > b->cap) {
+        size_t cap = b->cap * 2 > b->len + size ? b->cap * 2 : b->len + size;
+        uint8_t *grown = realloc(b->pending, cap);
+        if (!grown)
+            return false;
+        b->pending = grown;
+        b->cap = cap;
+    }
+    if (b->payload_cap < max_payload + 1) {
+        uint8_t *grown = realloc(b->payload, max_payload + 1);
+        if (!grown)
+            return false;
+        b->payload = grown;
+        b->payload_cap = max_payload + 1;
+    }
+    memcpy(b->pending + b->len, data, size);
+    b->len += size;
+
+    const uint8_t *buf = b->pending;
+    size_t len = b->len, pos = 0;
+    bool ok = true;
+    while (pos + BURST_HEADER <= len) {
+        // Pa Pb as little-endian words; in between bursts the carrier is zero.
+        if (buf[pos] != 0x72 || buf[pos + 1] != 0xF8 ||
+            buf[pos + 2] != 0x1F || buf[pos + 3] != 0x4E)
+        {
+            pos += 2;
+            continue;
+        }
+        unsigned type = buf[pos + 4] & 0x7F;
+        size_t length = buf[pos + 6] | ((size_t)buf[pos + 7] << 8);
+        size_t padded = (length + 1) & ~(size_t)1;
+        if (type != BURST_TYPE_EAC3 || !length || padded > max_payload) {
+            b->skipped_other = true;
+            pos += 4;
+            continue;
+        }
+        if (pos + BURST_HEADER + padded > len)
+            break;                      // the rest comes with the next write
+
+        // The payload is a big-endian bitstream in little-endian words; an
+        // odd length still occupies a whole last word.
+        const uint8_t *src = buf + pos + BURST_HEADER;
+        for (size_t n = 0; n < padded; n += 2) {
+            b->payload[n] = src[n + 1];
+            b->payload[n + 1] = src[n];
+        }
+        if (!cb(ctx, b->payload, length, b->offset + (int64_t)pos)) {
+            ok = false;
+            break;
+        }
+        pos += BURST_HEADER + padded;
+    }
+
+    // Carrier padding cannot begin a burst: do not keep it for the next write.
+    while (ok && pos + 2 <= len && !buf[pos] && !buf[pos + 1])
+        pos += 2;
+
+    if (pos)
+        memmove(b->pending, b->pending + pos, len - pos);
+    b->len = len - pos;
+    b->offset += (int64_t)pos;
+    return ok;
+}
+// --- end bursts
+
+// Access units mpv may queue here on top of what the pipeline has pulled.
+#define QUEUE_UNITS 6
+#define MAX_UNITS 32
+
+// Waits on the player thread.
+#define TOPOLOGY_TIMEOUT_MS 2000
+#define CLOSE_TIMEOUT_MS 1000
+
+// How long the session may take to report a start, how long the clock may
+// stand still while the renderer has all it asked for, and how long it stands
+// still before a pipeline without data counts as played out.
+#define START_TIMEOUT_MS 3000
+#define STALL_TIMEOUT_MS 3000
+#define DRY_MS 40
+
+static const GUID null_guid = {0};
+
+// MEStreamSinkFormatInvalidated, which not every mingw-w64 has.
+#define ME_STREAM_SINK_FORMAT_INVALIDATED 802
+
+// Not in every mingw-w64: MFAudioFormat_Float_SpatialObjects and
+// MF_MT_SPATIAL_AUDIO_MAX_DYNAMIC_OBJECTS.
+static const GUID spatial_objects_subtype = {
+    0xfa39cd94, 0xbc64, 0x4ab1, {0x9b, 0x71, 0xdc, 0xd0, 0x9d, 0x5a, 0x7e, 0x7a}};
+static const GUID spatial_max_dynamic_objects = {
+    0xdcfba24a, 0x2609, 0x4240, {0xa7, 0x21, 0x3f, 0xae, 0xa7, 0x6a, 0x4d, 0xf9}};
+
+// mf.dll and mfplat.dll are missing on Windows editions that come without the
+// media features (the "N" editions), and a player that imports them does not
+// start there at all. So they are loaded when this output is first asked for,
+// and stay loaded: the session may still call into the source after uninit.
+static struct mf_dll {
+    HRESULT (WINAPI *MFStartup)(ULONG, DWORD);
+    HRESULT (WINAPI *MFShutdown)(void);
+    HRESULT (WINAPI *MFCreateEventQueue)(IMFMediaEventQueue **);
+    HRESULT (WINAPI *MFCreateMediaType)(IMFMediaType **);
+    HRESULT (WINAPI *MFCreateMemoryBuffer)(DWORD, IMFMediaBuffer **);
+    HRESULT (WINAPI *MFCreateSample)(IMFSample **);
+    HRESULT (WINAPI *MFCreateStreamDescriptor)(DWORD, DWORD, IMFMediaType **,
+                                               IMFStreamDescriptor **);
+    HRESULT (WINAPI *MFCreatePresentationDescriptor)(DWORD,
+                                                     IMFStreamDescriptor **,
+                                                     IMFPresentationDescriptor **);
+    HRESULT (WINAPI *MFCreateMediaSession)(IMFAttributes *, IMFMediaSession **);
+    HRESULT (WINAPI *MFCreateTopology)(IMFTopology **);
+    HRESULT (WINAPI *MFCreateTopologyNode)(MF_TOPOLOGY_TYPE, IMFTopologyNode **);
+    HRESULT (WINAPI *MFCreateAudioRendererActivate)(IMFActivate **);
+    HRESULT (WINAPI *MFGetService)(IUnknown *, REFGUID, REFIID, LPVOID *);
+    bool loaded;
+} mf;
+static mp_once mf_once = MP_STATIC_ONCE_INITIALIZER;
+
+static void load_mf(void)
+{
+    HMODULE plat = LoadLibraryExW(L"mfplat.dll", NULL,
+                                  LOAD_LIBRARY_SEARCH_SYSTEM32);
+    HMODULE core = LoadLibraryExW(L"mf.dll", NULL,
+                                  LOAD_LIBRARY_SEARCH_SYSTEM32);
+    if (!plat || !core)
+        return;
+#define MF_GET(dll, name) (mf.name = (void *)GetProcAddress(dll, #name))
+    mf.loaded = MF_GET(plat, MFStartup) &&
+                MF_GET(plat, MFShutdown) &&
+                MF_GET(plat, MFCreateEventQueue) &&
+                MF_GET(plat, MFCreateMediaType) &&
+                MF_GET(plat, MFCreateMemoryBuffer) &&
+                MF_GET(plat, MFCreateSample) &&
+                MF_GET(plat, MFCreateStreamDescriptor) &&
+                MF_GET(plat, MFCreatePresentationDescriptor) &&
+                MF_GET(core, MFCreateMediaSession) &&
+                MF_GET(core, MFCreateTopology) &&
+                MF_GET(core, MFCreateTopologyNode) &&
+                MF_GET(core, MFCreateAudioRendererActivate) &&
+                MF_GET(core, MFGetService);
+#undef MF_GET
+}
+
+struct unit {
+    uint8_t *data;
+    DWORD size;
+    LONGLONG time;                      // 100 ns, from the last reset
+};
+
+enum source_state {
+    SOURCE_STOPPED,
+    SOURCE_STARTED,
+    SOURCE_PAUSED,
+    SOURCE_SHUTDOWN,
+};
+
+// Everything Media Foundation and the device notifications call into. It can
+// outlive the AO, since the session releases its references from its own
+// threads.
+struct mf_core {
+    IMFMediaSource source;
+    IMFMediaStream stream;
+    IMFAsyncCallback callback;
+    IMMNotificationClient notify;
+    LONG refs;
+
+    SRWLOCK lock;
+    CONDITION_VARIABLE changed;
+    struct ao *ao;                      // NULL once the AO is gone
+
+    IMFMediaEventQueue *source_events;
+    IMFMediaEventQueue *stream_events;
+    IMFPresentationDescriptor *pd;
+    IMFStreamDescriptor *sd;
+    IMFMediaSession *session;
+    wchar_t *endpoint;                  // the device played on
+    bool follow_default;                // no device was asked for
+
+    enum source_state state;
+    bool flushing;                      // reset(): nothing goes out before the next Start
+    int stops_pending;                  // Stops reset() sent that the source has not seen
+    bool announced;
+    bool discontinuity;
+    LONGLONG unit_duration;
+    struct unit units[MAX_UNITS];
+    int unit_pos, num_units;
+    IUnknown **tokens;                  // RequestSample calls not answered yet
+    int num_tokens, tokens_cap;
+
+    bool live;                          // init is done: problems go to the player
+    bool played;                        // the clock ran: the stream worked here
+    bool topology_ready, failed, reload_requested;
+    bool events_done;                   // no session event will come any more
+    HRESULT error;
+    unsigned started_events;            // MESessionStarted that succeeded
+};
+
+struct priv {
+    struct mf_core *core;
+    IMFMediaSession *session;
+    IMFPresentationClock *clock;
+    IMFAudioStreamVolume *volume;
+    IMMDeviceEnumerator *enumerator;
+    bool notify_registered;
+    bool com_init, mf_started;
+
+    struct bursts bursts;
+    int64_t written;                    // frames since the last reset
+    bool warned_type;
+
+    bool started, paused;
+    bool session_running;               // Start was sent and no Stop since
+    unsigned starts_ok;                 // Start calls the session accepted
+    unsigned restart_call;              // the one that restarted the clock at zero
+    int64_t restart_time;               // when it was made
+    LONGLONG last_clock;
+    int64_t last_clock_change;
+    bool clock_moved;                   // since the clock restarted at zero
+    int64_t last_state_time;            // the previous get_state()
+    float gain;
+    bool volume_set, warned_gain, warned_volume;
+
+    bool opt_require_spatial;
+};
+
+#define CORE_OF(iface, member) \
+    ((struct mf_core *)((char *)(iface) - offsetof(struct mf_core, member)))
+
+static void drop_tokens(struct mf_core *c)
+{
+    for (int n = 0; n < c->num_tokens; n++) {
+        if (c->tokens[n])
+            IUnknown_Release(c->tokens[n]);
+    }
+    c->num_tokens = 0;
+}
+
+static bool push_token(struct mf_core *c, IUnknown *token)
+{
+    if (c->num_tokens == c->tokens_cap) {
+        int cap = c->tokens_cap ? c->tokens_cap * 2 : 16;
+        IUnknown **grown = realloc(c->tokens, cap * sizeof(*grown));
+        if (!grown)
+            return false;
+        c->tokens = grown;
+        c->tokens_cap = cap;
+    }
+    if (token)
+        IUnknown_AddRef(token);
+    c->tokens[c->num_tokens++] = token;
+    return true;
+}
+
+static void drop_units(struct mf_core *c)
+{
+    for (int n = 0; n < c->num_units; n++)
+        free(c->units[(c->unit_pos + n) % MAX_UNITS].data);
+    c->unit_pos = c->num_units = 0;
+}
+
+static ULONG core_addref(struct mf_core *c)
+{
+    return InterlockedIncrement(&c->refs);
+}
+
+static ULONG core_release(struct mf_core *c)
+{
+    ULONG refs = InterlockedDecrement(&c->refs);
+    if (!refs) {
+        drop_tokens(c);
+        drop_units(c);
+        free(c->tokens);
+        free(c->endpoint);
+        if (c->source_events)
+            IMFMediaEventQueue_Release(c->source_events);
+        if (c->stream_events)
+            IMFMediaEventQueue_Release(c->stream_events);
+        if (c->pd)
+            IMFPresentationDescriptor_Release(c->pd);
+        if (c->sd)
+            IMFStreamDescriptor_Release(c->sd);
+        free(c);
+    }
+    return refs;
+}
+
+// The stream cannot go on: the player decodes the track instead. Before init
+// is done, init() sees the flag and fails. Called with the lock held.
+static void fail_locked(struct mf_core *c, const char *what, HRESULT hr)
+{
+    if (c->failed)
+        return;
+    c->failed = true;
+    c->error = hr;
+    if (c->ao && c->live) {
+        MP_WARN(c->ao, "%s: %s. Decoding the track instead.\n", what,
+                mp_HRESULT_to_str(hr));
+        ao_request_pcm_fallback(c->ao);
+        ao_wakeup(c->ao);
+    }
+}
+
+// The device changed under the session: reopen, which tries passthrough
+// again on whatever device is current. Called with the lock held.
+static void reload_locked(struct mf_core *c, const char *why)
+{
+    if (c->reload_requested || c->failed || !c->ao || !c->live)
+        return;
+    c->reload_requested = true;
+    MP_VERBOSE(c->ao, "%s: reopening the output.\n", why);
+    ao_request_reload(c->ao);
+}
+
+// The renderer reports trouble with its device. Once the stream has played,
+// that is a change to follow; before, reopening would meet the same trouble
+// again and again, so the track is decoded instead. Called with the lock held.
+static void device_trouble_locked(struct mf_core *c, const char *why)
+{
+    if (c->played) {
+        reload_locked(c, why);
+    } else {
+        fail_locked(c, why, MF_E_AUDIO_PLAYBACK_DEVICE_INVALIDATED);
+    }
+}
+
+static void fail(struct ao *ao, const char *what, HRESULT hr)
+{
+    struct mf_core *c = ((struct priv *)ao->priv)->core;
+    AcquireSRWLockExclusive(&c->lock);
+    fail_locked(c, what, hr);
+    ReleaseSRWLockExclusive(&c->lock);
+}
+
+// Answer the pipeline's sample requests with the queued access units.
+// Called with the lock held.
+static void deliver(struct mf_core *c)
+{
+    while (c->num_tokens && c->num_units && c->state == SOURCE_STARTED &&
+           !c->flushing && !c->failed)
+    {
+        struct unit *u = &c->units[c->unit_pos];
+        IMFSample *sample = NULL;
+        IMFMediaBuffer *buffer = NULL;
+        BYTE *dst = NULL;
+        HRESULT hr = mf.MFCreateSample(&sample);
+        if (SUCCEEDED(hr))
+            hr = mf.MFCreateMemoryBuffer(u->size, &buffer);
+        if (SUCCEEDED(hr))
+            hr = IMFMediaBuffer_Lock(buffer, &dst, NULL, NULL);
+        if (SUCCEEDED(hr)) {
+            memcpy(dst, u->data, u->size);
+            IMFMediaBuffer_Unlock(buffer);
+            IMFMediaBuffer_SetCurrentLength(buffer, u->size);
+            IMFSample_AddBuffer(sample, buffer);
+            IMFSample_SetSampleTime(sample, u->time);
+            IMFSample_SetSampleDuration(sample, c->unit_duration);
+            IMFSample_SetUINT32(sample, &MFSampleExtension_CleanPoint, 1);
+            if (c->discontinuity)
+                IMFSample_SetUINT32(sample, &MFSampleExtension_Discontinuity, 1);
+            c->discontinuity = false;
+            IUnknown *token = c->tokens[0];
+            if (token) {
+                IMFSample_SetUnknown(sample, &MFSampleExtension_Token, token);
+                IUnknown_Release(token);
+            }
+            c->num_tokens--;
+            memmove(c->tokens, c->tokens + 1, c->num_tokens * sizeof(c->tokens[0]));
+            hr = IMFMediaEventQueue_QueueEventParamUnk(c->stream_events, MEMediaSample,
+                                                       &null_guid, S_OK,
+                                                       (IUnknown *)sample);
+        }
+        if (buffer)
+            IMFMediaBuffer_Release(buffer);
+        if (sample)
+            IMFSample_Release(sample);
+        if (FAILED(hr)) {
+            if (hr != MF_E_SHUTDOWN)
+                fail_locked(c, "Could not hand the decoder a sample", hr);
+            break;
+        }
+        free(u->data);
+        u->data = NULL;
+        c->unit_pos = (c->unit_pos + 1) % MAX_UNITS;
+        c->num_units--;
+    }
+}
