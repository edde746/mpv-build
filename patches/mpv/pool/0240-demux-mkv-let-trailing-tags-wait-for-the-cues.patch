+// Whether every level 1 element stored after the clusters can wait until a
+// seek needs the index. Reading them on opening means leaving the clusters for
+// the end of the file and coming back, which over HTTP is two more connections
+// before the first packet. The Cues can always wait. With defer_tags the Tags
+// wait with them: nothing needs them to start playback, and they are read on
+// the way when the Cues are (read_deferred_cues()). Anything else found there
+// (chapters, attachments, another seek head) is read on opening.
+static bool trailing_headers_can_wait(struct mkv_demuxer *mkv_d, bool defer_tags)
+{
+    int waiting = 0;
+    for (int n = 0; n < mkv_d->num_headers; n++) {
+        struct header_elem *elem = &mkv_d->headers[n];
+        if (elem->parsed)
+            continue;
+        if (elem->id != MATROSKA_ID_CUES &&
+            !(defer_tags && elem->id == MATROSKA_ID_TAGS))
+            return false;
+        waiting++;
+    }
+    return waiting > 0;
+}
+
 static void read_deferred_cues(demuxer_t *demuxer)
 {
     mkv_demuxer_t *mkv_d = demuxer->priv;
@@ -1508,12 +1563,107 @@ static void read_deferred_cues(demuxer_t *demuxer)
     if (mkv_d->index_complete || demuxer->opts->index_mode != 1)
         return;
 
+    // Tags that waited are read only on the way to Cues that are read anyway:
+    // mkvmerge writes one right after the other, so one read returns both.
+    bool with_tags = false;
     for (int n = 0; n < mkv_d->num_headers; n++) {
         struct header_elem *elem = &mkv_d->headers[n];
+        if (elem->id == MATROSKA_ID_CUES && !elem->parsed)
+            with_tags = mkv_d->tags_deferred;
+    }
+    mkv_d->tags_deferred = false;
 
-        if (elem->id == MATROSKA_ID_CUES)
-            read_deferred_element(demuxer, elem);
+    // In file order, to read the end of the file in one piece.
+    while (1) {
+        struct header_elem *lowest = NULL;
+        for (int n = 0; n < mkv_d->num_headers; n++) {
+            struct header_elem *elem = &mkv_d->headers[n];
+            if (elem->parsed)
+                continue;
+            if (elem->id != MATROSKA_ID_CUES &&
+                !(with_tags && elem->id == MATROSKA_ID_TAGS))
+                continue;
+            if (!lowest || elem->pos < lowest->pos)
+                lowest = elem;
+        }
+        if (!lowest)
+            break;
+        read_deferred_element(demuxer, lowest);
     }
+
+    if (with_tags)
+        process_tags(demuxer);
+}
+
+// Read the level 1 elements stored after the clusters (i.e. the ones that
+// require seeking), or leave them to read_deferred_cues() if all can wait.
+// Note: reading might increase ->num_headers.
+//       Likewise, ->headers might be reallocated.
+static int read_trailing_headers(struct demuxer *demuxer, bool want_replaygain)
+{
+    struct mkv_demuxer *mkv_d = demuxer->priv;
+    stream_t *s = demuxer->stream;
+    int64_t end = stream_get_size(s);
+
+    bool cues_waiting = false, tags_waiting = false;
+    for (int n = 0; n < mkv_d->num_headers; n++) {
+        struct header_elem *elem = &mkv_d->headers[n];
+        if (elem->parsed)
+            continue;
+        // Warn against incomplete files and skip headers outside of range.
+        if (elem->pos >= end || !s->seekable) {
+            elem->parsed = true; // don't bother if file is incomplete
+            if (end < 0 || !s->seekable) {
+                MP_WARN(demuxer, "Stream is not seekable or unknown size, "
+                        "not reading mkv metadata at end of file.\n");
+            } else if (!mkv_d->eof_warning &&
+                       !(mkv_d->probably_webm_dash_init &&  elem->pos == end))
+            {
+                MP_WARN(demuxer, "mkv metadata beyond end of file - incomplete "
+                        "file?\n");
+                mkv_d->eof_warning = true;
+            }
+            continue;
+        }
+        cues_waiting |= elem->id == MATROSKA_ID_CUES;
+        tags_waiting |= elem->id == MATROSKA_ID_TAGS;
+    }
+
+    // Tags may wait where leaving the clusters is expensive, unless replaygain
+    // needs their values before the first sample plays.
+    bool defer_tags = tags_waiting && mkv_d->opts->defer_tags &&
+                      demuxer->is_network && !want_replaygain;
+
+    if (trailing_headers_can_wait(mkv_d, defer_tags)) {
+        // Read them when they are needed, to avoid seeking on opening.
+        MP_VERBOSE(demuxer, "Deferring reading %s%s%s.\n",
+                   cues_waiting ? "cues" : "",
+                   cues_waiting && defer_tags ? " and " : "",
+                   defer_tags ? "tags" : "");
+        mkv_d->tags_deferred = defer_tags;
+        return 0;
+    }
+
+    // Read them by ascending position to reduce unneeded seeks.
+    // O(n^2) because the number of elements is very low.
+    while (1) {
+        struct header_elem *lowest = NULL;
+        for (int n = 0; n < mkv_d->num_headers; n++) {
+            struct header_elem *elem = &mkv_d->headers[n];
+            if (elem->parsed)
+                continue;
+            if (!lowest || elem->pos < lowest->pos)
+                lowest = elem;
+        }
+
+        if (!lowest)
+            break;
+
+        if (read_deferred_element(demuxer, lowest) < 0)
+            return -1;
+    }
+
+    return 0;
 }
 
