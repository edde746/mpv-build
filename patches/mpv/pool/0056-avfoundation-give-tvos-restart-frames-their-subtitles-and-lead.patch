@@ -1257,6 +1279,34 @@ static int64_t avf_host_refresh_stamp_ns(int64_t target_ns, int64_t vsync_ns,
         n++;
     return base_ns + n * period_ns;
 }
+
+// The first frames after the start, a seek or a resume are due at once: vo.c
+// flips them as soon as they are decoded, short of the queue lead. A sample
+// that reaches the layers less than about three refreshes before the refresh
+// its stamp asks for (the first vsync at or after it) can show a refresh
+// late in the video layer and not in the OSD layer: at a resume the first
+// frame's subtitle showed a refresh before its picture (plezy#3073). For
+// the first AVF_RESTART_FRAMES timed frames from then, a stamp whose refresh
+// comes less than 3.5 refreshes after now moves on by whole refreshes until
+// it does not; the frames after it then follow it, by avf_host_present_ns().
+// Steady playback reaches the layers at least 3.6 refreshes ahead. A period
+// of 0 (no vsync seen) leaves the stamp as it is.
+#define AVF_RESTART_FRAMES 8
+
+static int64_t avf_host_restart_stamp_ns(int64_t stamp_ns, int64_t now_ns,
+                                         int64_t vsync_ns, int64_t period_ns)
+{
+    if (period_ns <= 0)
+        return stamp_ns;
+    int64_t rest_ns = (stamp_ns - vsync_ns) % period_ns;
+    if (rest_ns < 0)
+        rest_ns += period_ns;
+    int64_t refresh_ns = rest_ns ? stamp_ns + period_ns - rest_ns : stamp_ns;
+    int64_t min_ns = now_ns + period_ns * 7 / 2;
+    if (refresh_ns >= min_ns)
+        return stamp_ns;
+    return stamp_ns + (min_ns - refresh_ns + period_ns - 1) / period_ns * period_ns;
+}
 // --- end avf host refresh stamp ---
 
