+
+// A restart frame, which may have waited for its subtitles, gets its
+// refreshes back (avf_host_restart_stamp_ns), once and as late as it can:
+// when its subtitle change is filed with its stamp, or else just before its
+// samples are made, after the subtitles are drawn.
+static void restart_stamp(struct priv *p)
+{
+    if (!p->next_restart)
+        return;
+    p->next_restart = false;
+    p->next_present_host_ns = avf_host_restart_stamp_ns(
+        p->next_present_host_ns, mp_time_ns(),
+        atomic_load(&p->refresh_vsync_ns),
+        atomic_load(&p->refresh_period_ns));
+    p->last_host_present_ns = p->next_present_host_ns;
+}
