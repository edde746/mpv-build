+    if (r->packer)
+        mp_ass_packer_release(r->packer);
     if (r->renderer)
         ass_renderer_done(r->renderer);
 }
@@ -886,6 +889,8 @@ static struct sub_bitmaps *get_bitmaps(struct sd *sd, struct mp_osd_res dim,
     // Keep those masks rather than flattening colors before that adjustment.
     if (!converted && (format & (1 << SUBBITMAP_LIBASS)) && mangle_colors(sd, NULL))
