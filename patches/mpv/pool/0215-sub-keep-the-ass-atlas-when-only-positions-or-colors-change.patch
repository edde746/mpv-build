diff --git a/sub/ass_mp.c b/sub/ass_mp.c
index b5eebf9..31a3ac7 100644
--- a/sub/ass_mp.c
+++ b/sub/ass_mp.c
@@ -200,6 +200,12 @@ static void draw_ass_rgba(unsigned char *src, int src_w, int src_h,
     }
 }
 
+// A part's libass bitmap, as packed into the current atlas.
+struct packed_src {
+    const unsigned char *bitmap;
+    int w, h, stride;
+};
+
 struct mp_ass_packer {
     struct sub_bitmap *cached_parts; // only for the array memory
     struct mp_image *cached_img;
@@ -207,17 +213,98 @@ struct mp_ass_packer {
     bool cached_subs_valid;
     struct sub_bitmap rgba_imgs[MP_SUB_BB_LIST_MAX];
     struct bitmap_packer *packer;
+    // Spare atlases: earlier cached_img, still referenced by consumers or
+    // free again. A free one is reused instead of allocating, which on
+    // Android means a fresh mmap, page faults on every page of the copy, and
+    // a munmap when the last consumer lets go, per changed frame.
+    int pool_max;
+    struct mp_image *spare[MP_ASS_PACKER_POOL_MAX];
+    int num_spare;
+    // Atlas reuse (single image list only): the list packed last, held with
+    // ass_frame_ref so its bitmaps stay allocated and pointer equality means
+    // pixel equality, and its parts' bitmaps in cached_parts order.
+    bool reuse;
+    ASS_Image *held;
+    struct packed_src *src;
+    int num_src;            // -1: cached_subs isn't a mask atlas of src
 };
 
-// Free with talloc_free().
+// Identifies an atlas' pixels across sub_bitmaps copies; 0 is never used.
+static _Atomic uint64_t next_atlas_id;
+
+// Free with talloc_free(), after mp_ass_packer_release().
 struct mp_ass_packer *mp_ass_packer_alloc(void *ta_parent)
 {
     struct mp_ass_packer *p = talloc_zero(ta_parent, struct mp_ass_packer);
     p->packer = talloc_zero(p, struct bitmap_packer);
     p->packer->padding = 1; // assume bilinear sampling
+    p->num_src = -1;
     return p;
 }
 
+void mp_ass_packer_configure(struct mp_ass_packer *p, bool reuse, int pool)
+{
+    if (!reuse)
+        mp_ass_packer_release(p);
+    p->reuse = reuse;
+    p->pool_max = MPCLAMP(pool, 0, MP_ASS_PACKER_POOL_MAX);
+    while (p->num_spare > p->pool_max)
+        talloc_free(p->spare[--p->num_spare]);
+}
+
+void mp_ass_packer_release(struct mp_ass_packer *p)
+{
+    ass_frame_unref(p->held);
+    p->held = NULL;
+    p->num_src = -1;
+}
+
+static bool atlas_fits(struct mp_image *img, int imgfmt, int w, int h)
+{
+    return img && img->imgfmt == imgfmt && img->w >= w && img->h >= h &&
+           mp_image_is_writeable(img);
+}
+
+// Retire cached_img into the spares; the oldest spare goes when full.
+static void retire_atlas(struct mp_ass_packer *p)
+{
+    if (!p->cached_img)
+        return;
+    if (!p->pool_max) {
+        talloc_free(p->cached_img);
+    } else {
+        if (p->num_spare == p->pool_max) {
+            talloc_free(p->spare[0]);
+            memmove(&p->spare[0], &p->spare[1], --p->num_spare * sizeof(p->spare[0]));
+        }
+        p->spare[p->num_spare++] = p->cached_img;
+    }
+    p->cached_img = NULL;
+}
+
+// An atlas for imgfmt that holds w x h: the current one if nothing else
+// references it, else a free spare, else a new one of the packer's size.
+static struct mp_image *take_atlas(struct mp_ass_packer *p, int imgfmt, int w, int h)
+{
+    if (atlas_fits(p->cached_img, imgfmt, w, h))
+        return p->cached_img;
+    retire_atlas(p);
+    int best = -1;
+    for (int n = p->num_spare - 1; n >= 0 && best < 0; n--) {
+        if (atlas_fits(p->spare[n], imgfmt, w, h))
+            best = n;
+    }
+    if (best >= 0) {
+        p->cached_img = p->spare[best];
+        memmove(&p->spare[best], &p->spare[best + 1], (--p->num_spare - best) * sizeof(p->spare[0]));
+    } else {
+        p->cached_img = mp_image_alloc(imgfmt, p->packer->w, p->packer->h);
+        if (p->cached_img)
+            talloc_steal(p, p->cached_img);
+    }
+    return p->cached_img;
+}
+
 static bool pack(struct mp_ass_packer *p, struct sub_bitmaps *res, int imgfmt)
 {
     packer_set_size(p->packer, res->num_parts);
@@ -236,23 +323,15 @@ static bool pack(struct mp_ass_packer *p, struct sub_bitmaps *res, int imgfmt)
 
     // A consumer still holding the previous atlas (a VO keeps frames in
     // flight) makes it read-only. Nothing reads an atlas outside the parts
-    // packed into it, so start a fresh one rather than copy tens of
-    // megabytes to unshare it.
-    if (!p->cached_img || p->cached_img->w < res->packed_w ||
-                          p->cached_img->h < res->packed_h ||
-                          p->cached_img->imgfmt != imgfmt ||
-                          !mp_image_is_writeable(p->cached_img))
-    {
-        talloc_free(p->cached_img);
-        p->cached_img = mp_image_alloc(imgfmt, p->packer->w, p->packer->h);
-        if (!p->cached_img) {
-            packer_reset(p->packer);
-            return false;
-        }
-        talloc_steal(p, p->cached_img);
+    // packed into it, so start a fresh one (or a free spare) rather than
+    // copy tens of megabytes to unshare it.
+    if (!take_atlas(p, imgfmt, res->packed_w, res->packed_h)) {
+        packer_reset(p->packer);
+        return false;
     }
 
     res->packed = p->cached_img;
+    res->atlas_id = ++next_atlas_id;
 
     for (int n = 0; n < res->num_parts; n++) {
         struct sub_bitmap *b = &res->parts[n];
@@ -393,15 +472,43 @@ static bool pack_rgba(struct mp_ass_packer *p, struct sub_bitmaps *res)
     return true;
 }
 
-// Pack the contents of image_lists[0] to image_lists[num_image_lists-1] into
-// a single image, and make *out point to it. *out is completely overwritten.
-// If libass reported any change, image_lists_changed must be set (it then
-// repacks all images). preferred_osd_format is a bitmask of supported
-// (1 << SUBBITMAP_*) formats. Prefer masks unless heavy overlap makes their
-// upload substantially larger than a composited image.
-void mp_ass_packer_pack(struct mp_ass_packer *p, ASS_Image **image_lists,
-                        int num_image_lists, bool image_lists_changed, bool video_color_space,
-                        int preferred_osd_format, struct sub_bitmaps *out)
+// Whether res (just filled from the image list) draws exactly the bitmaps
+// packed into the current mask atlas, in the same order: then only positions
+// and colors moved, and the atlas holds every part already. Sound because
+// the previous list is held: none of its bitmaps can have been freed and
+// their memory reused by a bitmap of this frame.
+static bool reuse_atlas(struct mp_ass_packer *p, struct sub_bitmaps *res,
+                        bool cached_valid)
+{
+    if (!p->reuse || p->num_src != res->num_parts || !cached_valid ||
+        p->cached_subs.format != SUBBITMAP_LIBASS ||
+        p->cached_subs.packed != p->cached_img || !p->cached_img)
+        return false;
+    for (int n = 0; n < res->num_parts; n++) {
+        const struct sub_bitmap *b = &res->parts[n];
+        const struct packed_src *s = &p->src[n];
+        if (b->bitmap != s->bitmap || b->w != s->w || b->h != s->h ||
+            b->stride != s->stride)
+            return false;
+    }
+    uint8_t *base = p->cached_img->planes[0];
+    int stride = p->cached_img->stride[0];
+    for (int n = 0; n < res->num_parts; n++) {
+        struct sub_bitmap *b = &res->parts[n];
+        b->bitmap = base + b->src_y * stride + b->src_x;
+        b->stride = stride;
+    }
+    res->packed = p->cached_img;
+    res->packed_w = p->cached_subs.packed_w;
+    res->packed_h = p->cached_subs.packed_h;
+    res->atlas_id = p->cached_subs.atlas_id;
+    return true;
+}
+
+static void pack_lists(struct mp_ass_packer *p, ASS_Image **image_lists,
+                       int num_image_lists, bool image_lists_changed,
+                       bool video_color_space, int preferred_osd_format,
+                       struct sub_bitmaps *out)
 {
     if (p->cached_subs_valid && !image_lists_changed &&
         (preferred_osd_format & (1 << p->cached_subs.format)))
@@ -411,6 +518,7 @@ void mp_ass_packer_pack(struct mp_ass_packer *p, ASS_Image **image_lists,
     }
 
     *out = (struct sub_bitmaps){.change_id = 1};
+    bool was_valid = p->cached_subs_valid;
     p->cached_subs_valid = false;
 
     struct sub_bitmaps res = {
@@ -420,6 +528,8 @@ void mp_ass_packer_pack(struct mp_ass_packer *p, ASS_Image **image_lists,
         .video_color_space = video_color_space,
     };
 
+    // Parts keep their slot's src_x/src_y from the last pack: reuse_atlas
+    // relies on part n being bitmap n of that pack.
     for (int n = 0; n < num_image_lists; n++) {
         for (struct ass_image *img = image_lists[n]; img; img = img->next) {
             if (img->w == 0 || img->h == 0)
@@ -458,9 +568,22 @@ void mp_ass_packer_pack(struct mp_ass_packer *p, ASS_Image **image_lists,
 
     bool r = false;
     if (format == SUBBITMAP_BGRA) {
+        p->num_src = -1;
         r = pack_rgba(p, &res);
+    } else if (reuse_atlas(p, &res, was_valid)) {
+        r = true;
     } else {
+        p->num_src = -1;
+        if (p->reuse) {
+            MP_TARRAY_GROW(p, p->src, res.num_parts);
+            for (int n = 0; n < res.num_parts; n++) {
+                const struct sub_bitmap *b = &res.parts[n];
+                p->src[n] = (struct packed_src){b->bitmap, b->w, b->h, b->stride};
+            }
+        }
         r = pack_libass(p, &res);
+        if (r && p->reuse)
+            p->num_src = res.num_parts;
     }
 
     if (!r)
@@ -472,6 +595,33 @@ void mp_ass_packer_pack(struct mp_ass_packer *p, ASS_Image **image_lists,
     p->cached_subs_valid = true;
 }
 
+// Pack the contents of image_lists[0] to image_lists[num_image_lists-1] into
+// a single image, and make *out point to it. *out is completely overwritten.
+// If libass reported any change, image_lists_changed must be set (it then
+// repacks all images). preferred_osd_format is a bitmask of supported
+// (1 << SUBBITMAP_*) formats. Prefer masks unless heavy overlap makes their
+// upload substantially larger than a composited image.
+// With reuse configured and a single list, a frame that draws the previous
+// frame's bitmaps at other positions or in other colors keeps that atlas
+// (and its atlas_id) instead of packing again.
+void mp_ass_packer_pack(struct mp_ass_packer *p, ASS_Image **image_lists,
+                        int num_image_lists, bool image_lists_changed, bool video_color_space,
+                        int preferred_osd_format, struct sub_bitmaps *out)
+{
+    // Keep the previous list until the comparison is done.
+    ASS_Image *prev = p->held;
+    p->held = NULL;
+    if (p->reuse && num_image_lists == 1) {
+        p->held = image_lists[0];
+        ass_frame_ref(p->held);
+    } else {
+        p->num_src = -1;
+    }
+    pack_lists(p, image_lists, num_image_lists, image_lists_changed,
+               video_color_space, preferred_osd_format, out);
+    ass_frame_unref(prev);
+}
+
 // Set *out_rc to [x0, y0, x1, y1] of the graphical bounding box in script
 // coordinates.
 // Set it to [inf, inf, -inf, -inf] if empty.
diff --git a/sub/ass_mp.h b/sub/ass_mp.h
index a1f02ba..da988d5 100644
--- a/sub/ass_mp.h
+++ b/sub/ass_mp.h
@@ -56,6 +56,15 @@ ASS_Library *mp_ass_init(struct mpv_global *global,
 struct sub_bitmaps;
 struct mp_ass_packer;
 struct mp_ass_packer *mp_ass_packer_alloc(void *ta_parent);
+// At most this many spare atlases (mp_ass_packer_configure's pool).
+#define MP_ASS_PACKER_POOL_MAX 8
+// reuse: keep the atlas for a frame whose bitmaps are the previous frame's
+// (holds a reference on the last packed ASS_Image list; call
+// mp_ass_packer_release before the renderer's ass_renderer_done). pool:
+// how many earlier atlases to keep for reuse once consumers let go.
+void mp_ass_packer_configure(struct mp_ass_packer *p, bool reuse, int pool);
+// Drop the held image list. Required before ass_renderer_done.
+void mp_ass_packer_release(struct mp_ass_packer *p);
 // preferred_osd_format is a bitmask of supported (1 << SUBBITMAP_*) formats.
 void mp_ass_packer_pack(struct mp_ass_packer *p, ASS_Image **image_lists,
                         int num_image_lists, bool changed, bool video_color_space,
