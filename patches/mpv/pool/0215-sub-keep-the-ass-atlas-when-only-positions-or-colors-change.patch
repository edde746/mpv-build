index 30feacd..0fcded7 100644
--- a/sub/osd.h
+++ b/sub/osd.h
@@ -73,6 +73,12 @@ struct sub_bitmaps {
     // box. (The origin of the box is at (0,0).)
     int packed_w, packed_h;
 
+    // Nonzero: identifies the pixels of packed. Items with the same
+    // atlas_id have the same atlas contents (parts may sit at other screen
+    // positions or have other colors: change_id still says that), so a VO
+    // may keep an uploaded copy. 0: unknown, key on change_id.
+    uint64_t atlas_id;
+
     int change_id;  // Incremented on each change (0 is never used)
 
     bool video_color_space; // True if the bitmap is in video color space
