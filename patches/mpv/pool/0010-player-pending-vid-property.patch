--- a/player/command.c
+++ b/player/command.c
@@ -2314,6 +2314,38 @@ static int mp_property_hwdec_current(void *ctx, struct m_property *prop,
     return m_property_strdup_ro(action, arg, current);
 }
 
+// The video track playback will select, readable before it is selected.
+// Inside on_preloaded the track list is complete but no track is selected
+// yet (vid still answers with the option value, "auto" as often as not), so
+// a hook that must decide per-file decode routing before the decoder exists
+// cannot tell which track the routing is for. This runs the same selection
+// the player runs right after the hook, with no side effects. Once playback
+// is initialized it reports the selected track. "no" when none will be.
+static int mp_property_pending_vid(void *ctx, struct m_property *prop,
+                                   int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    struct MPOpts *opts = mpctx->opts;
+    struct track *track;
+
+    if (mpctx->playback_initialized) {
+        track = mpctx->current_track[0][STREAM_VIDEO];
+    } else {
+        if (!mpctx->demuxer)
+            return M_PROPERTY_UNAVAILABLE;
+        track = NULL;
+        if (opts->stream_auto_sel && opts->stream_id[0][STREAM_VIDEO] != -2)
+            track = select_default_track(mpctx, 0, STREAM_VIDEO);
+    }
+
+    if (!track)
+        return m_property_strdup_ro(action, arg, "no");
+    char *id = talloc_asprintf(NULL, "%d", track->user_tid);
+    int r = m_property_strdup_ro(action, arg, id);
+    talloc_free(id);
+    return r;
+}
+
 static int mp_property_hwdec_interop(void *ctx, struct m_property *prop,
                                      int action, void *arg)
 {
