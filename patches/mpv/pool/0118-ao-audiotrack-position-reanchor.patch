+// The head counter advances at the track's own rate: codec frames on raw
+// passthrough tracks, carrier frames elsewhere.
+static int head_rate(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    return ao->samplerate / MPMAX(p->raw_rate_mult, 1);
+}
+
+// A backward jump in a 32-bit counter is either a wrap or a restart. A wrap
+// can only follow a read within reach of UINT32_MAX; anything else means the
+// counter restarted and the epoch anchor must be dropped so the new epoch
+// counts from zero. written_frames is never rewound: post-anchor writes are
+// genuinely buffered, and a restarted counter that keeps the buffer still
+// owes those frames.
+static bool head_jump_is_wrap(struct ao *ao, uint32_t last_raw)
+{
+    return last_raw >= UINT32_MAX - 2 * (uint32_t)head_rate(ao);
+}
