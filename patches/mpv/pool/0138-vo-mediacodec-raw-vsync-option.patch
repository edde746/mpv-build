Subject: [PATCH] vo_mediacodec: snap to every vsync sample as Media3 does with --vo-mediacodec-raw-vsync

On a MediaTek projector with motion processing on (Plezy #2654), 24 fps
on a 60 Hz mode stutters under mpv and not under ExoPlayer. On this
device the Choreographer's samples step by 0.4 to 0.5 of a vsync every
few seconds. Media3 snaps each release to the newest sample and to the
frame timelines' spacing as they come. mpv holds its own grid: a sample
more than a quarter of a vsync off it waits for the next resample, the
grid follows the median drift of recent resamples, and the display
mode's period stands unless the spacing is more than 2% off it. Neither
a fixed release offset nor the hold-back fixed the stutter, and nothing
has yet tested whether following the samples does.

--vo-mediacodec-raw-vsync=yes (default no) does what Media3 does: every
fresh sample is the grid at once, and the timelines' spacing is the
period whenever it is a plausible one. Freshness, cadence, hysteresis
and the release offset are unchanged. The filter keeps its state while
the option is on. The "Timed release" line says when raw vsync is on.

diff --git a/DOCS/man/vo.rst b/DOCS/man/vo.rst
index 40903a1..dedd42f 100644
--- a/DOCS/man/vo.rst
+++ b/DOCS/man/vo.rst
@@ -817,6 +817,16 @@ Available video output drivers are:
     platforms whose frame-rendered reports carry the latch (Tensor,
     MediaTek), the present trace's ``err`` moves with the offset.
 
+    ``--vo-mediacodec-raw-vsync=<yes|no>`` (default no) snaps releases to
+    every Choreographer vsync sample and to the frame timelines' spacing as
+    they come, as Media3 does. By default a sample more than a quarter of a
+    vsync off the grid is held back until a later 500 ms resample confirms
+    it, the grid follows the recent resamples' drift, and the display
+    mode's period stands unless the timelines' spacing is more than 2% off
+    it. Where the samples step by part of a vsync, the default keeps
+    releases on the old grid until a later resample confirms the step; this
+    option follows it at the next frame.
+
 ``mediacodec_embed`` (Android)
     Renders ``IMGFMT_MEDIACODEC`` frames directly to an ``android.view.Surface``.
     Requires ``--hwdec=mediacodec`` for hardware decoding, along with
diff --git a/video/out/vo_mediacodec.c b/video/out/vo_mediacodec.c
index b7c9d94..9ba2691 100644
--- a/video/out/vo_mediacodec.c
+++ b/video/out/vo_mediacodec.c
@@ -830,6 +830,7 @@ struct mediacodec_opts {
     int64_t osd_surface;
     bool present_trace;
     int release_offset;
+    bool raw_vsync;
 };
 
 #define OPT_BASE_STRUCT struct mediacodec_opts
@@ -843,6 +844,7 @@ static const struct m_sub_options mediacodec_conf = {
         {"vo-mediacodec-present-trace", OPT_BOOL(present_trace)},
         {"vo-mediacodec-release-offset", OPT_INT(release_offset),
             M_RANGE(10, 90)},
+        {"vo-mediacodec-raw-vsync", OPT_BOOL(raw_vsync)},
         {0},
     },
     .size = sizeof(struct mediacodec_opts),
@@ -920,6 +922,9 @@ struct priv {
     int64_t trace_vsync;
     // --vo-mediacodec-release-offset, in percent of a period.
     int release_offset;
+    // --vo-mediacodec-raw-vsync: the grid without the phase filter and the
+    // 2% rule (see snap_vsync_sample and update_queue_timing).
+    bool raw_vsync;
     // When the VO first saw the prepared and the current frame
     // (CLOCK_MONOTONIC), the core's hand-off stamps of the current frame
     // (struct vo_frame, mp_time_ns()), and how many releases
@@ -2917,6 +2922,7 @@ static int preinit(struct vo *vo)
     p->osd_vsync_delay = opts->osd_vsync_delay;
     p->present_trace = opts->present_trace;
     p->release_offset = opts->release_offset;
+    p->raw_vsync = opts->raw_vsync;
     m_config_cache_set_wakeup_cb(p->opts_cache, opts_wakeup, vo);
     vo->hwdec_devs = hwdec_devices_create();
     p->hwctx = (struct mp_hwdec_ctx){
@@ -3016,11 +3022,21 @@ static bool vsync_sample_is_fresh(struct priv *p, int64_t sample,
 // The vsync sample releases snap to now, 0 when none is fresh. Preparation
 // and release read it alike: the filter follows the samples, not the frames,
 // so the first read of a sample decides it for both.
+//
+// --vo-mediacodec-raw-vsync takes every fresh sample as it comes, as Media3
+// does. The MediaTek projector of Plezy #2654 steps its Choreographer samples
+// by part of a vsync every few seconds; under motion processing Media3, which
+// follows them, plays smoothly there and this filtered grid does not. The
+// option tells whether that is the difference. The filter keeps its state
+// meanwhile and, as after a pause, adopts a sample more than
+// MEDIACODEC_PHASE_MAX_GAP_NS past its last one.
 static int64_t snap_vsync_sample(struct priv *p, int64_t mono_now)
 {
     int64_t sample = p->queue_period > 0 ? read_vsync_sample(p) : 0;
     if (sample && !vsync_sample_is_fresh(p, sample, mono_now))
         sample = 0;
+    if (p->raw_vsync)
+        return sample;
     return mediacodec_phase_filter(&p->vsync_phase, sample, p->queue_period);
 }
 
@@ -3048,7 +3064,11 @@ static void update_queue_timing(struct vo *vo, double frame_duration)
 {
     struct priv *p = vo->priv;
     int64_t nominal = mode_period(vo);
-    int64_t period = mediacodec_grid_period(read_vsync_spacing(), nominal);
+    int64_t spacing = read_vsync_spacing();
+    // --vo-mediacodec-raw-vsync snaps with the timelines' spacing whenever it
+    // is a plausible period, as Media3 1.11 snaps with it whatever it is.
+    int64_t raw = p->raw_vsync ? plausible_period(spacing) : 0;
+    int64_t period = raw ? raw : mediacodec_grid_period(spacing, nominal);
 
     bool mode_changed = nominal != p->queue_mode;
     bool was_timelines = !mode_changed && p->queue_period != nominal;
@@ -3083,9 +3103,9 @@ static void update_queue_timing(struct vo *vo, double frame_duration)
     vo_set_queue_params(vo, offset, 1);
     if (period) {
         MP_VERBOSE(vo, "Timed release: %.3f Hz, prepare %.1f ms, codec %.1f ms "
-                       "ahead, offset %d%%.\n",
+                       "ahead, offset %d%%%s.\n",
                    1e9 / period, offset / 1e6, MEDIACODEC_CODEC_LEAD_NS / 1e6,
-                   p->release_offset);
+                   p->release_offset, p->raw_vsync ? ", raw vsync" : "");
     }
 }
 
@@ -3128,6 +3148,7 @@ static void update_opts(struct vo *vo)
     struct mediacodec_opts *opts = p->opts_cache->opts;
     p->present_trace = opts->present_trace;
     p->release_offset = opts->release_offset;
+    p->raw_vsync = opts->raw_vsync;
     struct mediacodec_geometry geometry;
     bool geometry_ok = mediacodec_geometry_parse(opts->video_rect, &geometry);
     if (!geometry_ok)
