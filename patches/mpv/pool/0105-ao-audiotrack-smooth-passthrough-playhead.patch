+static void AudioTrack_resetPlayheadSmoothing(struct priv *p)
+{
+    p->smooth_count = 0;
+    p->smooth_next = 0;
+    p->smooth_sampled = 0;
+    p->smooth_last_head = 0;
+    p->smooth_head = 0;
+}
+
+// Passthrough tracks have no AudioTimestamp here, so their only clock is
+// AudioTrack.getPlaybackHeadPosition(), which on a direct or offload track
+// is the HAL's render position and advances in HAL-period steps: 8192
+// frames at 192 kHz (42.7 ms) for the HBR IEC 61937 output on the Shield,
+// longer than a 24p frame. The AO thread samples it once per chunk, so two
+// consecutive samples can sit anywhere within a period of the true position,
+// and the step lands unfiltered in the end time the core schedules video
+// against: a forward snap larger than a frame's remaining lead makes vo.c
+// drop that frame (edde746/plezy#2202). Estimate the position the way
+// media3's AudioTrackPositionTracker does instead: keep the last few
+// (head - clock) offsets, taken at least 30 ms apart, and report
+// clock + mean offset, which spreads a period-sized step over the window.
+//
+// `head` is the wrap-safe position relative to the post-flush origin, in
+// ao->samplerate frames; the return value is its smoothed equivalent.
+static uint32_t AudioTrack_smoothPlayhead(struct ao *ao, uint32_t head)
+{
+    struct priv *p = ao->priv;
+    if (!head) // not started, or just flushed: nothing to average yet
+        return head;
+
+    int64_t now = mp_time_ns();
+    double clock = MP_TIME_NS_TO_S(now) * ao->samplerate;
+
+    p->smooth_head += (int32_t)(head - p->smooth_last_head);
+    p->smooth_last_head = head;
+
+    if (!p->smooth_count ||
+        now - p->smooth_sampled >= MP_TIME_MS_TO_NS(30))
+    {
+        p->smooth_offset[p->smooth_next] = p->smooth_head - clock;
+        p->smooth_next = (p->smooth_next + 1) % MP_ARRAY_SIZE(p->smooth_offset);
+        p->smooth_count = MPMIN(p->smooth_count + 1,
+                                MP_ARRAY_SIZE(p->smooth_offset));
+        p->smooth_sampled = now;
+    }
+
+    double sum = 0;
+    for (int n = 0; n < p->smooth_count; n++)
+        sum += p->smooth_offset[n];
+    int64_t est = llround(clock + sum / p->smooth_count);
+    return (uint32_t)est;
+}
