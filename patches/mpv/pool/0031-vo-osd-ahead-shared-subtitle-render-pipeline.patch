+ */
+
+/*
+ * Subtitle/OSD render-ahead pipeline for a VO that shows the OSD on a plane
+ * or layer of its own, above video that must never wait for it.
+ *
+ * The render thread ("vo/osd-render") rasterizes the OSD for a media pts into
+ * one of OSD_SLOTS slots. The VO files a request for every frame as soon as
+ * it knows the frame (osd_ahead_file_request); requests not yet served are
+ * latest-wins under load, while completed frames enter a bounded FIFO
+ * (results) that the VO's presenter drains. Between requests the thread
+ * pre-renders the frame the observed cadence predicts next, and while the OSD
+ * is static, the first frame of the next subtitle event, so a heavy sign is
+ * rasterized before it is due. Pre-rendering never runs past the subtitle
+ * decoders' read horizon, where an undecoded event or a pending segment
+ * switch would make the result wrong. Only the render thread waits for queue
+ * capacity; the video keeps advancing.
+ *
+ * The VO owns presentation: it publishes each frame's release
+ * (osd_ahead_publish_release), pops results, draws their slots and reports
+ * the slot on screen in present_slot. Every field below the lock is shared
+ * under it, and the presenter may wait on wakeup with the same lock.
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "osdep/threads.h"
+#include "sub/osd.h"
+
+struct mp_log;
+struct sub_bitmap_list;
+
+// --- osd ahead types
+
+#define OSD_CADENCE_SAMPLES 8
+#define OSD_CADENCE_MIN_SAMPLES 4
+#define OSD_CADENCE_MAX_DELTA 0.25  // seconds; longer gaps are not a cadence
+
+// Median of at most OSD_MEDIAN_MAX samples: the middle one, or the mean of
+// the middle two. Insertion sort; the rings here are far smaller than a sort
+// would pay for, and no caller's ring is larger than this.
+#define OSD_MEDIAN_MAX 8
+
+// Media-pts cadence of the frames admitted for preparation: median of the
+// last eight consecutive deltas, trusted after four. A frame_id gap, a
+// non-positive delta (seek,
+// backwards step) or a delta longer than OSD_CADENCE_MAX_DELTA starts over.
+struct osd_cadence {
+    double deltas[OSD_CADENCE_SAMPLES];
+    int count;
+    int next;
+    bool have_last;
+    uint64_t last_frame_id;
+    double last_pts;
+};
+
+struct osd_spec {
+    bool valid;
+    double pts;
+    uint64_t epoch;
+    int slot; // -1: the pre-render found the OSD unchanged, nothing to post
+    uint32_t hits, misses, skips, horizon_skips;
+};
+
+struct osd_prefetch {
+    bool valid;            // a slot holds the next event's first frame
+    double event_start;    // that event's start (video pts)
+    uint64_t epoch;
+    int slot;
+    double attempted_start; // last event start warmed
+    double max_event_s;    // slowest render per event starting, seen so far
+    int unchanged_streak;  // consecutive renders that changed nothing
+    uint32_t count;
+};
+
+// Release timestamp of a flipped frame, by sequence number, in the
+// presenter's clock (vo_mediacodec: the CLOCK_MONOTONIC time handed to
+// MediaCodec).
+struct osd_release {
+    uint64_t seq;
+    int64_t timestamp;  // when the frame is shown, 0 = untimed
+    int64_t vsync;      // the vsync that timestamp targets, 0 = unknown
+    int64_t period;     // display period at release, 0 = unknown
+};
+
+struct osd_result {
+    int slot;        // -1: none
+    uint64_t seq;
+    uint64_t epoch;
+    double pts;      // trace
+    int64_t posted;  // trace: mp_time_ns at post
+    struct osd_release release; // copied before release history can roll over
+};
+
+// Future poses must not replace each other while the presenter waits for an
+// earlier deadline. Bound CPU snapshots; only the renderer waits for capacity.
+#define OSD_RESULT_CAPACITY 4
+struct osd_result_queue {
+    struct osd_result entries[OSD_RESULT_CAPACITY];
+    int first, count;
+};
+
+// Active frame, bounded pending queue, next-frame and event pre-renders.
+#define OSD_SLOTS (OSD_RESULT_CAPACITY + 3)
+#define OSD_RELEASE_HISTORY 16
+
+// One rendered OSD frame: the sub bitmap list for a canvas_w x canvas_h
+// canvas, composited by the VO's presenter. The margins are the letterbox of
+// that render (mp_osd_res ml/mt/mr/mb), which the presenter fills opaque
+// black.
+struct osd_slot {
+    struct sub_bitmap_list *sbs;
+    int canvas_w, canvas_h;
+    int ml, mt, mr, mb;
+};
+
+struct osd_request {
+    double pts;      // render pts, MP_NOPTS_VALUE ok
+    double delta;    // cadence at filing time, 0 when unknown
+    uint64_t seq;    // frame sequence, 0 for an unpinned repaint
+    uint64_t epoch;
+    bool full;
+};
+
+// --- end osd ahead types
+
+struct osd_ahead_callbacks {
+    void *ctx;
+    // Render thread, once at start (thread priority and the like). Optional.
+    void (*thread_init)(void *ctx);
+    // Locked, render thread: latch the canvas description the renders that
+    // follow read, before a request is served and before pre-renders are
+    // planned.
+    void (*latch_canvas)(void *ctx);
+    // Render thread: the canvas size now; <= 0 when there is no canvas.
+    void (*canvas_size)(void *ctx, int *w, int *h);
+    // Render thread: the OSD resolution for a w x h canvas under the latched
+    // description.
+    struct mp_osd_res (*canvas_res)(void *ctx, int w, int h);
+};
+
+// Counters the VO reads for its statistics (writer noted per field).
+struct osd_ahead_stats {
+    uint32_t frames;            // VO: pinned requests filed
+    uint32_t coalesced;         // VO: requests replaced before service
+    uint32_t renders, renders_changed; // render
+    int64_t render_ns_last, render_ns_max; // render
+    uint32_t render_hist[5];    // render: <=10, <=25, <=42, <=84, >84 ms
+    uint32_t stale;             // results cancelled or missing their release
+};
+
+struct osd_ahead {
+    // Set by the VO before osd_ahead_start; constant while running.
+    struct mp_log *log;
+    struct osd_state *osd;
+    const bool *formats;        // SUBBITMAP_COUNT entries, as for osd_render
+    struct osd_ahead_callbacks cb;
+
+    mp_mutex lock;
+    mp_cond wakeup;             // broadcast for any change below
+    bool terminate;
+    bool present_failed;        // nothing will consume results
+    bool paused;
+    uint64_t epoch;
+
+    // VO -> render
+    bool requested;
+    struct osd_request request;
+    // VO -> presenter
+    struct osd_release releases[OSD_RELEASE_HISTORY];
+    int release_next;
+    uint64_t release_seq;       // newest published
+    // render -> presenter
+    struct osd_result_queue results;
+    int present_slot;           // slot on screen or being presented, -1 none
+
+    struct osd_ahead_stats stats;
+    struct osd_spec spec;       // render (counters read by the VO thread)
+    struct osd_prefetch prefetch; // render (counters read by the VO thread)
+
+    // Written by the render thread alone, which may read them unlocked. A
+    // slot a result, present_slot or a pre-render names stays immutable.
+    struct osd_slot slots[OSD_SLOTS];
+
+    mp_thread thread;
+    bool started;               // lock, wakeup and thread exist
+};
+
+// VO thread. Start the render thread with fresh state; only the epoch
+// advances and the pause state carries over. The slots must be empty.
+// Returns false, with nothing left running, when the thread cannot start.
+bool osd_ahead_start(struct osd_ahead *s);
+// VO thread. Terminate and join the render thread; the lock stays usable
+// for a presenter that still runs and for a final statistics read.
+void osd_ahead_stop(struct osd_ahead *s);
+// VO thread, after osd_ahead_stop (or without a start): free the lock and
+// every slot.
+void osd_ahead_destroy(struct osd_ahead *s);
+
+// Locked. File a render request; seq 0 is an immediate, unpinned repaint
+// that replaces the timeline.
+void osd_ahead_file_request(struct osd_ahead *s, struct osd_request req);
+// Locked. Discard everything in flight and repaint at pts.
+void osd_ahead_invalidate(struct osd_ahead *s, double pts);
+// Locked. Publish when the frame with release.seq is shown.
+void osd_ahead_publish_release(struct osd_ahead *s, struct osd_release release);
+
+// Scheduler core, freestanding (see the osd ahead scheduler core region).
+int64_t osd_median_ns(const int64_t *v, int n);
+void osd_cadence_reset(struct osd_cadence *c);
+void osd_cadence_observe(struct osd_cadence *c, uint64_t frame_id, double pts);
+double osd_cadence_delta(const struct osd_cadence *c);
+struct osd_result *osd_result_head(struct osd_result_queue *q);
+int osd_result_slot(const struct osd_result_queue *q);
+struct osd_result osd_result_pop(struct osd_result_queue *q);
+
+// A standalone copy of an item's id, layout and atlas reference (talloc
+// root; the atlas is refcounted).
+struct sub_bitmaps *osd_clone_item(const struct sub_bitmaps *src);
