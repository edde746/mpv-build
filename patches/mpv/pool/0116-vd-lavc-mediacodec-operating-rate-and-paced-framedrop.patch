+    // Drops a decoder counts itself (VDCTRL_GET_FRAMEDROP_STATS); -1 while
+    // the decoder has not answered, which keeps the packet heuristic.
+    int64_t decoder_drops_seen;
+    // A decoder shed logs at trace level under ffmpeg/video, which a
+    // diagnostic log holds at warn; this line is the only visible record of
+    // one. At most one line per DECODER_SHED_LOG_NS, carrying every shed
