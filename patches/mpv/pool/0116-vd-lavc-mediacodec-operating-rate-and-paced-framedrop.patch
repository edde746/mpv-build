+// Hand a changed --hwdec-mediacodec-operating-rate to the running decoder.
+// The platform reports only outright refusal; a component may take the
+// parameter and change nothing, so the caller confirms by measurement.
+static void update_operating_rate(struct mp_filter *vd)
+{
+    vd_ffmpeg_ctx *ctx = vd->priv;
+    int rate = ctx->hwdec_opts->mediacodec_operating_rate;
+
+    if (!ctx->avctx || rate <= 0 || rate == ctx->applied_operating_rate)
+        return;
+    int ret = av_mediacodec_set_operating_rate(ctx->avctx, rate);
+    if (ret == AVERROR(ENOSYS))
+        return; // not a MediaCodec decoder, or a platform without the call
+    ctx->applied_operating_rate = rate;
+    if (ret < 0) {
+        MP_WARN(vd, "Decoder refused operating rate %d.\n", rate);
+    } else {
+        MP_VERBOSE(vd, "Decoder operating rate: %d\n", rate);
+    }
+}
