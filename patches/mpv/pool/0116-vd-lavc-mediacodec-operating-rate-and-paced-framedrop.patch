@@ -331,6 +345,7 @@ static void decf_reset(struct mp_filter *f)
     p->pts_reset = false;
     p->attempt_framedrops = 0;
     p->dropped_frames = 0;
+    p->decoder_drops_seen = -1;
     mp_mutex_unlock(&p->cache_lock);
 
     p->coverart_returned = 0;
@@ -922,10 +937,23 @@ static void feed_packet(struct priv *p)
         int framedrop_type = 0;
 
         mp_mutex_lock(&p->cache_lock);
-        if (p->attempt_framedrops)
-            framedrop_type = 1;
+        int wanted = p->attempt_framedrops;
         mp_mutex_unlock(&p->cache_lock);
 
+        if (wanted) {
+            // A decoder with a deep pipeline (a hardware decoder holding
+            // a dozen frames) shows a drop's effect only that many frames
+            // later; the A/V difference that sized the request does not
+            // move meanwhile. Requesting against the drops it has already
+            // made but not yet shown would drop the same deficit again.
+            struct vd_framedrop_stats stats = {0};
+            if (p->decoder->control(p->decoder->f, VDCTRL_GET_FRAMEDROP_STATS,
+                                    &stats) == CONTROL_TRUE)
+                wanted -= stats.pending;
+            if (wanted > 0)
+                framedrop_type = 1;
+        }
+
         if (start_pts != MP_NOPTS_VALUE && packet && p->play_dir > 0 &&
             packet->pts < start_pts - .005 && !p->has_broken_packet_pts)
             framedrop_type = 2;
@@ -1026,7 +1054,29 @@ static void read_frame(struct priv *p)
     if (p->attached_picture && frame.type == MP_FRAME_VIDEO)
         p->decoded_coverart = frame;
     if (p->attempt_framedrops) {
-        int dropped = MPMAX(0, p->packets_without_output - 1);
+        int dropped;
+        struct vd_framedrop_stats stats = {0};
+        if (p->decoder->control &&
+            p->decoder->control(p->decoder->f, VDCTRL_GET_FRAMEDROP_STATS,
+                                &stats) == CONTROL_TRUE)
+        {
+            // The decoder knows exactly which packets it dropped.
+            if (p->decoder_drops_seen < 0)
+                p->decoder_drops_seen = stats.performed;
+            dropped = MPMAX(0, (int)(stats.performed - p->decoder_drops_seen));
+            p->decoder_drops_seen = stats.performed;
+            p->shed_unlogged += dropped;
+            int64_t now = mp_time_ns();
+            if (dropped && now - p->shed_logged_ns >= DECODER_SHED_LOG_NS) {
+                MP_VERBOSE(p, "decoder shed %d frame(s) before decode, "
+                           "%d pending, %" PRId64 " over the session\n",
+                           p->shed_unlogged, stats.pending, stats.performed);
+                p->shed_unlogged = 0;
+                p->shed_logged_ns = now;
+            }
+        } else {
+            dropped = MPMAX(0, p->packets_without_output - 1);
+        }
         p->attempt_framedrops = MPMAX(0, p->attempt_framedrops - dropped);
         p->dropped_frames += dropped;
     }
