 // This is automatically unset if the target is reached, or on reset.
 void mp_decoder_wrapper_set_start_pts(struct mp_decoder_wrapper *d, double pts);
 
+// What a decoder that drops frames before decoding them (a hardware
+// decoder shedding non-reference input) reports about its own drops.
+struct vd_framedrop_stats {
+    int64_t performed;  // frames dropped so far, lifetime
+    int pending;        // of those, the ones whose effect has not reached
+                        // the output yet: the decoder is still "behind" by
+                        // them, but they are already being made up
+};
+
 enum dec_ctrl {
     VDCTRL_FORCE_HWDEC_FALLBACK, // force software decoding fallback
     VDCTRL_GET_HWDEC,
@@ -75,6 +85,10 @@ enum dec_ctrl {
     // framedrop mode: 0=none, 1=standard, 2=hrseek
     VDCTRL_SET_FRAMEDROP,
     VDCTRL_CHECK_FORCED_EOF,
+    // arg: struct vd_framedrop_stats*. CONTROL_TRUE only from a decoder that
+    // counts its own drops; everything else keeps the packet-counting
+    // heuristic in the wrapper.
+    VDCTRL_GET_FRAMEDROP_STATS,
 };
 
 int mp_decoder_wrapper_control(struct mp_decoder_wrapper *d,
