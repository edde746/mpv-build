diff --git a/audio/out/ao_spatial.h b/audio/out/ao_spatial.h
new file mode 100644
index 0000000..e9d11c0
--- /dev/null
+++ b/audio/out/ao_spatial.h
@@ -0,0 +1,28 @@
+// Private interface between ao_spatial and its Swift sink. Not installed.
+#pragma once
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+enum {
+    MP_SPATIAL_OK,
+    // The timeline stopped at a gap in the audio; begin another.
+    MP_SPATIAL_DISCONTINUITY,
+    // The stream cannot be rendered; fall back to PCM.
+    MP_SPATIAL_FAILED,
+};
+
+void *mp_spatial_create(int codec, void *synchronizer, size_t buffer_limit);
+void mp_spatial_destroy(void *output);
+void mp_spatial_begin(void *output, int64_t nanoseconds);
+size_t mp_spatial_write(void *output, const void *bytes, size_t size);
+void mp_spatial_end(void *output);
+void mp_spatial_volume(void *output, float volume);
+// Returns MP_SPATIAL_*. Times are nanoseconds on the synchronizer clock, or
+// INT64_MIN before the timeline has reset the renderer: *covered is how far
+// the renderer holds audio, *end how far the enqueued audio reaches.
+// *final: the end of the stream has been enqueued.
+int mp_spatial_poll(void *output, bool *ready, int64_t *covered, int64_t *end,
+                    bool *final);
+// Describes the current failure for the log, or returns NULL. free() it.
+char *mp_spatial_failure(void *output);
