+// Private interface between ao_spatial and its Swift renderer. Not installed.
+#pragma once
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+void *mp_spatial_create(int codec, void *synchronizer);
+void mp_spatial_destroy(void *sink);
+void mp_spatial_begin(void *sink, int64_t nanoseconds, size_t capacity);
+bool mp_spatial_write(void *sink, const void *bytes, size_t size);
+size_t mp_spatial_pending(void *sink);
+bool mp_spatial_finished(void *sink);
+void mp_spatial_end(void *sink);
+bool mp_spatial_ready(void *sink);
+bool mp_spatial_failed(void *sink);
+void mp_spatial_volume(void *sink, float volume);
+int64_t mp_spatial_time(void *sink, bool playing, bool paused);
+int64_t mp_spatial_submitted(void *sink);
+bool mp_spatial_drained(void *sink);
