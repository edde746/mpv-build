+
+// Converts TrueHD Atmos and DTS:X to APAC with SpatialAudioBridge and keeps
+// mpv's audio clock on the synchronizer used by the renderer.
+//
+// A stream the renderer fails on falls back to PCM the way avfoundation's
+// compressed sink does: the format is latched and the output reloaded, the
+// reopen refuses it, and mpv decodes the track instead. A later PCM
+// initialization clears the latch, so the next track or file tries again.
+// The latch belongs to this mpv player and survives AO reconstruction.
+
+#include <stdatomic.h>
+
+#include "ao.h"
+#include "audio/format.h"
+#include "common/common.h"
+#include "common/global.h"
+#include "common/msg.h"
+#include "internal.h"
+#include "ao_spatial.h"
+
+#import <AVFoundation/AVFoundation.h>
+#import <CoreMedia/CoreMedia.h>
+
+struct priv {
+    void *sink;
+    AVSampleBufferRenderSynchronizer *synchronizer;
+    // Nudges the ao thread while the clock waits for the renderer, which the
+    // thread would otherwise only notice at its next refill.
+    dispatch_queue_t queue;
+    dispatch_source_t wakeup_timer;
+    atomic_bool waiting;
+    // The current timeline's start on the synchronizer clock, and the samples
+    // written since.
+    CMTime timeline;
+    int64_t written;
+    bool playing;
+    bool paused;
+    // The renderer has finished this timeline; the next write begins another.
+    bool ended;
+    bool reload_requested;
+};
+
+static int spatial_latch_index(int format)
+{
+    return format == AF_FORMAT_S_DTSHD;
+}
+
+static int64_t ns_from_time(CMTime time)
+{
+    return CMTimeConvertScale(time, 1000000000, kCMTimeRoundingMethod_Default).value;
+}
+
+// Arms the timer that nudges the ao thread only while the clock waits.
+static void set_waiting(struct ao *ao, bool waiting)
+{
+    struct priv *p = ao->priv;
+
+    atomic_store(&p->waiting, waiting);
+    dispatch_source_set_timer(p->wakeup_timer,
+        waiting ? dispatch_time(DISPATCH_TIME_NOW, 10 * NSEC_PER_MSEC) : DISPATCH_TIME_FOREVER,
+        10 * NSEC_PER_MSEC, NSEC_PER_MSEC);
+}
+
+// Audio written but not yet played. While the clock waits, that is all of it,
+// so mpv's audio position, and with it the video, waits too.
+static int64_t queued_ns(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    // Split so that days of 192 kHz audio stay within int64.
+    int64_t written = p->written / ao->samplerate * INT64_C(1000000000) +
+                      p->written % ao->samplerate * INT64_C(1000000000) / ao->samplerate;
+    int64_t now = mp_spatial_time(p->sink, p->playing, p->paused);
+    if (p->ended && mp_spatial_drained(p->sink))
+        return 0;
+    int64_t end = MPMAX(ns_from_time(p->timeline) + written, mp_spatial_submitted(p->sink));
+    return MPMAX(end - now, 0);
+}
+
+static void begin_timeline(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    p->timeline = CMTimeMake(mp_spatial_time(p->sink, false, false), 1000000000);
+    p->written = 0;
+    p->playing = false;
+    p->paused = false;
+    p->ended = false;
+    set_waiting(ao, false);
+    mp_spatial_begin(p->sink, ns_from_time(p->timeline), (size_t)ao->device_buffer * ao->sstride);
+}
+
+static int init(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    int codec;
+    if (ao->format == AF_FORMAT_S_TRUEHD) {
+        codec = 1;
+    } else if (ao->format == AF_FORMAT_S_DTSHD) {
+        codec = 2;
+    } else {
+        if (!af_fmt_is_spdif(ao->format)) {
+            atomic_store(&ao->global->spatial_format_latch[0], false);
+            atomic_store(&ao->global->spatial_format_latch[1], false);
+        }
+        MP_VERBOSE(ao, "only TrueHD and DTS-HD passthrough are handed to the renderer\n");
+        return -1;
+    }
+    if (atomic_load(&ao->global->spatial_format_latch[spatial_latch_index(ao->format)])) {
+        MP_INFO(ao, "%s failed in the renderer; decoding it instead\n",
+                af_fmt_to_str(ao->format));
+        return -1;
+    }
+
+    p->synchronizer = [[AVSampleBufferRenderSynchronizer alloc] init];
+    p->sink = mp_spatial_create(codec, (void *)p->synchronizer);
+    if (!p->sink) {
+        MP_VERBOSE(ao, "the renderer refused the stream\n");
+        [p->synchronizer release];
+        p->synchronizer = nil;
+        return -1;
+    }
+
+    mp_spatial_volume(p->sink, atomic_load(&ao->gain));
+
+    // The renderer's encoder holds 1.5 s before its first output, so let mpv
+    // queue well beyond that.
+    ao->device_buffer = ao->samplerate * 3;
+
+    p->queue = dispatch_queue_create("mpv spatial audio", DISPATCH_QUEUE_SERIAL);
+    p->wakeup_timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, p->queue);
+    dispatch_source_set_timer(p->wakeup_timer, DISPATCH_TIME_FOREVER, 0, 0);
+    dispatch_source_set_event_handler(p->wakeup_timer, ^{
+        if (atomic_load(&p->waiting))
+            ao_wakeup(ao);
+    });
+    dispatch_resume(p->wakeup_timer);
+
+    begin_timeline(ao);
+    return 0;
+}
+
+static void uninit(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    // Not set when init() failed.
+    if (!p->queue)
+        return;
+    dispatch_source_cancel(p->wakeup_timer);
+    // A handler already running finishes before this returns.
+    dispatch_sync(p->queue, ^{});
+    dispatch_release(p->wakeup_timer);
+    dispatch_release(p->queue);
+
+    mp_spatial_destroy(p->sink);
+    [p->synchronizer release];
+}
+
+static void reset(struct ao *ao)
+{
+    begin_timeline(ao);
+}
+
+static void start(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    p->playing = true;
+    mp_spatial_time(p->sink, p->playing, p->paused);
+    set_waiting(ao, !p->paused);
+}
+
+static bool set_pause(struct ao *ao, bool paused)
+{
+    struct priv *p = ao->priv;
+
+    p->paused = paused;
+    mp_spatial_time(p->sink, p->playing, p->paused);
+    set_waiting(ao, p->playing && !paused);
+    return true;
+}
+
+static bool audio_write(struct ao *ao, void **data, int samples)
+{
+    struct priv *p = ao->priv;
+
+    // Timely holds preserve encoder/parser state. A missed horizon fails
+    // the sink and reloads PCM; only a completed file starts a new timeline.
+    if (p->ended) {
+        MP_VERBOSE(ao, "beginning a new timeline\n");
+        bool playing = p->playing;
+        begin_timeline(ao);
+        p->playing = playing;
+        set_waiting(ao, playing);
+    }
+    if (!mp_spatial_write(p->sink, data[0], (size_t)samples * ao->sstride))
+        return false;
+    p->written += samples;
+    return true;
+}
+
+// The renderer holds back the start of a stream, and its encoder the latest
+// audio, until it has more; at the end it has to let both go.
+static void end_of_stream(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    p->ended = true;
+    mp_spatial_end(p->sink);
+}
+
+// mpv's software volume never reaches a bitstream, so the renderer applies it.
+// mpv calls this whenever it changes, paused or not.
+static void set_gain(struct ao *ao, float gain)
+{
+    struct priv *p = ao->priv;
+
+    // ao_alloc() sets the gain before init() has opened the renderer.
+    if (!p->queue)
+        return;
+    mp_spatial_volume(p->sink, gain);
+}
+
+static void get_state(struct ao *ao, struct mp_pcm_state *state)
+{
+    struct priv *p = ao->priv;
+
+    int64_t queued = queued_ns(ao);
+    if (mp_spatial_failed(p->sink) && !p->reload_requested) {
+        MP_WARN(ao, "the renderer failed to render the stream, falling back to PCM\n");
+        p->reload_requested = true;
+        atomic_store(&ao->global->spatial_format_latch[spatial_latch_index(ao->format)], true);
+        ao_request_reload(ao);
+    }
+
+    size_t pending = mp_spatial_pending(p->sink);
+    bool unfinished = p->ended && !mp_spatial_finished(p->sink);
+
+    // Recheck progress early enough to request a hold before coverage runs out.
+    // Missed holds fail closed instead of rewinding the physical clock.
+    bool waiting = p->playing && !p->paused && (!p->ended || !mp_spatial_drained(p->sink));
+    if (atomic_load(&p->waiting) != waiting)
+        set_waiting(ao, waiting);
+
+    state->queued_samples = queued * ao->samplerate / INT64_C(1000000000);
+    int period = ao->samplerate / 100;
+    state->free_samples = MPMAX(ao->device_buffer - state->queued_samples, 0)
+                          / period * period;
+    // Wall-clock space cannot admit bytes that the feeder has not consumed.
+    // write() runs on this same AO thread; pending only decreases meanwhile.
+    size_t capacity = (size_t)ao->device_buffer * ao->sstride;
+    int feeder_space = pending < capacity ? (capacity - pending) / ao->sstride : 0;
+    state->free_samples = MPMIN(state->free_samples, feeder_space / period * period);
+    // The next file's audio waits until this one has played out.
+    if (p->ended && (queued > 0 || unfinished))
+        state->free_samples = 0;
+    state->delay = queued / 1e9;
+    state->playing = p->playing && (!p->ended || !mp_spatial_drained(p->sink));
+}
+
+const struct ao_driver audio_out_spatial = {
+    .description = "TrueHD and DTS-HD passthrough to Apple spatial audio",
+    .name        = "spatial",
+    .init        = init,
+    .uninit      = uninit,
+    .reset       = reset,
+    .start       = start,
+    .set_pause   = set_pause,
+    .write       = audio_write,
+    .get_state   = get_state,
+    .end_of_stream = end_of_stream,
+    .set_gain    = set_gain,
+    .priv_size   = sizeof(struct priv),
+};
diff --git a/audio/out/ao_spatial.swift b/audio/out/ao_spatial.swift
new file mode 100644
index 0000000..20d005c
--- /dev/null
+++ b/audio/out/ao_spatial.swift
@@ -0,0 +1,547 @@
+@preconcurrency import AVFoundation // Xcode 26 SDKs omit the synchronizer's Sendable annotation.
+import Synchronization
+
+// Submission and rate changes share this lock. Ordinary holds preserve time;
+// an unfinished clock overrun is terminal, never repaired by moving it back.
+@available(macOS 26, iOS 26, tvOS 26, *)
+private final class SpatialClock: Sendable {
+    enum Failure: Error { case overrun, invalidTime, unsettled, insufficientLead }
+    private enum Mode { case anchoring, held, starting, running, stopping, failed }
+    private struct State {
+        var generation = 0
+        var origin = CMTime.zero
+        var position = CMTime.zero
+        var submitted = CMTime.zero
+        var mode = Mode.anchoring
+        var deadline: ContinuousClock.Instant? = ContinuousClock.now.advanced(by: .seconds(2))
+        var requested = false
+        var hasPlayed = false
+        var hasSubmission = false
+        var leadDeadline: ContinuousClock.Instant?
+        var finalizing = false
+        var terminal = false
+        var overrunDuringFinalization = false
+        var failure: Failure?
+    }
+    // Policies, not scheduling guarantees: missed deadlines fail closed.
+    private static let stopLead = CMTime(value: 100, timescale: 1000)
+    private static let resumeLead = CMTime(value: 250, timescale: 1000)
+    private let state = Mutex(State())
+    private let synchronizer: AVSampleBufferRenderSynchronizer
+
+    init(_ synchronizer: AVSampleBufferRenderSynchronizer) {
+        self.synchronizer = synchronizer
+        synchronizer.delaysRateChangeUntilHasSufficientMediaData = false
+    }
+
+    func begin(at time: CMTime, generation: Int) {
+        state.withLock { state in
+            // Only a new timeline may change the timebase anchor.
+            synchronizer.setRate(0, time: time)
+            state = State(generation: generation, origin: time, position: time, submitted: time)
+        }
+    }
+
+    private func fail(_ state: inout State, _ error: Failure) {
+        guard state.failure == nil else { return }
+        state.failure = error
+        state.mode = .failed
+        synchronizer.setRate(0, time: .invalid)
+    }
+
+    private func stop(_ state: inout State) {
+        guard state.mode == .running || state.mode == .starting else { return }
+        synchronizer.setRate(0, time: .invalid)
+        state.mode = .stopping
+        state.deadline = ContinuousClock.now.advanced(by: .seconds(2))
+    }
+
+    private func beyond(_ raw: CMTime, _ horizon: CMTime) -> Bool {
+        // Allow only the rounding needed to express the endpoint in the raw
+        // clock's timescale, never the scheduling safety margin.
+        raw > CMTimeConvertScale(horizon, timescale: raw.timescale, method: .roundTowardPositiveInfinity)
+    }
+
+    private func observe(_ state: inout State, strict: Bool = false) {
+        guard state.failure == nil else { return }
+        let raw = synchronizer.currentTime()
+        guard raw.isNumeric && raw.timescale > 0 else { fail(&state, .invalidTime); return }
+        let rate = CMTimebaseGetRate(synchronizer.timebase)
+        if state.mode == .anchoring {
+            let origin = CMTimeConvertScale(state.origin, timescale: raw.timescale, method: .default)
+            if rate == 0 && raw == origin { state.mode = .held; state.deadline = nil }
+        } else {
+            if state.hasPlayed && !state.terminal &&
+                (state.overrunDuringFinalization || beyond(raw, state.submitted)) {
+                if state.finalizing && !strict {
+                    // Empty final encoding may legitimately leave no more audio.
+                    // No new submission is admitted under this exception.
+                    state.overrunDuringFinalization = true
+                    stop(&state)
+                } else { fail(&state, .overrun); return }
+            }
+            state.position = max(state.position, min(raw, state.submitted))
+            if state.mode == .stopping && rate == 0 {
+                state.mode = .held; state.deadline = nil
+            } else if state.mode == .starting && rate != 0 {
+                state.mode = .running; state.deadline = nil
+            }
+            if !state.requested ||
+                (state.terminal ? raw >= state.submitted : state.submitted - raw <= Self.stopLead) {
+                stop(&state)
+            }
+        }
+        if let deadline = state.deadline, ContinuousClock.now >= deadline { fail(&state, .unsettled) }
+    }
+
+    private func resume(_ state: inout State) {
+        guard state.failure == nil, state.mode == .held, state.requested,
+              !state.overrunDuringFinalization else { return }
+        let lead = state.submitted - state.position
+        // Finished output may drain a short final tail. Unfinished output needs
+        // enough lead to avoid resuming once for every single APAC packet.
+        guard state.terminal ? lead > .zero : lead >= Self.resumeLead else {
+            // The framework promises no minimum queue capacity. If it refuses
+            // more data below our policy lead, polling must fail rather than
+            // wait forever for the suspended encoder batch/flush to return.
+            if state.hasSubmission && !state.terminal {
+                if state.leadDeadline == nil {
+                    state.leadDeadline = ContinuousClock.now.advanced(by: .seconds(2))
+                }
+                if let deadline = state.leadDeadline, ContinuousClock.now >= deadline {
+                    fail(&state, .insufficientLead)
+                }
+            }
+            return
+        }
+        state.leadDeadline = nil
+        synchronizer.setRate(1, time: .invalid)
+        state.mode = .starting
+        state.deadline = ContinuousClock.now.advanced(by: .seconds(2))
+        state.hasPlayed = true
+    }
+
+    func position(playing: Bool) -> CMTime {
+        state.withLock { state in
+            state.requested = playing
+            if !playing { state.leadDeadline = nil }
+            observe(&state)
+            resume(&state)
+            return state.position
+        }
+    }
+
+    var failure: Failure? { state.withLock { $0.failure } }
+    var ready: Bool {
+        state.withLock { state in
+            state.failure == nil && (state.terminal || state.hasPlayed ||
+                state.submitted - state.position >= Self.resumeLead)
+        }
+    }
+    var submitted: CMTime { state.withLock { $0.submitted } }
+    var drained: Bool {
+        state.withLock { state in
+            observe(&state)
+            return state.failure == nil && state.terminal && state.position >= state.submitted
+        }
+    }
+
+    func beginFinalization(generation: Int) {
+        state.withLock { state in
+            guard state.generation == generation, state.failure == nil else { return }
+            state.finalizing = true
+            observe(&state)
+        }
+    }
+
+    func finishEmpty(generation: Int) throws {
+        try state.withLock { state in
+            guard state.generation == generation else { throw CancellationError() }
+            observe(&state)
+            if let failure = state.failure { throw failure }
+            state.terminal = true
+            state.leadDeadline = nil
+            state.finalizing = false
+            state.overrunDuringFinalization = false
+            observe(&state)
+            resume(&state)
+        }
+    }
+
+    func submit(through end: CMTime, isFinal: Bool, generation: Int, enqueue: () -> Void) throws -> Bool {
+        try state.withLock { state in
+            guard state.generation == generation else { throw CancellationError() }
+            guard end.isNumeric, !state.terminal else {
+                fail(&state, .invalidTime); throw Failure.invalidTime
+            }
+            // Even the final packet must respect OLD coverage. A late final
+            // packet cannot turn a preceding overrun into successful draining.
+            observe(&state, strict: true)
+            if let failure = state.failure { throw failure }
+            if state.mode == .anchoring || state.mode == .stopping { return false }
+            enqueue()
+            observe(&state, strict: true) // framework enqueue can take time
+            if let failure = state.failure { throw failure }
+            state.submitted = max(state.submitted, end) // includes origin for priming-only output
+            state.hasSubmission = true
+            if isFinal { state.terminal = true; state.finalizing = false; state.leadDeadline = nil }
+            resume(&state)
+            return true
+        }
+    }
+}
+
+// Compiled with SpatialAudioBridge's renderer sources into libmpv. The C side
+// owns this object and the synchronizer; asynchronous work never calls mpv.
+@available(macOS 26, iOS 26, tvOS 26, *)
+private final class SpatialOutput: Sendable {
+    private struct Timeline {
+        let input: AsyncStream<Data>.Continuation
+        let feeder: Task<Void, Never>
+        let capacity: Int
+        var pending = 0
+        var ended = false
+        var finished = false
+    }
+
+    private struct State {
+        var renderer: SpatialAudioRenderer?
+        var timeline: Timeline?
+        var generation = 0
+        var failed = false
+        var volume: Float = 1
+        var volumeUpdate: Task<Void, Never>?
+        var activator: AtmosOutputActivator?
+        var resourceDirectory: URL?
+    }
+
+    private let state: Mutex<State>
+    private let clock: SpatialClock
+
+    init(codec: SpatialAudioCodec, synchronizer: AVSampleBufferRenderSynchronizer) throws {
+        clock = SpatialClock(synchronizer)
+        let renderer = try SpatialAudioRenderer(codec: codec, synchronizer: synchronizer)
+        try SpatialSession.acquire()
+        state = Mutex(State(renderer: renderer))
+        Task { @MainActor [weak self] in
+            guard let self else { return }
+            // AVPlayer needs a file URL. The build embeds the pinned silent
+            // clip so a static libmpv needs no application resource bundle.
+            var directory: URL?
+            do {
+                guard self.state.withLock({ $0.renderer != nil }) else { return }
+                let root = FileManager.default.temporaryDirectory
+                    .appendingPathComponent("mpv-spatial-\(UUID().uuidString)", isDirectory: true)
+                try FileManager.default.createDirectory(at: root, withIntermediateDirectories: false,
+                    attributes: [.posixPermissions: 0o700])
+                directory = root
+                let stream = root.appendingPathComponent("silent-atmos.mp4")
+                try mpSpatialSilentAtmos.write(to: stream, options: .atomic)
+                let activator = AtmosOutputActivator(silentAtmosStream: stream)
+                activator.attach(to: synchronizer)
+                let current = self.state.withLock { state in
+                    guard state.renderer != nil else { return false }
+                    state.activator = activator
+                    state.resourceDirectory = root
+                    return true
+                }
+                if current { directory = nil } else { activator.detach() }
+            } catch {
+                self.fail(error)
+            }
+            if let directory { try? FileManager.default.removeItem(at: directory) }
+        }
+    }
+
+    // Attachment installs the rate observer before C can start the clock.
+    // Submitted output publishes readiness even while an encoder batch/flush
+    // is suspended on a full renderer queue. This is not receiver readiness.
+    var ready: Bool {
+        state.withLock { $0.activator != nil && !$0.failed && clock.ready }
+    }
+    var failed: Bool { state.withLock { $0.failed || clock.failure != nil } }
+    var pending: Int { state.withLock { $0.timeline?.pending ?? 0 } }
+    var finished: Bool { state.withLock { $0.timeline?.finished ?? false } }
+    var submitted: Int64 { CMTimeConvertScale(clock.submitted, timescale: 1_000_000_000, method: .default).value }
+    var drained: Bool { state.withLock { ($0.timeline?.finished ?? false) && clock.drained } }
+    func time(playing: Bool, paused: Bool) -> Int64 {
+        state.withLock { state in
+            let attached = state.activator != nil && !state.failed
+            let time = clock.position(playing: playing && !paused && attached)
+            return CMTimeConvertScale(time, timescale: 1_000_000_000, method: .default).value
+        }
+    }
+
+    func begin(_ nanoseconds: Int64, capacity: Int) {
+        let time = CMTime(value: nanoseconds, timescale: 1_000_000_000)
+        let (bursts, input) = AsyncStream<Data>.makeStream()
+        state.withLock { state in
+            state.generation += 1
+            let generation = state.generation
+            clock.begin(at: time, generation: generation)
+            let previous = state.timeline
+            previous?.input.finish()
+            previous?.feeder.cancel()
+            guard let renderer = state.renderer else { return }
+            let feeder = Task { [weak self] in
+                guard let self else { return }
+                await self.feed(bursts, renderer: renderer, time: time,
+                    previous: previous?.feeder, generation: generation)
+            }
+            state.timeline = Timeline(input: input, feeder: feeder, capacity: capacity)
+        }
+    }
+
+    func write(_ bytes: Data) -> Bool {
+        state.withLock { state in
+            guard !state.failed, clock.failure == nil, let timeline = state.timeline, !timeline.ended,
+                  bytes.count <= timeline.capacity - timeline.pending else { return false }
+            // Reserve through enqueue completion, including the chunk currently
+            // held by the feeder. A full queue never evicts an accepted burst.
+            state.timeline?.pending += bytes.count
+            switch timeline.input.yield(bytes) {
+            case .enqueued: return true
+            default:
+                state.timeline?.pending -= bytes.count
+                return false
+            }
+        }
+    }
+
+    func end() {
+        state.withLock { state in
+            state.timeline?.ended = true
+            state.timeline?.input.finish()
+        }
+    }
+
+    func setVolume(_ volume: Float) {
+        state.withLock { state in
+            state.volume = volume
+            guard let renderer = state.renderer else { return }
+            let previous = state.volumeUpdate
+            state.volumeUpdate = Task { [weak self] in
+                await previous?.value
+                guard let volume = self?.state.withLock({ $0.volume }) else { return }
+                await renderer.setVolume(volume)
+            }
+        }
+    }
+
+    func close() {
+        let old = state.withLock { state in
+            let position = clock.position(playing: false)
+            clock.begin(at: position, generation: state.generation + 1)
+            defer { state = State(generation: state.generation + 1) }
+            return state
+        }
+        guard let renderer = old.renderer else { return }
+        old.timeline?.input.finish()
+        old.timeline?.feeder.cancel()
+        // Release a feeder waiting for space on the now-stopped clock.
+        Task { try? await renderer.begin(at: .zero) }
+        Task { @MainActor in
+            old.activator?.detach()
+            if let directory = old.resourceDirectory {
+                try? FileManager.default.removeItem(at: directory)
+            }
+        }
+        // Restore synchronously before mpv opens the fallback output.
+        SpatialSession.release()
+    }
+
+    private func feed(_ bursts: AsyncStream<Data>, renderer: SpatialAudioRenderer,
+                      time: CMTime, previous: Task<Void, Never>?, generation: Int) async {
+        do {
+            try Task.checkCancellation()
+            try await renderer.begin(at: time)
+            await previous?.value
+            try Task.checkCancellation()
+            try await renderer.begin(at: time, submission: { [clock] end, isFinal, enqueue in
+                try clock.submit(through: end, isFinal: isFinal, generation: generation, enqueue: enqueue)
+            }, completion: { [clock] in
+                try clock.finishEmpty(generation: generation)
+            })
+            var unpacker = IEC61937Unpacker()
+            var enqueued = false
+            for await chunk in bursts {
+                try Task.checkCancellation()
+                let stream = try unpacker.unpack(chunk)
+                if !stream.isEmpty {
+                    try await renderer.enqueue(stream, time: time + unpacker.skippedDuration)
+                    enqueued = true
+                }
+                state.withLock { state in
+                    if state.generation == generation { state.timeline?.pending -= chunk.count }
+                }
+            }
+            guard !Task.isCancelled else { return }
+            clock.beginFinalization(generation: generation)
+            if enqueued {
+                // A partial final IEC unit does not discard already decoded audio.
+                try? unpacker.finish()
+                try await renderer.endOfStream()
+            } else {
+                try clock.finishEmpty(generation: generation)
+            }
+            // An empty tail has no submitted audio to drain. Nonempty output
+            // remains playing until the clock reaches the last submitted buffer.
+            state.withLock { state in
+                if state.generation == generation { state.timeline?.finished = true }
+            }
+        } catch is CancellationError {
+        } catch {
+            fail(error, generation: generation)
+        }
+    }
+
+    private func fail(_ error: Error, generation: Int? = nil) {
+        let current = state.withLock { state in
+            guard state.renderer != nil, generation == nil || state.generation == generation else { return false }
+            state.failed = true
+            return true
+        }
+        if current { NSLog("[ao_spatial] Falling back to PCM: %@", String(describing: error)) }
+    }
+}
+
+// AVAudioSession is process-wide. Overlapping mpv outputs share the session
+// and the last close restores settings still matching those it installed.
+// Matching values cannot reveal whether another caller touched the session.
+@available(macOS 26, iOS 26, tvOS 26, *)
+private enum SpatialSession {
+    #if os(iOS) || os(tvOS)
+    private struct State {
+        var users = 0
+        var category = AVAudioSession.Category.playback
+        var mode = AVAudioSession.Mode.default
+        var options: AVAudioSession.CategoryOptions = []
+        var multichannel = false
+    }
+    private static let state = Mutex(State())
+    #endif
+
+    static func acquire() throws {
+        #if os(iOS) || os(tvOS)
+        try state.withLock { state in
+            if state.users == 0 {
+                let session = AVAudioSession.sharedInstance()
+                state.category = session.category
+                state.mode = session.mode
+                state.options = session.categoryOptions
+                state.multichannel = session.supportsMultichannelContent
+                do {
+                    try session.setCategory(.playback, mode: .moviePlayback)
+                    try session.setSupportsMultichannelContent(true)
+                    try session.setActive(true)
+                } catch {
+                    try? session.setCategory(state.category, mode: state.mode, options: state.options)
+                    try? session.setSupportsMultichannelContent(state.multichannel)
+                    throw error
+                }
+            }
+            state.users += 1
+        }
+        #endif
+    }
+
+    static func release() {
+        #if os(iOS) || os(tvOS)
+        state.withLock { state in
+            state.users -= 1
+            guard state.users == 0 else { return }
+            let session = AVAudioSession.sharedInstance()
+            // Activation is idempotent, but there is no public isActive query.
+            // The host may already own this session; only it may deactivate it.
+            let restoreMultichannel = session.supportsMultichannelContent
+            // setCategory writes all three values, so preserve the whole group
+            // if any current value differs from what we installed.
+            if session.category == .playback,
+               session.mode == .moviePlayback,
+               session.categoryOptions.isEmpty {
+                do {
+                    try session.setCategory(state.category, mode: state.mode, options: state.options)
+                } catch { NSLog("[ao_spatial] Cannot restore audio session category: %@", String(describing: error)) }
+            }
+            if restoreMultichannel {
+                do {
+                    try session.setSupportsMultichannelContent(state.multichannel)
+                } catch { NSLog("[ao_spatial] Cannot restore multichannel setting: %@", String(describing: error)) }
+            }
+        }
+        #endif
+    }
+}
