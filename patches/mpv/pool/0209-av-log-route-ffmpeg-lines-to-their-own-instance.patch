+// The instance a line logged on the calling thread goes to; NULL when none is
+// alive. Called with log_lock held.
+static struct av_log_instance *thread_log_instance(void)
+{
+    for (int n = 0; n < num_log_instances; n++) {
+        if (log_instances[n]->global == log_thread_global)
+            return log_instances[n];
+    }
+    return num_log_instances ? log_instances[0] : NULL;
+}
