+// FFmpeg has one log callback for the whole process, and a process may run
+// several mpv instances at once: an embedder starts its next player while the
+// last one still terminates, which can take seconds. Each instance gets the
+// lines logged on its own threads (mp_av_log_set_thread()), so a player that
+// cannot open a file sees the "HTTP error 404" FFmpeg logged for it; a line
+// from any other thread (FFmpeg's own workers, a client's thread) goes to the
+// oldest instance alive.
+struct av_log_instance {
+    struct mpv_global *global;
+    struct mp_log *root, *decaudio, *decvideo, *demuxer;
+    bool print_prefix;
+    bstr buffer;
+};
