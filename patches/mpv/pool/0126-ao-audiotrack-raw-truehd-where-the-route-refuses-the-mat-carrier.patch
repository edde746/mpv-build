+// and the rest is the unit stream. The fixed offsets are the whole parse, so
+// each code's first word is checked; a frame that does not match is not
+// trusted with unit boundaries.
+static void AudioTrack_thdMatWord(struct ao *ao, uint8_t b0, uint8_t b1)
+{
