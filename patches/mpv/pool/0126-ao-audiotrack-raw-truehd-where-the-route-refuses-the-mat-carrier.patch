+    p->thd_mat_pos += 2;
+    const uint16_t word = b0 << 8 | b1;
+    const uint16_t code = pos == 0 ? 0x079e : pos == MAT_MIDDLE_POS ? 0xc3c1 :
+                          pos == MAT_END_POS ? 0xc3c2 : 0;
+    if (code && word != code) {
+        if (!p->thd_code_warned) {
+            p->thd_code_warned = true;
+            MP_WARN(ao, "TrueHD burst has no MAT code at offset %d; resyncing\n", pos);
+        }
+        AudioTrack_thdLoseSync(p);
+    }
+    if (pos < MAT_START_LEN || pos >= MAT_END_POS ||
+        (pos >= MAT_MIDDLE_POS && pos < MAT_MIDDLE_POS + MAT_MIDDLE_LEN))
+        return;
