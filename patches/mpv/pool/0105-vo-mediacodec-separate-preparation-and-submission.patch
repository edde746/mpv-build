+// OSD work needs the current/next render plus composition time, independently
+// of how long a decoder-owned output buffer is held by SurfaceView.
+static int64_t mediacodec_codec_lead(int64_t period_ns)
+{
+    return period_ns > 0 && period_ns < 25000000
+         ? 2 * period_ns : 50000000;
+}
+
+static int64_t mediacodec_prepare_lead(int64_t period_ns, double duration_ns)
+{
+    int64_t lead = period_ns * 2 > 50000000 ? period_ns * 2 : 50000000;
+    if (period_ns > 0 && isfinite(duration_ns) && duration_ns > 0) {
+        int64_t render = llround(fmin(2 * duration_ns + period_ns, 500000000));
+        if (render > lead)
+            lead = render;
+    }
+    return lead;
+}
+
+static bool mediacodec_synthetic_still(bool still, int64_t pts,
+                                      double duration)
+{
+    return still && pts == 0 && duration < 0;
+}
