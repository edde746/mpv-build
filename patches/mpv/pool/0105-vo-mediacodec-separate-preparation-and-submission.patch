+// Preparation does not own or submit the decoder image. The core can discard
+// a queued frame on seek/drop while this bounded OSD request is in flight.
+static uint64_t prepare_osd(struct vo *vo, struct vo_frame *frame, bool synthetic)
+{
+    struct priv *p = vo->priv;
+    uint64_t seq = ++p->frame_seq;
+    double pts = frame->current->pts;
+    if (!synthetic && p->cadence.last_frame_id != frame->frame_id) {
+        if (pts == MP_NOPTS_VALUE)
+            osd_cadence_reset(&p->cadence);
+        else
+            osd_cadence_observe(&p->cadence, frame->frame_id, pts);
+    }
+    if (p->osd_threads_created) {
+        mp_mutex_lock(&p->osd_lock);
+        osd_file_request(p, (struct osd_request){
+            .pts = pts,
+            .delta = synthetic ? 0 : osd_cadence_delta(&p->cadence),
+            .seq = seq,
+            .epoch = p->osd.epoch,
+        });
+        p->osd.frames++;
+        mp_mutex_unlock(&p->osd_lock);
+    }
+    return seq;
+}
+
+static int64_t prepare_frame(struct vo *vo, struct vo_frame *frame)
+{
+    struct priv *p = vo->priv;
+    if (!frame) {
+        // A dropped prepared pose will never get a release timestamp. Retire
+        // it, including raster work in flight, rather than wedging the FIFO.
+        p->prepared_frame_id = p->prepared_seq = p->prepared_epoch = 0;
+        if (p->osd_threads_created) {
+            mp_mutex_lock(&p->osd_lock);
+            osd_invalidate_locked(p);
+            mp_mutex_unlock(&p->osd_lock);
+        }
+        return 0;
+    }
+    if (frame->redraw || frame->repeat || !frame->current ||
+        mediacodec_synthetic_still(frame->still, frame->pts, frame->duration))
+        return 0;
+
+    // Called on each event-loop wake, including after refresh-rate changes.
+    // Never rely on the offset the core observed before this frame was drawn.
+    update_queue_timing(vo, frame->duration);
+    // Only this VO thread changes epoch; OSD workers only read it under lock.
+    if (!p->prepared_seq || p->prepared_frame_id != frame->frame_id ||
+        p->prepared_epoch != p->osd.epoch)
+    {
+        p->prepared_seq = prepare_osd(vo, frame, false);
+        p->prepared_frame_id = frame->frame_id;
+        p->prepared_epoch = p->osd.epoch;
+    }
+    return frame->pts > 0 && !frame->display_synced
+         ? frame->pts - mediacodec_codec_lead(p->queue_period) : 0;
+}
