+// Called locked. Preparation may start early without blocking the event loop
+// or committing the queued frame to draw/flip. Recheck after each wakeup.
+static bool prepare_queued_frame(struct vo *vo)
+{
+    struct vo_internal *in = vo->in;
+    if (!in->frame_queued || !vo->driver->prepare_frame)
+        return true;
+    struct vo_frame *frame = vo_frame_ref(in->frame_queued);
+    mp_mutex_unlock(&in->lock);
+    int64_t ready = vo->driver->prepare_frame(vo, frame);
+    mp_mutex_lock(&in->lock);
+    talloc_free(frame);
+    // Seek/reset may discard the queued frame while preparation is unlocked.
+    if (in->frame_queued && ready > mp_time_ns()) {
+        in->wakeup_pts = ready;
+        return false;
+    }
+    return true;
+}
+
+// Called locked. The VO's next wake, given the deadline preparation asked for.
+// A deadline that expired between prepare_queued_frame's own check and this
+// sample must not retire into an idle sleep: the frame it belongs to is still
+// queued, only render_frame can admit it, and wakeup_core wakes the playback
+// core rather than this thread -- which cannot hand over another frame while
+// frame_queued is occupied. The VO would sleep out the caller's fallback,
+// stop releasing decoder buffers, and come back only on an unrelated wakeup.
+static int64_t vo_wakeup_deadline(struct vo *vo, int64_t now, int64_t wait_until)
+{
+    struct vo_internal *in = vo->in;
+    if (!in->wakeup_pts)
+        return wait_until;
+    if (in->wakeup_pts > now)
+        return MPMIN(wait_until, in->wakeup_pts);
+    in->wakeup_pts = 0;
+    wakeup_core(vo);
+    return in->frame_queued ? now : wait_until;
+}
+
 static bool render_frame(struct vo *vo)
 {
     struct vo_internal *in = vo->in;
