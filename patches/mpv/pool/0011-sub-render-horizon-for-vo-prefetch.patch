@@ -1042,6 +1042,73 @@ static int control(struct sd *sd, enum sd_ctrl cmd, void *arg)
         a[0] += res / 1000.0 + SUB_SEEK_OFFSET;
         return true;
     }
+    case SD_CTRL_NEXT_EVENT: {
+        // The earliest event start after a[0], exact, and the number of
+        // events sharing it; unlike SD_CTRL_SUB_STEP no seek slack is added.
+        double *a = arg;
+        long long after = llrint(a[0] * 1000.0);
+        ASS_Track *track = ctx->ass_track;
+        long long best = -1;
+        int count = 0;
+        for (int n = 0; n < track->n_events; n++) {
+            long long start = track->events[n].Start;
+            if (start <= after)
+                continue;
+            if (best < 0 || start < best) {
+                best = start;
+                count = 1;
+            } else if (start == best) {
+                count++;
+            }
+        }
+        if (best < 0)
+            return CONTROL_FALSE;
+        a[0] = best / 1000.0;
+        a[1] = count;
+        return CONTROL_OK;
+    }
+    case SD_CTRL_EVENT_LOAD: {
+        // The events around a[0], in subtitle time (see struct
+        // sub_event_load): how many are active and how many of those are
+        // not active at a[1], the last event start or end at or before
+        // a[0], the first boundary after it and how many events start
+        // there, and the latest end among the active ones.
+        double *a = arg;
+        long long at = llrint(a[0] * 1000.0);
+        long long ref = a[1] == MP_NOPTS_VALUE ? LLONG_MIN : llrint(a[1] * 1000.0);
+        ASS_Track *track = ctx->ass_track;
+        long long boundary = -1, next = -1, visible_end = -1;
+        int active = 0, cold = 0;
+        for (int n = 0; n < track->n_events; n++) {
+            ASS_Event *e = &track->events[n];
+            long long end = e->Start + e->Duration;
+            if (e->Start > at) {
+                if (next < 0 || e->Start < next)
+                    next = e->Start;
+                continue;
+            }
+            if (at < end) {
+                active++;
+                cold += !(e->Start <= ref && ref < end);
+                boundary = MPMAX(boundary, e->Start);
+                visible_end = MPMAX(visible_end, end);
+                if (next < 0 || end < next)
+                    next = end;
+            } else {
+                boundary = MPMAX(boundary, end);
+            }
+        }
+        int next_starting = 0;
+        for (int n = 0; n < track->n_events; n++)
+            next_starting += next >= 0 && track->events[n].Start == next;
+        a[0] = active;
+        a[1] = cold;
+        a[2] = boundary < 0 ? MP_NOPTS_VALUE : boundary / 1000.0;
+        a[3] = next < 0 ? MP_NOPTS_VALUE : next / 1000.0;
+        a[4] = next_starting;
+        a[5] = visible_end < 0 ? MP_NOPTS_VALUE : visible_end / 1000.0;
+        return CONTROL_OK;
+    }
     case SD_CTRL_SET_ANIMATED_CHECK:
