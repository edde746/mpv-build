+// Video pts at which the first event starting after `after` begins, or
+// MP_NOPTS_VALUE, and how many events start there (a measure of the work the
+// frame will take). A renderer with idle time uses it to rasterize a heavy
+// upcoming event into the decoder's caches before it is due.
+double sub_get_next_event_start(struct dec_sub *sub, double after, int *num_events)
+{
+    mp_mutex_lock(&sub->lock);
+    wait_render_done(sub);
+    double next = MP_NOPTS_VALUE;
+    *num_events = 0;
+    double spts = pts_to_subtitle(sub, after);
+    struct sd *sd = sub->sd;
+    if (spts != MP_NOPTS_VALUE && sd->driver->control) {
+        double ev[2] = {spts, 0};
+        if (sd->driver->control(sd, SD_CTRL_NEXT_EVENT, ev) == CONTROL_OK) {
+            next = pts_from_subtitle(sub, ev[0]);
+            *num_events = (int)ev[1];
+        }
+    }
+    mp_mutex_unlock(&sub->lock);
+    return next;
+}
+
+// Video pts at which the events visible at pts end, or MP_NOPTS_VALUE when
+// nothing is visible or the duration is unknown.
+double sub_get_visible_end(struct dec_sub *sub, double pts)
+{
+    mp_mutex_lock(&sub->lock);
+    wait_render_done(sub);
+    double end = MP_NOPTS_VALUE;
+    double spts = pts_to_subtitle(sub, pts);
+    struct sd *sd = sub->sd;
+    if (spts != MP_NOPTS_VALUE && sd->driver->get_times) {
+        struct sd_times times = sd->driver->get_times(sd, spts);
+        if (times.end != MP_NOPTS_VALUE && times.end > spts)
+            end = pts_from_subtitle(sub, times.end);
+    }
+    mp_mutex_unlock(&sub->lock);
+    return end;
+}
+
+// The events around a video pts (struct sub_event_load), times as video pts.
+// A renderer that cannot finish a frame inside its interval uses them to
+// render the frame that will be current when it does finish instead.
+void sub_get_event_load(struct dec_sub *sub, double pts, double ref,
+                        struct sub_event_load *load)
+{
+    *load = (struct sub_event_load){
+        .boundary = MP_NOPTS_VALUE, .next_boundary = MP_NOPTS_VALUE,
+        .visible_end = MP_NOPTS_VALUE,
+    };
+    mp_mutex_lock(&sub->lock);
+    wait_render_done(sub);
+    double spts = pts_to_subtitle(sub, pts);
+    double sref = ref == MP_NOPTS_VALUE ? MP_NOPTS_VALUE : pts_to_subtitle(sub, ref);
+    struct sd *sd = sub->sd;
+    if (spts != MP_NOPTS_VALUE && sd->driver->control) {
+        double ev[6] = {spts, sref, 0, 0, 0, 0};
+        if (sd->driver->control(sd, SD_CTRL_EVENT_LOAD, ev) == CONTROL_OK) {
+            load->active = (int)ev[0];
+            load->cold = (int)ev[1];
+            load->next_starting = (int)ev[4];
+            if (ev[2] != MP_NOPTS_VALUE)
+                load->boundary = pts_from_subtitle(sub, ev[2]);
+            if (ev[3] != MP_NOPTS_VALUE)
+                load->next_boundary = pts_from_subtitle(sub, ev[3]);
+            if (ev[5] != MP_NOPTS_VALUE)
+                load->visible_end = pts_from_subtitle(sub, ev[5]);
+        }
+    }
+    mp_mutex_unlock(&sub->lock);
+}
+
+// The furthest video pts a renderer may ask sub_get_bitmaps() for ahead of
+// the playloop and still get the right answer: every packet up to it has
+// been handed to the decoder, and no pending segment switch lies before it
+// (sub_get_bitmaps would perform the switch). MP_NOPTS_VALUE while nothing
+// has been read, INFINITY once the demuxer reached EOF. Packets are assumed
+// to arrive in pts order, as interleaved muxers emit them.
+double sub_get_render_horizon(struct dec_sub *sub)
+{
+    mp_mutex_lock(&sub->lock);
+    double horizon = MP_NOPTS_VALUE;
+    if (sub->demux_eof) {
+        horizon = INFINITY;
+    } else {
+        horizon = MP_PTS_MAX(sub->read_horizon, sub->last_pkt_pts);
+    }
+    if (sub->new_segment && horizon != MP_NOPTS_VALUE)
+        horizon = MPMIN(horizon, sub->new_segment->start);
+    if (horizon != MP_NOPTS_VALUE && isfinite(horizon))
+        horizon = pts_from_subtitle(sub, horizon);
+    mp_mutex_unlock(&sub->lock);
+    return horizon;
+}
