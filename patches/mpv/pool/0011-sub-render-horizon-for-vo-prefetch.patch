+// The furthest video pts osd_render() can be asked for ahead of the playloop
+// with every subtitle decoder still answering correctly: the minimum of the
+// decoders' read horizons (see sub_get_render_horizon). INFINITY without
+// subtitles, NAN while one decoder has read nothing yet.
+double osd_get_sub_render_horizon(struct osd_state *osd)
+{
+    double horizon = INFINITY;
+    mp_mutex_lock(&osd->lock);
+    for (int n = OSDTYPE_SUB; n <= OSDTYPE_SUB2; n++) {
+        struct dec_sub *sub = osd->objs[n]->sub;
+        if (!sub)
+            continue;
+        double h = sub_get_render_horizon(sub);
+        if (h == MP_NOPTS_VALUE) {
+            horizon = NAN;
+            break;
+        }
+        horizon = MPMIN(horizon, h);
+    }
+    mp_mutex_unlock(&osd->lock);
+    return horizon;
+}
+
+// The earliest event start after `after`, how many events start there, and
+// the earliest end of what is visible at pts, over the active subtitle
+// objects (see sub_get_next_event_start, sub_get_visible_end);
+// MP_NOPTS_VALUE when unknown.
+void osd_get_sub_schedule(struct osd_state *osd, double pts, double after,
+                          double *next_start, int *next_events,
+                          double *visible_end)
+{
+    *next_start = MP_NOPTS_VALUE;
+    *next_events = 0;
+    *visible_end = MP_NOPTS_VALUE;
+    mp_mutex_lock(&osd->lock);
+    for (int n = OSDTYPE_SUB; n <= OSDTYPE_SUB2; n++) {
+        struct dec_sub *sub = osd->objs[n]->sub;
+        if (!sub)
+            continue;
+        int events = 0;
+        double start = sub_get_next_event_start(sub, after, &events);
+        if (start != MP_NOPTS_VALUE) {
+            if (*next_start == MP_NOPTS_VALUE || start < *next_start - 0.0005) {
+                *next_start = start;
+                *next_events = events;
+            } else if (fabs(start - *next_start) <= 0.0005) {
+                *next_events += events;
+            }
+        }
+        *visible_end = MP_PTS_MIN(*visible_end, sub_get_visible_end(sub, pts));
+    }
+    mp_mutex_unlock(&osd->lock);
+}
+
+// The events around pts over the active subtitle objects (see
+// sub_get_event_load): counts summed, the last boundary the latest, the next
+// boundary the earliest, the visible end the latest.
+void osd_get_sub_load(struct osd_state *osd, double pts, double ref,
+                      struct sub_event_load *load)
+{
+    *load = (struct sub_event_load){
+        .boundary = MP_NOPTS_VALUE, .next_boundary = MP_NOPTS_VALUE,
+        .visible_end = MP_NOPTS_VALUE,
+    };
+    mp_mutex_lock(&osd->lock);
+    for (int n = OSDTYPE_SUB; n <= OSDTYPE_SUB2; n++) {
+        struct dec_sub *sub = osd->objs[n]->sub;
+        if (!sub)
+            continue;
+        struct sub_event_load l;
+        sub_get_event_load(sub, pts, ref, &l);
+        load->active += l.active;
+        load->cold += l.cold;
+        if (l.boundary != MP_NOPTS_VALUE &&
+            (load->boundary == MP_NOPTS_VALUE || l.boundary > load->boundary))
+            load->boundary = l.boundary;
+        if (l.next_boundary != MP_NOPTS_VALUE &&
+            (load->next_boundary == MP_NOPTS_VALUE || l.next_boundary < load->next_boundary))
+        {
+            load->next_boundary = l.next_boundary;
+            load->next_starting = l.next_starting;
+        } else if (l.next_boundary != MP_NOPTS_VALUE &&
+                   fabs(l.next_boundary - load->next_boundary) <= 0.0005) {
+            load->next_starting += l.next_starting;
+        }
+        load->visible_end = MP_PTS_MAX(load->visible_end, l.visible_end);
+    }
+    mp_mutex_unlock(&osd->lock);
+}
