+// The subtitle events around a video pts, for a renderer scheduling its work.
+// `ref` is the pts of the frame the renderer rendered last: events visible
+// at pts but not at ref have not been rasterized yet and cost accordingly.
+struct sub_event_load {
+    int active;          // events visible at pts
+    int cold;            // of active, those not visible at ref
+    double boundary;     // last event start or end <= pts: the frame's content
+                         // has been these events since then; MP_NOPTS_VALUE unknown
+    double next_boundary; // first event start or end > pts, or MP_NOPTS_VALUE
+    int next_starting;   // events starting at next_boundary
+    double visible_end;  // latest end among active, or MP_NOPTS_VALUE
+};
+void sub_get_event_load(struct dec_sub *sub, double pts, double ref,
+                        struct sub_event_load *load);
