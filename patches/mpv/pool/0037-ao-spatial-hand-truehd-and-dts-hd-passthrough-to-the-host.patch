+
+// Converts TrueHD Atmos and DTS:X to APAC with SpatialAudioBridge and keeps
+// mpv's audio clock on the synchronizer used by the renderer.
+//
+// A stream the renderer fails on falls back to PCM the way avfoundation's
+// compressed sink does: the format is latched and the output reloaded, the
+// reopen refuses it, and mpv decodes the track instead. A later PCM
+// initialization clears the latch, so the next track or file tries again.
+
+#include <stdatomic.h>
+
+#include "ao.h"
+#include "audio/format.h"
+#include "common/common.h"
+#include "common/msg.h"
+#include "internal.h"
+#include "ao_spatial.h"
+
+#import <AVFoundation/AVFoundation.h>
+#import <CoreMedia/CoreMedia.h>
+
+struct priv {
+    void *sink;
+    AVSampleBufferRenderSynchronizer *synchronizer;
+    // Nudges the ao thread while the clock waits for the renderer, which the
+    // thread would otherwise only notice at its next refill.
+    dispatch_queue_t queue;
+    dispatch_source_t wakeup_timer;
+    atomic_bool waiting;
+    // The current timeline's start on the synchronizer clock, and the samples
+    // written since.
+    CMTime timeline;
+    int64_t written;
+    bool playing;
+    bool paused;
+    bool clock_running;
+    // The renderer has finished this timeline; the next write begins another.
+    bool ended;
+    bool reload_requested;
+};
+
+static _Atomic bool spatial_format_latch[2];
+
+static int spatial_latch_index(int format)
+{
+    return format == AF_FORMAT_S_DTSHD;
+}
+
+static int64_t ns_from_time(CMTime time)
+{
+    return CMTimeConvertScale(time, 1000000000, kCMTimeRoundingMethod_Default).value;
+}
+
+// Arms the timer that nudges the ao thread only while the clock waits.
+static void set_waiting(struct ao *ao, bool waiting)
+{
+    struct priv *p = ao->priv;
+
+    atomic_store(&p->waiting, waiting);
+    dispatch_source_set_timer(p->wakeup_timer,
+        waiting ? dispatch_time(DISPATCH_TIME_NOW, 10 * NSEC_PER_MSEC) : DISPATCH_TIME_FOREVER,
+        10 * NSEC_PER_MSEC, NSEC_PER_MSEC);
+}
+
+// Audio written but not yet played. While the clock waits, that is all of it,
+// so mpv's audio position, and with it the video, waits too.
+static int64_t queued_ns(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    // Split so that days of 192 kHz audio stay within int64.
+    int64_t written = p->written / ao->samplerate * INT64_C(1000000000) +
+                      p->written % ao->samplerate * INT64_C(1000000000) / ao->samplerate;
+    int64_t now = ns_from_time(CMTimebaseGetTime(p->synchronizer.timebase));
+    return MPMAX(ns_from_time(p->timeline) + written - now, 0);
+}
+
+static void begin_timeline(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    [p->synchronizer setRate:0];
+    p->timeline = CMTimebaseGetTime(p->synchronizer.timebase);
+    p->written = 0;
+    p->playing = false;
+    p->paused = false;
+    p->clock_running = false;
+    p->ended = false;
+    set_waiting(ao, false);
+    mp_spatial_begin(p->sink, ns_from_time(p->timeline));
+}
+
+static int init(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    int codec;
+    if (ao->format == AF_FORMAT_S_TRUEHD) {
+        codec = 1;
+    } else if (ao->format == AF_FORMAT_S_DTSHD) {
+        codec = 2;
+    } else {
+        if (!af_fmt_is_spdif(ao->format)) {
+            atomic_store(&spatial_format_latch[0], false);
+            atomic_store(&spatial_format_latch[1], false);
+        }
+        MP_VERBOSE(ao, "only TrueHD and DTS-HD passthrough are handed to the renderer\n");
+        return -1;
+    }
+    if (atomic_load(&spatial_format_latch[spatial_latch_index(ao->format)])) {
+        MP_INFO(ao, "%s failed in the renderer; decoding it instead\n",
+                af_fmt_to_str(ao->format));
+        return -1;
+    }
+
+    p->synchronizer = [[AVSampleBufferRenderSynchronizer alloc] init];
+    p->sink = mp_spatial_create(codec, (void *)p->synchronizer);
+    if (!p->sink) {
+        MP_VERBOSE(ao, "the renderer refused the stream\n");
+        [p->synchronizer release];
+        p->synchronizer = nil;
+        return -1;
+    }
+
+    mp_spatial_volume(p->sink, atomic_load(&ao->gain));
+
+    // The renderer's encoder holds 1.5 s before its first output, so let mpv
+    // queue well beyond that.
+    ao->device_buffer = ao->samplerate * 3;
+
+    p->queue = dispatch_queue_create("mpv spatial audio", DISPATCH_QUEUE_SERIAL);
+    p->wakeup_timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, p->queue);
+    dispatch_source_set_timer(p->wakeup_timer, DISPATCH_TIME_FOREVER, 0, 0);
+    dispatch_source_set_event_handler(p->wakeup_timer, ^{
+        if (atomic_load(&p->waiting))
+            ao_wakeup(ao);
+    });
+    dispatch_resume(p->wakeup_timer);
+
+    begin_timeline(ao);
+    return 0;
+}
+
+static void uninit(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    // Not set when init() failed.
+    if (!p->queue)
+        return;
+    dispatch_source_cancel(p->wakeup_timer);
+    // A handler already running finishes before this returns.
+    dispatch_sync(p->queue, ^{});
+    dispatch_release(p->wakeup_timer);
+    dispatch_release(p->queue);
+
+    [p->synchronizer setRate:0];
+    mp_spatial_destroy(p->sink);
+    [p->synchronizer release];
+}
+
+static void reset(struct ao *ao)
+{
+    begin_timeline(ao);
+}
+
+static void start(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    p->playing = true;
+    set_waiting(ao, !p->paused && !p->clock_running);
+}
+
+static bool set_pause(struct ao *ao, bool paused)
+{
+    struct priv *p = ao->priv;
+
+    p->paused = paused;
+    if (p->clock_running)
+        [p->synchronizer setRate:paused ? 0 : 1];
+    set_waiting(ao, p->playing && !paused && !p->clock_running);
+    return true;
+}
+
+static bool audio_write(struct ao *ao, void **data, int samples)
+{
+    struct priv *p = ao->priv;
+
+    // After an underrun the clock has run past everything written, so
+    // continuing that timeline would place new audio in the past. After the
+    // end (gapless playback goes on to the next file without a reset), the
+    // renderer takes no more audio on it. Either way a new timeline begins, and
+    // playback stays active: mpv calls start() only if it saw the underrun.
+    if (p->ended || (p->clock_running && queued_ns(ao) == 0)) {
+        MP_VERBOSE(ao, "beginning a new timeline\n");
+        bool playing = p->playing;
+        begin_timeline(ao);
+        p->playing = playing;
+        set_waiting(ao, playing);
+    }
+    mp_spatial_write(p->sink, data[0], (size_t)samples * ao->sstride);
+    p->written += samples;
+    return true;
+}
+
+// The renderer holds back the start of a stream, and its encoder the latest
+// audio, until it has more; at the end it has to let both go.
+static void end_of_stream(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    p->ended = true;
+    mp_spatial_end(p->sink);
+}
+
+// mpv's software volume never reaches a bitstream, so the renderer applies it.
+// mpv calls this whenever it changes, paused or not.
+static void set_gain(struct ao *ao, float gain)
+{
+    struct priv *p = ao->priv;
+
+    // ao_alloc() sets the gain before init() has opened the renderer.
+    if (!p->queue)
+        return;
+    mp_spatial_volume(p->sink, gain);
+}
+
+static void get_state(struct ao *ao, struct mp_pcm_state *state)
+{
+    struct priv *p = ao->priv;
+
+    if (mp_spatial_failed(p->sink) && !p->reload_requested) {
+        MP_WARN(ao, "the renderer failed to render the stream, falling back to PCM\n");
+        p->reload_requested = true;
+        atomic_store(&spatial_format_latch[spatial_latch_index(ao->format)], true);
+        ao_request_reload(ao);
+    }
+
+    if (p->playing && !p->paused && !p->clock_running &&
+        mp_spatial_ready(p->sink))
+    {
+        [p->synchronizer setRate:1 time:p->timeline];
+        p->clock_running = true;
+        set_waiting(ao, false);
+    }
+
+    int64_t queued = queued_ns(ao);
+
+    // After the end mpv writes nothing until this timeline has played out, and
+    // its thread would sleep a quarter of the buffer before noticing, holding
+    // up EOF and a gapless next file. Paused, nothing plays out.
+    bool draining = p->ended && !p->paused && queued > 0;
+    if (p->ended && atomic_load(&p->waiting) != draining)
+        set_waiting(ao, draining);
+
+    state->queued_samples = queued * ao->samplerate / INT64_C(1000000000);
+    int period = ao->samplerate / 100;
+    state->free_samples = MPMAX(ao->device_buffer - state->queued_samples, 0)
+                          / period * period;
+    // The next file's audio waits until this one has played out.
+    if (p->ended && queued > 0)
+        state->free_samples = 0;
+    state->delay = queued / 1e9;
+    state->playing = p->playing && queued > 0;
+}
+
+const struct ao_driver audio_out_spatial = {
+    .description = "TrueHD and DTS-HD passthrough to Apple spatial audio",
+    .name        = "spatial",
+    .init        = init,
+    .uninit      = uninit,
+    .reset       = reset,
+    .start       = start,
+    .set_pause   = set_pause,
+    .write       = audio_write,
+    .get_state   = get_state,
+    .end_of_stream = end_of_stream,
+    .set_gain    = set_gain,
+    .priv_size   = sizeof(struct priv),
+};
diff --git a/audio/out/ao_spatial.swift b/audio/out/ao_spatial.swift
new file mode 100644
index 0000000..e5ab453
--- /dev/null
+++ b/audio/out/ao_spatial.swift
@@ -0,0 +1,268 @@
+import AVFoundation
+import Synchronization
+
+// Compiled with SpatialAudioBridge's renderer sources into libmpv. The C side
+// owns this object and the synchronizer; asynchronous work never calls mpv.
+@available(macOS 26, iOS 26, tvOS 26, *)
+private final class SpatialOutput: Sendable {
+    private struct Timeline {
+        let input: AsyncStream<Data>.Continuation
+        let feeder: Task<Void, Never>
+    }
+
+    private struct State {
+        var renderer: SpatialAudioRenderer?
+        var timeline: Timeline?
+        var generation = 0
+        var readyGeneration = -1
+        var failed = false
+        var volume: Float = 1
+        var volumeUpdate: Task<Void, Never>?
+        var activator: AtmosOutputActivator?
+        var resourceDirectory: URL?
+    }
+
+    private let state: Mutex<State>
+
+    init(codec: SpatialAudioCodec, synchronizer: AVSampleBufferRenderSynchronizer) throws {
+        let renderer = try SpatialAudioRenderer(codec: codec, synchronizer: synchronizer)
+        try SpatialSession.acquire()
+        state = Mutex(State(renderer: renderer))
+        Task { @MainActor [weak self] in
+            guard let self else { return }
+            // AVPlayer needs a file URL. The build embeds the pinned silent
+            // clip so a static libmpv needs no application resource bundle.
+            var directory: URL?
+            do {
+                guard self.state.withLock({ $0.renderer != nil }) else { return }
+                let root = FileManager.default.temporaryDirectory
+                    .appendingPathComponent("mpv-spatial-\(UUID().uuidString)", isDirectory: true)
+                try FileManager.default.createDirectory(at: root, withIntermediateDirectories: false,
+                    attributes: [.posixPermissions: 0o700])
+                directory = root
+                let stream = root.appendingPathComponent("silent-atmos.mp4")
+                try mpSpatialSilentAtmos.write(to: stream, options: .atomic)
+                let activator = AtmosOutputActivator(silentAtmosStream: stream)
+                activator.attach(to: synchronizer)
+                let current = self.state.withLock { state in
+                    guard state.renderer != nil else { return false }
+                    state.activator = activator
+                    state.resourceDirectory = root
+                    return true
+                }
+                if current { directory = nil } else { activator.detach() }
+            } catch {
+                self.fail(error)
+            }
+            if let directory { try? FileManager.default.removeItem(at: directory) }
+        }
+    }
+
+    var ready: Bool { state.withLock { $0.readyGeneration == $0.generation } }
+    var failed: Bool { state.withLock { $0.failed } }
+
+    func begin(_ nanoseconds: Int64) {
+        let time = CMTime(value: nanoseconds, timescale: 1_000_000_000)
+        let (bursts, input) = AsyncStream<Data>.makeStream()
+        state.withLock { state in
+            state.generation += 1
+            let generation = state.generation
+            let previous = state.timeline
+            previous?.input.finish()
+            previous?.feeder.cancel()
+            guard let renderer = state.renderer else { return }
+            let feeder = Task { [weak self] in
+                guard let self else { return }
+                await self.feed(bursts, renderer: renderer, time: time,
+                    previous: previous?.feeder, generation: generation)
+            }
+            state.timeline = Timeline(input: input, feeder: feeder)
+        }
+    }
+
+    func write(_ bytes: Data) { _ = state.withLock { $0.timeline }?.input.yield(bytes) }
+    func end() { state.withLock { $0.timeline }?.input.finish() }
+
+    func setVolume(_ volume: Float) {
+        state.withLock { state in
+            state.volume = volume
+            guard let renderer = state.renderer else { return }
+            let previous = state.volumeUpdate
+            state.volumeUpdate = Task { [weak self] in
+                await previous?.value
+                guard let volume = self?.state.withLock({ $0.volume }) else { return }
+                await renderer.setVolume(volume)
+            }
+        }
+    }
+
+    func close() {
+        let old = state.withLock { state in
+            defer { state = State(generation: state.generation + 1) }
+            return state
+        }
+        guard let renderer = old.renderer else { return }
+        old.timeline?.input.finish()
+        old.timeline?.feeder.cancel()
+        // Release a feeder waiting for space on the now-stopped clock.
+        Task { try? await renderer.begin(at: .zero) }
+        Task { @MainActor in
+            old.activator?.detach()
+            if let directory = old.resourceDirectory {
+                try? FileManager.default.removeItem(at: directory)
+            }
+        }
+        // Restore synchronously before mpv opens the fallback output.
+        SpatialSession.release()
+    }
+
+    private func feed(_ bursts: AsyncStream<Data>, renderer: SpatialAudioRenderer,
+                      time: CMTime, previous: Task<Void, Never>?, generation: Int) async {
+        do {
+            try Task.checkCancellation()
+            try await renderer.begin(at: time)
+            await previous?.value
+            try Task.checkCancellation()
+            try await renderer.begin(at: time)
+            var unpacker = IEC61937Unpacker()
+            var ready = false
+            var enqueued = false
+            for await chunk in bursts {
+                let stream = try unpacker.unpack(chunk)
+                guard !stream.isEmpty else { continue }
+                try await renderer.enqueue(stream, time: time + unpacker.skippedDuration)
+                enqueued = true
+                if !ready, await renderer.isReadyToPlay {
+                    ready = true
+                    markReady(generation)
+                }
+            }
+            guard !Task.isCancelled, enqueued else { return }
+            // A partial final IEC unit does not discard already decoded audio.
+            try? unpacker.finish()
+            try await renderer.endOfStream()
+            markReady(generation)
+        } catch is CancellationError {
+        } catch {
+            fail(error, generation: generation)
+        }
+    }
+
+    private func markReady(_ generation: Int) {
+        state.withLock { if $0.generation == generation { $0.readyGeneration = generation } }
+    }
+
+    private func fail(_ error: Error, generation: Int? = nil) {
+        let current = state.withLock { state in
+            guard state.renderer != nil, generation == nil || state.generation == generation else { return false }
+            state.failed = true
+            return true
+        }
+        if current { NSLog("[ao_spatial] Falling back to PCM: %@", String(describing: error)) }
+    }
+}
+
+// AVAudioSession is process-wide. Overlapping mpv outputs share the session
+// and the last close restores the configuration observed by the first open.
+@available(macOS 26, iOS 26, tvOS 26, *)
+private enum SpatialSession {
+    #if os(iOS) || os(tvOS)
+    private struct State {
+        var users = 0
+        var category = AVAudioSession.Category.playback
+        var mode = AVAudioSession.Mode.default
+        var options: AVAudioSession.CategoryOptions = []
+        var multichannel = false
+    }
+    private static let state = Mutex(State())
+    #endif
+
+    static func acquire() throws {
+        #if os(iOS) || os(tvOS)
+        try state.withLock { state in
+            if state.users == 0 {
+                let session = AVAudioSession.sharedInstance()
+                state.category = session.category
+                state.mode = session.mode
+                state.options = session.categoryOptions
+                state.multichannel = session.supportsMultichannelContent
+                do {
+                    try session.setCategory(.playback, mode: .moviePlayback)
+                    try session.setSupportsMultichannelContent(true)
+                    try session.setActive(true)
+                } catch {
+                    try? session.setCategory(state.category, mode: state.mode, options: state.options)
+                    try? session.setSupportsMultichannelContent(state.multichannel)
+                    throw error
+                }
+            }
+            state.users += 1
+        }
+        #endif
+    }
+
+    static func release() {
+        #if os(iOS) || os(tvOS)
+        state.withLock { state in
+            state.users -= 1
+            guard state.users == 0 else { return }
+            let session = AVAudioSession.sharedInstance()
+            do {
+                try session.setActive(false, options: .notifyOthersOnDeactivation)
+            } catch { NSLog("[ao_spatial] Cannot deactivate audio session: %@", String(describing: error)) }
+            do {
+                try session.setCategory(state.category, mode: state.mode, options: state.options)
+            } catch { NSLog("[ao_spatial] Cannot restore audio session category: %@", String(describing: error)) }
+            do {
+                try session.setSupportsMultichannelContent(state.multichannel)
+            } catch { NSLog("[ao_spatial] Cannot restore multichannel setting: %@", String(describing: error)) }
+        }
+        #endif
+    }
+}
+
+@_cdecl("mp_spatial_create")
+func mpSpatialCreate(_ codec: Int32, _ pointer: UnsafeMutableRawPointer) -> UnsafeMutableRawPointer? {
+    guard #available(macOS 26, iOS 26, tvOS 26, *), let codec = SpatialAudioCodec(rawValue: UInt32(codec)) else { return nil }
+    let synchronizer = Unmanaged<AVSampleBufferRenderSynchronizer>.fromOpaque(pointer).takeUnretainedValue()
+    do {
+        return Unmanaged.passRetained(try SpatialOutput(codec: codec, synchronizer: synchronizer)).toOpaque()
+    } catch {
+        NSLog("[ao_spatial] Cannot open output: %@", String(describing: error))
+        return nil
+    }
+}
+
+@_cdecl("mp_spatial_destroy")
+func mpSpatialDestroy(_ pointer: UnsafeMutableRawPointer) {
+    if #available(macOS 26, iOS 26, tvOS 26, *) {
+        Unmanaged<SpatialOutput>.fromOpaque(pointer).takeRetainedValue().close()
+    }
+}
+
+@_cdecl("mp_spatial_begin")
+func mpSpatialBegin(_ pointer: UnsafeMutableRawPointer, _ nanoseconds: Int64) {
+    if #available(macOS 26, iOS 26, tvOS 26, *) { Unmanaged<SpatialOutput>.fromOpaque(pointer).takeUnretainedValue().begin(nanoseconds) }
+}
+@_cdecl("mp_spatial_write")
+func mpSpatialWrite(_ pointer: UnsafeMutableRawPointer, _ bytes: UnsafeRawPointer, _ size: Int) {
+    if #available(macOS 26, iOS 26, tvOS 26, *) { Unmanaged<SpatialOutput>.fromOpaque(pointer).takeUnretainedValue().write(Data(bytes: bytes, count: size)) }
+}
+@_cdecl("mp_spatial_end")
+func mpSpatialEnd(_ pointer: UnsafeMutableRawPointer) {
+    if #available(macOS 26, iOS 26, tvOS 26, *) { Unmanaged<SpatialOutput>.fromOpaque(pointer).takeUnretainedValue().end() }
+}
+@_cdecl("mp_spatial_ready")
