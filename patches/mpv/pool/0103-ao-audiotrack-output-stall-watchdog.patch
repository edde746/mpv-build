+// Replace the track from the worker (p->lock held). The old track's buffered
+// audio is lost; the core resyncs on the delay drop. Playback resumes at
+// once when the core still wants it, so a recreate never parks the worker
+// on a STOPPED track waiting for a start() that already happened.
+static int AudioTrack_Recreate(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    JNIEnv *env = MP_JNI_GET_ENV(ao);
+
+    mp_mutex_lock(&p->track_lock);
+    if (p->audiotrack) {
