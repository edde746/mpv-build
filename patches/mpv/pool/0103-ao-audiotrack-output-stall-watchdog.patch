+// Watches the worker from outside its lock. While the core wants playback
+// and a write is outstanding, a playback head that does not move for
+// STALL_TIMEOUT_NS means the device stopped consuming: pause the track to
+// pull the worker out of AudioTrack.write and have it rebuild the track, or
+// once that has been tried, tell the core to end playback. Head samples
+// also refresh the progress clock, so a slow device that still drains keeps
+// a long write out of the stall verdict.
+static MP_THREAD_VOID monitor_thread(void *arg)
+{
+    struct ao *ao = arg;
+    struct priv *p = ao->priv;
+    JNIEnv *env = MP_JNI_GET_ENV(ao);
+    mp_thread_set_name("ao/at-monitor");
+    uint32_t last_head = 0;
+    bool have_head = false;
+    int64_t healthy_since = 0;
+    mp_mutex_lock(&p->monitor_lock);
+    while (!atomic_load(&p->monitor_terminate)) {
+        mp_cond_timedwait(&p->monitor_wakeup, &p->monitor_lock, STALL_POLL_NS);
+        if (atomic_load(&p->monitor_terminate))
+            break;
+        if (atomic_load(&p->failed) || !atomic_load(&p->play_requested)) {
+            have_head = false;
+            continue;
+        }
+
+        mp_mutex_lock(&p->track_lock);
+        uint32_t head = 0;
+        bool sampled = false;
+        if (p->audiotrack) {
+            head = 0xFFFFFFFFL & MP_JNI_CALL_INT(p->audiotrack, AudioTrack.getPlaybackHeadPosition);
+            sampled = MP_JNI_EXCEPTION_LOG(ao) >= 0;
+        }
+        mp_mutex_unlock(&p->track_lock);
+        if (!sampled) {
+            have_head = false;
+            continue;
+        }
+
+        int64_t now = mp_time_ns();
+        if (!have_head || head != last_head) {
+            if (have_head) {
+                atomic_store(&p->write_progress_ns, now);
+                if (atomic_load(&p->recovery_attempts) > 0) {
+                    if (!healthy_since) {
+                        healthy_since = now;
+                    } else if (now - healthy_since >= STALL_RECOVERED_NS) {
+                        MP_VERBOSE(ao, "audio output recovered; clearing recovery budget\n");
+                        atomic_store(&p->recovery_attempts, 0);
+                        healthy_since = 0;
+                    }
+                }
+            }
+            last_head = head;
+            have_head = true;
+            continue;
+        }
+
+        if (!atomic_load(&p->write_outstanding))
+            continue;
+        int64_t stalled_ns = now - atomic_load(&p->write_progress_ns);
+        if (stalled_ns < STALL_TIMEOUT_NS)
+            continue;
+
+        healthy_since = 0;
+        char why[96];
+        snprintf(why, sizeof(why), "AudioTrack accepted no audio for %d ms",
+                 (int)(stalled_ns / 1000000));
