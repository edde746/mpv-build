+            // then sees recreate_requested at the top of its loop. Never
+            // take p->lock here: the worker holds it across the write, so
+            // a monitor waiting on it would hang once the replacement track
+            // stalls too. A paused worker polls every 300 ms regardless.
+            MP_JNI_CALL_VOID(p->audiotrack, AudioTrack.pause);
+            MP_JNI_EXCEPTION_LOG(ao);
+        }
+        mp_mutex_unlock(&p->track_lock);
+    }
+    mp_mutex_unlock(&p->monitor_lock);
+    MP_THREAD_RETURN();
+}
