@@ -476,6 +481,20 @@
 // (head - clock) offsets, taken at least 30 ms apart, and report
 // clock + mean offset, which spreads a period-sized step over the window.
 //
+// Two guards from the same tracker bound what the average alone cannot:
+//  - the estimate may not run ahead of what was written. It does exactly
+//    that whenever the head stalls (device underrun, the HAL freezing its
+//    position) while the clock keeps going, and the uint32 (written - head)
+//    then wraps into a bogus multi-hour delay that getLatency zeroes, i.e.
+//    the core sees the whole remaining buffer vanish in one step. Clamp to
+//    `written` and restart the window so the stale offsets do not survive
+//    the stall;
+//  - between two reports the position may not deviate from "last report
+//    + elapsed wall time" by more than 10% of that elapsed time, unless it
+//    is a second or more off. A single bad head read or a stall shorter
+//    than the pipeline depth still moves the average by a tenth of itself;
+//    this keeps that below a frame.
+//
 // `head` is the wrap-safe position relative to the post-flush origin, in
 // ao->samplerate frames; the return value is its smoothed equivalent.
 static uint32_t AudioTrack_smoothPlayhead(struct ao *ao, uint32_t head)
@@ -504,6 +523,28 @@
     for (int n = 0; n < p->smooth_count; n++)
         sum += p->smooth_offset[n];
     int64_t est = llround(clock + sum / p->smooth_count);
+
+    if (p->smooth_reported_ns) {
+        double elapsed = MP_TIME_NS_TO_S(now - p->smooth_reported_ns) *
+                         ao->samplerate;
+        int64_t expected = p->smooth_reported + llround(elapsed);
+        int64_t drift = est - expected;
+        if (drift && llabs(drift) < ao->samplerate) {
+            int64_t allowed = llround(elapsed * 0.1);
+            est = MPCLAMP(est, expected - allowed, expected + allowed);
+        }
+    }
+    p->smooth_reported = est;
+    p->smooth_reported_ns = now;
+
+    int32_t over = (int32_t)((uint32_t)est - p->written_frames);
+    if (over > 0) {
+        est -= over;
+        p->smooth_count = 0;
+        p->smooth_next = 0;
+        p->smooth_sampled = 0;
+        p->smooth_reported_ns = 0;
+    }
     return (uint32_t)est;
 }
 
