+// IEC 61937 burst parser states
+enum {
+    RAW_SYNC_PA = 0,
+    RAW_SYNC_PB,
+    RAW_PC,
+    RAW_PD,
+    RAW_PAYLOAD,
+};
+
+// IEC 61937-2 data types carried by the stereo bursts we unwrap.
+#define IEC61937_AC3  0x01
+#define IEC61937_DTS1 0x0b
+#define IEC61937_DTS2 0x0c
+#define IEC61937_DTS3 0x0d
+#define IEC61937_EAC3 0x15
+
+static jint raw_encoding_for_format(int format, int *rate_mult)
+{
+    *rate_mult = 1;
+    switch (format) {
+    case AF_FORMAT_S_AC3:
+        return AudioFormat.ENCODING_AC3;
+    case AF_FORMAT_S_EAC3:
+        // ad_spdif opens E-AC3 at the 192 kHz IEC carrier rate; the raw
+        // track runs at the codec's 48 kHz frame rate.
+        *rate_mult = 4;
+        return AudioFormat.ENCODING_E_AC3;
+    case AF_FORMAT_S_DTS:
+        return AudioFormat.ENCODING_DTS;
+    default:
+        // TrueHD (MAT) and DTS-HD MA keep the 8-channel IEC 61937 carrier:
+        // their raw forms are not trivially recoverable from the bursts.
+        return 0;
+    }
 }
 
+// Whether the current route takes a direct AudioTrack of this exact raw
+// tuple. getMinBufferSize alone can size formats the route cannot actually
+// play, and a lying HAL then opens a raw track that renders silence - the
+// failure class the raw path exists to fix. media3 gates its raw
+// passthrough on the same probe. Below API 29 the probe does not exist;
+// answering true there leaves the getMinBufferSize/init-failure fallbacks
+// in charge, which is also media3's pre-29 behavior.
+static bool AudioTrack_rawRouteSupported(struct ao *ao, jint format,
+                                         jint samplerate, jint channel_config)
+{
+    JNIEnv *env = MP_JNI_GET_ENV(ao);
+    if (!AudioTrack.isDirectPlaybackSupported ||
+        !AudioFormatBuilder.clazz || !AudioAttributesBuilder.clazz)
+        return true;
+
+    jobject tmp = NULL;
+
+    jobject format_builder = MP_JNI_NEW(AudioFormatBuilder.clazz, AudioFormatBuilder.ctor);
+    if (MP_JNI_EXCEPTION_LOG(ao) < 0 || !format_builder)
+        return true;
+    tmp = MP_JNI_CALL_OBJECT(format_builder, AudioFormatBuilder.setEncoding, format);
+    MP_JNI_LOCAL_FREEP(&tmp);
+    tmp = MP_JNI_CALL_OBJECT(format_builder, AudioFormatBuilder.setSampleRate, samplerate);
+    MP_JNI_LOCAL_FREEP(&tmp);
+    tmp = MP_JNI_CALL_OBJECT(format_builder, AudioFormatBuilder.setChannelMask, channel_config);
+    MP_JNI_LOCAL_FREEP(&tmp);
+    jobject afmt = MP_JNI_CALL_OBJECT(format_builder, AudioFormatBuilder.build);
+    MP_JNI_LOCAL_FREEP(&format_builder);
+
+    jobject attr_builder = MP_JNI_NEW(AudioAttributesBuilder.clazz, AudioAttributesBuilder.ctor);
+    if (MP_JNI_EXCEPTION_LOG(ao) < 0 || !attr_builder) {
+        MP_JNI_LOCAL_FREEP(&afmt);
+        return true;
+    }
+    tmp = MP_JNI_CALL_OBJECT(attr_builder, AudioAttributesBuilder.setUsage, AudioAttributes.USAGE_MEDIA);
+    MP_JNI_LOCAL_FREEP(&tmp);
+    tmp = MP_JNI_CALL_OBJECT(attr_builder, AudioAttributesBuilder.setContentType, AudioAttributes.CONTENT_TYPE_MOVIE);
+    MP_JNI_LOCAL_FREEP(&tmp);
+    jobject attr = MP_JNI_CALL_OBJECT(attr_builder, AudioAttributesBuilder.build);
+    MP_JNI_LOCAL_FREEP(&attr_builder);
+
+    bool supported = true;
+    if (MP_JNI_EXCEPTION_LOG(ao) < 0 || !afmt || !attr)
+        goto done; // a malfunctioning probe is not a "no"
+
+    supported = MP_JNI_DO(CallStaticBooleanMethod, AudioTrack.clazz,
+                          AudioTrack.isDirectPlaybackSupported, afmt, attr);
+    if (MP_JNI_EXCEPTION_LOG(ao) < 0)
+        supported = true;
+
+done:
+    MP_JNI_LOCAL_FREEP(&afmt);
+    MP_JNI_LOCAL_FREEP(&attr);
+    return supported;
+}
