+// Incrementally unwraps an IEC 61937 stream (16-bit little-endian words as
+// produced by libavformat's spdif muxer) back into the raw codec byte
+// stream. Payload words are byte-swapped back to bitstream order; preambles
+// and zero padding are dropped. Burst boundaries may fall anywhere inside
+// [src, src+len), so parser state persists in priv across calls.
+static int AudioTrack_unwrapIEC61937(struct ao *ao, uint8_t *dst,
+                                     const uint8_t *src, int len)
+{
+    struct priv *p = ao->priv;
+    int out = 0;
+
+    for (int i = 0; i + 1 < len; i += 2) {
+        const uint8_t lo = src[i], hi = src[i + 1];
+
+        if (p->raw_state == RAW_PAYLOAD) {
+            // spdifenc byte-swaps the payload into LE words; a lone final
+            // byte rides the high half of its word. Swapping each pair and
+            // emitting only the bytes Pd promised undoes both.
+            dst[out++] = hi;
+            if (--p->raw_payload_left > 0) {
+                dst[out++] = lo;
+                p->raw_payload_left--;
+            }
+            if (p->raw_payload_left == 0)
+                p->raw_state = RAW_SYNC_PA;
+            continue;
+        }
+
+        const uint16_t word = lo | (hi << 8);
+        switch (p->raw_state) {
+        case RAW_SYNC_PA:
+            if (word == 0xf872)
+                p->raw_state = RAW_SYNC_PB;
+            break;
+        case RAW_SYNC_PB:
+            if (word == 0x4e1f)
+                p->raw_state = RAW_PC;
+            else
+                p->raw_state = word == 0xf872 ? RAW_SYNC_PB : RAW_SYNC_PA;
+            break;
+        case RAW_PC:
+            p->raw_data_type = word & 0x7f;
+            p->raw_state = RAW_PD;
+            break;
+        case RAW_PD:
+            switch (p->raw_data_type) {
+            case IEC61937_AC3:
+            case IEC61937_DTS1:
+            case IEC61937_DTS2:
+            case IEC61937_DTS3:
+                p->raw_payload_left = word >> 3; // Pd in bits
+                break;
+            case IEC61937_EAC3:
+                p->raw_payload_left = word; // Pd in bytes
+                break;
+            default:
+                MP_WARN(ao, "unexpected IEC 61937 data type 0x%x\n",
+                        p->raw_data_type);
+                p->raw_payload_left = 0;
+                break;
+            }
+            p->raw_state = p->raw_payload_left > 0 ? RAW_PAYLOAD : RAW_SYNC_PA;
+            break;
+        }
+    }
+
+    return out;
+}
