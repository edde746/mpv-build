+// The display's vsync period changed (or is first known). A fresh phase
+// sample on the new grid is requested at once rather than at the next
+// 500 ms resample, and the attached vo re-times its next frame against it.
+static void refresh_rate_callback(int64_t vsync_period_ns, void *data)
+{
+    mp_mutex_lock(&vsync_sampler.lock);
+    if (vsync_period_ns > 0 && vsync_period_ns != vsync_sampler.vsync_period) {
+        vsync_sampler.vsync_period = vsync_period_ns;
+        struct vo *vo = vsync_sampler.client;
+        if (vo) {
+            MP_VERBOSE(vo, "Choreographer vsync period: %.3f Hz\n",
+                       1e9 / vsync_period_ns);
+            ((struct priv *)vo->priv)->vsync_sample = 0;
+            post_vsync_callback(false);
+            vo_event(vo, VO_EVENT_WIN_STATE);
+            vo_wakeup(vo);
+        }
+    }
+    mp_mutex_unlock(&vsync_sampler.lock);
+}
