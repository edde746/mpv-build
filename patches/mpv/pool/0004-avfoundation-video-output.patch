+    // backing surface lets the clear touch just those rows instead of the
+    // whole display-sized buffer. The CFRetain on the surface pins its
+    // pointer so an entry can never alias a different (recycled) surface.
+    struct osd_buf_state {
+        IOSurfaceRef surf;     // CFRetained
+        struct mp_rect dirty;  // drawn region from the surface's last use
+        int64_t last_used_ns;
+    } osd_buf_states[4];
+    int osd_buf_state_count;
+
+    // OSD performance counters; accumulation is unconditional (cheap),
+    // formatted output is gated on -v.
+    struct {
+        int renders, skipped, empty, frames;
+        int64_t total_ns, max_ns;
+        int64_t clear_ns, blend_ns, cg_ns, bounds_ns;
+        int64_t enqueue_ns, video_sample_ns;
+        // Scheduling margin of enqueued OSD samples: sample PTS minus the
