+#import <AppKit/AppKit.h>
+#endif
+
+struct avf_render_geometry {
+    int w, h;
+    struct mp_rect src, dst;
+    struct mp_osd_res osd_res;
+};
+
+// The canvas libass lays the OSD out on (res) and the pixel size of the
+// overlay buffer it is drawn into.
+struct avf_osd_canvas {
+    int w, h;
+    struct mp_osd_res res;
+};
+
+// --- avf osd ahead policy
+
+// How long flip_page may wait for its frame's subtitles before it enqueues
+// the video without them, as an mp_time_ns deadline (0: do not wait).
+// Subtitles render ahead on the shared pipeline's thread (osd_ahead.h), so
+// the wait is normally just the handoff of a result that is already there.
+// A timed frame keeps at least half its queue lead for the video: a slow
+// render costs the subtitle a frame, never the video. While the render
+// thread is still busy with an older frame, waiting would only buy part of
+// that render, so the frame does not wait and shows what is ready. An
+// untimed frame (a redraw, or any frame while paused) has no deadline to
+// keep and waits a bounded time; a result later than that is shown on its
+// own while paused (ahead_present_late). The composite modes draw the subtitle into the
+// video sample itself, so they wait as the synchronous path did.
+#define AVF_OSD_UNTIMED_WAIT_NS INT64_C(250000000)
+#define AVF_OSD_COMPOSITE_WAIT_NS INT64_C(1000000000)
+
+static int64_t avf_osd_wait_until(int64_t now, int64_t present_ns,
+                                  int64_t queue_lead_ns, bool timed,
+                                  bool composite, bool behind)
+{
+    if (composite)
+        return now + AVF_OSD_COMPOSITE_WAIT_NS;
+    if (behind)
+        return 0;
+    if (!timed)
+        return now + AVF_OSD_UNTIMED_WAIT_NS;
+    int64_t until = present_ns - queue_lead_ns / 2;
+    return until > now ? until : 0;
+}
+
+// --- end avf osd ahead policy
+
+enum avf_osd_draw_path {
+    AVF_OSD_DRAW_NONE = 0,
+    AVF_OSD_DRAW_DIRECT_LIBASS,
+    AVF_OSD_DRAW_DIRECT_BGRA,
+    AVF_OSD_DRAW_COREGRAPHICS,
+};
+
+// How enqueued samples are timed against the display layer's timebase.
+//
+// Host mode reproduces the original single-clock design: samples carry
+// mpv's scheduled display time (frame->pts) and the timebase free-runs on
+// the host clock at rate 1.0. mpv's audio-slaved scheduler re-times every
+// frame, so audio/host clock skew is absorbed continuously in
+// microsecond-scale per-frame adjustments and no timing state accumulates
+// in the VO. The cost: the layer cannot pause autonomously, so up to
+// queue-lead-ms of already-queued frames still present after a pause.
+//
+// Media mode stamps container PTS against a media timebase that is
+// anchored and rate-servoed to follow mpv's schedule. PiP requires it (the
+// system PiP UI reads media time and playback rate off the layer's
+// timebase), but any error between the two clock domains can only be
+// retired by rate slewing or a visible re-anchor snap (plezy#1776).
+enum avf_presentation_mode {
+    AVF_PRESENTATION_MEDIA = 0,
+    AVF_PRESENTATION_HOST = 1,
+};
+
+struct avfoundation_opts {
+    bool composite_osd;
+    bool pip_composite_osd;
+    int queue_lead_ms;
+    int presentation;
+    int osd_max_height;
+    bool osd_video_res;
+};
+
+// --- avf sync servo core (host-testable; keep freestanding) ---
+//
+// mpv schedules video against its playback clock (normally the audio clock),
+// while the CMTimebase driving presentation runs on the CoreMedia host
+// clock. On real hardware those clocks skew against each other, and the
+// skew wanders (HDMI audio PLLs, route renegotiation, temperature). A
+// timebase that free-runs at a fixed rate therefore accumulates error, and
+// correcting it by re-anchoring is a visible >=20ms snap: queued samples
+// are suddenly early or late by the full error, so a frame repeats, skips,
+// or is dropped by the renderer outright (#1776's recurring stutter).
+//
+// Instead, sub-threshold error is absorbed by slewing the timebase rate: a
+// PI servo that retires the error over AVF_SERVO_HORIZON_NS. Rate offsets
+// this small only shift presentation deadlines by microseconds per frame,
+// so corrections are invisible; the integral term additionally absorbs any
+// constant rate mismatch (clock skew, an imperfectly inferred playback
+// rate), so the steady-state error converges to zero instead of parking at
+// mismatch * horizon. Hard re-anchoring remains only for genuine
+// discontinuities (broken timestamps, playback-speed changes, audio-clock
+// steps after route changes).
+
+// Errors above this are discontinuities: snap the anchor instead of chasing
+// them (at the slew cap, retiring 50ms would take >3s of visibly off-sync
+// video; mpv itself hard-resyncs A/V at this scale).
+#define AVF_DRIFT_SNAP_NS      MP_TIME_MS_TO_NS(50)
+// Retire the measured error over this long: the servo's time constant.
+#define AVF_SERVO_HORIZON_NS   MP_TIME_S_TO_NS(2)
+// Cap the correction offset at +-1.5% of nominal rate.
+#define AVF_SERVO_MAX_OFFSET   0.015
+// Skip timebase updates smaller than 100ppm; quantizes the steady state to
+// ~0.2ms of error rather than churning CoreMedia every frame.
+#define AVF_SERVO_MIN_DELTA    0.0001
+// Floor between consecutive rate updates; ~10x faster than the horizon, so
+// throttling never destabilizes the loop.
+#define AVF_SERVO_UPDATE_NS    MP_TIME_MS_TO_NS(200)
+// Integral time constant: 4x the horizon critically damps the loop
+// ((s + 1/(2T))^2 closed-loop poles); larger would absorb rate mismatch
+// slower, smaller would ring.
+#define AVF_SERVO_INTEGRAL_NS  (4 * AVF_SERVO_HORIZON_NS)
+// Estimate playback rate over enough frame time to average timestamp
+// quantization. Crucially, the denominator is mpv's speed-adjusted frame
+// duration, not the frame's host scheduling deadline: the latter follows the
+// audio clock and contains wakeup jitter, buffering stalls, and A/V corrections
+// that are not playback-speed changes.
+#define AVF_RATE_WINDOW_NS        MP_TIME_MS_TO_NS(500)
+#define AVF_RATE_MIN              0.05
+#define AVF_RATE_MAX              8.0
+#define AVF_RATE_CHANGE_FRACTION  0.01
+#define AVF_RATE_FAST_FRACTION    0.04
+#define AVF_RATE_FAST_SAMPLES     2
+
+// Playback-rate estimator state. Media deltas are compared with mpv's
+// speed-adjusted frame durations, never with jittery scheduling deadlines.
+struct avf_rate_est {
+    int64_t last_media_pts_ns;
+    int64_t last_frame_duration_ns;
+    bool last_sample_valid;
+    // Averaging window for steady-state drift.
+    int64_t media_span_ns;
+    int64_t real_span_ns;
+    // Confirmation window for the large-change fast path.
+    int64_t fast_media_span_ns;
+    int64_t fast_real_span_ns;
+    int fast_sample_count;
+};
+
+// Discard partially collected windows; the last-sample pair stays valid.
+static void avf_rate_reset_windows(struct avf_rate_est *e)
+{
+    e->media_span_ns = 0;
+    e->real_span_ns = 0;
+    e->fast_media_span_ns = 0;
+    e->fast_real_span_ns = 0;
+    e->fast_sample_count = 0;
+}
+
+static bool avf_rate_sample(struct avf_rate_est *e, int64_t media_pts_ns,
+                            int64_t frame_duration_ns, double current_rate,
+                            double *rate)
+{
+    if (frame_duration_ns <= 0)
+        return false;
+
+    if (!e->last_sample_valid) {
+        e->last_media_pts_ns = media_pts_ns;
+        e->last_frame_duration_ns = frame_duration_ns;
+        e->last_sample_valid = true;
+        return false;
+    }
+
+    int64_t media_delta = media_pts_ns - e->last_media_pts_ns;
+    int64_t previous_duration = e->last_frame_duration_ns;
+
+    if (media_delta == 0)
+        return false;
+
+    e->last_media_pts_ns = media_pts_ns;
+    e->last_frame_duration_ns = frame_duration_ns;
+
+    // A duration step normally means mpv's playback speed changed. Discard a
+    // partly collected old-rate window so it cannot produce an intermediate
+    // false rate. This also safely restarts estimation at VFR transitions.
+    int64_t duration_gate = MPMAX(MP_TIME_US_TO_NS(250),
+                                  llabs(previous_duration) / 100);
+    if (media_delta < 0 ||
+        llabs(frame_duration_ns - previous_duration) > duration_gate) {
+        avf_rate_reset_windows(e);
+        return false;
+    }
+
+    double instant = (double)media_delta / (double)previous_duration;
+    if (instant < AVF_RATE_MIN || instant > AVF_RATE_MAX) {
+        avf_rate_reset_windows(e);
+        return false;
+    }
+
+    // Large speed changes must not wait for the averaging window: by then a
+    // 2x schedule would already be one quarter-second away. Require two
+    // consecutive frame-duration samples so timestamp quantization or one VFR
+    // transition cannot masquerade as a speed change.
+    if (fabs(instant - current_rate) >
+            AVF_RATE_FAST_FRACTION * current_rate) {
+        if (e->fast_sample_count > 0) {
+            double fast_rate = (double)e->fast_media_span_ns /
+                               (double)e->fast_real_span_ns;
+            if (fabs(instant - fast_rate) >
+                    AVF_RATE_FAST_FRACTION * fast_rate) {
+                e->fast_media_span_ns = 0;
+                e->fast_real_span_ns = 0;
+                e->fast_sample_count = 0;
+            }
+        }
+        e->fast_media_span_ns += media_delta;
+        e->fast_real_span_ns += previous_duration;
+        e->fast_sample_count++;
+        if (e->fast_sample_count >= AVF_RATE_FAST_SAMPLES) {
+            *rate = (double)e->fast_media_span_ns /
+                    (double)e->fast_real_span_ns;
+            avf_rate_reset_windows(e);
+            return *rate >= AVF_RATE_MIN && *rate <= AVF_RATE_MAX;
+        }
+    } else {
+        e->fast_media_span_ns = 0;
+        e->fast_real_span_ns = 0;
+        e->fast_sample_count = 0;
+    }
+
+    e->media_span_ns += media_delta;
+    e->real_span_ns += previous_duration;
+    if (e->real_span_ns < AVF_RATE_WINDOW_NS)
+        return false;
+
+    *rate = (double)e->media_span_ns / (double)e->real_span_ns;
+    e->media_span_ns = 0;
+    e->real_span_ns = 0;
+    return *rate >= AVF_RATE_MIN && *rate <= AVF_RATE_MAX;
+}
+
+// Ignore implausible integration steps (scheduling stalls, first sample).
+#define AVF_SERVO_MAX_DT_NS    MP_TIME_MS_TO_NS(500)
+
+// Decide how one frame's scheduling error feeds back into the timebase.
+// error_ns: frame media pts minus the timebase's projected media time at
+// the frame's presentation time (positive = timebase behind the schedule).
+// dt_ns: host time since the previous evaluation; *integral persists
+// between calls and must be zeroed on every hard anchor.
+// Returns the rate to run at; *snap requests a hard re-anchor, *update_rate
+// requests applying the returned rate to the timebase.
+static double avf_servo_rate(int64_t error_ns, double nominal_rate,
+                             double applied_rate, int64_t now_ns,
+                             int64_t last_update_ns, int64_t dt_ns,
+                             double *integral, bool *snap,
+                             bool *update_rate)
+{
+    *snap = false;
+    *update_rate = false;
+
+    if (llabs(error_ns) > AVF_DRIFT_SNAP_NS) {
+        *snap = true;
+        return nominal_rate;
+    }
+
+    double p_term = (double)error_ns / (double)AVF_SERVO_HORIZON_NS;
+    p_term = MPCLAMP(p_term, -AVF_SERVO_MAX_OFFSET, AVF_SERVO_MAX_OFFSET);
+
+    if (dt_ns > 0 && dt_ns <= AVF_SERVO_MAX_DT_NS) {
+        *integral += p_term * (double)dt_ns / (double)AVF_SERVO_INTEGRAL_NS;
+        *integral = MPCLAMP(*integral, -AVF_SERVO_MAX_OFFSET,
+                            AVF_SERVO_MAX_OFFSET);
+    }
+
+    double offset = MPCLAMP(p_term + *integral, -AVF_SERVO_MAX_OFFSET,
+                            AVF_SERVO_MAX_OFFSET);
+    double desired = nominal_rate * (1.0 + offset);
+
+    if (fabs(desired - applied_rate) <= AVF_SERVO_MIN_DELTA * nominal_rate)
+        return applied_rate;
+    if (last_update_ns && now_ns - last_update_ns < AVF_SERVO_UPDATE_NS)
+        return applied_rate;
+
+    *update_rate = true;
+    return desired;
+}
+// --- end avf sync servo core ---
+
