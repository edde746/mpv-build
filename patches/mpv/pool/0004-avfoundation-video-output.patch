+static void record_deadline_drop(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    record_not_ready_drop(vo);
+    vo_increment_drop_count(vo, 1);
+    p->diag_drop_count++;
+}
+
+// Sleep until the renderer announces it is ready for more media data, or
+// until `until`. The announcement comes from requestMediaDataWhenReadyOnQueue:,
+// which runs the block once the renderer is (or becomes) ready, so the wait
+// costs one wakeup instead of one per millisecond of isReadyForMoreMediaData
+// polling. The 20 ms slice is a backstop for a renderer that fails without
+// ever becoming ready; the caller re-checks readiness and recovery after every
+// return.
+//
+// The block disarms the request itself, because a block that returns without
+// enqueueing is run again at once. Disarming drops the renderer's reference to
+// the block while the block is still running, so this function holds its own
+// copy, and before releasing it drains the private serial queue the block runs
+// on: a timed-out wait may stop the request while an invocation that began
+// just before is still running.
+static void wait_for_renderer_ready(struct priv *p, AVSampleBufferDisplayLayer *layer,
+                                    int64_t until)
+{
+    int64_t timeout = MPMIN(until - mp_time_ns(), MP_TIME_MS_TO_NS(20));
+    if (timeout <= 0)
+        return;
+
+    id<AVQueuedSampleBufferRendering> renderer =
+        active_sample_buffer_renderer(layer);
+    if (!renderer || !p->ready_queue) {
+        mp_sleep_ns(MPMIN(timeout, MP_TIME_MS_TO_NS(1)));
+        return;
+    }
+
+    dispatch_semaphore_t ready = dispatch_semaphore_create(0);
+    dispatch_block_t on_ready = [^{
+        [renderer stopRequestingMediaData];
+        dispatch_semaphore_signal(ready);
+    } copy];
+    [renderer requestMediaDataWhenReadyOnQueue:p->ready_queue
+                                    usingBlock:on_ready];
+    dispatch_semaphore_wait(ready, dispatch_time(DISPATCH_TIME_NOW, timeout));
+    [renderer stopRequestingMediaData];
+    dispatch_sync(p->ready_queue, ^{});
+    [on_ready release];
+    dispatch_release(ready);
+}
+
+static bool wait_until_ready_for_more_media_data(struct vo *vo, int64_t present_host_ns)
+{
+    struct priv *p = vo->priv;
+    if (display_layer_needs_recovery(p->displayLayer))
+        recover_display_layer(vo, "layer recovery request", false);
+
+    if (sample_buffer_renderer_is_ready(p->displayLayer)) {
+        p->not_ready_drop_count = 0;
+        p->last_not_ready_drop_ns = 0;
+        return true;
+    }
+
+    // A renderer that reports not-ready while the frame's deadline is still
+    // far away is back-pressure, not a failure: frames arrive up to
+    // queue-lead-ms ahead of their presentation time, and at high playback
+    // rates the renderer's queue fills long before frames are due. Pace to
+    // the drain rate by waiting until shortly before the deadline (#1484).
+    int64_t start = mp_time_ns();
+    int64_t give_up = present_host_ns > 0
+        ? present_host_ns - MP_TIME_MS_TO_NS(4)
+        : start + MP_TIME_MS_TO_NS(2);
+
+    if (give_up <= start) {
+        MP_VERBOSE(vo, "Display layer not ready %.2f ms before PTS; dropping frame\n",
+                   (present_host_ns - start) / 1000000.0);
+        record_deadline_drop(vo);
+        return false;
+    }
+
+    while (!sample_buffer_renderer_is_ready(p->displayLayer)) {
+        // Check for a failed layer before the deadline: a renderer that fails
+        // without becoming ready need not run the readiness block, so a wait
+        // can end at the deadline without having seen the failure.
+        if (display_layer_needs_recovery(p->displayLayer)) {
+            recover_display_layer(vo, "not-ready wait", false);
+            if (display_layer_needs_recovery(p->displayLayer)) {
+                // Recovery was throttle-suppressed; don't poll a failed
+                // renderer all the way to the deadline.
+                MP_VERBOSE(vo, "Display layer unrecovered during wait; dropping frame\n");
+                record_deadline_drop(vo);
+                return false;
+            }
+            continue;
+        }
+        if (mp_time_ns() >= give_up) {
+            MP_VERBOSE(vo, "Display layer not ready at PTS deadline; dropping frame\n");
+            record_deadline_drop(vo);
+            return false;
+        }
+        wait_for_renderer_ready(p, p->displayLayer, give_up);
+    }
+
+    p->not_ready_drop_count = 0;
+    p->last_not_ready_drop_ns = 0;
+    p->diag_wait_count++;
+    p->diag_wait_total_ns += mp_time_ns() - start;
+    return true;
+}
+
+static void report_presentation_diagnostics(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    int64_t now = mp_time_ns();
+
+    if (!p->diag_window_start_ns) {
+        p->diag_window_start_ns = now;
+        return;
+    }
+    if (now - p->diag_window_start_ns < MP_TIME_MS_TO_NS(5000))
+        return;
+
+    if (p->diag_wait_count || p->diag_drop_count || p->diag_anchor_count ||
+        p->diag_rate_update_count || p->diag_drift_peak_ns) {
+        double rate = p->timebase_rate > 0.0 ? p->timebase_rate : 1.0;
+        double offset_ppm =
+            (p->timebase_applied_rate / rate - 1.0) * 1e6;
+        MP_VERBOSE(vo, "Presentation pacing over %.1fs: %d ready-waits "
+                   "(avg %.2f ms), %d deadline drops, %d timebase anchors, "
+                   "%d rate updates (now %+.0f ppm), drift peak %.2f ms\n",
+                   (now - p->diag_window_start_ns) / 1e9,
+                   p->diag_wait_count,
+                   p->diag_wait_count
+                       ? p->diag_wait_total_ns / 1e6 / p->diag_wait_count
+                       : 0.0,
+                   p->diag_drop_count, p->diag_anchor_count,
+                   p->diag_rate_update_count, offset_ppm,
+                   p->diag_drift_peak_ns / 1e6);
+    }
+
+    p->diag_window_start_ns = now;
+    p->diag_wait_count = 0;
+    p->diag_wait_total_ns = 0;
+    p->diag_drop_count = 0;
+    p->diag_anchor_count = 0;
+    p->diag_rate_update_count = 0;
+    p->diag_drift_peak_ns = 0;
+}
+
+static void dispatch_main_sync_safe(dispatch_block_t block)
+{
+    if ([NSThread isMainThread]) {
+        block();
+    } else {
+        dispatch_sync(dispatch_get_main_queue(), block);
+    }
+}
