+static void set_colorspace_from_attachments(CVPixelBufferRef pixbuf)
+{
+    CFDictionaryRef attachments = CVBufferGetAttachments(
+        pixbuf, kCVAttachmentMode_ShouldPropagate);
+    if (!attachments)
+        return;
+
+    CGColorSpaceRef colorspace = CVImageBufferCreateColorSpaceFromAttachments(attachments);
+    if (!colorspace)
+        return;
+
+    CVBufferSetAttachment(pixbuf, kCVImageBufferCGColorSpaceKey, colorspace,
+                          kCVAttachmentMode_ShouldPropagate);
+    CGColorSpaceRelease(colorspace);
+}
+
+static void tag_pixel_buffer_color_metadata(CVPixelBufferRef pixbuf,
+                                            const struct mp_image_params *params)
+{
+    CFStringRef primaries = get_cv_color_primaries(params->color.primaries);
+    CFStringRef transfer = get_cv_transfer_function(params->color.transfer);
+    CFStringRef matrix = get_cv_ycbcr_matrix(params->repr.sys);
+
+    if (primaries) {
+        CVBufferSetAttachment(pixbuf, kCVImageBufferColorPrimariesKey,
+                              primaries, kCVAttachmentMode_ShouldPropagate);
+    }
+    if (transfer) {
+        CVBufferSetAttachment(pixbuf, kCVImageBufferTransferFunctionKey,
+                              transfer, kCVAttachmentMode_ShouldPropagate);
+    }
+    if (matrix) {
+        CVBufferSetAttachment(pixbuf, kCVImageBufferYCbCrMatrixKey,
+                              matrix, kCVAttachmentMode_ShouldPropagate);
+    }
+    if (primaries || transfer || matrix)
+        set_colorspace_from_attachments(pixbuf);
+}
+
+static void restore_dolby_vision_transfer(CVPixelBufferRef pixbuf,
+                                          const struct mp_image_params *params)
+{
+    if (!pixbuf || params->repr.sys != PL_COLOR_SYSTEM_DOLBYVISION)
+        return;
+    if (!CVBufferGetAttachment(pixbuf, CFSTR("DolbyVisionRPUData"), NULL) ||
+        CVBufferGetAttachment(pixbuf, kCVImageBufferTransferFunctionKey, NULL))
+        return;
+
+    CFStringRef transfer = get_cv_transfer_function(params->color.transfer);
+    if (transfer) {
+        CVBufferSetAttachment(pixbuf, kCVImageBufferTransferFunctionKey,
+                              transfer, kCVAttachmentMode_ShouldPropagate);
+    }
+}
+
+// --- avf dovi profile5 rpu (host-testable; keep freestanding) ---
+// Dolby Vision profile 5 has no backward-compatible base layer: its picture is
+// full-range IPT-PQ-c2, which only the RPU's reshaping turns into an image. A
+// VideoToolbox dvh1 session hands that RPU to the display layer as the
+// DolbyVisionRPUData attachment, and the display pipeline reshapes the frame
+// with it -- also on devices that have no Dolby Vision decoder (the iPad 10th
+// and 11th generation) and therefore decode profile 5 in software
+// (plezy#2760). A software frame uploaded without the RPU shows the raw IPT
+// codes: a magenta and green picture.
+//
+// FFmpeg's HEVC decoder exports the RPU NAL payload as
+// AV_FRAME_DATA_DOVI_RPU_BUFFER, NAL header stripped and emulation prevention
+// bytes intact, which is the layout VideoToolbox attaches. Return it for a
+// profile 5 frame, told apart the way FFmpeg's ff_dovi_guess_profile_hevc()
+// does. Profile 8 keeps presenting its HDR10/HLG base layer as before.
+static const AVBufferRef *find_dolby_vision_profile5_rpu(const mp_image_t *mpi)
+{
+    if (mpi->params.repr.sys != PL_COLOR_SYSTEM_DOLBYVISION)
+        return NULL;
+
+    const AVBufferRef *metadata = NULL;
+    const AVBufferRef *rpu = NULL;
+    for (int i = 0; i < mpi->num_ff_side_data; i++) {
+        const struct mp_ff_side_data *sd = &mpi->ff_side_data[i];
+        if (sd->type == AV_FRAME_DATA_DOVI_METADATA)
+            metadata = sd->buf;
+        else if (sd->type == AV_FRAME_DATA_DOVI_RPU_BUFFER)
+            rpu = sd->buf;
+    }
+    if (!metadata || metadata->size < sizeof(AVDOVIMetadata) || !rpu || !rpu->size)
+        return NULL;
+
+    const AVDOVIRpuDataHeader *header =
+        av_dovi_get_header((const AVDOVIMetadata *)metadata->data);
+    if (header->vdr_rpu_profile != 0 || !header->bl_video_full_range_flag)
+        return NULL;
+    return rpu;
+}
+// --- end avf dovi profile5 rpu ---
+
+static void attach_dolby_vision_rpu(struct vo *vo, CVPixelBufferRef pixbuf,
+                                    const AVBufferRef *rpu)
+{
+    struct priv *p = vo->priv;
+
+    CFDataRef data = CFDataCreate(NULL, rpu->data, rpu->size);
+    if (!data)
+        return;
+    CVBufferSetAttachment(pixbuf, CFSTR("DolbyVisionRPUData"), data,
+                          kCVAttachmentMode_ShouldPropagate);
+    CFRelease(data);
+
+    if (!p->dovi_software_rpu_logged) {
+        MP_INFO(vo, "Dolby Vision profile 5 software frames carry their RPU "
+                    "(%zu bytes) to the display pipeline\n", (size_t)rpu->size);
+        p->dovi_software_rpu_logged = true;
+    }
+}
+
+// --- HDR10+ per-frame metadata ---
+// HEVC carries HDR10+ (SMPTE ST 2094-40) as a per-frame T.35 user-data SEI.
+// FFmpeg parses it into AV_FRAME_DATA_DYNAMIC_HDR_PLUS on every decoded frame,
+// hwaccel included, and mpv keeps that side data on the mp_image. It travels no
+// further on its own: Core Video only has attachment keys for the static HDR10
+// metadata, so a VideoToolbox pixel buffer arrives without it and the display
+// layer signals plain HDR10 to the sink. AVSampleBufferDisplayLayer forwards
+// HDR10+ from one place, the per-sample attachment
+// kCMSampleAttachmentKey_HDR10PlusPerFrameData: the SEI payload as sent,
+// starting at itu_t_t35_country_code (plezy#2404).
+//
+// av_dynamic_hdr_plus_to_t35() writes the payload from application_mode on and
+// leaves the 48-bit T.35 header to the caller: country code US (0xB5),
+// terminal provider Samsung (0x003C), provider oriented code 0x0001 and
+// application identifier 4 name ST 2094-40, the same values FFmpeg's SEI
+// parser matches before it hands the rest to av_dynamic_hdr_plus_from_t35().
+static const uint8_t hdr10plus_t35_header[6] = {0xB5, 0x00, 0x3C, 0x00, 0x01, 0x04};
+
+static const AVDynamicHDRPlus *find_hdr10plus_side_data(const mp_image_t *mpi)
+{
+    for (int i = 0; i < mpi->num_ff_side_data; i++) {
+        const struct mp_ff_side_data *sd = &mpi->ff_side_data[i];
+        if (sd->type == AV_FRAME_DATA_DYNAMIC_HDR_PLUS && sd->buf &&
+            sd->buf->size >= sizeof(AVDynamicHDRPlus))
+            return (const AVDynamicHDRPlus *)sd->buf->data;
+    }
+    return NULL;
+}
+
+// Dolby Vision frames are left alone: their RPU is the dynamic metadata the DV
+// pipeline presents (tvOS derives HDR10+ from it itself for a DV-less sink),
+// and a second, competing description of the same frame is not something to
+// hand the display. HDR10+ is defined over PQ only, so other transfers are
+// skipped as well.
+static void attach_hdr10plus_metadata(struct vo *vo, const mp_image_t *mpi,
+                                      CVPixelBufferRef pixbuf, CMSampleBufferRef buf)
+{
+    struct priv *p = vo->priv;
+
+    if (mpi->params.color.transfer != PL_COLOR_TRC_PQ ||
+        mpi->params.repr.sys == PL_COLOR_SYSTEM_DOLBYVISION)
+        return;
+    const AVDynamicHDRPlus *hdr_plus = find_hdr10plus_side_data(mpi);
+    if (!hdr_plus)
+        return;
+    if (CVBufferGetAttachment(pixbuf, CFSTR("DolbyVisionRPUData"), NULL))
+        return;
+
+    if (@available(iOS 16.0, tvOS 16.0, macOS 13.0, *)) {
+        uint8_t *payload = p->hdr10plus_t35 + sizeof(hdr10plus_t35_header);
+        size_t payload_size = sizeof(p->hdr10plus_t35) - sizeof(hdr10plus_t35_header);
+        int ret = av_dynamic_hdr_plus_to_t35(hdr_plus, &payload, &payload_size);
+        if (ret < 0) {
+            if (!p->hdr10plus_unsupported_logged) {
+                MP_WARN(vo, "HDR10+ metadata could not be serialized (%d); "
+                            "presenting as HDR10\n", ret);
+                p->hdr10plus_unsupported_logged = true;
+            }
+            return;
+        }
+        memcpy(p->hdr10plus_t35, hdr10plus_t35_header, sizeof(hdr10plus_t35_header));
+        size_t t35_size = sizeof(hdr10plus_t35_header) + payload_size;
+
+        CFArrayRef attachments = CMSampleBufferGetSampleAttachmentsArray(buf, true);
+        if (!attachments || CFArrayGetCount(attachments) < 1)
+            return;
+        CFMutableDictionaryRef sample_attachments =
+            (CFMutableDictionaryRef)CFArrayGetValueAtIndex(attachments, 0);
+        CFDataRef t35 = CFDataCreate(NULL, p->hdr10plus_t35, t35_size);
+        if (!t35)
+            return;
+        CFDictionarySetValue(sample_attachments,
+                             kCMSampleAttachmentKey_HDR10PlusPerFrameData, t35);
+        CFRelease(t35);
+
+        if (!p->hdr10plus_attached_logged) {
+            MP_INFO(vo, "HDR10+ per-frame metadata attached to the display "
+                        "samples (%zu bytes, %d window%s)\n",
+                    t35_size, hdr_plus->num_windows,
+                    hdr_plus->num_windows == 1 ? "" : "s");
+            p->hdr10plus_attached_logged = true;
+        }
+    } else if (!p->hdr10plus_unsupported_logged) {
+        MP_WARN(vo, "HDR10+ metadata present but this OS cannot forward it; "
+                    "presenting as HDR10\n");
+        p->hdr10plus_unsupported_logged = true;
+    }
+}
+// --- end HDR10+ per-frame metadata ---
+
+// Whether the buffer's pixel aspect attachment already describes p_w:p_h. A
+// buffer without one is square. Reading an attachment is cheap; setting or
+// removing one on an IOSurface-backed buffer is a kernel round trip, and
+// FFmpeg's VideoToolbox hwaccel has already written the frame's sample aspect
+// ratio, which is usually the one wanted here.
+static bool pixel_aspect_matches(CVPixelBufferRef pixbuf, int p_w, int p_h)
+{
+    CFTypeRef par = CVBufferGetAttachment(pixbuf, kCVImageBufferPixelAspectRatioKey, NULL);
+    if (!par)
+        return p_w == p_h;
+    if (CFGetTypeID(par) != CFDictionaryGetTypeID())
+        return false;
+
+    CFNumberRef h = CFDictionaryGetValue(par, kCVImageBufferPixelAspectRatioHorizontalSpacingKey);
+    CFNumberRef v = CFDictionaryGetValue(par, kCVImageBufferPixelAspectRatioVerticalSpacingKey);
+    int64_t hs = 0, vs = 0;
+    if (!h || !v || CFGetTypeID(h) != CFNumberGetTypeID() ||
+        CFGetTypeID(v) != CFNumberGetTypeID() ||
+        !CFNumberGetValue(h, kCFNumberSInt64Type, &hs) ||
+        !CFNumberGetValue(v, kCFNumberSInt64Type, &vs) ||
+        hs <= 0 || vs <= 0)
+        return false;
+
+    return hs * p_h == vs * p_w;
+}
+
+static void tag_pixel_buffer_pixel_aspect(struct vo *vo, CVPixelBufferRef pixbuf)
+{
+    if (!pixbuf || !vo->params)
+        return;
+
+    int p_w = vo->params->p_w;
+    int p_h = vo->params->p_h;
+    size_t bw = CVPixelBufferGetWidth(pixbuf);
+    size_t bh = CVPixelBufferGetHeight(pixbuf);
+
+    // Only coded-size buffers carry the source sample aspect ratio: passthrough
+    // and upload buffers, plus the frame-space composites that keep the coded
+    // grid. A display-shaped buffer (window-space geometry or composite, both
+    // letterboxed via vo_get_src_dst_rects) is already square-pixel and must
+    // stay that way to avoid double-correcting the aspect.
+    bool coded_size = bw == (size_t)vo->params->w && bh == (size_t)vo->params->h;
+
+    if (coded_size && p_w > 0 && p_h > 0 && p_w != p_h) {
+        if (pixel_aspect_matches(pixbuf, p_w, p_h))
+            return;
+        NSDictionary *par = @{
+            (id)kCVImageBufferPixelAspectRatioHorizontalSpacingKey: @(p_w),
+            (id)kCVImageBufferPixelAspectRatioVerticalSpacingKey: @(p_h)
+        };
+        CVBufferSetAttachment(pixbuf, kCVImageBufferPixelAspectRatioKey,
+                              (__bridge CFDictionaryRef)par,
+                              kCVAttachmentMode_ShouldPropagate);
+    } else if (!pixel_aspect_matches(pixbuf, 1, 1)) {
+        // Square pixels (or a reused pool buffer): strip a stale non-square
+        // attachment. A 1:1 one, which FFmpeg writes for square-pixel
+        // streams, already means square and stays.
+        CVBufferRemoveAttachment(pixbuf, kCVImageBufferPixelAspectRatioKey);
+    }
+}
+
+static void copy_pixel_buffer_attachment(CVBufferRef src, CVBufferRef dst,
+                                         CFStringRef key)
+{
+    CVAttachmentMode mode = kCVAttachmentMode_ShouldPropagate;
+    CFTypeRef value = CVBufferGetAttachment(src, key, &mode);
+    if (value) {
+        CVBufferSetAttachment(dst, key, value, mode);
+    } else {
+        CVBufferRemoveAttachment(dst, key);
+    }
+}
+
+static void copy_pixel_buffer_metadata(CVPixelBufferRef src, CVPixelBufferRef dst,
+                                       OSType dst_format)
+{
+    CVBufferPropagateAttachments(src, dst);
+
+    const CFStringRef keys[] = {
+        kCVImageBufferCGColorSpaceKey,
+        kCVImageBufferICCProfileKey,
+        kCVImageBufferGammaLevelKey,
+        kCVImageBufferColorPrimariesKey,
+        kCVImageBufferTransferFunctionKey,
+        kCVImageBufferYCbCrMatrixKey,
+        kCVImageBufferMasteringDisplayColorVolumeKey,
+        kCVImageBufferContentLightLevelInfoKey,
+        kCVImageBufferChromaLocationTopFieldKey,
+        kCVImageBufferChromaLocationBottomFieldKey,
+        kCVImageBufferChromaSubsamplingKey,
+        kCVImageBufferCleanApertureKey,
+        kCVImageBufferPreferredCleanApertureKey,
+        kCVImageBufferPixelAspectRatioKey,
+    };
+
+    for (int i = 0; i < MP_ARRAY_SIZE(keys); i++)
+        copy_pixel_buffer_attachment(src, dst, keys[i]);
+
+    if (!is_biplanar_yuv_format(dst_format))
+        CVBufferRemoveAttachment(dst, kCVImageBufferYCbCrMatrixKey);
+
+    if (!CVBufferGetAttachment(dst, kCVImageBufferCGColorSpaceKey, NULL) &&
+        !is_biplanar_yuv_format(dst_format))
+        set_colorspace_from_attachments(dst);
+}
+
+static void get_yuv_coefficients(CVPixelBufferRef pixbuf, double *kr, double *kb)
+{
+    *kr = 0.2126;
+    *kb = 0.0722;
+
+    CFTypeRef matrix = CVBufferGetAttachment(pixbuf, kCVImageBufferYCbCrMatrixKey, NULL);
+    if (!matrix)
+        return;
+
+    if (CFEqual(matrix, kCVImageBufferYCbCrMatrix_ITU_R_2020)) {
+        *kr = 0.2627;
+        *kb = 0.0593;
+    } else if (CFEqual(matrix, kCVImageBufferYCbCrMatrix_ITU_R_601_4)) {
+        *kr = 0.299;
+        *kb = 0.114;
+    }
+}
+
+static bool copy_pixel_buffer_planes(CVPixelBufferRef src, CVPixelBufferRef dst)
+{
+    CVReturn src_status = CVPixelBufferLockBaseAddress(src, kCVPixelBufferLock_ReadOnly);
+    if (src_status != kCVReturnSuccess)
+        return false;
+
+    CVReturn dst_status = CVPixelBufferLockBaseAddress(dst, 0);
+    if (dst_status != kCVReturnSuccess) {
+        CVPixelBufferUnlockBaseAddress(src, kCVPixelBufferLock_ReadOnly);
+        return false;
+    }
+
+    size_t planes = CVPixelBufferGetPlaneCount(src);
+    bool ok = planes == CVPixelBufferGetPlaneCount(dst);
+    if (ok && planes > 0) {
+        for (size_t plane = 0; plane < planes; plane++) {
+            uint8_t *src_base = CVPixelBufferGetBaseAddressOfPlane(src, plane);
+            uint8_t *dst_base = CVPixelBufferGetBaseAddressOfPlane(dst, plane);
+            size_t src_stride = CVPixelBufferGetBytesPerRowOfPlane(src, plane);
+            size_t dst_stride = CVPixelBufferGetBytesPerRowOfPlane(dst, plane);
+            size_t height = MPMIN(CVPixelBufferGetHeightOfPlane(src, plane),
+                                  CVPixelBufferGetHeightOfPlane(dst, plane));
+            size_t bytes = MPMIN(src_stride, dst_stride);
+            if (!src_base || !dst_base) {
+                ok = false;
+                break;
+            }
+            for (size_t y = 0; y < height; y++)
+                memcpy(dst_base + y * dst_stride, src_base + y * src_stride, bytes);
+        }
+    } else if (ok) {
+        uint8_t *src_base = CVPixelBufferGetBaseAddress(src);
+        uint8_t *dst_base = CVPixelBufferGetBaseAddress(dst);
+        size_t src_stride = CVPixelBufferGetBytesPerRow(src);
+        size_t dst_stride = CVPixelBufferGetBytesPerRow(dst);
+        size_t height = MPMIN(CVPixelBufferGetHeight(src), CVPixelBufferGetHeight(dst));
+        size_t bytes = MPMIN(src_stride, dst_stride);
+        ok = src_base && dst_base;
+        if (ok) {
+            for (size_t y = 0; y < height; y++)
+                memcpy(dst_base + y * dst_stride, src_base + y * src_stride, bytes);
+        }
+    }
+
+    CVPixelBufferUnlockBaseAddress(dst, 0);
+    CVPixelBufferUnlockBaseAddress(src, kCVPixelBufferLock_ReadOnly);
+    return ok;
+}
+
+static int clip_u8(double value)
+{
+    return MPCLAMP((int)(value + 0.5), 0, 255);
+}
+
+static int clip_u10(double value)
+{
+    return MPCLAMP((int)(value + 0.5), 0, 1023);
+}
+
+// Union of the part destination rects, clamped to the OSD buffer. Both draw
+// paths only write inside these rects, so this bounds everything non-blank
+// without scanning the rendered pixels.
+static void reset_subtitle_bounds(struct priv *p)
+{
+    p->subtitle_x0 = p->osd_w;
+    p->subtitle_y0 = p->osd_h;
+    p->subtitle_x1 = 0;
+    p->subtitle_y1 = 0;
+}
+
+static void extend_subtitle_bounds(struct priv *p, struct sub_bitmaps *imgs)
+{
+    if (!imgs || p->osd_w <= 0 || p->osd_h <= 0)
+        return;
+
+    for (int i = 0; i < imgs->num_parts; i++) {
+        struct sub_bitmap *sb = &imgs->parts[i];
+        if (!sb->bitmap || sb->w <= 0 || sb->h <= 0)
+            continue;
+        int dw = sb->dw > 0 ? sb->dw : sb->w;
+        int dh = sb->dh > 0 ? sb->dh : sb->h;
+        p->subtitle_x0 = MPMIN(p->subtitle_x0, MPCLAMP(sb->x, 0, p->osd_w));
+        p->subtitle_y0 = MPMIN(p->subtitle_y0, MPCLAMP(sb->y, 0, p->osd_h));
+        p->subtitle_x1 = MPMAX(p->subtitle_x1, MPCLAMP(sb->x + dw, 0, p->osd_w));
+        p->subtitle_y1 = MPMAX(p->subtitle_y1, MPCLAMP(sb->y + dh, 0, p->osd_h));
+    }
+}
+
+static void update_subtitle_bounds_from_parts(struct priv *p,
+                                              struct sub_bitmaps *imgs)
+{
+    reset_subtitle_bounds(p);
+    extend_subtitle_bounds(p, imgs);
+}
+
+// Map mpv image format to the CVPixelBuffer format the frame is uploaded as.
+// Everything lands in a biplanar format: the display pipeline only handles
+// NV12/P010-family surfaces reliably (tri-planar 'y420' is not used by any
+// shipping AVSampleBufferDisplayLayer client and would also fall off the fast
+// biplanar subtitle blend path). Planar sources are interleaved during the
+// upload copy itself.
+static OSType get_cv_pixel_format(int imgfmt)
+{
+    if (imgfmt == IMGFMT_NV12 || imgfmt == IMGFMT_420P)
+        return kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange;
+    if (imgfmt == IMGFMT_P010 || imgfmt == imgfmt_420p10() ||
+        imgfmt == imgfmt_420p12())
+        return kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange;
+    return 0;
+}
+
+// Create software upload pool
+static bool create_sw_upload_pool(struct vo *vo, int w, int h, OSType format)
+{
+    struct priv *p = vo->priv;
+    return create_pixel_buffer_pool(vo, &p->swUploadPool, &p->sw_pool_w,
+        &p->sw_pool_h, &p->sw_pool_format, w, h, format, "software upload");
+}
+
+static void reset_osd_buf_states(struct priv *p)
+{
+    for (int i = 0; i < p->osd_buf_state_count; i++) {
+        if (p->osd_buf_states[i].surf)
+            CFRelease(p->osd_buf_states[i].surf);
+    }
+    p->osd_buf_state_count = 0;
+}
+
+// Entries pin their IOSurface only briefly past the pool's own lifetime;
+// drop ones the pool has likely aged out so they don't hold memory.
+static void prune_osd_buf_states(struct priv *p, int64_t now)
+{
+    for (int i = 0; i < p->osd_buf_state_count;) {
+        if (now - p->osd_buf_states[i].last_used_ns > MP_TIME_MS_TO_NS(2000)) {
+            CFRelease(p->osd_buf_states[i].surf);
+            p->osd_buf_states[i] = p->osd_buf_states[--p->osd_buf_state_count];
+        } else {
+            i++;
+        }
+    }
+}
+
+static struct osd_buf_state *osd_buf_state_acquire(struct priv *p,
+                                                   CVPixelBufferRef buf)
+{
+    IOSurfaceRef surf = buf ? CVPixelBufferGetIOSurface(buf) : NULL;
+    if (!surf)
+        return NULL;
+
+    int64_t now = mp_time_ns();
+    struct osd_buf_state *oldest = NULL;
+    for (int i = 0; i < p->osd_buf_state_count; i++) {
+        struct osd_buf_state *st = &p->osd_buf_states[i];
+        if (st->surf == surf) {
+            st->last_used_ns = now;
+            return st;
+        }
+        if (!oldest || st->last_used_ns < oldest->last_used_ns)
+            oldest = st;
+    }
+
+    struct osd_buf_state *st;
+    if (p->osd_buf_state_count < (int)MP_ARRAY_SIZE(p->osd_buf_states)) {
+        st = &p->osd_buf_states[p->osd_buf_state_count++];
+    } else {
+        st = oldest;
+        CFRelease(st->surf);
+    }
+    *st = (struct osd_buf_state){
+        .surf = (IOSurfaceRef)CFRetain(surf),
+        // Contents unknown until this code has drawn into it: clear fully.
+        .dirty = {0, 0, INT_MAX, INT_MAX},
+        .last_used_ns = now,
+    };
+    return st;
+}
+
+static void osd_buf_record_dirty(struct priv *p, CVPixelBufferRef buf,
+                                 struct mp_rect dirty)
+{
+    IOSurfaceRef surf = buf ? CVPixelBufferGetIOSurface(buf) : NULL;
+    if (!surf)
+        return;
+    for (int i = 0; i < p->osd_buf_state_count; i++) {
+        if (p->osd_buf_states[i].surf == surf) {
+            p->osd_buf_states[i].dirty = dirty;
+            return;
+        }
+    }
+}
+
+static bool create_osd_pool(struct vo *vo, int w, int h)
+{
+    struct priv *p = vo->priv;
+    // The pool is about to be recreated: its buffers (and their recorded
+    // dirty state) are going away.
+    if (p->osdPool && (p->osd_pool_w != w || p->osd_pool_h != h))
+        reset_osd_buf_states(p);
+    return create_pixel_buffer_pool(vo, &p->osdPool, &p->osd_pool_w,
+        &p->osd_pool_h, NULL, w, h, kCVPixelFormatType_32BGRA, "OSD overlay");
+}
+
+// Row kernels for the software-frame upload. Planar sources are fused
+// (interleave, and for 10/12-bit the MSB-align shift) into the biplanar
+// destination during the one unavoidable copy, so no separate conversion
+// pass runs anywhere.
+
+// 16-bit row copy with LSB->MSB alignment shift (yuv420p10/12 -> P010 layout).
+static void copy_shift_u16_row(uint16_t *dst, const uint16_t *src, size_t n,
+                               int shift)
+{
+    size_t x = 0;
+#if defined(__aarch64__)
+    int16x8_t vshift = vdupq_n_s16(shift);
+    for (; x + 8 <= n; x += 8)
+        vst1q_u16(dst + x, vshlq_u16(vld1q_u16(src + x), vshift));
+#endif
+    for (; x < n; x++)
+        dst[x] = src[x] << shift;
+}
+
+// Interleave 16-bit U and V rows with the alignment shift
+// (libyuv I010ToP010 semantics).
+static void interleave_shift_uv_row_u16(uint16_t *dst, const uint16_t *u,
+                                        const uint16_t *v, size_t n, int shift)
+{
+    size_t x = 0;
+#if defined(__aarch64__)
+    int16x8_t vshift = vdupq_n_s16(shift);
+    for (; x + 8 <= n; x += 8) {
+        uint16x8x2_t uv = {{
+            vshlq_u16(vld1q_u16(u + x), vshift),
+            vshlq_u16(vld1q_u16(v + x), vshift),
+        }};
+        vst2q_u16(dst + 2 * x, uv);
+    }
+#endif
+    for (; x < n; x++) {
+        dst[2 * x + 0] = u[x] << shift;
+        dst[2 * x + 1] = v[x] << shift;
+    }
+}
+
+// Interleave 8-bit U and V rows (yuv420p -> NV12).
+static void interleave_uv_row_u8(uint8_t *dst, const uint8_t *u,
+                                 const uint8_t *v, size_t n)
+{
+    size_t x = 0;
+#if defined(__aarch64__)
+    for (; x + 16 <= n; x += 16) {
+        uint8x16x2_t uv = {{ vld1q_u8(u + x), vld1q_u8(v + x) }};
+        vst2q_u8(dst + 2 * x, uv);
+    }
+#endif
+    for (; x < n; x++) {
+        dst[2 * x + 0] = u[x];
+        dst[2 * x + 1] = v[x];
+    }
+}
+
+// yuv420p10/12 (LSB-aligned planar) -> locked P010-layout ('x420') buffer.
+static void upload_420p1x_to_p010(struct mp_image *mpi, CVPixelBufferRef pixbuf,
+                                  int shift)
+{
+    int w = mpi->w, h = mpi->h;
+    int cw = (w + 1) / 2, ch = (h + 1) / 2;
+
+    uint8_t *dst_y = CVPixelBufferGetBaseAddressOfPlane(pixbuf, 0);
+    size_t dst_y_stride = CVPixelBufferGetBytesPerRowOfPlane(pixbuf, 0);
+    for (int y = 0; y < h; y++) {
+        copy_shift_u16_row((uint16_t *)(dst_y + y * dst_y_stride),
+                           (const uint16_t *)(mpi->planes[0] + y * mpi->stride[0]),
+                           w, shift);
+    }
+
+    uint8_t *dst_uv = CVPixelBufferGetBaseAddressOfPlane(pixbuf, 1);
+    size_t dst_uv_stride = CVPixelBufferGetBytesPerRowOfPlane(pixbuf, 1);
+    for (int y = 0; y < ch; y++) {
+        interleave_shift_uv_row_u16(
+            (uint16_t *)(dst_uv + y * dst_uv_stride),
+            (const uint16_t *)(mpi->planes[1] + y * mpi->stride[1]),
+            (const uint16_t *)(mpi->planes[2] + y * mpi->stride[2]),
+            cw, shift);
+    }
+}
+
+// yuv420p (planar) -> locked NV12 ('420v') buffer.
+static void upload_420p_to_nv12(struct mp_image *mpi, CVPixelBufferRef pixbuf)
+{
+    int w = mpi->w, h = mpi->h;
+    int cw = (w + 1) / 2, ch = (h + 1) / 2;
+
+    uint8_t *dst_y = CVPixelBufferGetBaseAddressOfPlane(pixbuf, 0);
+    size_t dst_y_stride = CVPixelBufferGetBytesPerRowOfPlane(pixbuf, 0);
+    if (dst_y_stride == (size_t)mpi->stride[0]) {
+        memcpy(dst_y, mpi->planes[0], dst_y_stride * h);
+    } else {
+        for (int y = 0; y < h; y++) {
+            memcpy(dst_y + y * dst_y_stride,
+                   mpi->planes[0] + y * mpi->stride[0], w);
+        }
+    }
+
+    uint8_t *dst_uv = CVPixelBufferGetBaseAddressOfPlane(pixbuf, 1);
+    size_t dst_uv_stride = CVPixelBufferGetBytesPerRowOfPlane(pixbuf, 1);
+    for (int y = 0; y < ch; y++) {
+        interleave_uv_row_u8(dst_uv + y * dst_uv_stride,
+                             mpi->planes[1] + y * mpi->stride[1],
+                             mpi->planes[2] + y * mpi->stride[2],
+                             cw);
+    }
+}
+
+// Upload a software-decoded frame to CVPixelBuffer
+static CVPixelBufferRef upload_software_frame(struct vo *vo, struct mp_image *mpi)
+{
+    struct priv *p = vo->priv;
+
+    OSType cvFormat = get_cv_pixel_format(mpi->imgfmt);
+    if (!cvFormat) {
+        MP_ERR(vo, "Unsupported software format: %d\n", mpi->imgfmt);
+        return NULL;
+    }
+
+    // Profile 5's codes are full range, which the video-range buffer every
+    // other 10-bit frame gets would clip. The pool is rebuilt on a format
+    // change, so only profile 5 frames, each given its own RPU below, ever
+    // use the full-range one.
+    const AVBufferRef *dovi_rpu = NULL;
+    if (cvFormat == kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange) {
+        dovi_rpu = find_dolby_vision_profile5_rpu(mpi);
+        if (dovi_rpu)
+            cvFormat = kCVPixelFormatType_420YpCbCr10BiPlanarFullRange;
+    }
+
+    int w = mpi->w;
+    int h = mpi->h;
+
+    if (!create_sw_upload_pool(vo, w, h, cvFormat))
+        return NULL;
+
+    CVPixelBufferRef pixbuf = NULL;
+    CVReturn status = CVPixelBufferPoolCreatePixelBuffer(
+        kCFAllocatorDefault, p->swUploadPool, &pixbuf);
+
+    if (status != kCVReturnSuccess || !pixbuf) {
+        MP_ERR(vo, "Failed to get upload buffer: %d\n", status);
+        return NULL;
+    }
+
+    CVPixelBufferLockBaseAddress(pixbuf, 0);
+
+    size_t planeCount = CVPixelBufferGetPlaneCount(pixbuf);
+
+    if (mpi->imgfmt == IMGFMT_420P) {
+        upload_420p_to_nv12(mpi, pixbuf);
+    } else if (mpi->imgfmt == imgfmt_420p10()) {
+        upload_420p1x_to_p010(mpi, pixbuf, 6);
+    } else if (mpi->imgfmt == imgfmt_420p12()) {
+        // P010 layout keeps 2 extra significant low bits; harmless, they sit
+        // below the display's 10-bit quantization (libyuv does the same).
+        upload_420p1x_to_p010(mpi, pixbuf, 4);
+    } else if (planeCount == 0) {
+        // Non-planar format
+        void *dst = CVPixelBufferGetBaseAddress(pixbuf);
+        size_t dstStride = CVPixelBufferGetBytesPerRow(pixbuf);
+        size_t srcStride = mpi->stride[0];
+
+        // Fast path: single memcpy if strides match
+        if (dstStride == srcStride) {
+            memcpy(dst, mpi->planes[0], dstStride * h);
+        } else {
+            size_t copyBytes = MPMIN(dstStride, srcStride);
+            for (int y = 0; y < h; y++) {
+                memcpy((uint8_t *)dst + y * dstStride,
+                       mpi->planes[0] + y * srcStride,
+                       copyBytes);
+            }
+        }
+    } else {
+        // Source plane layout matches the destination (NV12, P010)
+        for (size_t plane = 0; plane < planeCount && plane < MP_MAX_PLANES; plane++) {
+            void *dst = CVPixelBufferGetBaseAddressOfPlane(pixbuf, plane);
+            size_t dstStride = CVPixelBufferGetBytesPerRowOfPlane(pixbuf, plane);
+            size_t dstHeight = CVPixelBufferGetHeightOfPlane(pixbuf, plane);
+
+            uint8_t *src = mpi->planes[plane];
+            size_t srcStride = mpi->stride[plane];
+
+            if (!src)
+                continue;
+
+            // Fast path: single memcpy if strides match
+            if (dstStride == srcStride) {
+                memcpy(dst, src, dstStride * dstHeight);
+            } else {
+                size_t copyBytes = MPMIN(dstStride, srcStride);
+                for (size_t y = 0; y < dstHeight; y++) {
+                    memcpy((uint8_t *)dst + y * dstStride,
+                           src + y * srcStride,
+                           copyBytes);
+                }
+            }
+        }
+    }
+
+    CVPixelBufferUnlockBaseAddress(pixbuf, 0);
+    tag_pixel_buffer_color_metadata(pixbuf, &mpi->params);
+    if (dovi_rpu)
+        attach_dolby_vision_rpu(vo, pixbuf, dovi_rpu);
+
+    return pixbuf;
+}
+
+static void draw_subtitle_bitmaps(CGContextRef context, struct sub_bitmaps *imgs,
+                                  int h)
+{
+    CGColorSpaceRef partColorSpace = (imgs->format == SUBBITMAP_BGRA)
+        ? CGColorSpaceCreateDeviceRGB() : NULL;
+
+    for (int i = 0; i < imgs->num_parts; i++) {
+        struct sub_bitmap *sb = &imgs->parts[i];
+
+        if (!sb->bitmap || sb->w <= 0 || sb->h <= 0)
+            continue;
+
+        CGDataProviderRef provider = CGDataProviderCreateWithData(
+            NULL, sb->bitmap, sb->stride * sb->h, NULL);
+
+        if (!provider)
+            continue;
+
+        if (imgs->format == SUBBITMAP_BGRA) {
+            CGImageRef partImage = CGImageCreate(
+                sb->w, sb->h, 8, 32, sb->stride, partColorSpace,
+                kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Little,
+                provider, NULL, false, kCGRenderingIntentDefault);
+
+            if (partImage) {
+                CGRect destRect = CGRectMake(sb->x, h - sb->y - sb->dh, sb->dw, sb->dh);
+                CGContextDrawImage(context, destRect, partImage);
+                CGImageRelease(partImage);
+            }
+        } else if (imgs->format == SUBBITMAP_LIBASS) {
+            // Invert decode array: libass uses 255=opaque, but CGImageMask uses 0=paint
+            CGFloat decode[] = {1, 0};
+            CGImageRef mask = CGImageMaskCreate(
+                sb->w, sb->h, 8, 8, sb->stride, provider, decode, false);
+
+            if (mask) {
+                CGContextSaveGState(context);
+                CGRect destRect = CGRectMake(sb->x, h - sb->y - sb->dh, sb->dw, sb->dh);
+                CGContextClipToMask(context, destRect, mask);
+
+                uint32_t c = sb->libass.color;
+                float r = ((c >> 24) & 0xFF) / 255.0f;
+                float g = ((c >> 16) & 0xFF) / 255.0f;
+                float b = ((c >> 8) & 0xFF) / 255.0f;
+                float a = 1.0f - ((c >> 0) & 0xFF) / 255.0f;
+
+                CGContextSetRGBFillColor(context, r, g, b, a);
+                CGContextFillRect(context, destRect);
+                CGContextRestoreGState(context);
+                CGImageRelease(mask);
+            }
+        }
+
+        CGDataProviderRelease(provider);
+    }
+
+    if (partColorSpace)
+        CGColorSpaceRelease(partColorSpace);
+}
+
+static int get_direct_osd_draw_path(struct sub_bitmaps *imgs)
+{
+    if (!imgs || imgs->num_parts <= 0)
+        return AVF_OSD_DRAW_NONE;
+
+    int path = AVF_OSD_DRAW_NONE;
+    if (imgs->format == SUBBITMAP_LIBASS) {
+        path = AVF_OSD_DRAW_DIRECT_LIBASS;
+    } else if (imgs->format == SUBBITMAP_BGRA) {
+        path = AVF_OSD_DRAW_DIRECT_BGRA;
+    } else {
+        return AVF_OSD_DRAW_NONE;
+    }
+
+    for (int i = 0; i < imgs->num_parts; i++) {
+        struct sub_bitmap *sb = &imgs->parts[i];
+        if (!sb->bitmap || sb->w <= 0 || sb->h <= 0)
+            continue;
+
+        int dw = sb->dw > 0 ? sb->dw : sb->w;
+        int dh = sb->dh > 0 ? sb->dh : sb->h;
+        if (dw != sb->w || dh != sb->h)
+            return AVF_OSD_DRAW_COREGRAPHICS;
+    }
+
+    return path;
+}
+
+static void blend_libass_bgra_scalar(uint8_t *dst, size_t dst_stride,
+                                     uint8_t *src, int src_stride,
+                                     int w, int h, uint32_t color)
+{
+    const unsigned int r = (color >> 24) & 0xff;
+    const unsigned int g = (color >> 16) & 0xff;
+    const unsigned int b = (color >>  8) & 0xff;
+    const unsigned int a = 0xff - (color & 0xff);
+
+    if (!a)
+        return;
+
+    for (int y = 0; y < h; y++) {
+        uint32_t *dstrow = (uint32_t *)dst;
+        for (int x = 0; x < w; x++) {
+            const unsigned int v = src[x];
+            if (!v)
+                continue;
+
+            unsigned int aa = a * v;
+            unsigned int inv = 255 * 255 - aa;
+            uint32_t dstpix = dstrow[x];
+            unsigned int dstb =  dstpix        & 0xff;
+            unsigned int dstg = (dstpix >>  8) & 0xff;
+            unsigned int dstr = (dstpix >> 16) & 0xff;
+            unsigned int dsta = (dstpix >> 24) & 0xff;
+
+            dstb = (v * b * a + dstb * inv + 32512) / (255 * 255);
+            dstg = (v * g * a + dstg * inv + 32512) / (255 * 255);
+            dstr = (v * r * a + dstr * inv + 32512) / (255 * 255);
+            dsta = (aa * 255 + dsta * inv + 32512) / (255 * 255);
+            dstrow[x] = dstb | (dstg << 8) | (dstr << 16) | (dsta << 24);
+        }
+        dst += dst_stride;
+        src += src_stride;
+    }
+}
+
+static void blend_bgra_over_bgra_scalar(uint8_t *dst, size_t dst_stride,
+                                        uint8_t *src, int src_stride,
+                                        int w, int h)
+{
+    for (int y = 0; y < h; y++) {
+        uint32_t *srcrow = (uint32_t *)src;
+        uint32_t *dstrow = (uint32_t *)dst;
+        for (int x = 0; x < w; x++) {
+            uint32_t srcpix = srcrow[x];
+            unsigned int srca = (srcpix >> 24) & 0xff;
+            if (!srca)
+                continue;
+            if (srca == 0xff || !dstrow[x]) {
+                dstrow[x] = srcpix;
+                continue;
+            }
+
+            uint32_t dstpix = dstrow[x];
+            unsigned int inv = 0xff - srca;
+            unsigned int srcb =  srcpix        & 0xff;
+            unsigned int srcg = (srcpix >>  8) & 0xff;
+            unsigned int srcr = (srcpix >> 16) & 0xff;
+            unsigned int dstb =  dstpix        & 0xff;
+            unsigned int dstg = (dstpix >>  8) & 0xff;
+            unsigned int dstr = (dstpix >> 16) & 0xff;
+            unsigned int dsta = (dstpix >> 24) & 0xff;
+
+            dstb = MPMIN(0xff, srcb + (dstb * inv + 127) / 255);
+            dstg = MPMIN(0xff, srcg + (dstg * inv + 127) / 255);
+            dstr = MPMIN(0xff, srcr + (dstr * inv + 127) / 255);
+            dsta = MPMIN(0xff, srca + (dsta * inv + 127) / 255);
+            dstrow[x] = dstb | (dstg << 8) | (dstr << 16) | (dsta << 24);
+        }
+        dst += dst_stride;
+        src += src_stride;
+    }
+}
+
+#if defined(__aarch64__)
+
+// NEON versions of the two scalar blends above, bit-exact with them: both
+// divisions are folded into exact floor-by-255 stages (floor(x/65025) ==
+// floor(floor(x/255)/255)).
+
+// Exact floor(x/255) for u16 lanes.
+static inline uint16x8_t div255_u16_neon(uint16x8_t x)
+{
+    return vshrq_n_u16(
+        vaddq_u16(vaddq_u16(x, vdupq_n_u16(1)), vshrq_n_u16(x, 8)), 8);
+}
+
+// Exact floor(x/255) for u32 lanes (canonical magic-multiply), narrowed to
+// u16; every reachable numerator here is < 2^24 so the result fits.
+static inline uint16x4_t div255_u32_to_u16_neon(uint32x4_t x)
+{
+    const uint32x2_t magic = vdup_n_u32(0x80808081u);
+    uint64x2_t lo = vmull_u32(vget_low_u32(x), magic);
+    uint64x2_t hi = vmull_u32(vget_high_u32(x), magic);
+    uint32x2_t l = vmovn_u64(vshrq_n_u64(lo, 39));
+    uint32x2_t h = vmovn_u64(vshrq_n_u64(hi, 39));
+    return vmovn_u32(vcombine_u32(l, h));
+}
+
+// One channel of the libass blend: (aa*c + inv*dst + 32512) / 65025.
+static inline uint8x8_t blend_libass_channel_neon(uint16x8_t aa, uint16x8_t inv,
+                                                  uint8_t c, uint8x8_t dst)
+{
+    uint16x8_t d16 = vmovl_u8(dst);
+    uint32x4_t lo = vmull_n_u16(vget_low_u16(aa), c);
+    uint32x4_t hi = vmull_n_u16(vget_high_u16(aa), c);
+    lo = vmlal_u16(lo, vget_low_u16(inv), vget_low_u16(d16));
+    hi = vmlal_u16(hi, vget_high_u16(inv), vget_high_u16(d16));
+    lo = vaddq_u32(lo, vdupq_n_u32(32512));
+    hi = vaddq_u32(hi, vdupq_n_u32(32512));
+    uint16x8_t y = vcombine_u16(div255_u32_to_u16_neon(lo),
+                                div255_u32_to_u16_neon(hi));
+    return vmovn_u16(div255_u16_neon(y));
+}
+
+// Requires w % 8 == 0; the dispatcher routes the tail through the scalar path.
+// Mask lanes of 0 come out as dst exactly ((dst*65025 + 32512)/65025 == dst),
+// so no per-lane select is needed; the vmaxv skip is purely an optimization.
+static void blend_libass_bgra_neon(uint8_t *dst, size_t dst_stride,
+                                   uint8_t *src, int src_stride,
+                                   int w, int h, uint32_t color)
+{
+    const uint8_t r = (color >> 24) & 0xff;
+    const uint8_t g = (color >> 16) & 0xff;
+    const uint8_t b = (color >>  8) & 0xff;
+    const uint8_t a = 0xff - (color & 0xff);
+    const uint8x8_t va = vdup_n_u8(a);
+    const uint16x8_t full = vdupq_n_u16(255 * 255);
+
+    for (int y = 0; y < h; y++) {
+        for (int x = 0; x < w; x += 8) {
+            uint8x8_t m = vld1_u8(src + x);
+            if (!vmaxv_u8(m))
+                continue;
+
+            uint16x8_t aa = vmull_u8(m, va);
+            uint16x8_t inv = vsubq_u16(full, aa);
+            uint8x8x4_t d = vld4_u8(dst + (size_t)x * 4);
+            d.val[0] = blend_libass_channel_neon(aa, inv, b, d.val[0]);
+            d.val[1] = blend_libass_channel_neon(aa, inv, g, d.val[1]);
+            d.val[2] = blend_libass_channel_neon(aa, inv, r, d.val[2]);
+            d.val[3] = blend_libass_channel_neon(aa, inv, 255, d.val[3]);
+            vst4_u8(dst + (size_t)x * 4, d);
+        }
+        dst += dst_stride;
+        src += src_stride;
+    }
+}
+
+// One channel of src-over: min(0xff, src + (dst*inv + 127)/255). The scalar
+// srca==0xff and dst==0 shortcuts produce the same result as this formula,
+// so only srca==0 lanes need to keep dst (selected by the caller).
+static inline uint8x8_t blend_over_channel_neon(uint8x8_t srcc, uint8x8_t dstc,
+                                                uint8x8_t inv)
+{
+    uint16x8_t t = vaddq_u16(vmull_u8(dstc, inv), vdupq_n_u16(127));
+    return vqadd_u8(srcc, vmovn_u16(div255_u16_neon(t)));
+}
+
+// Requires w % 8 == 0; tail goes through the scalar path.
+static void blend_bgra_over_bgra_neon(uint8_t *dst, size_t dst_stride,
+                                      uint8_t *src, int src_stride,
+                                      int w, int h)
+{
+    for (int y = 0; y < h; y++) {
+        for (int x = 0; x < w; x += 8) {
+            uint8x8x4_t s = vld4_u8(src + (size_t)x * 4);
+            if (!vmaxv_u8(s.val[3]))
+                continue;
+
+            uint8x8x4_t d = vld4_u8(dst + (size_t)x * 4);
+            uint8x8_t inv = vmvn_u8(s.val[3]);
+            uint8x8_t keep = vceqz_u8(s.val[3]);
+            for (int c = 0; c < 4; c++) {
+                d.val[c] = vbsl_u8(keep, d.val[c],
+                    blend_over_channel_neon(s.val[c], d.val[c], inv));
+            }
+            vst4_u8(dst + (size_t)x * 4, d);
+        }
+        dst += dst_stride;
+        src += src_stride;
+    }
+}
+
+#endif // __aarch64__
+
+static void blend_libass_bgra(uint8_t *dst, size_t dst_stride,
+                              uint8_t *src, int src_stride,
+                              int w, int h, uint32_t color)
+{
+    if (!(0xff - (color & 0xff)))
+        return;
+#if defined(__aarch64__)
+    int w8 = w & ~7;
+    if (w8 > 0)
+        blend_libass_bgra_neon(dst, dst_stride, src, src_stride, w8, h, color);
+    if (w > w8)
+        blend_libass_bgra_scalar(dst + (size_t)w8 * 4, dst_stride,
+                                 src + w8, src_stride, w - w8, h, color);
+#else
+    blend_libass_bgra_scalar(dst, dst_stride, src, src_stride, w, h, color);
+#endif
+}
+
+static void blend_bgra_over_bgra(uint8_t *dst, size_t dst_stride,
+                                 uint8_t *src, int src_stride,
+                                 int w, int h)
+{
+#if defined(__aarch64__)
+    int w8 = w & ~7;
+    if (w8 > 0)
+        blend_bgra_over_bgra_neon(dst, dst_stride, src, src_stride, w8, h);
+    if (w > w8)
+        blend_bgra_over_bgra_scalar(dst + (size_t)w8 * 4, dst_stride,
+                                    src + (size_t)w8 * 4, src_stride,
+                                    w - w8, h);
+#else
+    blend_bgra_over_bgra_scalar(dst, dst_stride, src, src_stride, w, h);
+#endif
+}
+
+static void draw_direct_libass_bitmap(uint8_t *base, size_t stride,
+                                      int w, int h, struct sub_bitmap *sb)
+{
+    int x0 = MPCLAMP(sb->x, 0, w);
+    int y0 = MPCLAMP(sb->y, 0, h);
+    int x1 = MPCLAMP(sb->x + sb->w, 0, w);
+    int y1 = MPCLAMP(sb->y + sb->h, 0, h);
+    int draw_w = x1 - x0;
+    int draw_h = y1 - y0;
+    if (draw_w <= 0 || draw_h <= 0)
+        return;
+
+    uint8_t *dst = base + (size_t)y0 * stride + (size_t)x0 * 4;
+    uint8_t *src = (uint8_t *)sb->bitmap + (y0 - sb->y) * sb->stride + (x0 - sb->x);
+    blend_libass_bgra(dst, stride, src, sb->stride, draw_w, draw_h, sb->libass.color);
+}
+
+static void draw_direct_bgra_bitmap(uint8_t *base, size_t stride,
+                                    int w, int h, struct sub_bitmap *sb)
+{
+    int dw = sb->dw > 0 ? sb->dw : sb->w;
+    int dh = sb->dh > 0 ? sb->dh : sb->h;
+    int x0 = MPCLAMP(sb->x, 0, w);
+    int y0 = MPCLAMP(sb->y, 0, h);
+    int x1 = MPCLAMP(sb->x + dw, 0, w);
+    int y1 = MPCLAMP(sb->y + dh, 0, h);
+    int draw_w = x1 - x0;
+    int draw_h = y1 - y0;
+    if (draw_w <= 0 || draw_h <= 0)
+        return;
+
+    uint8_t *dst = base + (size_t)y0 * stride + (size_t)x0 * 4;
+    uint8_t *src = (uint8_t *)sb->bitmap + (y0 - sb->y) * sb->stride + (size_t)(x0 - sb->x) * 4;
+    blend_bgra_over_bgra(dst, stride, src, sb->stride, draw_w, draw_h);
+}
+
+static bool draw_subtitle_bitmaps_direct(struct priv *p, uint8_t *base,
+                                         size_t stride, int w, int h,
+                                         struct sub_bitmaps *imgs)
+{
+    int path = get_direct_osd_draw_path(imgs);
+    if (path != AVF_OSD_DRAW_DIRECT_LIBASS && path != AVF_OSD_DRAW_DIRECT_BGRA)
+        return false;
+
+    for (int i = 0; i < imgs->num_parts; i++) {
+        struct sub_bitmap *sb = &imgs->parts[i];
+        if (!sb->bitmap || sb->w <= 0 || sb->h <= 0)
+            continue;
+        if (path == AVF_OSD_DRAW_DIRECT_LIBASS)
+            draw_direct_libass_bitmap(base, stride, w, h, sb);
+        else
+            draw_direct_bgra_bitmap(base, stride, w, h, sb);
+    }
+
+    return true;
+}
+
+// Render subtitle bitmap to CGImage (used by compositing mode)
+static CGImageRef render_subtitle_image(struct vo *vo, struct sub_bitmaps *imgs)
+{
+    struct priv *p = vo->priv;
+
+    if (!imgs || imgs->num_parts == 0)
+        return NULL;
+
+    int w = p->osd_w;
+    int h = p->osd_h;
+
+    if (w <= 0 || h <= 0)
+        return NULL;
+
+    CGColorSpaceRef colorSpace = CGColorSpaceCreateDeviceRGB();
+    if (!colorSpace)
+        return NULL;
+
+    CGContextRef context = CGBitmapContextCreate(
+        NULL, w, h, 8, w * 4, colorSpace,
+        kCGImageAlphaPremultipliedLast | kCGBitmapByteOrder32Big
+    );
+    CGColorSpaceRelease(colorSpace);
+
+    if (!context)
+        return NULL;
+
+    CGContextClearRect(context, CGRectMake(0, 0, w, h));
+    draw_subtitle_bitmaps(context, imgs, h);
+
+    CGImageRef result = CGBitmapContextCreateImage(context);
+    CGContextRelease(context);
+
+    return result;
+}
+
+static CVPixelBufferRef create_empty_osd_pixel_buffer(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    int w = p->osd_w;
+    int h = p->osd_h;
+
+    if (w <= 0 || h <= 0)
+        return NULL;
+
+    if (!create_osd_pool(vo, w, h))
+        return NULL;
+
+    CVPixelBufferRef pixbuf = NULL;
+    CVReturn status = CVPixelBufferPoolCreatePixelBuffer(
+        kCFAllocatorDefault, p->osdPool, &pixbuf);
+
+    if (status != kCVReturnSuccess || !pixbuf) {
+        MP_ERR(vo, "Failed to get OSD overlay buffer: %d\n", status);
+        return NULL;
+    }
+
+    CVPixelBufferLockBaseAddress(pixbuf, 0);
+    void *base = CVPixelBufferGetBaseAddress(pixbuf);
+    size_t stride = CVPixelBufferGetBytesPerRow(pixbuf);
+    if (!base || !stride) {
+        CVPixelBufferUnlockBaseAddress(pixbuf, 0);
+        CVPixelBufferRelease(pixbuf);
+        return NULL;
+    }
+
+    int64_t t = mp_time_ns();
+    struct osd_buf_state *st = osd_buf_state_acquire(p, pixbuf);
+    struct mp_rect dirty = st ? st->dirty : (struct mp_rect){0, 0, w, h};
+    dirty.x0 = MPCLAMP(dirty.x0, 0, w);
+    dirty.y0 = MPCLAMP(dirty.y0, 0, h);
+    dirty.x1 = MPCLAMP(dirty.x1, 0, w);
+    dirty.y1 = MPCLAMP(dirty.y1, 0, h);
+    if (dirty.x1 > dirty.x0 && dirty.y1 > dirty.y0) {
+        size_t span = (size_t)(dirty.x1 - dirty.x0) * 4;
+        uint8_t *row = (uint8_t *)base + (size_t)dirty.y0 * stride +
+                       (size_t)dirty.x0 * 4;
+        for (int y = dirty.y0; y < dirty.y1; y++) {
+            memset(row, 0, span);
+            row += stride;
+        }
+    }
+    if (st)
+        st->dirty = (struct mp_rect){0, 0, 0, 0};
+    p->perf.clear_ns += mp_time_ns() - t;
+
+    CVPixelBufferUnlockBaseAddress(pixbuf, 0);
+    return pixbuf;
+}
+
+static CVPixelBufferRef render_subtitle_pixel_buffer(struct vo *vo,
+                                                     struct sub_bitmaps *imgs)
+{
+    struct priv *p = vo->priv;
+    int w = p->osd_w;
+    int h = p->osd_h;
+
+    if (!imgs || imgs->num_parts == 0)
+        return NULL;
+
+    CVPixelBufferRef pixbuf = create_empty_osd_pixel_buffer(vo);
+    if (!pixbuf)
+        return NULL;
+
+    CVPixelBufferLockBaseAddress(pixbuf, 0);
+    void *base = CVPixelBufferGetBaseAddress(pixbuf);
+    size_t stride = CVPixelBufferGetBytesPerRow(pixbuf);
+    if (!base || !stride) {
+        CVPixelBufferUnlockBaseAddress(pixbuf, 0);
+        CVPixelBufferRelease(pixbuf);
+        return NULL;
+    }
+
+    int64_t t = mp_time_ns();
+    if (draw_subtitle_bitmaps_direct(p, base, stride, w, h, imgs)) {
+        p->perf.blend_ns += mp_time_ns() - t;
+        CVPixelBufferUnlockBaseAddress(pixbuf, 0);
+        return pixbuf;
+    }
+
+    CGColorSpaceRef colorSpace = CGColorSpaceCreateDeviceRGB();
+    CGContextRef context = colorSpace ? CGBitmapContextCreate(
+        base, w, h, 8, stride, colorSpace,
+        kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Little
+    ) : NULL;
+
+    if (colorSpace)
+        CGColorSpaceRelease(colorSpace);
+
+    if (!context) {
+        CVPixelBufferUnlockBaseAddress(pixbuf, 0);
+        CVPixelBufferRelease(pixbuf);
+        return NULL;
+    }
+
+    draw_subtitle_bitmaps(context, imgs, h);
+    CGContextRelease(context);
+    p->perf.cg_ns += mp_time_ns() - t;
+
+    CVPixelBufferUnlockBaseAddress(pixbuf, 0);
+    return pixbuf;
+}
+
+// Draw every item of list into one overlay buffer: the frame's subtitles and
+// OSD share the inline layer, so one item must not replace another. NULL
+// when nothing could be drawn.
+static CVPixelBufferRef render_subtitle_list_pixel_buffer(struct vo *vo,
+                                                          struct sub_bitmap_list *list)
+{
+    struct priv *p = vo->priv;
+    int w = p->osd_w;
+    int h = p->osd_h;
+
+    CVPixelBufferRef pixbuf = create_empty_osd_pixel_buffer(vo);
+    if (!pixbuf)
+        return NULL;
+
+    CVPixelBufferLockBaseAddress(pixbuf, 0);
+    void *base = CVPixelBufferGetBaseAddress(pixbuf);
+    size_t stride = CVPixelBufferGetBytesPerRow(pixbuf);
+    if (!base || !stride) {
+        CVPixelBufferUnlockBaseAddress(pixbuf, 0);
+        CVPixelBufferRelease(pixbuf);
+        return NULL;
+    }
+
+    CGContextRef context = NULL;
+    bool drawn = false;
+    for (int n = 0; n < list->num_items; n++) {
+        struct sub_bitmaps *imgs = list->items[n];
+        if (!imgs->num_parts)
+            continue;
+        int64_t t = mp_time_ns();
+        if (draw_subtitle_bitmaps_direct(p, base, stride, w, h, imgs)) {
+            p->perf.blend_ns += mp_time_ns() - t;
+            drawn = true;
+            continue;
+        }
+        if (!context) {
+            CGColorSpaceRef colorSpace = CGColorSpaceCreateDeviceRGB();
+            context = colorSpace ? CGBitmapContextCreate(
+                base, w, h, 8, stride, colorSpace,
+                kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Little
+            ) : NULL;
+            if (colorSpace)
+                CGColorSpaceRelease(colorSpace);
+            if (!context)
+                continue;
+        }
+        draw_subtitle_bitmaps(context, imgs, h);
+        p->perf.cg_ns += mp_time_ns() - t;
+        drawn = true;
+    }
+    if (context)
+        CGContextRelease(context);
+
+    CVPixelBufferUnlockBaseAddress(pixbuf, 0);
+    if (!drawn) {
+        CVPixelBufferRelease(pixbuf);
+        return NULL;
+    }
+    return pixbuf;
+}
+
+// Wrap pixbuf (not consumed) in a sample buffer. An immediate sample is shown
+// as soon as it arrives instead of at pts on the layer's timebase.
+static CMSampleBufferRef create_image_sample_buffer(struct vo *vo,
+                                                    CVPixelBufferRef pixbuf,
+                                                    int64_t pts_ns,
+                                                    bool immediate)
+{
+    CMSampleTimingInfo info = {
+        .presentationTimeStamp = cm_time_from_ns(pts_ns),
+        .duration = kCMTimeInvalid,
+        .decodeTimeStamp = kCMTimeInvalid
+    };
+
+    CMFormatDescriptionRef format = NULL;
+    CMSampleBufferRef buf = NULL;
+    OSStatus err = CMVideoFormatDescriptionCreateForImageBuffer(NULL, pixbuf, &format);
+    if (err == noErr && format)
+        err = CMSampleBufferCreateReadyWithImageBuffer(NULL, pixbuf, format, &info, &buf);
+
+    if (format)
+        CFRelease(format);
+
+    if (err != noErr || !buf) {
+        MP_ERR(vo, "Failed to create image sample buffer: %d\n", (int)err);
+        return NULL;
+    }
+
+    if (immediate) {
+        CFArrayRef attachments = CMSampleBufferGetSampleAttachmentsArray(buf, true);
+        if (attachments && CFArrayGetCount(attachments) > 0) {
+            CFMutableDictionaryRef dict =
+                (CFMutableDictionaryRef)CFArrayGetValueAtIndex(attachments, 0);
+            CFDictionarySetValue(dict, kCMSampleAttachmentKey_DisplayImmediately,
+                                 kCFBooleanTrue);
+        }
+    }
+
+    return buf;
+}
+
+static CMSampleBufferRef create_osd_sample_buffer(struct vo *vo,
+                                                  int64_t media_pts_ns,
+                                                  bool *needed)
+{
+    struct priv *p = vo->priv;
+
+    if (needed)
+        *needed = false;
+
+    if (!should_use_inline_osd_layer(p) || !p->osd_needs_enqueue)
+        return NULL;
+
+    if (needed)
+        *needed = true;
+
+    CVPixelBufferRef pixbuf = NULL;
+    if (p->has_subtitle && p->cachedSubtitleBuffer) {
+        pixbuf = CVPixelBufferRetain(p->cachedSubtitleBuffer);
+    } else {
+        pixbuf = create_empty_osd_pixel_buffer(vo);
+    }
+    if (!pixbuf)
+        return NULL;
+
+    CMSampleBufferRef buf = create_image_sample_buffer(vo, pixbuf, media_pts_ns, false);
+    CVPixelBufferRelease(pixbuf);
+    return buf;
+}
+
+static bool enqueue_osd_sample(struct vo *vo, CMSampleBufferRef buf)
+{
+    struct priv *p = vo->priv;
+
+    if (!buf)
+        return true;
+
+    AVSampleBufferDisplayLayer *osdLayer = [p->osdLayer retain];
+    if (!osdLayer)
+        return false;
+
+    if (!sample_buffer_renderer_is_ready(osdLayer)) {
+        MP_VERBOSE(vo, "OSD layer not ready; dropping subtitle sample for this frame\n");
+        [osdLayer release];
+        return false;
+    }
+
+    sample_buffer_renderer_enqueue(osdLayer, buf);
+    [osdLayer release];
+
+    return true;
+}
+
+// Where the layers' shared timebase is now, for samples shown at once.
+static int64_t layer_time_ns(struct priv *p)
+{
+    return p->timebase ? cm_time_to_ns(CMTimebaseGetTime(p->timebase)) : 0;
+}
+
+// Make the OSD layer show nothing, dropping what is queued for it, without
+// removing its image. Removing the displayed image (flush with removal)
+// hands the layer's video receiver an empty configuration on every seek,
+// and on macOS 27 tearing receivers down on a visible layer can wedge the
+// display (AVF_LAYER_RETIRE_DELAY_NS). A transparent sample looks the same.
+static void clear_osd_layer(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    if (!p->osdLayer)
+        return;
+    sample_buffer_renderer_flush(p->osdLayer);
+    if (!p->osd_layer_dirty)
+        return;
+
+    // Shown at once, so the subtitle leaves with the seek rather than with
+    // the first frame after it. The next frame carries a timed clear too, in
+    // case another flush drops this one before it is shown.
+    p->osd_needs_enqueue = true;
+    CVPixelBufferRef pixbuf = create_empty_osd_pixel_buffer(vo);
+    if (!pixbuf)
+        return;
+    CMSampleBufferRef buf = create_image_sample_buffer(vo, pixbuf, layer_time_ns(p), true);
+    CVPixelBufferRelease(pixbuf);
+    if (!buf)
+        return;
+    // A flush leaves the layer refusing samples for a moment (under a
+    // millisecond on macOS 27); wait that out rather than drop the clear.
+    if (!sample_buffer_renderer_is_ready(p->osdLayer))
+        wait_for_renderer_ready(p, p->osdLayer, mp_time_ns() + MP_TIME_MS_TO_NS(4));
+    enqueue_osd_sample(vo, buf);
+    CFRelease(buf);
+}
+
+// Callback for osd_draw - renders subtitle bitmaps
+static void draw_osd_cb(void *ctx, struct sub_bitmaps *imgs)
+{
+    struct vo *vo = ctx;
+    struct priv *p = vo->priv;
+
+    // Mark that callback was invoked this frame
+    p->osd_callback_invoked = true;
+
+    // Clear subtitles when there are none
+    if (!imgs || imgs->num_parts == 0) {
+        if (p->has_subtitle || p->cachedSubtitleImage || p->cachedSubtitleBuffer) {
+            p->perf.empty++;
+            p->has_subtitle = false;
+            p->osd_change_id = 0;  // Reset change_id so next subtitle renders
+            if (p->cachedSubtitleImage) {
+                CGImageRelease(p->cachedSubtitleImage);
+                p->cachedSubtitleImage = NULL;
+            }
+            if (p->cachedSubtitleBuffer) {
+                CVPixelBufferRelease(p->cachedSubtitleBuffer);
+                p->cachedSubtitleBuffer = NULL;
+            }
+            if (should_use_inline_osd_layer(p))
+                p->osd_needs_enqueue = true;
+        }
+        return;
+    }
+
+    // Skip redraw if content hasn't changed AND we already have a subtitle cached
+    // This prevents unnecessary re-rendering but ensures we don't skip first render
+    bool need_image = should_composite_into_video(p);
+    bool need_buffer = should_use_inline_osd_layer(p) || should_composite_into_video(p);
+    bool has_cached_subtitle = (!need_image || p->cachedSubtitleImage) &&
+        (!need_buffer || p->cachedSubtitleBuffer);
+    if (imgs->change_id != 0 && imgs->change_id == p->osd_change_id &&
+        p->has_subtitle && has_cached_subtitle) {
+        p->perf.skipped++;
+        return;
+    }
+
+    int64_t t_render = mp_time_ns();
+    bool rendered = false;
+    if (need_image) {
+        CGImageRef subtitleImage = render_subtitle_image(vo, imgs);
+        if (subtitleImage) {
+            if (p->cachedSubtitleImage)
+                CGImageRelease(p->cachedSubtitleImage);
+            p->cachedSubtitleImage = subtitleImage;
+            rendered = true;
+        }
+    }
+
+    if (need_buffer) {
+        CVPixelBufferRef subtitleBuffer = render_subtitle_pixel_buffer(vo, imgs);
+        if (!subtitleBuffer && !rendered)
+            return;
+
+        if (subtitleBuffer) {
+            if (p->cachedSubtitleBuffer)
+                CVPixelBufferRelease(p->cachedSubtitleBuffer);
+            p->cachedSubtitleBuffer = subtitleBuffer;
+            int64_t t_bounds = mp_time_ns();
+            update_subtitle_bounds_from_parts(p, imgs);
+            osd_buf_record_dirty(p, subtitleBuffer, (struct mp_rect){
+                p->subtitle_x0, p->subtitle_y0,
+                p->subtitle_x1, p->subtitle_y1});
+            p->perf.bounds_ns += mp_time_ns() - t_bounds;
+            rendered = true;
+        }
+    }
+
+    if (!rendered)
+        return;
+
+    int64_t render_ns = mp_time_ns() - t_render;
+    p->perf.renders++;
+    p->perf.total_ns += render_ns;
+    p->perf.max_ns = MPMAX(p->perf.max_ns, render_ns);
+    if (render_ns > MP_TIME_MS_TO_NS(8) && mp_msg_test(vo->log, MSGL_V)) {
+        int64_t now = mp_time_ns();
+        if (now - p->perf.last_spike_ns > MP_TIME_MS_TO_NS(1000)) {
+            p->perf.last_spike_ns = now;
+            MP_VERBOSE(vo, "osd-perf spike: render %.2fms (parts=%d osd=%dx%d)\n",
+                       render_ns / 1e6, imgs->num_parts, p->osd_w, p->osd_h);
+        }
+    }
+
+    p->osd_change_id = imgs->change_id;
+    p->has_subtitle = true;
+    if (should_use_inline_osd_layer(p))
+        p->osd_needs_enqueue = true;
+}
+
+static const bool osd_formats[SUBBITMAP_COUNT] = {
+    [SUBBITMAP_BGRA] = true,
+    [SUBBITMAP_LIBASS] = true,
+};
+
+// The OSD canvas for a frame of height frame_h shown with geometry. False
+// when there is nothing to draw on.
+static bool osd_canvas(struct vo *vo, struct avf_render_geometry geometry,
+                       int frame_h, struct avf_osd_canvas *out)
+{
+    struct priv *p = vo->priv;
+
+    if (!vo->osd)
+        return false;
+
+    // In compositing modes, we don't need the inline OSD layer.
+    if (!should_composite_into_video(p) && !p->osdLayer)
+        return false;
+
+    struct mp_osd_res osd_res = geometry.osd_res;
+
+    if (geometry.w <= 0 || geometry.h <= 0 || osd_res.w <= 0 || osd_res.h <= 0)
+        return false;
+
+    int osd_w = geometry.w;
+    int osd_h = geometry.h;
+
+    // Optionally rasterize the OSD below display resolution; the OSD layer
+    // upscales (videoGravity resize). Inline mode only: the composite paths
+    // do pixel math that assumes the buffer matches the display geometry.
+    double scale = 1.0;
+    if (should_use_inline_osd_layer(p) && p->opts) {
+        // Video-resolution mode: match the OSD pixel density to the video's
+        // upscale factor, so the canvas maps 1:1 onto video pixels over the
+        // on-screen video rect.
+        if (p->opts->osd_video_res) {
+            if (frame_h <= 0)
+                frame_h = vo->params ? vo->params->h : 0;
+            int dst_h = geometry.dst.y1 - geometry.dst.y0;
+            if (frame_h > 0 && dst_h > frame_h)
+                scale = (double)frame_h / dst_h;
+        }
+        int max_h = p->opts->osd_max_height;
+        if (max_h > 0 && osd_res.h * scale > max_h)
+            scale = (double)max_h / osd_res.h;
+    }
+    if (scale < 1.0) {
+        osd_res.w = MPMAX(1, (int)(osd_res.w * scale + 0.5));
+        osd_res.h = MPMAX(1, (int)(osd_res.h * scale + 0.5));
+        osd_res.ml = (int)(osd_res.ml * scale + 0.5);
+        osd_res.mt = (int)(osd_res.mt * scale + 0.5);
+        osd_res.mr = (int)(osd_res.mr * scale + 0.5);
+        osd_res.mb = (int)(osd_res.mb * scale + 0.5);
+        osd_w = osd_res.w;
+        osd_h = osd_res.h;
+    }
+
+    *out = (struct avf_osd_canvas){.w = osd_w, .h = osd_h, .res = osd_res};
+    return true;
+}
+
+static bool osd_canvas_equal(const struct avf_osd_canvas *a,
+                             const struct avf_osd_canvas *b)
+{
+    return a->w == b->w && a->h == b->h && osd_res_equals(a->res, b->res);
+}
+
+// Forget the displayed subtitle; the inline layer then needs a clear sample.
+static void drop_displayed_subtitle(struct priv *p)
+{
+    p->has_subtitle = false;
+    p->osd_change_id = 0;
+    if (p->cachedSubtitleImage) {
+        CGImageRelease(p->cachedSubtitleImage);
+        p->cachedSubtitleImage = NULL;
+    }
+    if (p->cachedSubtitleBuffer) {
+        CVPixelBufferRelease(p->cachedSubtitleBuffer);
+        p->cachedSubtitleBuffer = NULL;
+    }
+    if (should_use_inline_osd_layer(p))
+        p->osd_needs_enqueue = true;
+}
+
+// Inline layer: the whole list becomes the overlay buffer the next OSD
+// sample carries.
+static void present_inline_osd_list(struct vo *vo, struct sub_bitmap_list *list)
+{
+    struct priv *p = vo->priv;
+
+    int parts = 0;
+    for (int n = 0; n < list->num_items; n++)
+        parts += list->items[n]->num_parts;
+    if (!parts) {
+        if (p->has_subtitle || p->cachedSubtitleImage || p->cachedSubtitleBuffer) {
+            p->perf.empty++;
+            drop_displayed_subtitle(p);
+        }
+        return;
+    }
+
+    if (list->change_id && list->change_id == p->osd_change_id &&
+        p->has_subtitle && p->cachedSubtitleBuffer)
+    {
+        p->perf.skipped++;
+        return;
+    }
+
+    int64_t t_render = mp_time_ns();
+    CVPixelBufferRef subtitleBuffer = render_subtitle_list_pixel_buffer(vo, list);
+    if (!subtitleBuffer)
+        return;
+    if (p->cachedSubtitleBuffer)
+        CVPixelBufferRelease(p->cachedSubtitleBuffer);
+    p->cachedSubtitleBuffer = subtitleBuffer;
+
+    int64_t t_bounds = mp_time_ns();
+    reset_subtitle_bounds(p);
+    for (int n = 0; n < list->num_items; n++)
+        extend_subtitle_bounds(p, list->items[n]);
+    osd_buf_record_dirty(p, subtitleBuffer, (struct mp_rect){
+        p->subtitle_x0, p->subtitle_y0,
+        p->subtitle_x1, p->subtitle_y1});
+    p->perf.bounds_ns += mp_time_ns() - t_bounds;
+
+    int64_t render_ns = mp_time_ns() - t_render;
+    p->perf.renders++;
+    p->perf.total_ns += render_ns;
+    p->perf.max_ns = MPMAX(p->perf.max_ns, render_ns);
+    if (render_ns > MP_TIME_MS_TO_NS(8) && mp_msg_test(vo->log, MSGL_V)) {
+        int64_t now = mp_time_ns();
+        if (now - p->perf.last_spike_ns > MP_TIME_MS_TO_NS(1000)) {
+            p->perf.last_spike_ns = now;
+            MP_VERBOSE(vo, "osd-perf spike: render %.2fms (parts=%d osd=%dx%d)\n",
+                       render_ns / 1e6, parts, p->osd_w, p->osd_h);
+        }
+    }
+
+    p->osd_change_id = list->change_id;
+    p->has_subtitle = true;
+    p->osd_needs_enqueue = true;
+}
+
+// Make list, rendered on canvas, what the next frame shows.
+static void apply_osd_list(struct vo *vo, const struct avf_osd_canvas *canvas,
+                           struct sub_bitmap_list *list)
+{
+    struct priv *p = vo->priv;
+
+    if (!osd_res_equals(p->osd_res, canvas->res)) {
+        p->osd_res = canvas->res;
+        p->osd_change_id = 0;
+    }
+    p->osd_w = canvas->w;
+    p->osd_h = canvas->h;
+
+    if (should_use_inline_osd_layer(p)) {
+        present_inline_osd_list(vo, list);
+        return;
+    }
+
+    // The composite modes keep per-item images (draw_osd_cb), which the
+    // video sample composites.
+    p->osd_callback_invoked = false;
+    for (int n = 0; n < list->num_items; n++)
+        draw_osd_cb(vo, list->items[n]);
+
+    // If callback wasn't invoked, there are no subtitles for this PTS
+    // Clear any cached subtitle state
+    if (!p->osd_callback_invoked && p->has_subtitle)
+        drop_displayed_subtitle(p);
+}
+
+// Render OSD/subtitles synchronously so timed clear samples are never
+// skipped. Only used when the render-ahead thread is unavailable.
+static void render_osd(struct vo *vo, double pts)
+{
+    struct priv *p = vo->priv;
+    int frame_w = p->next_image ? p->next_image->w : 0;
+    int frame_h = p->next_image ? p->next_image->h : 0;
+    struct avf_render_geometry geometry = get_render_geometry(vo, frame_w, frame_h);
+
+    struct avf_osd_canvas canvas;
+    if (!osd_canvas(vo, geometry, frame_h, &canvas))
+        return;
+    struct sub_bitmap_list *list = osd_render(vo->osd, canvas.res, pts, 0, osd_formats);
+    apply_osd_list(vo, &canvas, list);
+    talloc_free(list);
+}
+
+// --- subtitle render-ahead (osd_ahead.h)
+
+// Render thread: a result was queued. While paused, flip_page runs only for
+// the core's redraws, so nothing would show a result that missed its frame;
+// wake the VO thread to present it.
+static void ahead_result_posted(void *ctx)
+{
+    struct vo *vo = ctx;
+    struct priv *p = vo->priv;
+    if (!atomic_load(&p->ahead_paused))
+        return;
+    atomic_store(&p->ahead_late_result, true);
+    vo_wakeup(vo);
+}
+
+// Locked.
+static void ahead_latch_canvas(void *ctx)
+{
+    struct priv *p = ((struct vo *)ctx)->priv;
+    p->ahead_render_canvas = p->ahead_canvas;
+}
+
+static void ahead_canvas_size(void *ctx, int *w, int *h)
+{
+    struct priv *p = ((struct vo *)ctx)->priv;
+    *w = p->ahead_render_canvas.w;
+    *h = p->ahead_render_canvas.h;
+}
+
+static struct mp_osd_res ahead_canvas_res(void *ctx, int w, int h)
+{
+    struct priv *p = ((struct vo *)ctx)->priv;
+    return p->ahead_render_canvas.res;
+}
+
+static void ahead_start(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (!vo->osd)
+        return;
+    p->ahead.log = vo->log;
+    p->ahead.osd = vo->osd;
+    p->ahead.formats = osd_formats;
+    p->ahead.cb = (struct osd_ahead_callbacks){
+        .ctx = vo,
+        .latch_canvas = ahead_latch_canvas,
+        .canvas_size = ahead_canvas_size,
+        .canvas_res = ahead_canvas_res,
+        .result_posted = ahead_result_posted,
+    };
+    p->ahead_last_pts = MP_NOPTS_VALUE;
+    if (!osd_ahead_start(&p->ahead))
+        MP_WARN(vo, "Subtitle render thread unavailable; rendering on the VO thread\n");
+}
+
+// File this frame's subtitles with the render thread: pinned to the frame
+// for a new one, an immediate repaint for a redraw. flip_page presents them.
+static void ahead_file_frame(struct vo *vo, struct vo_frame *frame)
+{
+    struct priv *p = vo->priv;
+    struct osd_ahead *s = &p->ahead;
+
+    p->ahead_req.valid = false;
+    if (!s->started || !p->next_image || p->ahead_replay)
+        return;
+
+    int frame_h = p->next_image->h;
+    struct avf_render_geometry geometry =
+        get_render_geometry(vo, p->next_image->w, frame_h);
+    struct avf_osd_canvas canvas;
+    if (!osd_canvas(vo, geometry, frame_h, &canvas))
+        return;
+
+    double pts = p->next_pts;
+    bool redraw = frame->redraw;
+    if (!redraw) {
+        if (pts == MP_NOPTS_VALUE)
+            osd_cadence_reset(&p->ahead_cadence);
+        else
+            osd_cadence_observe(&p->ahead_cadence, frame->frame_id, pts);
+    }
+
+    mp_mutex_lock(&s->lock);
+    if (!p->ahead_canvas_valid || !osd_canvas_equal(&p->ahead_canvas, &canvas)) {
+        // Nothing rendered for the old canvas may reach this one.
+        p->ahead_canvas = canvas;
+        p->ahead_canvas_valid = true;
+        osd_ahead_invalidate(s, pts);
+    }
+    osd_ahead_file_request(s, (struct osd_request){
+        .pts = pts,
+        .delta = redraw ? 0 : osd_cadence_delta(&p->ahead_cadence),
+        .seq = redraw ? 0 : ++p->ahead_frame_seq,
+        .epoch = s->epoch,
+    });
+    if (!redraw)
+        s->stats.frames++;
+    // What the filing became: a repaint moves to a new epoch, or adopts a
+    // pending frame of the same pts.
+    p->ahead_req.valid = true;
+    p->ahead_req.seq = s->request.seq;
+    p->ahead_req.epoch = s->request.epoch;
+    // While paused a new frame (a seek) is shown at once: there is no queue
+    // lead to protect.
+    p->ahead_req.timed = !redraw && frame->pts > 0 && !s->paused;
+    mp_mutex_unlock(&s->lock);
+    p->ahead_last_pts = pts;
+}
+
+// Present what the render thread has for this frame, waiting only as long
+// as avf_osd_wait_until allows. A result that arrives later is shown with a
+// later frame; of several ready ones only the newest is drawn.
+static void ahead_present(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    struct osd_ahead *s = &p->ahead;
+    bool composite = should_composite_into_video(p);
+
+    mp_mutex_lock(&s->lock);
+    if (p->ahead_req.valid && p->ahead_req.seq) {
+        osd_ahead_publish_release(s, (struct osd_release){
+            .seq = p->ahead_req.seq,
+            .timestamp = p->next_present_host_ns,
+        });
+    }
+    if (p->ahead_req.valid) {
+        int64_t now = mp_time_ns();
+        bool behind = p->ahead_req.seq && s->served_epoch == p->ahead_req.epoch &&
+                      s->served_seq + 1 < p->ahead_req.seq;
+        int64_t until = avf_osd_wait_until(now, p->next_present_host_ns,
+            MP_TIME_MS_TO_NS(p->opts->queue_lead_ms), p->ahead_req.timed,
+            composite, behind);
+        if (behind)
+            p->ahead_perf.behind++;
+        if (until > now) {
+            bool served = osd_ahead_wait_served(s, p->ahead_req.epoch,
+                                                p->ahead_req.seq, until);
+            int64_t waited = mp_time_ns() - now;
+            p->ahead_perf.waited++;
+            p->ahead_perf.wait_ns += waited;
+            p->ahead_perf.wait_max_ns = MPMAX(p->ahead_perf.wait_max_ns, waited);
+            if (!served)
+                p->ahead_perf.gave_up++;
+        }
+    }
+    int dropped;
+    struct osd_result r = osd_ahead_take_newest(s, &dropped);
+    struct sub_bitmap_list *list = r.slot >= 0 ? s->slots[r.slot].sbs : NULL;
+    mp_mutex_unlock(&s->lock);
+    p->ahead_req.valid = false;
+    p->ahead_perf.dropped += dropped;
+
+    // The taken slot stays immutable while it is present_slot.
+    if (!list)
+        return;
+    p->ahead_perf.presented++;
+    if (r.seq && r.seq < p->ahead_frame_seq) {
+        int late = (int)(p->ahead_frame_seq - r.seq);
+        p->ahead_perf.late++;
+        p->ahead_perf.max_late = MPMAX(p->ahead_perf.max_late, late);
+    }
+    apply_osd_list(vo, &p->ahead_canvas, list);
+}
+
+// Nothing the render thread has rendered or is rendering counts as shown any
+// more: repaint in full at pts.
+static void ahead_invalidate(struct priv *p, double pts)
+{
+    if (!p->ahead.started)
+        return;
+    mp_mutex_lock(&p->ahead.lock);
+    osd_ahead_invalidate(&p->ahead, pts);
+    mp_mutex_unlock(&p->ahead.lock);
+}
+
+static void ahead_set_paused(struct priv *p, bool paused)
+{
+    if (!p->ahead.started)
+        return;
+    mp_mutex_lock(&p->ahead.lock);
+    p->ahead.paused = paused;
+    mp_cond_broadcast(&p->ahead.wakeup);
+    mp_mutex_unlock(&p->ahead.lock);
+    atomic_store(&p->ahead_paused, paused);
+    // A result queued just before the pause saw playback still running and
+    // is waiting for a frame that will not come.
+    if (paused)
+        atomic_store(&p->ahead_late_result, true);
+}
+
+static void flip_page(struct vo *vo);
+static bool draw_frame(struct vo *vo, struct vo_frame *frame);
+
+// Paused: redraw the frame on screen with a result that arrived after it, as
+// the core's redraw would, but without filing a request. A filing is a
+// repaint, which would discard the very result that is ready and render it
+// again.
+static void ahead_present_late(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    struct osd_ahead *s = &p->ahead;
+    if (!s->started || !p->ahead_shown_image)
+        return;
+    mp_mutex_lock(&s->lock);
+    struct osd_result *head = osd_result_head(&s->results);
+    bool ready = s->paused && head && (!head->seq || head->release.seq == head->seq);
+    mp_mutex_unlock(&s->lock);
+    if (!ready)
+        return;
+    struct vo_frame frame = {
+        .pts = 0,
+        .duration = -1,
+        .redraw = true,
+        .still = true,
+        .current = p->ahead_shown_image,
+        .num_frames = 1,
+        .frames = {p->ahead_shown_image},
+    };
+    p->ahead_replay = true;
+    if (draw_frame(vo, &frame))
+        flip_page(vo);
+    p->ahead_replay = false;
+}
+
+static void report_ahead_perf(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    struct osd_ahead *s = &p->ahead;
+    if (!s->started || !mp_msg_test(vo->log, MSGL_V))
+        return;
+    mp_mutex_lock(&s->lock);
+    struct osd_ahead_stats st = s->stats;
+    struct osd_spec spec = s->spec;
+    uint32_t prefetch = s->prefetch.count;
+    mp_mutex_unlock(&s->lock);
+    int nw = MPMAX(p->ahead_perf.waited, 1);
+    MP_VERBOSE(vo, "osd-ahead: presented=%d waited=%d (avg %.2fms max %.2fms) "
+               "gave_up=%d behind=%d dropped=%d late=%d (max %d frames) | "
+               "renders=%u/%u maxMs=%d hist=%u,%u,%u,%u,%u spec=%u/%u/%u "
+               "horizonSkips=%u prefetch=%u coalesced=%u stale=%u\n",
+               p->ahead_perf.presented, p->ahead_perf.waited,
+               p->ahead_perf.wait_ns / nw / 1e6, p->ahead_perf.wait_max_ns / 1e6,
+               p->ahead_perf.gave_up, p->ahead_perf.behind, p->ahead_perf.dropped,
+               p->ahead_perf.late, p->ahead_perf.max_late,
+               st.renders_changed, st.renders, (int)(st.render_ns_max / 1000000),
+               st.render_hist[0], st.render_hist[1], st.render_hist[2],
+               st.render_hist[3], st.render_hist[4],
+               spec.hits, spec.misses, spec.skips, spec.horizon_skips, prefetch,
+               st.coalesced, st.stale);
+    memset(&p->ahead_perf, 0, sizeof(p->ahead_perf));
+}
+
+// --- end subtitle render-ahead
+
+static bool ensure_ci_compositor(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    if (p->ciContext)
+        return true;
+
+    p->mtlDevice = MTLCreateSystemDefaultDevice();
+    if (!p->mtlDevice) {
+        MP_ERR(vo, "Failed to create Metal device\n");
+        return false;
+    }
+
+    NSDictionary *ciOptions = @{
+        kCIContextHighQualityDownsample: @NO,
+        kCIContextUseSoftwareRenderer: @NO
+    };
+    p->ciContext = [[CIContext contextWithMTLDevice:p->mtlDevice options:ciOptions] retain];
+    if (!p->ciContext) {
+        MP_ERR(vo, "Failed to create CIContext\n");
+        [p->mtlDevice release];
+        p->mtlDevice = nil;
+        return false;
+    }
+
+    return true;
+}
+
+static void release_ci_compositor(struct priv *p)
+{
+    [p->ciContext release];
+    p->ciContext = nil;
+    [p->mtlDevice release];
+    p->mtlDevice = nil;
+}
+
+static CVPixelBufferRef composite_yuv_frame(struct vo *vo, CVPixelBufferRef videoBuffer,
+                                           OSType sourceFormat, bool in_place)
+{
+    struct priv *p = vo->priv;
+
+    if (!p->cachedSubtitleBuffer || p->subtitle_x1 <= p->subtitle_x0 ||
+        p->subtitle_y1 <= p->subtitle_y0)
+        return NULL;
+
+    int videoW = (int)CVPixelBufferGetWidth(videoBuffer);
+    int videoH = (int)CVPixelBufferGetHeight(videoBuffer);
+    if (videoW <= 0 || videoH <= 0)
+        return NULL;
+
+    int subW = (int)CVPixelBufferGetWidth(p->cachedSubtitleBuffer);
+    int subH = (int)CVPixelBufferGetHeight(p->cachedSubtitleBuffer);
+    if (subW <= 0 || subH <= 0)
+        return NULL;
+
+    struct avf_render_geometry geometry = get_render_geometry(vo, videoW, videoH);
+    struct mp_rect src = geometry.src;
+    struct mp_rect dst = geometry.dst;
+    int srcW = src.x1 - src.x0;
+    int srcH = src.y1 - src.y0;
+    int dstW = dst.x1 - dst.x0;
+    int dstH = dst.y1 - dst.y0;
+
+    struct mp_rect sub = {p->subtitle_x0, p->subtitle_y0,
+                          p->subtitle_x1, p->subtitle_y1};
+    struct mp_rect target;
+    if (!avf_map_subtitle_rect(geometry, sub, subW, subH, videoW, videoH, &target))
+        return NULL;
+
+    int vx0 = target.x0;
+    int vy0 = target.y0;
+    int vx1 = target.x1;
+    int vy1 = target.y1;
+
+    CVPixelBufferRef outputBuffer = NULL;
+    if (in_place) {
+        outputBuffer = CVPixelBufferRetain(videoBuffer);
+    } else {
+        if (!create_output_pool(vo, videoW, videoH, sourceFormat))
+            return NULL;
+
+        CVReturn status = CVPixelBufferPoolCreatePixelBuffer(
+            kCFAllocatorDefault, p->outputPool, &outputBuffer);
+        if (status != kCVReturnSuccess || !outputBuffer) {
+            MP_ERR(vo, "Failed to get YUV composite buffer: %d\n", status);
+            return NULL;
+        }
+
+        copy_pixel_buffer_metadata(videoBuffer, outputBuffer, sourceFormat);
+        if (!copy_pixel_buffer_planes(videoBuffer, outputBuffer)) {
+            CVPixelBufferRelease(outputBuffer);
+            return NULL;
+        }
+    }
+
+    if (CVPixelBufferLockBaseAddress(outputBuffer, 0) != kCVReturnSuccess) {
+        CVPixelBufferRelease(outputBuffer);
+        return NULL;
+    }
+    if (CVPixelBufferLockBaseAddress(p->cachedSubtitleBuffer,
+                                     kCVPixelBufferLock_ReadOnly) != kCVReturnSuccess) {
+        CVPixelBufferUnlockBaseAddress(outputBuffer, 0);
+        CVPixelBufferRelease(outputBuffer);
+        return NULL;
+    }
+
+    uint8_t *subBase = CVPixelBufferGetBaseAddress(p->cachedSubtitleBuffer);
+    size_t subStride = CVPixelBufferGetBytesPerRow(p->cachedSubtitleBuffer);
+    uint8_t *yBase = CVPixelBufferGetBaseAddressOfPlane(outputBuffer, 0);
+    uint8_t *uvBase = CVPixelBufferGetBaseAddressOfPlane(outputBuffer, 1);
+    size_t yStride = CVPixelBufferGetBytesPerRowOfPlane(outputBuffer, 0);
+    size_t uvStride = CVPixelBufferGetBytesPerRowOfPlane(outputBuffer, 1);
+
+    if (!subBase || !subStride || subW <= 0 || subH <= 0 || !yBase || !uvBase) {
+        CVPixelBufferUnlockBaseAddress(p->cachedSubtitleBuffer, kCVPixelBufferLock_ReadOnly);
+        CVPixelBufferUnlockBaseAddress(outputBuffer, 0);
+        CVPixelBufferRelease(outputBuffer);
+        return NULL;
+    }
+
+    double kr, kb;
+    get_yuv_coefficients(videoBuffer, &kr, &kb);
+    double kg = 1.0 - kr - kb;
+    bool fullRange = is_full_range_yuv_format(sourceFormat);
+    bool p010 = is_p010_format(sourceFormat);
+
+    double yOffset = fullRange ? 0.0 : (p010 ? 64.0 : 16.0);
+    double yRange = fullRange ? (p010 ? 1023.0 : 255.0) : (p010 ? 876.0 : 219.0);
+    double cCenter = p010 ? 512.0 : 128.0;
+    double cRange = fullRange ? (p010 ? 1023.0 : 255.0) : (p010 ? 896.0 : 224.0);
+
+    for (int y = vy0; y < vy1; y++) {
+        int sy = MPCLAMP(dst.y0 + (int)(((int64_t)(y - src.y0) * dstH) / srcH), 0, subH - 1);
+        uint8_t *subRow = subBase + (size_t)sy * subStride;
+        if (p010) {
+            uint16_t *yRow = (uint16_t *)(yBase + (size_t)y * yStride);
+            uint16_t *uvRow = (uint16_t *)(uvBase + (size_t)(y / 2) * uvStride);
+            for (int x = vx0; x < vx1; x++) {
+                int sx = MPCLAMP(dst.x0 + (int)(((int64_t)(x - src.x0) * dstW) / srcW), 0, subW - 1);
+                uint8_t *sp = subRow + (size_t)sx * 4;
+                double alpha = sp[3] / 255.0;
+                if (alpha <= 0.0)
+                    continue;
+
+                double b = sp[0] / 255.0;
+                double g = sp[1] / 255.0;
+                double r = sp[2] / 255.0;
+                double py = kr * r + kg * g + kb * b;
+                double oldY = yRow[x] >> 6;
+                yRow[x] = (uint16_t)(clip_u10(oldY * (1.0 - alpha) + yOffset * alpha + yRange * py) << 6);
+
+                if ((x & 1) == 0 && (y & 1) == 0) {
+                    double pu = (b - py) / (2.0 * (1.0 - kb));
+                    double pv = (r - py) / (2.0 * (1.0 - kr));
+                    int uvx = (x / 2) * 2;
+                    double oldU = uvRow[uvx] >> 6;
+                    double oldV = uvRow[uvx + 1] >> 6;
+                    uvRow[uvx] = (uint16_t)(clip_u10(oldU * (1.0 - alpha) + cCenter * alpha + cRange * pu) << 6);
+                    uvRow[uvx + 1] = (uint16_t)(clip_u10(oldV * (1.0 - alpha) + cCenter * alpha + cRange * pv) << 6);
+                }
+            }
+        } else {
+            uint8_t *yRow = yBase + (size_t)y * yStride;
+            uint8_t *uvRow = uvBase + (size_t)(y / 2) * uvStride;
+            for (int x = vx0; x < vx1; x++) {
+                int sx = MPCLAMP(dst.x0 + (int)(((int64_t)(x - src.x0) * dstW) / srcW), 0, subW - 1);
+                uint8_t *sp = subRow + (size_t)sx * 4;
+                double alpha = sp[3] / 255.0;
+                if (alpha <= 0.0)
+                    continue;
+
+                double b = sp[0] / 255.0;
+                double g = sp[1] / 255.0;
+                double r = sp[2] / 255.0;
+                double py = kr * r + kg * g + kb * b;
+                yRow[x] = (uint8_t)clip_u8(yRow[x] * (1.0 - alpha) + yOffset * alpha + yRange * py);
+
+                if ((x & 1) == 0 && (y & 1) == 0) {
+                    double pu = (b - py) / (2.0 * (1.0 - kb));
+                    double pv = (r - py) / (2.0 * (1.0 - kr));
+                    int uvx = (x / 2) * 2;
+                    uvRow[uvx] = (uint8_t)clip_u8(uvRow[uvx] * (1.0 - alpha) + cCenter * alpha + cRange * pu);
+                    uvRow[uvx + 1] = (uint8_t)clip_u8(uvRow[uvx + 1] * (1.0 - alpha) + cCenter * alpha + cRange * pv);
+                }
+            }
+        }
+    }
+
+    CVPixelBufferUnlockBaseAddress(p->cachedSubtitleBuffer, kCVPixelBufferLock_ReadOnly);
+    CVPixelBufferUnlockBaseAddress(outputBuffer, 0);
+    return outputBuffer;
+}
+
+static CVPixelBufferRef render_video_geometry_frame(struct vo *vo,
+                                                    CVPixelBufferRef videoBuffer,
+                                                    bool include_subtitle)
+{
+    struct priv *p = vo->priv;
+
+    if (!ensure_ci_compositor(vo))
+        return NULL;
+
+    size_t videoW = CVPixelBufferGetWidth(videoBuffer);
+    size_t videoH = CVPixelBufferGetHeight(videoBuffer);
+
+    struct avf_render_geometry geometry = get_render_geometry(vo, (int)videoW, (int)videoH);
+    size_t outW = geometry.w > 0 ? (size_t)geometry.w : videoW;
+    size_t outH = geometry.h > 0 ? (size_t)geometry.h : videoH;
+    if (!outW || !outH)
+        return NULL;
+
+    struct mp_rect src = geometry.src;
+    struct mp_rect dst = geometry.dst;
+    if (src.x1 <= src.x0 || src.y1 <= src.y0 || dst.x1 <= dst.x0 || dst.y1 <= dst.y0)
+        return NULL;
+
+    OSType sourceFormat = CVPixelBufferGetPixelFormatType(videoBuffer);
+    OSType outputFormat = ci_output_format_for_source(sourceFormat);
+    if (!create_output_pool(vo, (int)outW, (int)outH, outputFormat))
+        return NULL;
+
+    CVPixelBufferRef outputBuffer = NULL;
+    CVReturn status = CVPixelBufferPoolCreatePixelBuffer(
+        kCFAllocatorDefault, p->outputPool, &outputBuffer);
+
+    if (status != kCVReturnSuccess || !outputBuffer) {
+        MP_ERR(vo, "Failed to get geometry output buffer: %d\n", status);
+        return NULL;
+    }
+
+    copy_pixel_buffer_metadata(videoBuffer, outputBuffer, outputFormat);
+
+    @autoreleasepool {
+        CGColorSpaceRef srcColorSpace = CVImageBufferGetColorSpace(videoBuffer);
+        CGColorSpaceRef fallbackColorSpace = NULL;
+        if (!srcColorSpace) {
+            fallbackColorSpace = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+            srcColorSpace = fallbackColorSpace;
+        }
+
+        CIImage *videoImage;
+        if (srcColorSpace) {
+            NSDictionary *videoOptions = @{
+                kCIImageColorSpace: (__bridge id)srcColorSpace
+            };
+            videoImage = [CIImage imageWithCVPixelBuffer:videoBuffer options:videoOptions];
+        } else {
+            videoImage = [CIImage imageWithCVPixelBuffer:videoBuffer];
+        }
+
+        if (fallbackColorSpace)
+            CGColorSpaceRelease(fallbackColorSpace);
+
+        if (!videoImage) {
+            CVPixelBufferRelease(outputBuffer);
+            return NULL;
+        }
+
+        CGRect srcRect = CGRectMake(src.x0, videoH - src.y1,
+                                   src.x1 - src.x0, src.y1 - src.y0);
+        CGFloat dstW = dst.x1 - dst.x0;
+        CGFloat dstH = dst.y1 - dst.y0;
+        CGFloat dstY = outH - dst.y1;
+
+        videoImage = [videoImage imageByCroppingToRect:srcRect];
+        videoImage = [videoImage imageByApplyingTransform:
+            CGAffineTransformMakeTranslation(-srcRect.origin.x, -srcRect.origin.y)];
+        videoImage = [videoImage imageByApplyingTransform:
+            CGAffineTransformMakeScale(dstW / srcRect.size.width, dstH / srcRect.size.height)];
+        videoImage = [videoImage imageByApplyingTransform:
+            CGAffineTransformMakeTranslation(dst.x0, dstY)];
+
+        CIImage *background = [[CIImage imageWithColor:
+            [CIColor colorWithRed:0 green:0 blue:0 alpha:1]] imageByCroppingToRect:CGRectMake(0, 0, outW, outH)];
+        CIImage *outputImage = [videoImage imageByCompositingOverImage:background];
+
+        if (include_subtitle && p->cachedSubtitleImage) {
+            CIImage *subtitleImage = [CIImage imageWithCGImage:p->cachedSubtitleImage];
+            if (subtitleImage) {
+                CGSize subSize = subtitleImage.extent.size;
+                if (subSize.width != (CGFloat)outW || subSize.height != (CGFloat)outH) {
+                    CGFloat scaleX = (CGFloat)outW / subSize.width;
+                    CGFloat scaleY = (CGFloat)outH / subSize.height;
+                    subtitleImage = [subtitleImage imageByApplyingTransform:
+                        CGAffineTransformMakeScale(scaleX, scaleY)];
+                }
+                outputImage = [subtitleImage imageByCompositingOverImage:outputImage];
+            }
+        }
+
+        CGColorSpaceRef outputColorSpace = CVImageBufferGetColorSpace(videoBuffer);
+        if (outputColorSpace) {
+            [p->ciContext render:outputImage
+                 toCVPixelBuffer:outputBuffer
+                          bounds:CGRectMake(0, 0, outW, outH)
+                      colorSpace:outputColorSpace];
+        } else {
+            [p->ciContext render:outputImage
+                 toCVPixelBuffer:outputBuffer
+                          bounds:CGRectMake(0, 0, outW, outH)
+                      colorSpace:nil];
+        }
+    }
+
+    return outputBuffer;
+}
+
+// Composite subtitle onto video frame using Core Image (GPU) - HDR compatible
+static CVPixelBufferRef composite_frame(struct vo *vo, CVPixelBufferRef videoBuffer)
+{
+    struct priv *p = vo->priv;
+
+    if (!p->has_subtitle)
+        return NULL;
+
+    OSType sourceFormat = CVPixelBufferGetPixelFormatType(videoBuffer);
+    if (is_biplanar_yuv_format(sourceFormat)) {
+        CVPixelBufferRef composited = composite_yuv_frame(vo, videoBuffer, sourceFormat, true);
+        if (composited)
+            return composited;
+
+        composited = composite_yuv_frame(vo, videoBuffer, sourceFormat, false);
+        if (composited)
+            return composited;
+    }
+
+    if (!p->cachedSubtitleImage)
+        return NULL;
+
+    return render_video_geometry_frame(vo, videoBuffer, true);
+}
+
+static int preinit(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    p->opts_cache = m_config_cache_alloc(p, vo->global, &avfoundation_conf);
+    p->opts = p->opts_cache->opts;
+    m_config_cache_set_wakeup_cb(p->opts_cache, avfoundation_opts_wakeup, vo);
+
+    if (vo->opts->WinID == -1) {
+        MP_ERR(vo, "No AVSampleBufferDisplayLayer provided via --wid\n");
+        return -1;
+    }
+
+    p->displayLayer = [(__bridge AVSampleBufferDisplayLayer *)(intptr_t)(vo->opts->WinID) retain];
+
+    MP_VERBOSE(vo, "displayLayer: %p, composite_osd: %s, pip_composite_osd: %s\n",
+               p->displayLayer, p->opts->composite_osd ? "yes" : "no",
+               p->opts->pip_composite_osd ? "yes" : "no");
+
+    if (CMTimebaseCreateWithSourceClock(kCFAllocatorDefault,
+                                        CMClockGetHostTimeClock(),
+                                        &p->timebase) != noErr || !p->timebase) {
+        MP_ERR(vo, "Failed to create display layer timebase\n");
+        [p->displayLayer release];
+        p->displayLayer = nil;
+        return -1;
+    }
+
+    p->presentation_host = p->opts->presentation == AVF_PRESENTATION_HOST;
+    reset_media_timing(p);
+    if (p->presentation_host) {
+        // mp_time_ns() and the CoreMedia host clock advance together on
+        // Apple platforms, so a rate-1.0 timebase seeded with mp_time makes
+        // timebase time equal to mpv host time for the layer's lifetime.
+        CMTimebaseSetTime(p->timebase, cm_time_from_ns(mp_time_ns()));
+        CMTimebaseSetRate(p->timebase, 1.0);
+    } else {
+        CMTimebaseSetTime(p->timebase, cm_time_from_ns(0));
+        CMTimebaseSetRate(p->timebase, 0.0);
+    }
+    AVSampleBufferDisplayLayer *displayLayer = [p->displayLayer retain];
+    CMTimebaseRef timebase = p->timebase;
+    dispatch_main_sync_safe(^{
+        displayLayer.controlTimebase = timebase;
+    });
+    [displayLayer release];
+    vo_set_queue_params(vo, MP_TIME_MS_TO_NS(p->opts->queue_lead_ms), 1);
+    p->ready_queue = dispatch_queue_create("avfoundation ready",
+        dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL,
+                                                QOS_CLASS_USER_INTERACTIVE, 0));
+    update_avfoundation_geometry(vo);
+
+    if (p->opts->composite_osd && !ensure_ci_compositor(vo))
+        MP_WARN(vo, "Core Image fallback compositor unavailable\n");
+
+    // The OSD layer's lifetime follows the option: created here, kept in step
+    // by sync_osd_layer_frame.
+    ensure_osd_layer(vo);
+    ahead_start(vo);
+
+    vo->hwdec_devs = hwdec_devices_create();
+    p->hwctx = (struct mp_hwdec_ctx){
+        .driver_name = "avfoundation",
+        .av_device_ref = create_videotoolbox_device_ref(vo),
+        .hw_imgfmt = IMGFMT_VIDEOTOOLBOX,
+    };
+    hwdec_devices_add(vo->hwdec_devs, &p->hwctx);
+
+    atomic_init(&p->pending_presentation_resync, false);
+#if TARGET_OS_IPHONE
+    dispatch_main_sync_safe(^{
+        NSNotificationCenter *nc = [NSNotificationCenter defaultCenter];
+        p->app_resign_observer = [[nc
+            addObserverForName:UIApplicationWillResignActiveNotification
+                        object:nil
+                         queue:[NSOperationQueue mainQueue]
+                    usingBlock:^(NSNotification *note) {
+            p->presentation_suspended = true;
+        }] retain];
+        p->app_active_observer = [[nc
+            addObserverForName:UIApplicationDidBecomeActiveNotification
+                        object:nil
+                         queue:[NSOperationQueue mainQueue]
+                    usingBlock:^(NSNotification *note) {
+            if (p->presentation_suspended) {
+                p->presentation_suspended = false;
+                atomic_store(&p->pending_presentation_resync, true);
+                vo_wakeup(vo);
+            }
+        }] retain];
+    });
+#endif
+
+    atomic_init(&p->pending_layer_geometry_sync, false);
+    {
+        MPVLayerGeometryObserver *observer = [[MPVLayerGeometryObserver alloc] init];
+        observer->vo = vo;
+        AVSampleBufferDisplayLayer *observedLayer = [p->displayLayer retain];
+        dispatch_main_sync_safe(^{
+            [observedLayer addObserver:observer
+                            forKeyPath:@"bounds"
+                               options:NSKeyValueObservingOptionOld |
+                                       NSKeyValueObservingOptionNew
+                               context:NULL];
+            [observedLayer addObserver:observer
+                            forKeyPath:@"contentsScale"
+                               options:NSKeyValueObservingOptionOld |
+                                       NSKeyValueObservingOptionNew
+                               context:NULL];
+        });
+        [observedLayer release];
+        p->layer_geometry_observer = observer;
+    }
+
+    return 0;
+}
+
+static CMSampleBufferRef create_video_sample_buffer(struct vo *vo, mp_image_t *mpi)
+{
+    @autoreleasepool {
+        struct priv *p = vo->priv;
+
+        CVPixelBufferRef pixbuf = NULL;
+        bool pixbufNeedsRelease = false;
+
+        // Handle different input formats
+        if (mpi->imgfmt == IMGFMT_VIDEOTOOLBOX) {
+            // Hardware decoded: zero-copy passthrough
+            pixbuf = (CVPixelBufferRef)mpi->planes[3];
+        } else {
+            // Software decoded: upload to CVPixelBuffer
+            pixbuf = upload_software_frame(vo, mpi);
+            if (!pixbuf) {
+                MP_ERR(vo, "Failed to upload software frame\n");
+                return NULL;
+            }
+            pixbufNeedsRelease = true;
+        }
+
+        CVPixelBufferRef finalBuffer = pixbuf;
+        bool needsRelease = false;
+
+        bool applyGeometry = should_apply_video_geometry(vo);
+        // Apple Dolby Vision passthrough buffers (native dvh1 decode) carry
+        // per-frame RPU metadata that only survives an untouched enqueue; a
+        // Core Image re-render feeds the DV display pipeline frames the RPU
+        // no longer describes and the picture collapses to near-black.
+        // Prefer an unzoomed but correct picture.
+        if (applyGeometry && pixbuf &&
+            CVBufferGetAttachment(pixbuf, CFSTR("DolbyVisionRPUData"), NULL)) {
+            if (!p->dovi_geometry_skip_logged) {
+                MP_WARN(vo, "Dolby Vision passthrough frame; ignoring video "
+                            "zoom/pan instead of destroying DV output\n");
+                p->dovi_geometry_skip_logged = true;
+            }
+            applyGeometry = false;
+        }
+        if (applyGeometry) {
+            CVPixelBufferRef rendered = render_video_geometry_frame(vo, pixbuf, p->has_subtitle);
+            if (rendered) {
+                if (!p->applied_geometry_last_frame) {
+                    struct mp_vo_opts *opts = vo->opts;
+                    MP_INFO(vo, "AVFoundation geometry rendering enabled "
+                                "(zoom=%.3f pan=%.3f,%.3f scale=%.3f,%.3f)\n",
+                            opts ? opts->zoom : 0.0f,
+                            opts ? opts->pan_x : 0.0f,
+                            opts ? opts->pan_y : 0.0f,
+                            opts ? opts->scale_x : 1.0f,
+                            opts ? opts->scale_y : 1.0f);
+                }
+                finalBuffer = rendered;
+                needsRelease = true;
+                p->applied_geometry_last_frame = true;
+                p->geometry_render_failure_logged = false;
+            } else if (!p->geometry_render_failure_logged) {
+                MP_WARN(vo, "AVFoundation geometry rendering failed; "
+                            "falling back to original sample-buffer frame\n");
+                p->geometry_render_failure_logged = true;
+            }
+        } else {
+            if (p->applied_geometry_last_frame || p->geometry_render_failure_logged) {
+                if (p->applied_geometry_last_frame)
+                    MP_INFO(vo, "AVFoundation geometry rendering disabled; "
+                                "returning to sample-buffer passthrough\n");
+                if (p->outputPool)
+                    CVPixelBufferPoolFlush(p->outputPool, kCVPixelBufferPoolFlushExcessBuffers);
+                p->applied_geometry_last_frame = false;
+                p->geometry_render_failure_logged = false;
+            }
+        }
+
+        if (!needsRelease && !applyGeometry && should_composite_into_video(p)) {
+            // In compositing modes, composite the subtitle rendered for this flip.
+            CVPixelBufferRef composited = composite_frame(vo, pixbuf);
+            if (composited && should_use_frame_space_osd(p) &&
+                (CVPixelBufferGetWidth(composited) != CVPixelBufferGetWidth(pixbuf) ||
+                 CVPixelBufferGetHeight(composited) != CVPixelBufferGetHeight(pixbuf))) {
+                // The system sizes the PiP window from the enqueued samples, so a
+                // composite that changed them would resize the window on every
+                // cue. Present the frame without the overlay instead.
+                if (!p->composite_size_mismatch_logged) {
+                    MP_WARN(vo, "Composited frame is %zux%zu instead of the frame's "
+                                "%zux%zu; dropping the overlay to keep the sample "
+                                "size steady\n",
+                            CVPixelBufferGetWidth(composited),
+                            CVPixelBufferGetHeight(composited),
+                            CVPixelBufferGetWidth(pixbuf),
+                            CVPixelBufferGetHeight(pixbuf));
+                    p->composite_size_mismatch_logged = true;
+                }
+                CVPixelBufferRelease(composited);
+                composited = NULL;
+            }
+            if (composited) {
+                finalBuffer = composited;
+                needsRelease = true;
+            }
+        }
+
+        CMSampleTimingInfo info = {
+            .presentationTimeStamp = cm_time_from_ns(sample_presentation_pts_ns(p)),
+            .duration = kCMTimeInvalid,
+            .decodeTimeStamp = kCMTimeInvalid
+        };
+
+        // DVD/anamorphic sources carry their display aspect in the sample aspect
+        // ratio; AVSampleBufferDisplayLayer only honors it via a buffer attachment.
+        tag_pixel_buffer_pixel_aspect(vo, finalBuffer);
+
+        // Profile 5 may retain its RPU while losing VideoToolbox's PQ tag.
+        // Its color primaries and matrix must remain unspecified.
+        if (mpi->imgfmt == IMGFMT_VIDEOTOOLBOX && finalBuffer == pixbuf)
+            restore_dolby_vision_transfer(finalBuffer, &mpi->params);
+
+        // The format description is stable across frames from the same pool.
+        // CMSampleBufferCreateReadyWithImageBuffer checks the buffer against
+        // it (dimensions, pixel format and the relevant attachments) and
+        // refuses a mismatch with kCMSampleBufferError_InvalidMediaFormat, so
+        // the cache is rebuilt only on that refusal (reconfig, geometry or
+        // composite output, color tags) rather than checked twice per frame.
+        CMSampleBufferRef buf = NULL;
+        OSStatus err = kCMSampleBufferError_InvalidMediaFormat;
+        if (p->video_format_desc) {
+            err = CMSampleBufferCreateReadyWithImageBuffer(
+                NULL, finalBuffer, p->video_format_desc, &info, &buf);
+        }
+        if (err == kCMSampleBufferError_InvalidMediaFormat) {
+            CMVideoFormatDescriptionRef new_format = NULL;
+            OSStatus desc_err = CMVideoFormatDescriptionCreateForImageBuffer(
+                NULL, finalBuffer, &new_format);
+            if (desc_err != noErr || !new_format) {
+                MP_ERR(vo, "Failed to create format description: %d\n", (int)desc_err);
+                if (needsRelease)
+                    CVPixelBufferRelease(finalBuffer);
+                if (pixbufNeedsRelease)
+                    CVPixelBufferRelease(pixbuf);
+                return NULL;
+            }
+            if (p->video_format_desc)
+                CFRelease(p->video_format_desc);
+            p->video_format_desc = new_format;
+            err = CMSampleBufferCreateReadyWithImageBuffer(
+                NULL, finalBuffer, new_format, &info, &buf);
+        }
+
+        if (err != noErr || !buf) {
+            MP_ERR(vo, "Failed to create sample buffer: %d\n", (int)err);
+            if (needsRelease)
+                CVPixelBufferRelease(finalBuffer);
+            if (pixbufNeedsRelease)
+                CVPixelBufferRelease(pixbuf);
+            return NULL;
+        }
+
+        // Geometry and composite renders keep the frame's PQ tags, and the
+        // metadata describes the scene rather than the pixel grid, so it
+        // applies to whichever buffer is enqueued.
+        attach_hdr10plus_metadata(vo, mpi, finalBuffer, buf);
+
+        // Release composited output buffer (always owned by us)
+        if (needsRelease)
+            CVPixelBufferRelease(finalBuffer);
+
+        // Release uploaded software frame buffer (owned by us, not by mpi)
+        if (pixbufNeedsRelease)
+            CVPixelBufferRelease(pixbuf);
+
+        return buf;
+    }
+}
+
+static bool enqueue_video_sample(struct vo *vo, CMSampleBufferRef buf)
+{
+    struct priv *p = vo->priv;
+
+    if (!buf)
+        return false;
+
+    sample_buffer_renderer_enqueue(p->displayLayer, buf);
+    p->last_video_enqueue_ns = mp_time_ns();
+    return true;
+}
+
+// OSD perf summary; counters always accumulate, formatting is gated on -v.
+static void report_osd_perf(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    if (p->perf.renders <= 0)
+        return;
+
+    if (mp_msg_test(vo->log, MSGL_V)) {
+        double n = p->perf.renders;
+        double nf = MPMAX(p->perf.frames, 1);
+        double ne = MPMAX(p->perf.enq_count, 1);
+        MP_VERBOSE(vo,
+            "osd-perf: n=%d avg=%.2fms max=%.2fms "
+            "[clear %.2f blend %.2f cg %.2f bounds %.2f] enq %.2f | "
+            "vid %.3f (/frame) | "
+            "margin avg=%.1f min=%.1fms drops=%d | "
+            "skip=%d empty=%d osd=%dx%d\n",
+            p->perf.renders,
+            p->perf.total_ns / n / 1e6,
+            p->perf.max_ns / 1e6,
+            p->perf.clear_ns / n / 1e6,
+            p->perf.blend_ns / n / 1e6,
+            p->perf.cg_ns / n / 1e6,
+            p->perf.bounds_ns / n / 1e6,
+            p->perf.enqueue_ns / n / 1e6,
+            p->perf.video_sample_ns / nf / 1e6,
+            p->perf.lead_sum_ns / ne / 1e6,
+            p->perf.enq_count ? p->perf.lead_min_ns / 1e6 : 0.0,
+            p->perf.enq_drops,
+            p->perf.skipped, p->perf.empty, p->osd_w, p->osd_h);
+    }
+    memset(&p->perf, 0, sizeof(p->perf));
+}
+
+static void flip_page(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    if (atomic_exchange(&p->pending_presentation_resync, false))
+        recover_display_layer(vo, "presentation resume", true);
+
+    report_presentation_diagnostics(vo);
+
+    if (p->next_image) {
+        CMSampleBufferRef osd_buf = NULL;
+        bool osd_needed = false;
+
+        // The OSD is enqueued before the video sample on purpose: the
+        // adjacent enqueues are what keep subtitle changes presenting on the
+        // exact frame they belong to. The subtitles were rendered ahead;
+        // when they are late, the video goes without them (ahead_present).
+        if (p->ahead.started) {
+            ahead_present(vo);
+        } else {
+            render_osd(vo, p->next_pts);
+        }
+
+        int64_t osd_pts_ns = sample_presentation_pts_ns(p);
+        osd_buf = create_osd_sample_buffer(vo, osd_pts_ns, &osd_needed);
+        bool osd_buf_has_subtitle = osd_buf && p->has_subtitle && p->cachedSubtitleBuffer;
+
+        int64_t t = mp_time_ns();
+        CMSampleBufferRef video_buf = create_video_sample_buffer(vo, p->next_image);
+        p->perf.video_sample_ns += mp_time_ns() - t;
+
+        bool osd_enqueued = !osd_needed;
+
+        if (video_buf && wait_until_ready_for_more_media_data(vo, p->next_present_host_ns)) {
+            if (!p->presentation_host)
+                update_media_timebase_for_frame(vo);
+
+            if (osd_buf) {
+                t = mp_time_ns();
+                osd_enqueued = enqueue_osd_sample(vo, osd_buf);
+                p->perf.enqueue_ns += mp_time_ns() - t;
+                if (osd_enqueued) {
+                    p->osd_needs_enqueue = false;
+                    if (osd_buf_has_subtitle)
+                        p->osd_layer_dirty = true;
+                    // Margin between the OSD/video enqueue pair and the
+                    // frame's intended presentation time (same clock).
+                    int64_t lead = p->next_present_host_ns - mp_time_ns();
+                    if (!p->perf.enq_count || lead < p->perf.lead_min_ns)
+                        p->perf.lead_min_ns = lead;
+                    p->perf.lead_sum_ns += lead;
+                    p->perf.enq_count++;
+                } else {
+                    p->perf.enq_drops++;
+                }
+            }
+
+            enqueue_video_sample(vo, video_buf);
+        }
+
+        if (osd_needed && !osd_enqueued)
+            p->osd_change_id = 0;
+
+        if (osd_buf)
+            CFRelease(osd_buf);
+        if (video_buf)
+            CFRelease(video_buf);
+
+        p->perf.frames++;
+    }
+
+    // Flush excess buffers every ~60 frames to prevent memory growth
+    // without causing buffer churn on every frame
+    if (++p->frame_count >= 60) {
+        p->frame_count = 0;
+        if (p->outputPool)
+            CVPixelBufferPoolFlush(p->outputPool, kCVPixelBufferPoolFlushExcessBuffers);
+        if (p->osdPool)
+            CVPixelBufferPoolFlush(p->osdPool, kCVPixelBufferPoolFlushExcessBuffers);
+        if (p->swUploadPool)
+            CVPixelBufferPoolFlush(p->swUploadPool, kCVPixelBufferPoolFlushExcessBuffers);
+        prune_osd_buf_states(p, mp_time_ns());
+    }
+
+    // Report often enough that short capture sessions still carry data.
+    if (p->perf.renders >= 32 ||
+        (p->perf.renders > 0 && p->perf.frames >= 300))
+    {
+        report_osd_perf(vo);
+        report_ahead_perf(vo);
+    }
+
+    if (p->next_image) {
+        mp_image_unrefp(&p->ahead_shown_image);
+        p->ahead_shown_image = p->next_image;
+        p->next_image = NULL;
+    }
+}
+
+static bool draw_frame(struct vo *vo, struct vo_frame *frame)
+{
+    struct priv *p = vo->priv;
+
+    mp_image_unrefp(&p->next_image);
+
+    if (!frame->current || (frame->repeat && !frame->redraw)) {
+        p->next_pts = MP_NOPTS_VALUE;
+        p->next_present_host_ns = mp_time_ns();
+        p->next_media_pts_valid = false;
+        p->next_timebase_rate_valid = false;
+        return true;
+    }
+
+    p->next_image = mp_image_new_ref(frame->current);
+    if (!p->next_image)
+        return false;
+
+    double pts = p->next_image->pts;
+    if (pts == MP_NOPTS_VALUE)
+        pts = frame->current->pts;
+
+    p->next_pts = pts;
+    p->next_present_host_ns = frame->pts > 0 ? frame->pts : mp_time_ns();
+    if (p->presentation_host) {
+        p->next_present_host_ns = avf_host_present_ns(
+            p->last_host_present_ns, p->next_present_host_ns,
+            MP_TIME_MS_TO_NS(p->opts->queue_lead_ms) + AVF_HOST_PRESENT_SLACK_NS);
+        p->last_host_present_ns = p->next_present_host_ns;
+    }
+    p->next_media_pts_valid = media_pts_is_valid(pts);
+    p->next_media_pts_ns = p->next_media_pts_valid
+        ? media_pts_to_ns(pts)
+        : current_media_time_ns(p);
+    p->next_timebase_rate_valid = false;
+    if (p->next_media_pts_valid) {
+        int64_t frame_duration_ns = frame->display_synced &&
+                                    frame->ideal_frame_duration > 0.0
+            ? MP_TIME_S_TO_NS(frame->ideal_frame_duration)
+            : frame->duration > 0.0 ? (int64_t)llrint(frame->duration) : 0;
+        p->next_timebase_rate_valid = avf_rate_sample(
+            &p->rate_est, p->next_media_pts_ns, frame_duration_ns,
+            p->timebase_rate > 0.0 ? p->timebase_rate : 1.0,
+            &p->next_timebase_rate);
+    }
+    ahead_file_frame(vo, frame);
+    return true;
+}
+
+static int query_format(struct vo *vo, int format)
+{
+    // Accepting the planar 10/12-bit decoder output formats directly matters
+    // for performance: it keeps mpv's autoconvert filter (scalar libswscale
+    // pass on the decode thread) out of the chain, and the upload fuses the
+    // biplanar conversion into the one unavoidable copy.
+    if (format == IMGFMT_VIDEOTOOLBOX ||   // Hardware decoded (zero-copy)
+        format == IMGFMT_NV12 ||           // Software decoded (common)
+        format == IMGFMT_420P ||           // YUV420P (very common)
+        format == IMGFMT_P010 ||           // 10-bit biplanar
+        format == imgfmt_420p10() ||       // 10-bit planar (AV1/HEVC SW decode)
+        format == imgfmt_420p12())         // 12-bit planar
+        return 1;
+    return 0;
+}
+
+static void clear_subtitle_cache(struct priv *p)
+{
+    if (p->cachedSubtitleImage) {
+        CGImageRelease(p->cachedSubtitleImage);
+        p->cachedSubtitleImage = NULL;
+    }
+    if (p->cachedSubtitleBuffer) {
+        CVPixelBufferRelease(p->cachedSubtitleBuffer);
+        p->cachedSubtitleBuffer = NULL;
+    }
+    p->has_subtitle = false;
+    p->osd_change_id = 0;
+    p->osd_needs_enqueue = false;
+    p->osd_callback_invoked = false;
+    p->subtitle_x0 = p->subtitle_y0 = p->subtitle_x1 = p->subtitle_y1 = 0;
+    ahead_invalidate(p, p->ahead_last_pts);
+}
+
+// Helper to clear all subtitle state (called on video change/stop)
+static void clear_subtitle_state(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    clear_subtitle_cache(p);
+    clear_osd_layer(vo);
+}
+
+static int reconfig(struct vo *vo, struct mp_image_params *params)
+{
+    MP_VERBOSE(vo, "reconfig: %dx%d\n", params->w, params->h);
+
+    // Clear subtitles when video configuration changes
+    struct priv *p = vo->priv;
+    p->ahead_last_pts = MP_NOPTS_VALUE;
+    osd_cadence_reset(&p->ahead_cadence);
+    mp_image_unrefp(&p->ahead_shown_image);
+    clear_subtitle_state(vo);
+    sync_osd_layer_frame(vo);
+
+    return 0;
+}
+
+static void uninit(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    report_osd_perf(vo);
+    report_ahead_perf(vo);
+    if (p->ahead.started)
+        osd_ahead_stop(&p->ahead);
+    osd_ahead_destroy(&p->ahead);
+
+#if TARGET_OS_IPHONE
+    if (p->app_resign_observer || p->app_active_observer) {
+        dispatch_main_sync_safe(^{
+            NSNotificationCenter *nc = [NSNotificationCenter defaultCenter];
+            if (p->app_resign_observer) {
+                [nc removeObserver:p->app_resign_observer];
+                [p->app_resign_observer release];
+                p->app_resign_observer = nil;
+            }
+            if (p->app_active_observer) {
+                [nc removeObserver:p->app_active_observer];
+                [p->app_active_observer release];
+                p->app_active_observer = nil;
+            }
+        });
+    }
+#endif
+
+    if (p->layer_geometry_observer) {
+        MPVLayerGeometryObserver *observer = p->layer_geometry_observer;
+        p->layer_geometry_observer = nil;
+        AVSampleBufferDisplayLayer *observedLayer = [p->displayLayer retain];
+        dispatch_main_sync_safe(^{
+            [observedLayer removeObserver:observer forKeyPath:@"bounds"];
+            [observedLayer removeObserver:observer forKeyPath:@"contentsScale"];
+        });
+        [observedLayer release];
+        [observer release];
+    }
+
+    mp_image_unrefp(&p->next_image);
+    mp_image_unrefp(&p->ahead_shown_image);
+    // Drop what is queued but keep the displayed images; clear_osd_layer
+    // explains why. The host hides the display layer before it leaves the
+    // tree, and release_osd_layer below does the same for the OSD layer.
+    sample_buffer_renderer_flush(p->displayLayer);
+    sample_buffer_renderer_flush(p->osdLayer);
+
+    if (p->timebase) {
+        AVSampleBufferDisplayLayer *displayLayer = [p->displayLayer retain];
+        AVSampleBufferDisplayLayer *osdLayer = [p->osdLayer retain];
+        dispatch_main_sync_safe(^{
+            displayLayer.controlTimebase = NULL;
+            osdLayer.controlTimebase = NULL;
+        });
+        [displayLayer release];
+        [osdLayer release];
+        CFRelease(p->timebase);
+        p->timebase = NULL;
+    }
+
+    if (p->cachedSubtitleImage) {
+        CGImageRelease(p->cachedSubtitleImage);
+        p->cachedSubtitleImage = NULL;
+    }
+
+    if (p->cachedSubtitleBuffer) {
+        CVPixelBufferRelease(p->cachedSubtitleBuffer);
+        p->cachedSubtitleBuffer = NULL;
+    }
+
+    if (p->outputPool) {
+        CVPixelBufferPoolRelease(p->outputPool);
+        p->outputPool = NULL;
+    }
+
+    if (p->osdPool) {
+        CVPixelBufferPoolRelease(p->osdPool);
+        p->osdPool = NULL;
+    }
+    reset_osd_buf_states(p);
+
+    if (p->swUploadPool) {
+        CVPixelBufferPoolRelease(p->swUploadPool);
+        p->swUploadPool = NULL;
+    }
+
+    if (p->video_format_desc) {
+        CFRelease(p->video_format_desc);
+        p->video_format_desc = NULL;
+    }
+
+    release_osd_layer(vo);
+
+    [p->ciContext release];
+    p->ciContext = nil;
+    [p->mtlDevice release];
+    p->mtlDevice = nil;
+
+    if (p->ready_queue) {
+        dispatch_release(p->ready_queue);
+        p->ready_queue = NULL;
+    }
+
+    [p->displayLayer release];
+    p->displayLayer = nil;
+
+    talloc_free(p->opts_cache);
+    p->opts_cache = NULL;
+    p->opts = NULL;
+
+    hwdec_devices_remove(vo->hwdec_devs, &p->hwctx);
+    av_buffer_unref(&p->hwctx.av_device_ref);
+}
+
+static int control(struct vo *vo, uint32_t request, void *data)
+{
+    struct priv *p = vo->priv;
+
+    switch (request) {
+    case VOCTRL_CHECK_EVENTS:
+        if (atomic_exchange(&p->pending_presentation_resync, false))
+            recover_display_layer(vo, "presentation resume", true);
+        if (atomic_exchange(&p->pending_layer_geometry_sync, false))
+            handle_layer_geometry_change(vo);
+        update_avfoundation_options(vo);
+        if (atomic_exchange(&p->ahead_late_result, false))
+            ahead_present_late(vo);
+        return VO_TRUE;
+    case VOCTRL_VO_OPTS_CHANGED:
+        update_avfoundation_options(vo);
+        clear_subtitle_cache(p);
+        sync_osd_layer_frame(vo);
+        return VO_TRUE;
+    case VOCTRL_SET_PANSCAN:
+        clear_subtitle_cache(p);
+        sync_osd_layer_frame(vo);
+        return VO_TRUE;
+    case VOCTRL_RESET:
+        // Fired by vo_seek_reset() on every seek (and on stop/track change).
+        // Flush queued-but-undisplayed samples without removing the on-screen
+        // frame: removing it blanks the layer to black until the first
+        // post-seek frame survives demux+decode, a visible flash on every
+        // skip. Reference VOs (gpu/gpu-next) hold the last frame through
+        // seeks; the OSD layer is still cleared so stale subtitles don't
+        // linger over the held frame.
+        p->ahead_last_pts = MP_NOPTS_VALUE;
+        osd_cadence_reset(&p->ahead_cadence);
+        clear_subtitle_cache(p);
+        p->not_ready_drop_count = 0;
+        p->last_not_ready_drop_ns = 0;
+        p->last_display_recovery_ns = 0;
+        p->last_video_enqueue_ns = 0;
+        p->applied_geometry_last_frame = false;
+        p->geometry_render_failure_logged = false;
+        bool was_paused = p->playback_paused;
+        reset_media_timing(p);
+        p->playback_paused = was_paused;
+        sample_buffer_renderer_flush(p->displayLayer);
+        if (p->presentation_host && p->timebase) {
+            // Fresh host-time samples arrive with future timestamps; the
+            // free-running timebase needs no correction.
+            reseed_host_timebase_if_drifted(p);
+        } else if (p->timebase) {
+            CMTimebaseSetTime(p->timebase, cm_time_from_ns(0));
+            CMTimebaseSetRate(p->timebase, 0.0);
+        }
+        // After the re-seed, so the clear is stamped on the new timeline.
+        clear_osd_layer(vo);
+        return VO_TRUE;
+    case VOCTRL_PAUSE:
+        if (!p->presentation_host)
+            set_media_timebase_paused(vo, true);
+        ahead_set_paused(p, true);
+        return VO_TRUE;
+    case VOCTRL_RESUME:
+        if (!p->presentation_host)
+            set_media_timebase_paused(vo, false);
+        ahead_set_paused(p, false);
+        return VO_TRUE;
+    case VOCTRL_REDRAW:
+        p->osd_change_id = 0;
+        return VO_TRUE;
+    case VOCTRL_UPDATE_WINDOW_TITLE:
+        return VO_TRUE;
+    }
+    return VO_NOTIMPL;
+}
