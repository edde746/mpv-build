+static int64_t media_pts_to_ns(double pts)
+{
+    return (int64_t)(pts * (double)NSEC_PER_SEC + (pts >= 0 ? 0.5 : -0.5));
+}
+
+static CMTime cm_time_from_ns(int64_t ns)
+{
+    return CMTimeMake(ns, NSEC_PER_SEC);
+}
+
+static int64_t cm_time_to_ns(CMTime time)
+{
+    if (!CMTIME_IS_NUMERIC(time))
+        return 0;
+
+    CMTime converted = CMTimeConvertScale(time, NSEC_PER_SEC,
+                                          kCMTimeRoundingMethod_Default);
+    return converted.value;
+}
+
+// CMTimebase anchors must use the immediate CoreMedia source clock. mpv's
+// scheduled presentation timestamps share mp_time_ns()'s epoch, not CM host time.
+static CMTime source_time_for_mp_time(struct priv *p, int64_t target_mp_ns)
+{
+    CMClockOrTimebaseRef source = CMTimebaseCopySource(p->timebase);
+    CMTime source_now = source ? CMSyncGetTime(source) : kCMTimeInvalid;
+    if (source)
+        CFRelease(source);
+    if (!CMTIME_IS_NUMERIC(source_now))
+        source_now = CMClockGetTime(CMClockGetHostTimeClock());
+
+    return CMTimeAdd(source_now, cm_time_from_ns(target_mp_ns - mp_time_ns()));
+}
+
+static int64_t current_media_time_ns(struct priv *p)
+{
+    if (p->next_media_pts_valid)
+        return p->next_media_pts_ns;
+    if (p->last_media_pts_valid)
+        return p->last_media_pts_ns;
+    if (p->timebase)
+        return cm_time_to_ns(CMTimebaseGetTime(p->timebase));
+    return 0;
+}
+
+// Presentation timestamp for enqueued video/OSD samples, in the unit the
+// active mode's timebase runs in: mpv's scheduled host display time in
+// host mode, container media PTS in media mode.
+static int64_t sample_presentation_pts_ns(struct priv *p)
+{
+    if (p->presentation_host)
+        return p->next_present_host_ns > 0 ? p->next_present_host_ns
+                                           : mp_time_ns();
+    return current_media_time_ns(p);
+}
+
+static void reset_media_timing(struct priv *p)
+{
+    p->next_present_host_ns = 0;
+    p->next_media_pts_ns = 0;
+    p->next_media_pts_valid = false;
+    p->next_timebase_rate = 0.0;
+    p->next_timebase_rate_valid = false;
+    p->last_media_pts_ns = 0;
+    p->last_media_pts_valid = false;
+    p->timebase_anchor_valid = false;
+    p->playback_paused = false;
+    // Keep the nominal rate across seeks. Unlike the frame/timestamp mapping,
+    // the player's speed persists, so the first post-seek anchor starts correct.
+    p->timebase_rate = p->timebase_rate > 0.0 ? p->timebase_rate : 1.0;
+    p->timebase_applied_rate = p->timebase_rate;
+    p->last_rate_update_ns = 0;
+    p->servo_integral = 0.0;
+    p->last_servo_eval_ns = 0;
+    p->rate_est = (struct avf_rate_est){0};
+}
+
+// How far a host-mode timebase may sit from mp_time_ns() before a reset puts
+// it back. Both run on mach_absolute_time, so an untouched timebase stays
+// within microseconds; only CoreMedia clamping or stopping it crosses this.
+#define AVF_HOST_TIMEBASE_TOLERANCE_NS MP_TIME_MS_TO_NS(5)
+
+// Host mode keeps timebase time equal to mp_time_ns(). Re-seed it only when
+// it has left that clock: every SetTime retimes the layers' image queues,
+// and on macOS 27 a retime behind frames the display has already taken
+// stops the whole screen until the timebase reaches them (plezy#2823).
+static void reseed_host_timebase_if_drifted(struct priv *p)
+{
+    int64_t now = mp_time_ns();
+    int64_t timebase_ns = cm_time_to_ns(CMTimebaseGetTime(p->timebase));
+    if (CMTimebaseGetRate(p->timebase) == 1.0 &&
+        llabs(timebase_ns - now) <= AVF_HOST_TIMEBASE_TOLERANCE_NS)
+        return;
+
+    CMTimebaseSetTime(p->timebase, cm_time_from_ns(now));
+    CMTimebaseSetRate(p->timebase, 1.0);
+}
+
+// --- avf host present stamp (host-testable; keep freestanding) ---
+// Host stamps never go back. A seek's flush drops the samples the layer
+// still holds, but not always the ones CoreMedia already took for display;
+// those keep their pre-seek stamps, up to queue-lead-ms ahead. The first
+// frame after a seek is due at once, so it could show before them and the
+// old position would flash back after the new one (plezy#2823). A target at
+// or before the last stamp is moved just after it, so no old frame can come
+// after a new one. A last stamp further ahead than window_ns (queue lead
+// plus slack) is not a queued frame and is ignored, so this never holds the
+// picture back by more than the queue lead.
+static int64_t avf_host_present_ns(int64_t last_ns, int64_t target_ns,
+                                   int64_t window_ns)
+{
+    if (last_ns >= target_ns && last_ns - target_ns <= window_ns)
+        return last_ns + 1;
+    return target_ns;
+}
+// --- end avf host present stamp ---
+
+// Slack over queue-lead-ms for avf_host_present_ns()'s window: how far ahead
+// of a new frame's target an already queued frame can be stamped.
+#define AVF_HOST_PRESENT_SLACK_NS MP_TIME_MS_TO_NS(50)
+
+static void update_media_timebase_for_frame(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (!p->timebase || !p->next_media_pts_valid)
+        return;
+
+    int64_t now = mp_time_ns();
+    int64_t present_host_ns = p->next_present_host_ns > 0
+        ? p->next_present_host_ns
+        : now;
+    int64_t media_pts_ns = p->next_media_pts_ns;
+
+    double rate = p->timebase_rate > 0.0 ? p->timebase_rate : 1.0;
+    bool rate_changed = false;
+    if (p->next_timebase_rate_valid && !p->playback_paused &&
+        fabs(p->next_timebase_rate - rate) >
+            AVF_RATE_CHANGE_FRACTION * rate) {
+        MP_VERBOSE(vo, "Playback rate changed from %.6f to %.6f\n",
+                   rate, p->next_timebase_rate);
+        rate = p->next_timebase_rate;
+        rate_changed = true;
+    }
+    if (p->playback_paused)
+        rate = 0.0;
+
+    bool should_anchor = !p->timebase_anchor_valid || p->playback_paused ||
+        rate_changed;
+
+    if (!should_anchor) {
+        double applied = p->timebase_applied_rate > 0.0
+            ? p->timebase_applied_rate
+            : rate;
+        int64_t timebase_ns = cm_time_to_ns(CMTimebaseGetTime(p->timebase));
+        int64_t projected_ns = timebase_ns +
+            (int64_t)((double)(present_host_ns - now) * applied);
+        int64_t error_ns = media_pts_ns - projected_ns;
+
+        if (llabs(error_ns) > p->diag_drift_peak_ns)
+            p->diag_drift_peak_ns = llabs(error_ns);
+
+        int64_t dt_ns = p->last_servo_eval_ns
+            ? now - p->last_servo_eval_ns
+            : 0;
+        p->last_servo_eval_ns = now;
+
+        bool snap = false, update_rate = false;
+        double servo = avf_servo_rate(error_ns, rate, applied, now,
+                                      p->last_rate_update_ns, dt_ns,
+                                      &p->servo_integral,
+                                      &snap, &update_rate);
+        if (snap) {
+            should_anchor = true;
+            MP_VERBOSE(vo, "Timebase %.1f ms off schedule; re-anchoring\n",
+                       error_ns / 1e6);
+            // Preserve the nominal playback rate. A scheduling discontinuity
+            // says nothing about speed; the frame-duration estimator owns it.
+        } else if (update_rate) {
+            CMTimebaseSetRate(p->timebase, servo);
+            p->timebase_applied_rate = servo;
+            p->last_rate_update_ns = now;
+            p->diag_rate_update_count++;
+        }
+    }
+
+    if (should_anchor) {
+        CMTime source_time = source_time_for_mp_time(p, present_host_ns);
+        OSStatus err = CMTimebaseSetRateAndAnchorTime(
+            p->timebase, rate, cm_time_from_ns(media_pts_ns),
+            source_time);
+        if (err != noErr) {
+            MP_WARN(vo, "Failed to anchor AVFoundation media timebase: %d\n", (int)err);
+        }
+        p->timebase_rate = rate;
+        p->timebase_applied_rate = rate;
+        p->last_rate_update_ns = now;
+        p->servo_integral = 0.0;
+        p->last_servo_eval_ns = 0;
+        p->timebase_anchor_valid = true;
+        p->diag_anchor_count++;
+    }
+
+    p->last_media_pts_ns = media_pts_ns;
+    p->last_media_pts_valid = true;
+}
+
+static void set_media_timebase_paused(struct vo *vo, bool paused)
+{
+    struct priv *p = vo->priv;
+    if (!p->timebase)
+        return;
+    p->playback_paused = paused;
+
+    if (paused) {
+        CMTime media_time = CMTimebaseGetTime(p->timebase);
+        if (!CMTIME_IS_NUMERIC(media_time)) {
+            media_time = cm_time_from_ns(current_media_time_ns(p));
+        }
+        CMTime source_time = source_time_for_mp_time(p, mp_time_ns());
+        OSStatus err = CMTimebaseSetRateAndAnchorTime(
+            p->timebase, 0.0, media_time, source_time);
+        if (err != noErr)
+            MP_WARN(vo, "Failed to pause AVFoundation media timebase: %d\n", (int)err);
+        p->timebase_applied_rate = 0.0;
+        return;
+    }
+
+    p->timebase_anchor_valid = false;
+}
+
+// Drop queued samples, keeping the displayed image: clear_osd_layer explains
+// why nothing here removes it.
+static void sample_buffer_renderer_flush(AVSampleBufferDisplayLayer *displayLayer)
+{
+    if (!displayLayer)
+        return;
+
+    if (@available(iOS 17.0, tvOS 17.0, macOS 14.0, *)) {
+        [displayLayer.sampleBufferRenderer flush];
+        return;
+    }
+
+    [displayLayer flush];
+}
+
+static void sample_buffer_renderer_enqueue(AVSampleBufferDisplayLayer *displayLayer,
+                                           CMSampleBufferRef buf)
+{
+    id<AVQueuedSampleBufferRendering> renderer =
+        active_sample_buffer_renderer(displayLayer);
+    [renderer enqueueSampleBuffer:buf];
+}
+
+static bool display_layer_needs_recovery(AVSampleBufferDisplayLayer *displayLayer)
+{
+    if (!displayLayer)
+        return false;
+
+    return sample_buffer_renderer_status(displayLayer) ==
+               AVQueuedSampleBufferRenderingStatusFailed ||
+           sample_buffer_renderer_requires_flush(displayLayer);
+}
+
+static void recover_display_layer(struct vo *vo, const char *reason, bool force)
+{
+    struct priv *p = vo->priv;
+    AVSampleBufferDisplayLayer *displayLayer = [p->displayLayer retain];
+    AVSampleBufferDisplayLayer *osdLayer = [p->osdLayer retain];
+
+    if (!displayLayer) {
+        [osdLayer release];
+        return;
+    }
+
+    int64_t now = mp_time_ns();
+    if (!force && p->last_display_recovery_ns &&
+        now - p->last_display_recovery_ns < MP_TIME_MS_TO_NS(500)) {
+        [displayLayer release];
+        [osdLayer release];
+        return;
+    }
+    p->last_display_recovery_ns = now;
+
+    __block AVQueuedSampleBufferRenderingStatus status =
+        AVQueuedSampleBufferRenderingStatusUnknown;
+    __block bool requires_flush = false;
+    __block bool ready = false;
+    __block int64_t timebase_ns = 0;
+    __block double timebase_rate = 0.0;
+
+    dispatch_main_sync_safe(^{
+        status = sample_buffer_renderer_status(displayLayer);
+        requires_flush = sample_buffer_renderer_requires_flush(displayLayer);
+        ready = sample_buffer_renderer_is_ready(displayLayer);
+        if (p->timebase) {
+            timebase_ns = cm_time_to_ns(CMTimebaseGetTime(p->timebase));
+            timebase_rate = CMTimebaseGetRate(p->timebase);
+        }
+
+        sample_buffer_renderer_flush(displayLayer);
+        sample_buffer_renderer_flush(osdLayer);
+    });
+
+    MP_WARN(vo, "Recovered AVFoundation display layer after %s "
+                "(status=%ld, requiresFlush=%s, ready=%s, "
+                "mediaPts=%.3f, timebase=%.3f, rate=%.3f)\n",
+            reason, (long)status, requires_flush ? "yes" : "no",
+            ready ? "yes" : "no",
+            current_media_time_ns(p) / 1000000000.0,
+            timebase_ns / 1000000000.0, timebase_rate);
+
+    p->not_ready_drop_count = 0;
+    p->last_not_ready_drop_ns = 0;
+    p->last_video_enqueue_ns = 0;
+    p->timebase_anchor_valid = false;
+    p->osd_change_id = 0;
+    p->osd_needs_enqueue = false;
+
+    [displayLayer release];
+    [osdLayer release];
+}
+
+static void record_not_ready_drop(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    int64_t now = mp_time_ns();
+
+    if (p->last_not_ready_drop_ns == 0 ||
+        now - p->last_not_ready_drop_ns > MP_TIME_MS_TO_NS(500))
+        p->not_ready_drop_count = 0;
+
+    p->last_not_ready_drop_ns = now;
+    p->not_ready_drop_count++;
+
+    if (p->not_ready_drop_count >= 3 &&
+        (!p->last_video_enqueue_ns ||
+         now - p->last_video_enqueue_ns >= MP_TIME_MS_TO_NS(500)))
+        recover_display_layer(vo, "repeated not-ready drops", false);
+}
+
+static void update_avfoundation_geometry(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    if (!p->displayLayer)
+        return;
+
+    __block int width = 0;
+    __block int height = 0;
+    AVSampleBufferDisplayLayer *displayLayer = [p->displayLayer retain];
+    dispatch_main_sync_safe(^{
+        CGFloat scale = displayLayer.contentsScale > 0 ? displayLayer.contentsScale : get_screen_scale();
+        CGSize size = displayLayer.bounds.size;
+        if (size.width <= 0 || size.height <= 0)
+            size = displayLayer.frame.size;
+
+        width = MPMAX(1, (int)(size.width * scale + 0.5));
+        height = MPMAX(1, (int)(size.height * scale + 0.5));
+    });
+    [displayLayer release];
+
+    vo->dwidth = width;
+    vo->dheight = height;
+    vo->monitor_par = 1.0;
+}
+
+// --- avf frame-space osd core ---
+// PiP hands the enqueued samples themselves to the system, which sizes its
+// window from their dimensions. The OSD therefore cannot be laid out in
+// display-layer space: a plaintext subtitle sits in the letterbox margin around
+// the video by default (--sub-use-margins), which is not part of the frame, so
+// compositing it grew the sample to the layer's size and the PiP window resized
+// with every cue (plezy#2078).
+//
+// Frame-space geometry lays the OSD out on the frame's own coded grid instead:
+// margins collapse, so --sub-pos is a percentage of the presented frame, the
+// dimension-preserving composite always applies, and the Core Image fallback
+// still produces a frame-sized buffer. Non-square source pixels squeeze the
+// text exactly as the display layer stretches the frame back out, which is the
+// convention osd_res_from_image_params() uses for the same job.
+static struct avf_render_geometry avf_frame_space_geometry(int frame_w, int frame_h,
+                                                          int p_w, int p_h)
+{
+    if (frame_w <= 0 || frame_h <= 0)
+        return (struct avf_render_geometry){0};
+
+    struct mp_rect frame = {0, 0, frame_w, frame_h};
+
+    return (struct avf_render_geometry){
+        .w = frame_w,
+        .h = frame_h,
+        .src = frame,
+        .dst = frame,
+        .osd_res = {
+            .w = frame_w,
+            .h = frame_h,
+            .display_par = p_w > 0 && p_h > 0 ? p_h / (double)p_w : 1.0,
+        },
+    };
+}
+
+// Clip the cached subtitle's OSD-space bounding box against the video rect the
+// frame actually contains, then map it onto the frame's pixel grid, with a
+// pixel of slack per side for the inverse mapping the composite loop does.
+// Returns false when the box misses that rect entirely: in display-layer space
+// that means the subtitle was laid out in a letterbox margin.
+static bool avf_map_subtitle_rect(struct avf_render_geometry geometry,
+                                  struct mp_rect sub, int sub_w, int sub_h,
+                                  int frame_w, int frame_h,
+                                  struct mp_rect *out)
+{
+    struct mp_rect src = geometry.src;
+    struct mp_rect dst = geometry.dst;
+    int srcW = src.x1 - src.x0;
+    int srcH = src.y1 - src.y0;
+    int dstW = dst.x1 - dst.x0;
+    int dstH = dst.y1 - dst.y0;
+    if (srcW <= 0 || srcH <= 0 || dstW <= 0 || dstH <= 0)
+        return false;
+
+    int frame_x0 = MPCLAMP(src.x0, 0, frame_w);
+    int frame_y0 = MPCLAMP(src.y0, 0, frame_h);
+    int frame_x1 = MPCLAMP(src.x1, 0, frame_w);
+    int frame_y1 = MPCLAMP(src.y1, 0, frame_h);
+    if (frame_x1 <= frame_x0 || frame_y1 <= frame_y0)
+        return false;
+
+    int osd_x0 = MPMAX(sub.x0, MPMAX(dst.x0, 0));
+    int osd_y0 = MPMAX(sub.y0, MPMAX(dst.y0, 0));
+    int osd_x1 = MPMIN(sub.x1, MPMIN(dst.x1, sub_w));
+    int osd_y1 = MPMIN(sub.y1, MPMIN(dst.y1, sub_h));
+    if (osd_x1 <= osd_x0 || osd_y1 <= osd_y0)
+        return false;
+
+    int x0 = src.x0 + (int)(((int64_t)(osd_x0 - dst.x0) * srcW) / dstW) - 1;
+    int y0 = src.y0 + (int)(((int64_t)(osd_y0 - dst.y0) * srcH) / dstH) - 1;
+    int x1 = src.x0 + (int)((((int64_t)(osd_x1 - dst.x0) * srcW) + dstW - 1) / dstW) + 1;
+    int y1 = src.y0 + (int)((((int64_t)(osd_y1 - dst.y0) * srcH) + dstH - 1) / dstH) + 1;
+    x0 = MPCLAMP(x0, frame_x0, frame_x1);
+    y0 = MPCLAMP(y0, frame_y0, frame_y1);
+    x1 = MPCLAMP(x1, frame_x0, frame_x1);
+    y1 = MPCLAMP(y1, frame_y0, frame_y1);
+    if (x1 <= x0 || y1 <= y0)
+        return false;
+
+    *out = (struct mp_rect){x0, y0, x1, y1};
+    return true;
+}
+// --- end avf frame-space osd core ---
+
+static struct avf_render_geometry compute_render_geometry(struct vo *vo,
+                                                          int frame_w,
+                                                          int frame_h)
+{
+    struct priv *p = vo->priv;
+    struct mp_rect src, dst;
+    struct mp_osd_res vo_osd;
+
+    if (frame_w <= 0)
+        frame_w = vo->params ? vo->params->w : 0;
+    if (frame_h <= 0)
+        frame_h = vo->params ? vo->params->h : 0;
+
+    if (should_use_frame_space_osd(p)) {
+        return avf_frame_space_geometry(frame_w, frame_h,
+                                        vo->params ? vo->params->p_w : 1,
+                                        vo->params ? vo->params->p_h : 1);
+    }
+
+    vo_get_src_dst_rects(vo, &src, &dst, &vo_osd);
+
+    if (should_use_inline_osd_layer(p)) {
+        return (struct avf_render_geometry){
+            .w = vo_osd.w,
+            .h = vo_osd.h,
+            .src = src,
+            .dst = dst,
+            .osd_res = vo_osd,
+        };
+    }
+
+    if (frame_w <= 0 || frame_h <= 0 || vo_osd.w <= 0 || vo_osd.h <= 0) {
+        return (struct avf_render_geometry){0};
+    }
+
+    int params_w = vo->params ? vo->params->w : frame_w;
+    int params_h = vo->params ? vo->params->h : frame_h;
+    if (src.x1 <= src.x0 || src.y1 <= src.y0) {
+        src = (struct mp_rect){0, 0, params_w, params_h};
+    }
+
+    return (struct avf_render_geometry){
+        .w = vo_osd.w,
+        .h = vo_osd.h,
+        .src = src,
+        .dst = dst,
+        .osd_res = vo_osd,
+    };
+}
+
+static void invalidate_render_geometry(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    p->render_geometry_valid = false;
+}
+
+static void update_render_geometry(struct vo *vo, int frame_w, int frame_h)
+{
+    struct priv *p = vo->priv;
+
+    if (frame_w <= 0)
+        frame_w = vo->params ? vo->params->w : 0;
+    if (frame_h <= 0)
+        frame_h = vo->params ? vo->params->h : 0;
+
+    update_avfoundation_geometry(vo);
+    p->render_geometry = compute_render_geometry(vo, frame_w, frame_h);
+    p->render_geometry_valid = true;
+}
+
+static struct avf_render_geometry get_render_geometry(struct vo *vo,
+                                                      int frame_w,
+                                                      int frame_h)
+{
+    struct priv *p = vo->priv;
+
+    if (!p->render_geometry_valid || should_apply_video_geometry(vo))
+        update_render_geometry(vo, frame_w, frame_h);
+
+    return p->render_geometry;
+}
+
+// Where `layer` sits in its superlayer with its transform ignored. A host may
+// scale the display layer itself (viewer zoom that keeps the sample-buffer
+// scanout path), and `frame` is then the transformed bounding box: an OSD
+// layer given that frame stretches its canvas, which is sized from `bounds`,
+// by the zoom and pushes the bottom subtitle lines off screen. The OSD stays
+// over the untransformed picture, where mpv laid the subtitles out.
+static CGRect layer_untransformed_frame(CALayer *layer)
+{
+    CGSize size = layer.bounds.size;
+    CGPoint anchor = layer.anchorPoint;
+    CGPoint position = layer.position;
+    return CGRectMake(position.x - anchor.x * size.width,
+                      position.y - anchor.y * size.height,
+                      size.width, size.height);
+}
+
+// Create the timed OSD sample-buffer layer, in inline mode only. Its lifetime
+// follows the composite_osd/pip_composite_osd options, so sync_osd_layer_frame
+// can call this again after the user turns compositing back off.
+static void ensure_osd_layer(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    if (p->osdLayer || !should_use_inline_osd_layer(p) || !p->displayLayer)
+        return;
+
+    AVSampleBufferDisplayLayer *osdDisplayLayer = [p->displayLayer retain];
+    CMTimebaseRef osdTimebase = p->timebase;
+    dispatch_main_sync_safe(^{
+        AVSampleBufferDisplayLayer *osdLayer = [[AVSampleBufferDisplayLayer alloc] init];
+        osdLayer.frame = layer_untransformed_frame(osdDisplayLayer);
+        osdLayer.anchorPoint = CGPointMake(0.5, 0.5);
+#if !TARGET_OS_IPHONE
+        osdLayer.autoresizingMask = kCALayerWidthSizable | kCALayerHeightSizable;
+#endif
+        osdLayer.contentsScale = osdDisplayLayer.contentsScale > 0 ? osdDisplayLayer.contentsScale : get_screen_scale();
+        osdLayer.backgroundColor = NULL;
+        osdLayer.opaque = NO;
+        osdLayer.videoGravity = AVLayerVideoGravityResize;
+        osdLayer.controlTimebase = osdTimebase;
+
+        CALayer *parent = osdDisplayLayer.superlayer;
+        if (parent) {
+            [parent addSublayer:osdLayer];
+            osdLayer.zPosition = osdDisplayLayer.zPosition + 1;
+        } else {
+            [osdDisplayLayer addSublayer:osdLayer];
+            osdLayer.frame = osdDisplayLayer.bounds;
+            MP_WARN(vo, "displayLayer has no superlayer; OSD will degrade direct scanout\n");
+        }
+        p->osdLayer = osdLayer;
+    });
+    [osdDisplayLayer release];
+}
+
+// How long a retired layer stays hidden before it leaves the layer tree.
+// Leaving the tree drops the layer's video receiver and image queue, and on
+// macOS 27 tearing those down while WindowServer still composites the layer
+// can wedge the display: it stops presenting, the WindowServer watchdog
+// fires and the Mac panics (plezy#2823). Hidden first, the layer is out of
+// the frames WindowServer presents by then; 200 ms is several refreshes even
+// at 24 Hz.
+#define AVF_LAYER_RETIRE_DELAY_NS MP_TIME_MS_TO_NS(200)
+
+// Drop the timed OSD layer, on uninit or when the composite path takes the
+// OSD over: hidden now, out of the tree once that has reached the screen.
+static void release_osd_layer(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    if (!p->osdLayer)
+        return;
+
+    AVSampleBufferDisplayLayer *osdLayer = p->osdLayer;
+    p->osdLayer = nil;
+    p->osd_layer_dirty = false;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        osdLayer.hidden = YES;
+        [CATransaction commit];
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, AVF_LAYER_RETIRE_DELAY_NS),
+                       dispatch_get_main_queue(), ^{
+            [osdLayer removeFromSuperlayer];
+            [osdLayer release];
+        });
+    });
+}
