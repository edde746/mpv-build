@@ -1143,6 +1147,29 @@ static int64_t avf_host_present_ns(int64_t last_ns, int64_t target_ns,
 }
 // --- end avf host present stamp ---
 
+// --- avf media stamp (host-testable; keep freestanding) ---
+// Media stamps never go back either. On media time a frame's sample is
+// stamped with its timestamp, and a reset's flush leaves the samples
+// CoreMedia already took for display, up to queue-lead-ms ahead of where the
+// old file or position was. The next file's timestamps start over (at 0, or
+// at a resume point), so when its clock reached those stamps a frame of the
+// file before showed in the middle of the new one (skip an episode a second
+// in, and a second into the next its frame flashes). A frame whose timestamp
+// plus offset_ns is at or before the last stamp moves the offset so that the
+// frame is stamped just after it; the frames after it keep the offset, and
+// their spacing. No old frame can then come after a new one. The layers'
+// clock runs on the stamps, not the media timestamps: whoever reads it (a
+// picture in picture time range) takes the position relative to it.
+static int64_t avf_media_stamp_offset(int64_t offset_ns, int64_t last_stamp_ns,
+                                      int64_t media_pts_ns)
+{
+    int64_t stamp = media_pts_ns + offset_ns;
+    if (stamp <= last_stamp_ns)
+        return offset_ns + (last_stamp_ns - stamp) + 1;
+    return offset_ns;
+}
+// --- end avf media stamp ---
+
 // Slack over queue-lead-ms for avf_host_present_ns()'s window: how far ahead
 // of a new frame's target an already queued frame can be stamped.
 #define AVF_HOST_PRESENT_SLACK_NS MP_TIME_MS_TO_NS(50)
@@ -5429,9 +5456,19 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
         p->last_host_present_ns = p->next_present_host_ns;
     }
     p->next_media_pts_valid = media_pts_is_valid(pts);
+    // A redraw shows the frame already up again, whose stamp it keeps.
+    bool restamp = p->next_media_pts_valid && !p->presentation_host &&
+                   !frame->redraw;
+    if (restamp) {
+        p->media_stamp_offset_ns = avf_media_stamp_offset(
+            p->media_stamp_offset_ns, p->last_media_stamp_ns,
+            media_pts_to_ns(pts));
+    }
     p->next_media_pts_ns = p->next_media_pts_valid
-        ? media_pts_to_ns(pts)
