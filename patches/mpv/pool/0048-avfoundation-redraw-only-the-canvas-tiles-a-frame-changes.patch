+enum {
+    AVF_TILE_KEEP,      // the buffer holds what is wanted
+    AVF_TILE_COPY,      // the previous canvas holds it
+    AVF_TILE_CLEAR,     // nothing is wanted where something is
+    AVF_TILE_DRAW,      // the buffer is empty there: blend
+    AVF_TILE_REDRAW,    // clear, then blend
+};
+
+struct avf_damage_ops {
+    void *ctx;
+    void (*clear)(void *ctx, struct mp_rect r);
+    void (*copy)(void *ctx, struct mp_rect r);  // from the previous canvas
+    void (*draw)(void *ctx, struct mp_rect r);  // the frame's parts, clipped to r
+};
+
+// Pixels each operation covered.
+struct avf_damage_px {
+    int64_t cleared, copied, drawn;
+};
+
+// have NULL: the buffer is blank (avf_damage_apply cleared it whole).
+static int avf_tile_op(const uint64_t *have, const uint64_t *prev,
+                       const uint64_t *want, int i)
+{
+    uint64_t h = have ? have[i] : 0, w = want ? want[i] : 0;
+    if (h == w)
+        return AVF_TILE_KEEP;
+    if (w && prev && prev[i] == w)
+        return AVF_TILE_COPY;
+    if (!w)
+        return AVF_TILE_CLEAR;
+    return h ? AVF_TILE_REDRAW : AVF_TILE_DRAW;
+}
+
+// One band of tile rows, y0 to y1, that all need op[] across.
+static void avf_damage_band(const uint8_t *op, int tiles_x, int w, int y0, int y1,
+                            const struct avf_damage_ops *ops,
+                            struct avf_damage_px *px)
+{
+    for (int tx = 0; tx < tiles_x;) {
+        int o = op[tx], e = tx + 1;
+        bool draws = o >= AVF_TILE_DRAW;
+        while (e < tiles_x && (draws ? op[e] >= AVF_TILE_DRAW : op[e] == o))
+            e++;
+        struct mp_rect r = {tx * AVF_TILE, y0, MPMIN(w, e * AVF_TILE), y1};
+        int64_t area = (int64_t)(r.x1 - r.x0) * (r.y1 - r.y0);
+        if (o == AVF_TILE_COPY) {
+            ops->copy(ops->ctx, r);
+            px->copied += area;
+        } else if (o == AVF_TILE_CLEAR) {
+            ops->clear(ops->ctx, r);
+            px->cleared += area;
+        } else if (draws) {
+            // Parts are blended over the whole run at once; the tiles of it
+            // that hold something are cleared first.
+            for (int k = tx; k < e;) {
+                int k1 = k + 1;
+                if (op[k] == AVF_TILE_REDRAW) {
+                    while (k1 < e && op[k1] == AVF_TILE_REDRAW)
+                        k1++;
+                    struct mp_rect c = {k * AVF_TILE, y0, MPMIN(w, k1 * AVF_TILE), y1};
+                    ops->clear(ops->ctx, c);
+                    px->cleared += (int64_t)(c.x1 - c.x0) * (c.y1 - c.y0);
+                }
+                k = k1;
+            }
+            ops->draw(ops->ctx, r);
+            px->drawn += area;
+        }
+        tx = e;
+    }
+}
+
+// Make a w x h buffer whose tiles hold `have` (NULL: contents unknown) hold
+// `want` (NULL: nothing), through ops. prev: what the canvas ops->copy reads
+// holds, NULL without one. Tile rows that need the same treatment across
+// are done as one band. A buffer of unknown contents is cleared whole, in
+// one piece (one large clear is several times faster per byte than the same
+// bytes row by row), and is blank from there.
+static void avf_damage_apply(const uint64_t *have, const uint64_t *prev,
+                             const uint64_t *want, int w, int h,
+                             const struct avf_damage_ops *ops,
+                             struct avf_damage_px *px)
+{
+    int tiles_x = avf_tiles(w), tiles_y = avf_tiles(h);
+    struct mp_rect all = {0, 0, w, h};
+    if (tiles_x > AVF_DAMAGE_MAX_TILES_X) {
+        ops->clear(ops->ctx, all);
+        ops->draw(ops->ctx, all);
+        px->cleared += (int64_t)w * h;
+        px->drawn += (int64_t)w * h;
+        return;
+    }
+    if (!have) {
+        ops->clear(ops->ctx, all);
+        px->cleared += (int64_t)w * h;
+    }
+    uint8_t band[AVF_DAMAGE_MAX_TILES_X], row[AVF_DAMAGE_MAX_TILES_X];
+    int band_y0 = 0, band_y1 = 0;
+    for (int ty = 0; ty <= tiles_y; ty++) {
+        if (ty < tiles_y) {
+            for (int tx = 0; tx < tiles_x; tx++)
+                row[tx] = avf_tile_op(have, prev, want, ty * tiles_x + tx);
+            if (band_y1 > band_y0 && !memcmp(row, band, tiles_x)) {
+                band_y1 = MPMIN(h, (ty + 1) * AVF_TILE);
+                continue;
+            }
+        }
+        if (band_y1 > band_y0)
+            avf_damage_band(band, tiles_x, w, band_y0, band_y1, ops, px);
+        if (ty < tiles_y) {
+            memcpy(band, row, tiles_x);
+            band_y0 = ty * AVF_TILE;
+            band_y1 = MPMIN(h, band_y0 + AVF_TILE);
+        }
     }
-    return px;
