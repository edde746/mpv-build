+// Each renderer gets its share of the configured ceiling, never the whole of
+// it. libass applies its own 128 MiB bitmap + 64 MiB composite defaults when
+// asked for 0, and mpv declares --sub-bitmap-max-size without shipping a
+// default, so passing the option straight through would give the pair 384 MiB
+// where upstream mpv's single renderer takes 192 -- an invisible doubling that
+// only shows up as memory pressure on small devices. Resolve the default here
+// so the split covers the unset case too.
+#define SD_ASS_LIBASS_DEFAULT_BITMAP_MAX_MB 192
+
+static void set_renderer_cache_limits(struct sd *sd, ASS_Renderer *renderer)
+{
+    int max_size = sd->opts->sub_bitmap_max_size;
+    if (max_size <= 0)
+        max_size = SD_ASS_LIBASS_DEFAULT_BITMAP_MAX_MB;
+    max_size /= SD_ASS_RENDERERS;
+    if (max_size < 1)
+        max_size = 1;
+    // A configured glyph limit is a count and splits the same way; leaving it
+    // at 0 keeps libass' own per-renderer default, which is not the term that
+    // dominates the footprint.
+    int glyph_limit = sd->opts->sub_glyph_limit;
+    if (glyph_limit > 0) {
+        glyph_limit /= SD_ASS_RENDERERS;
+        if (glyph_limit < 1)
+            glyph_limit = 1;
+    }
+    ass_set_cache_limits(renderer, glyph_limit, max_size);
+}
+
+static void destroy_renderer(void *ptr)
+{
+    struct ass_render_state *r = ptr;
+    if (r->renderer)
+        ass_renderer_done(r->renderer);
+}
+
+static struct ass_render_state *get_renderer(struct sd *sd, int index)
+{
+    struct sd_ass_priv *ctx = sd->priv;
+    if (ctx->renderers[index])
+        return ctx->renderers[index];
+    struct ass_render_state *r = talloc_zero(ctx, struct ass_render_state);
+    talloc_set_destructor(r, destroy_renderer);
+    r->renderer = ass_renderer_init(ctx->ass_library);
+    if (!r->renderer) {
+        talloc_free(r);
+        return NULL;
+    }
+    unsigned threads = ass_set_threads(r->renderer, 0);
+    if (threads)
+        MP_VERBOSE(sd, "libass rendering threads: %u\n", threads);
+    else
+        MP_WARN(sd, "libass built without threading support\n");
+    mp_ass_configure_fonts(r->renderer, sd->opts->sub_style, sd->global, sd->log);
+    set_renderer_cache_limits(sd, r->renderer);
+    r->packer = mp_sub_packer_alloc(r);
+    ctx->renderers[index] = r;
+    return r;
+}
+
+static void discard_prefetch(struct sd_ass_priv *ctx)
+{
+    int index = ctx->active_renderer ^ 1;
+    talloc_free(ctx->renderers[index]);
+    ctx->renderers[index] = NULL;
+    ctx->prefetched = false;
+    if (ctx->last_renderer == index)
+        ctx->last_renderer = -1;
+}
