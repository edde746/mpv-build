diff --git a/video/out/aspect.c b/video/out/aspect.c
index 55c595096..8623f29d7 100644
--- a/video/out/aspect.c
+++ b/video/out/aspect.c
@@ -198,6 +198,28 @@ void mp_get_src_dst_rects(struct mp_log *log, struct mp_vo_opts *opts,
     osd.mt += margin_y[0];
     osd.mb += margin_y[1];
 
+    // Subtitles are placed against these margins, i.e. against the displayed
+    // video rect. When a user shader composites the true picture centered
+    // inside an aspect-overridden frame, that rect is the frame and not the
+    // picture: place them against the largest centered rect of the picture's
+    // aspect inside the (unclipped) video rect instead.
+    if (opts->sub_video_rect_aspect > 0) {
+        int vx0 = osd.ml, vy0 = osd.mt;
+        int vw = window_w - osd.mr - vx0;
+        int vh = window_h - osd.mb - vy0;
+        double aspect = opts->sub_video_rect_aspect * monitor_par;
+        int rw = vw, rh = vh;
+        if (vw > vh * aspect) {
+            rw = MPMAX(1, (int)(vh * aspect + 0.5));
+        } else {
+            rh = MPMAX(1, (int)(vw / aspect + 0.5));
+        }
+        osd.ml = vx0 + (vw - rw) / 2;
+        osd.mr = window_w - (osd.ml + rw);
+        osd.mt = vy0 + (vh - rh) / 2;
+        osd.mb = window_h - (osd.mt + rh);
+    }
+
     *out_src = src;
     *out_dst = dst;
     *out_osd = osd;
