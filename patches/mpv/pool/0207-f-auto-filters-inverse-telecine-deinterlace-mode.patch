 };
 
+// Interlaced video at this rate may be 3:2 telecined film (23.976 or 24 fps
+// carried as 29.97 or 30 fps); at any other rate it never is.
+static bool is_telecine_carrier_rate(double fps)
+{
+    return fps > 29.9 && fps < 30.1;
+}
+
+// Inverse telecine: fieldmatch rebuilds each film frame from the two fields
+// that belong to it, bwdif deinterlaces only the frames fieldmatch could not
+// match (fades, video-shot inserts) and flagged interlaced, and decimate
+// drops the one duplicate in every five, restoring 23.976/24 fps. Returns
+// NULL when the input cannot be converted or the graph cannot be built (an
+// FFmpeg without these filters); the caller deinterlaces instead.
+static struct mp_filter *create_ivtc(struct mp_filter *f, struct mp_image *img,
+                                     const char *field_parity)
+{
+    struct mp_filter *subf = mp_bidir_dummy_filter_create(f);
+    struct mp_filter *filters[2] = {0};
+
+    struct mp_autoconvert *ac = mp_autoconvert_create(subf);
+    if (!ac)
+        goto fail;
+    filters[0] = ac->f;
+    // fieldmatch takes 8-bit planar YUV only. Converting here (swscale, or
+    // a download of hardware frames) keeps libavfilter from needing its own
+    // scale filter, which builds that prune their filter list leave out.
+    static const enum AVPixelFormat formats[] = {
+        AV_PIX_FMT_YUV420P, AV_PIX_FMT_YUV422P, AV_PIX_FMT_YUV444P,
+        AV_PIX_FMT_YUV411P, AV_PIX_FMT_YUV410P,
+    };
+    for (int n = 0; n < MP_ARRAY_SIZE(formats); n++)
+        mp_autoconvert_add_imgfmt(ac, pixfmt2imgfmt(formats[n]), 0);
+    if (!mp_autoconvert_probe_input_video(ac, img))
+        goto fail;
+
+    char *graph = talloc_asprintf(subf,
+        "fieldmatch=order=%s:combmatch=full,"
+        "bwdif=mode=send_frame:parity=%s:deint=interlaced,"
+        "decimate", field_parity, field_parity);
+    char *args[] = {"graph", graph, NULL};
+    filters[1] = mp_create_user_filter(subf, MP_OUTPUT_CHAIN_VIDEO, "lavfi", args);
+    if (!filters[1])
+        goto fail;
+
+    mp_chain_filters(subf->ppins[0], subf->ppins[1], filters, 2);
+    return subf;
+
+fail:
+    talloc_free(subf);
+    return NULL;
+}
+
 static void deint_process(struct mp_filter *f)
 {
     struct deint_priv *p = f->priv;
@@ -51,13 +110,20 @@ static void deint_process(struct mp_filter *f)
 
     m_config_cache_update(p->opts);
     struct filter_opts *opts = p->opts->opts;
-    bool should_deinterlace = (opts->deinterlace == -1 && interlaced) ||
-                               opts->deinterlace == 1;
+    bool ivtc_mode = opts->deinterlace == 2;
+    // Inverse telecine, once engaged, stays for the rest of the stream:
+    // field matching needs every frame, and hard-telecined streams often
+    // flag only the combed frames of each cycle as interlaced.
+    bool keep_ivtc = ivtc_mode && p->ivtc_active;
+    bool should_deinterlace = ((opts->deinterlace == -1 || ivtc_mode) && interlaced) ||
+                               keep_ivtc || opts->deinterlace == 1;
 
     if (!should_deinterlace)
         mp_subfilter_destroy(&p->sub);
 
-    if (img->imgfmt == p->prev_imgfmt && p->deinterlace_active == should_deinterlace) {
+    if (img->imgfmt == p->prev_imgfmt && p->deinterlace_active == should_deinterlace &&
+        p->ivtc_mode == ivtc_mode)
+    {
         mp_subfilter_continue(&p->sub);
         return;
     }
@@ -69,6 +135,8 @@ static void deint_process(struct mp_filter *f)
 
     p->prev_imgfmt = img->imgfmt;
     p->deinterlace_active = should_deinterlace;
+    p->ivtc_mode = ivtc_mode;
+    p->ivtc_active = false;
     if (!p->deinterlace_active) {
         mp_subfilter_continue(&p->sub);
         return;
@@ -86,6 +154,17 @@ static void deint_process(struct mp_filter *f)
         field_parity = "auto";
     }
 
+    if (ivtc_mode && is_telecine_carrier_rate(img->nominal_fps)) {
+        p->sub.filter = create_ivtc(f, img, field_parity);
+        if (p->sub.filter) {
+            p->ivtc_active = true;
+            mp_subfilter_continue(&p->sub);
+            return;
+        }
+        MP_WARN(f, "inverse telecine unavailable (input %s), deinterlacing\n",
+                mp_imgfmt_to_name(img->imgfmt));
+    }
+
     bool has_filter = true;
     if (img->imgfmt == IMGFMT_VDPAU) {
         char *args[] = {"deint", "yes",
@@ -188,7 +267,13 @@ static const struct mp_filter_info deint_filter = {
 bool mp_deint_active(struct mp_filter *f)
 {
     struct deint_priv *p = f->priv;
-    return p->deinterlace_active;
+    return p->deinterlace_active && !p->ivtc_active;
+}
+
+bool mp_deint_ivtc_active(struct mp_filter *f)
+{
+    struct deint_priv *p = f->priv;
+    return p->ivtc_active;
 }
 
