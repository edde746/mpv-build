# Apple (macOS/iOS/tvOS/Catalyst/visionOS) patch series for mpv, applied after
# series.common. One pool filename per line; order is authoritative and
# nothing is sorted.
0001-player-add-moltenvk-context.patch
0002-revert-build-static.patch
0003-fix-coreaudio-hal-guards-for-non-macos.patch
0004-avfoundation-video-output.patch
0005-audiounit-reject-spdif.patch
0006-avfoundation-avplayer-compressed-passthrough.patch
0015-avfoundation-bound-pcm-lookahead.patch
0019-avfoundation-configurable-compressed-audio.patch
0020-avfoundation-compressed-clock-accounting.patch
0021-avfoundation-configurable-compressed-lead.patch
0022-avfoundation-slow-source-preroll-patience.patch
0023-avfoundation-refuse-reads-past-the-write-head.patch
# Every group but android: a MediaCodec that starts failing mid-stream rarely
# recovers, and waiting out its error burst only delays the software fallback.
0025-vd-lavc-recover-hwdec-after-decode-error-burst.patch
0028-ao-coreaudio-uninit-on-init-failure.patch
0037-ao-coreaudio-typed-channel-map.patch
0033-avfoundation-compressed-software-volume.patch
0036-avfoundation-restart-only-a-running-pcm-sink.patch
0039-ao-spatial-render-truehd-atmos-and-dts-x.patch
0040-ao-decode-the-playing-track-to-pcm-when-passthrough-fails.patch
0041-avfoundation-say-when-avplayer-never-asked-for-the-stream.patch
0042-avfoundation-anchor-the-passthrough-clock-to-the-playhead.patch
# OSD canvas: a cheaper exact libass blend (test_avf_osd_blend.sh). Its
# per-buffer dirty rects are replaced by 0048.
0043-avfoundation-clear-and-blend-the-osd-canvas-for-less.patch
# vo_avfoundation takes a frame early on a wakeup the player makes anyway,
# instead of on VO timers of its own (--avfoundation-queue-slack-ms, off).
0044-vo-queue-slack-for-vos-that-present-by-timestamp.patch
# --hwdec-threads defaults to 1: VideoToolbox decodes one frame at a time.
0045-vd-lavc-one-hwdec-thread-by-default-on-apple-platforms.patch
# Startup: a file's first frame is on screen before the audio output opens,
# and vo_avfoundation waits for the main thread once, not seven times.
0046-player-first-video-frame-before-the-audio-output-opens.patch
0047-avfoundation-one-main-thread-trip-to-set-up.patch
# OSD canvas: a frame clears and blends only the 32 px tiles of its buffer
# that it changes, and copies from the previous canvas what that one already
# holds (common 0234's pixel ids; test_avf_osd_damage.sh).
0048-avfoundation-redraw-only-the-canvas-tiles-a-frame-changes.patch
