+// What a thread may keep for its next bitmap. A larger buffer is released
+// right after use: a full-frame blur must not pin that much in every thread.
+#define SCRATCH_KEEP_MAX (8 * 1024 * 1024)
+#define SCRATCH_ALIGNMENT 32
+#define SCRATCH_GRANULARITY (64 * 1024)
+
+void *ass_scratch_get(BitmapScratch *scratch, int slot, size_t size)
+{
+    scratch->used = true;
+    if (scratch->size[slot] < size) {
+        ass_aligned_free(scratch->buf[slot]);
+        scratch->buf[slot] = NULL;
+        scratch->size[slot] = 0;
+        if (size > SIZE_MAX - SCRATCH_GRANULARITY)
+            return NULL;
+        size = ass_align(SCRATCH_GRANULARITY, size);
+        scratch->buf[slot] = ass_aligned_alloc(SCRATCH_ALIGNMENT, size, false);
+        if (scratch->buf[slot])
+            scratch->size[slot] = size;
+    }
+    return scratch->buf[slot];
+}
+
+void ass_scratch_put(BitmapScratch *scratch, int slot)
+{
+    if (scratch->size[slot] > SCRATCH_KEEP_MAX) {
+        ass_aligned_free(scratch->buf[slot]);
+        scratch->buf[slot] = NULL;
+        scratch->size[slot] = 0;
+    }
+}
+
+void ass_scratch_done(BitmapScratch *scratch)
+{
+    for (int slot = 0; slot < 2; slot++)
+        ass_aligned_free(scratch->buf[slot]);
+    memset(scratch, 0, sizeof(*scratch));
+}
+
+void ass_scratch_sweep(BitmapScratch *scratch, unsigned sweeps)
+{
+    if (!scratch->used || sweeps > 1)
+        ass_scratch_done(scratch);
+    scratch->used = false;
+}
