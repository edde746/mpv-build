+
+/*
+ * NEON versions of the tile functions of c/rasterizer_template.h for 32-bit
+ * ARM, modelled on aarch64/rasterizer.S. Everything is generic in the tile
+ * order, which is a constant in each of the instantiations at the end.
+ * There is no merge_tile: the compiler makes the same of the C version.
+ *
+ * Tuned on a Cortex-A55, the kind of core that still runs 32-bit code:
+ * in-order, one NEON instruction per cycle whatever else there is to do,
+ * two or three cycles for the load of a vector, a hundred for a call of
+ * memset(), and scalar code is cheap in comparison.
+ */
+
+#include "config.h"
+#include "ass_compat.h"
+
+#include <arm_neon.h>
+#include <string.h>
+
+#include "ass_utils.h"
+#include "ass_rasterizer.h"
+
+
+#define ALWAYS_INLINE  static inline __attribute__((always_inline))
+
+// widest tile in 8-pixel vectors
+#define MAX_VEC  4
+
+
+ALWAYS_INLINE int32_t rescale_ab(int32_t ab, int32_t scale, const int order)
+{
+    return (ab * (int64_t) scale + ((int64_t) 1 << (45 + order))) >> (46 + order);
+}
+
+ALWAYS_INLINE int32_t rescale_c(int64_t c, int32_t scale, const int order)
+{
+    return ((int32_t) (c >> (7 + order)) * (int64_t) scale + ((int64_t) 1 << 44)) >> 45;
+}
+
+// c - a * x for the first 8 pixels of a row
+ALWAYS_INLINE int16x8_t line_start(int c, int a)
+{
+    static const int16_t index[8] = { 0, 1, 2, 3, 4, 5, 6, 7 };
+    return vmlsq_s16(vdupq_n_s16(c), vld1q_s16(index), vdupq_n_s16(a));
+}
+
+ALWAYS_INLINE int16x8_t clamp(int16x8_t val, int16x8_t max)
+{
+    return vminq_s16(vmaxq_s16(val, vdupq_n_s16(0)), max);
+}
+
+// The intrinsics below take immediates only.
+
+// res + (val >> (7 - order))
+ALWAYS_INLINE int16x8_t accumulate(int16x8_t res, int16x8_t val, const int order)
+{
+    return order == 4 ? vsraq_n_s16(res, val, 3) : vsraq_n_s16(res, val, 2);
+}
+
+// min(max(val, 0) << (order + 2), 65535):
+// val clamped to 0..full_value and scaled to 16 bits, 65535 for full_value
+ALWAYS_INLINE uint16x8_t clamp_scale(int16x8_t val, const int order)
+{
+    return order == 4 ? vqshluq_n_s16(val, 6) : vqshluq_n_s16(val, 7);
+}
+
+
+ALWAYS_INLINE void fill_solid_tile(uint8_t *buf, ptrdiff_t stride, int set,
+                                   const int order)
+{
+    const int tile_size = 1 << order;
+
+    uint8x16_t value = vdupq_n_u8(set ? 255 : 0);
+    for (int y = 0; y < tile_size; y++) {
+        for (int x = 0; x < tile_size; x += 16)
+            vst1q_u8(buf + x, value);
+        buf += stride;
+    }
+}
+
+
+/*
+ * Halfplane Filling Functions
+ *
+ * See c/rasterizer_template.h for the algorithm. The two clamped values of
+ * a pixel are c2 = cc - aa * x - delta and c1 = c2 + 2 * delta.
+ *
+ * clamp_scale() gives them as (c << (order + 2)) - (c == full_value), and
+ * the pixel is the upper byte of the rounded average of the two: the
+ * rounding makes up for one of them being full_value, so that this is
+ * (c1 + c2) >> (7 - order), and with both it is the 255 the pixel is
+ * clamped to.
+ */
+
+ALWAYS_INLINE void fill_halfplane_tile(uint8_t *buf, ptrdiff_t stride,
+                                       int32_t a, int32_t b, int64_t c, int32_t scale,
+                                       const int order)
+{
+    const int tile_size = 1 << order, n_vec = tile_size / 8;
+    const int full_value = 1 << (14 - order);
+
+    int16_t aa = rescale_ab(a, scale, order), bb = rescale_ab(b, scale, order);
+    int16_t cc = rescale_c(c, scale, order) + full_value / 2 - ((aa + bb) >> 1);
+
+    int16_t abs_a = aa < 0 ? -aa : aa;
+    int16_t abs_b = bb < 0 ? -bb : bb;
+    int16_t delta = (FFMIN(abs_a, abs_b) + 2) >> 2;
+
+    int16x8_t cur[MAX_VEC];
+    cur[0] = line_start(cc - delta, aa);
+    for (int i = 1; i < n_vec; i++)
+        cur[i] = vsubq_s16(cur[i - 1], vdupq_n_s16(aa * 8));
+
+    const int16x8_t vdelta = vdupq_n_s16(delta * 2), vb = vdupq_n_s16(bb);
+    for (int y = 0; y < tile_size; y++) {
+        for (int i = 0; i < n_vec; i += 2) {
+            uint16x8_t lo = vrhaddq_u16(clamp_scale(cur[i], order),
+                                        clamp_scale(vaddq_s16(cur[i], vdelta), order));
+            uint16x8_t hi = vrhaddq_u16(clamp_scale(cur[i + 1], order),
+                                        clamp_scale(vaddq_s16(cur[i + 1], vdelta), order));
+            vst1q_u8(buf + 8 * i, vcombine_u8(vshrn_n_u16(lo, 8), vshrn_n_u16(hi, 8)));
+            cur[i] = vsubq_s16(cur[i], vb);
+            cur[i + 1] = vsubq_s16(cur[i + 1], vb);
+        }
+        buf += stride;
+    }
+}
+
+
+/*
+ * Generic Filling Functions
+ *
+ * See c/rasterizer_template.h for the algorithm. What differs is the
+ * bookkeeping of the winding changes at the ends of the segments.
+ * The C version keeps delta[], whose running sum over the rows is added to
+ * all pixels of a row. An end at row y adds some -k * (64 - pos) to delta[y]
+ * and -k * pos to delta[y + 1]: a step of -64 * k from row y on and
+ * a correction of k * pos for row y alone. Here delta[y] holds both in one
+ * word, the step in the upper half and the correction in the lower one,
+ * which makes one update per end. The correction is signed and borrows from
+ * the step; that is undone when the halves are split as long as it fits into
+ * 16 bits, which MAX_PACKED segments cannot exceed.
+ */
+
+#define MAX_PACKED  128
+
+// Render top/bottom line of the trapezoid with antialiasing,
+// cur[] is c - va[] of the C version; the line is less than a row high
+ALWAYS_INLINE void update_border_line(int16_t *res, const int16x8_t cur[MAX_VEC],
+                                      int abs_a, int b, int abs_b,
+                                      int up, int dn, const int order)
+{
+    const int n_vec = (1 << order) / 8;
+    const int full_value = 1 << (14 - order);
+
+    // All of this fits into int16_t for any segment, as the C version has
+    // it, except for w with large tiles
+    int size = dn - up;
+    int w = full_value + (size << (8 - order)) - abs_a;
+    w = FFMIN(w, full_value) << (2 * order - 5);
+    if (order > 4)
+        w = (int16_t) w;
+
+    int dc_b = abs_b * size >> 6;
+    int dc = (FFMIN(abs_a, dc_b) + 2) >> 2;
+
+    int base = b * (up + dn) >> 7;
+    int offs1 = size - ((base + dc) * w >> 16);
+    int offs2 = size - ((base - dc) * w >> 16);
+
+    size <<= 1;
+    // w is even, so the doubling multiply by w / 2 gives val * w >> 16
+    // exactly and never saturates
+    const int16x8_t vw = vdupq_n_s16(w >> 1);
+    const int16x8_t voffs1 = vdupq_n_s16(offs1), voffs2 = vdupq_n_s16(offs2);
+
+    // Before the clamping c2 is c1 + diff, and 0 <= diff < 128 for any
+    // segment within the preconditions (only an abs_a far above full_value
+    // gets it out of there). The clamped values then follow from c2
+    // saturated to 8 bits, as size <= 126, and so does their sum.
+    int diff = offs2 - offs1;
+    if ((unsigned) diff < 128) {
+        const uint8x16_t vdiff = vdupq_n_u8(diff), vsize = vdupq_n_u8(size);
+        for (int i = 0; i < n_vec; i += 2) {
+            int16x8_t lo = vaddq_s16(vqdmulhq_s16(cur[i], vw), voffs2);
+            int16x8_t hi = vaddq_s16(vqdmulhq_s16(cur[i + 1], vw), voffs2);
+            uint8x16_t c2 = vcombine_u8(vqmovun_s16(lo), vqmovun_s16(hi));
+            uint8x16_t c1 = vminq_u8(vqsubq_u8(c2, vdiff), vsize);
+            uint8x16_t sum = vaddq_u8(c1, vminq_u8(c2, vsize));
+            uint16x8_t res_lo = vreinterpretq_u16_s16(vld1q_s16(res + 8 * i));
+            uint16x8_t res_hi = vreinterpretq_u16_s16(vld1q_s16(res + 8 * i + 8));
+            res_lo = vaddw_u8(res_lo, vget_low_u8(sum));
+            res_hi = vaddw_u8(res_hi, vget_high_u8(sum));
+            vst1q_s16(res + 8 * i, vreinterpretq_s16_u16(res_lo));
+            vst1q_s16(res + 8 * i + 8, vreinterpretq_s16_u16(res_hi));
+        }
+        return;
+    }
+
+    const int16x8_t vsize = vdupq_n_s16(size);
+    for (int i = 0; i < n_vec; i++) {
+        int16x8_t cw = vqdmulhq_s16(cur[i], vw);
+        int16x8_t c1 = clamp(vaddq_s16(cw, voffs1), vsize);
+        int16x8_t c2 = clamp(vaddq_s16(cw, voffs2), vsize);
+        int16x8_t val = vaddq_s16(vld1q_s16(res + 8 * i), vaddq_s16(c1, c2));
+        vst1q_s16(res + 8 * i, val);
+    }
+}
+
+// Running sum of the 8 values
+ALWAYS_INLINE int16x8_t running_sum(int16x8_t val)
+{
+    const int16x8_t zero = vdupq_n_s16(0);
+    val = vaddq_s16(val, vextq_s16(zero, val, 7));
+    val = vaddq_s16(val, vextq_s16(zero, val, 6));
+    return vaddq_s16(val, vextq_s16(zero, val, 4));
+}
+
+// Store clamped absolute value of one row
+ALWAYS_INLINE void store_row(uint8_t *buf, const int16_t *res, int16x8_t cur,
+                             const int n_vec)
+{
+    for (int i = 0; i < n_vec; i += 2) {
+        // -32768 stays negative and ends up as 0, like in the C version
+        int16x8_t lo = vabsq_s16(vaddq_s16(vld1q_s16(res + 8 * i), cur));
+        int16x8_t hi = vabsq_s16(vaddq_s16(vld1q_s16(res + 8 * i + 8), cur));
+        vst1q_u8(buf + 8 * i, vcombine_u8(vqmovun_s16(lo), vqmovun_s16(hi)));
+    }
+}
+
+// res[] is tile_size * tile_size, delta[] is tile_size + 1
+ALWAYS_INLINE void fill_generic_tile(uint8_t *restrict buf, ptrdiff_t stride,
+                                     const struct segment *restrict line, size_t n_lines,
+                                     int winding, int16_t *restrict res,
+                                     uint32_t *restrict delta, const int order)
+{
+    const int tile_size = 1 << order, n_vec = tile_size / 8;
+    const int full_value = 1 << (14 - order);
+    const int16x8_t full = vdupq_n_s16(full_value);
+
+    // The accumulators start out with what the winding adds to every pixel.
+    // (Zeros would do, but the compiler makes them a call of memset(), which
+    // takes three times as long as these stores.)
+    const int16x8_t base = vdupq_n_s16(256 * (int8_t) winding);
+    for (int i = 0; i < tile_size * tile_size; i += 32) {
+        vst1q_s16(res + i, base);
+        vst1q_s16(res + i + 8, base);
+        vst1q_s16(res + i + 16, base);
+        vst1q_s16(res + i + 24, base);
+    }
+    memset(delta, 0, sizeof(*delta) * (tile_size + 1));
+
+    // steps and corrections of the segments before the last MAX_PACKED ones
+    int16_t step_sum[8 * MAX_VEC], corr_sum[8 * MAX_VEC];
+    int unpacked = 0;
+
+    const struct segment *end = line + n_lines;
+    for (;;) {
+        const struct segment *packed_end =
+            (size_t) (end - line) > MAX_PACKED ? line + MAX_PACKED : end;
+        for (; line != packed_end; ++line) {
+            // The multiplications come first: their results are not there
+            // at once, and there is the bookkeeping to do meanwhile.
+            // a and b fit into int16_t for any segment.
+            int a = rescale_ab(line->a, line->scale, order);
+            int b = rescale_ab(line->b, line->scale, order);
+            int c = rescale_c(line->c, line->scale, order);
+
+            uint32_t flags = line->flags;
+            uint32_t up_delta = flags & SEGFLAG_DN ? 4 : 0;
+            uint32_t dn_delta = up_delta;
+            if (!line->x_min && (flags & SEGFLAG_EXACT_LEFT)) dn_delta ^= 4;
+            if (flags & SEGFLAG_UL_DR) {
+                uint32_t tmp = up_delta;
+                up_delta = dn_delta;
+                dn_delta = tmp;
+            }
+
+            int up = line->y_min >> 6, dn = line->y_max >> 6;
+            int up_pos = line->y_min & 63, dn_pos = line->y_max & 63;
+            // both ends are often in the same row: a load right after
+            // a store to the same place would have to wait for it
+            uint32_t delta_up = delta[up], delta_dn = delta[dn];
+            delta_up -= up_delta * ((64 << 16) - up_pos);
+            if (dn == up)
+                delta_dn = delta_up;
+            delta_dn += dn_delta * ((64 << 16) - dn_pos);
+            delta[up] = delta_up;
+            delta[dn] = delta_dn;
+            if (line->y_min == line->y_max)
+                continue;
+
+            c -= (a >> 1) + b * up;
+            int abs_a = a < 0 ? -a : a;
+            int abs_b = b < 0 ? -b : b;
+
+            // c - va[] of the C version, kept up to date with c
+            int16x8_t cur[MAX_VEC];
+            cur[0] = line_start(c, a);
+            for (int i = 1; i < n_vec; i++)
+                cur[i] = vsubq_s16(cur[i - 1], vdupq_n_s16(a * 8));
+            const int16x8_t vb = vdupq_n_s16(b);
+
+            int16_t *row = res + up * tile_size;
+            if (up_pos) {
+                update_border_line(row, cur, abs_a, b, abs_b,
+                                   up_pos, dn == up ? dn_pos : 64, order);
+                if (dn == up)
+                    continue;
+                row += tile_size;
+                up++;
+                for (int i = 0; i < n_vec; i++)
+                    cur[i] = vsubq_s16(cur[i], vb);
+            }
+            if (up < dn) {
+                int dc = (FFMIN(abs_a, abs_b) + 2) >> 2;
+                int base = full_value / 2 - (b >> 1);
+                const int16x8_t dc1 = vdupq_n_s16(base + dc), dc2 = vdupq_n_s16(base - dc);
+                const int16_t *row_end = res + dn * tile_size;
+                do {
+                    for (int i = 0; i < n_vec; i++) {
+                        int16x8_t c1 = clamp(vaddq_s16(cur[i], dc1), full);
+                        int16x8_t c2 = clamp(vaddq_s16(cur[i], dc2), full);
+                        int16x8_t val = accumulate(vld1q_s16(row + 8 * i),
+                                                   vaddq_s16(c1, c2), order);
+                        vst1q_s16(row + 8 * i, val);
+                        cur[i] = vsubq_s16(cur[i], vb);
+                    }
+                    row += tile_size;
+                } while (row != row_end);
+            }
+            if (dn_pos)
+                update_border_line(row, cur, abs_a, b, abs_b, 0, dn_pos, order);
+        }
+        if (line == end)
+            break;
+
+        // more segments than one packed delta[] is good for: split it
+        if (!unpacked) {
+            memset(step_sum, 0, sizeof(step_sum));
+            memset(corr_sum, 0, sizeof(corr_sum));
+            unpacked = 1;
+        }
+        for (int y = 0; y < tile_size; y++) {
+            step_sum[y] += (delta[y] + 0x8000) >> 16;
+            corr_sum[y] += delta[y];
+            delta[y] = 0;
+        }
+    }
+
+    // per row: running sum of the steps plus the correction, added to
+    // the accumulators
+    int16x8_t prev = vdupq_n_s16(0);
+    for (int i = 0; i < n_vec; i++) {
+        const int32x4_t half = vdupq_n_s32(0x8000);
+        int32x4_t lo = vreinterpretq_s32_u32(vld1q_u32(delta + 8 * i));
+        int32x4_t hi = vreinterpretq_s32_u32(vld1q_u32(delta + 8 * i + 4));
+        int16x8_t step = vcombine_s16(vaddhn_s32(lo, half), vaddhn_s32(hi, half));
+        int16x8_t corr = vcombine_s16(vmovn_s32(lo), vmovn_s32(hi));
+        if (unpacked) {
+            step = vaddq_s16(step, vld1q_s16(step_sum + 8 * i));
+            corr = vaddq_s16(corr, vld1q_s16(corr_sum + 8 * i));
+        }
+        step = vaddq_s16(running_sum(step), prev);
+        prev = vdupq_lane_s16(vget_high_s16(step), 3);
+
+        const int16x8_t cur = vaddq_s16(step, corr);
+        const int16x4_t cur_lo = vget_low_s16(cur), cur_hi = vget_high_s16(cur);
+#define STORE_ROW(half, lane) \
+        store_row(buf, res, vdupq_lane_s16(half, lane), n_vec); \
+        buf += stride; \
+        res += tile_size;
+        STORE_ROW(cur_lo, 0)
+        STORE_ROW(cur_lo, 1)
+        STORE_ROW(cur_lo, 2)
+        STORE_ROW(cur_lo, 3)
+        STORE_ROW(cur_hi, 0)
+        STORE_ROW(cur_hi, 1)
+        STORE_ROW(cur_hi, 2)
+        STORE_ROW(cur_hi, 3)
+#undef STORE_ROW
+    }
+}
+
+
+#define RASTERIZER_TILE(order, tile_size) \
+void ass_fill_solid_tile ## tile_size ## _neon(uint8_t *buf, ptrdiff_t stride, int set) \
+{ \
+    fill_solid_tile(buf, stride, set, order); \
+} \
+\
+void ass_fill_halfplane_tile ## tile_size ## _neon(uint8_t *buf, ptrdiff_t stride, \
+                                                   int32_t a, int32_t b, int64_t c, int32_t scale) \
+{ \
+    fill_halfplane_tile(buf, stride, a, b, c, scale, order); \
+} \
+\
+void ass_fill_generic_tile ## tile_size ## _neon(uint8_t *restrict buf, ptrdiff_t stride, \
+                                                 const struct segment *restrict line, size_t n_lines, \
+                                                 int winding) \
+{ \
+    int16_t res[tile_size * tile_size]; \
+    uint32_t delta[tile_size + 1]; \
+    fill_generic_tile(buf, stride, line, n_lines, winding, res, delta, order); \
+}
+
+RASTERIZER_TILE(4, 16)
+RASTERIZER_TILE(5, 32)
