diff --git a/libass/arm/be_blur.c b/libass/arm/be_blur.c
new file mode 100644
index 0000000..5316a44
--- /dev/null
+++ b/libass/arm/be_blur.c
@@ -0,0 +1,130 @@
+/*
+ * Copyright (C) 2026 libass contributors
+ *
+ * This file is part of libass.
+ *
+ * Permission to use, copy, modify, and distribute this software for any
+ * purpose with or without fee is hereby granted, provided that the above
+ * copyright notice and this permission notice appear in all copies.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES
+ * WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
+ * MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR
+ * ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
+ * WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN
+ * ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF
+ * OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+/*
+ * NEON version of c/c_be_blur.c for 32-bit ARM.
+ *
+ * Rows are processed in blocks of 8 pixels with the same two rows of state
+ * in tmp as the C version. Unlike aarch64/be_blur.S this touches nothing
+ * beyond the width of a row: its end is covered by a last block that overlaps
+ * the one before it, and that block takes its old state from before the
+ * other blocks updated it. Bitmaps narrower than a block are left to
+ * the C version.
+ */
+
+#include "config.h"
+#include "ass_compat.h"
+
+#include <arm_neon.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "ass_bitmap_engine.h"
+
+
+#define ALWAYS_INLINE  static inline __attribute__((always_inline))
+
+BeBlurFunc ass_be_blur_c;
+
+
+// [1, 2, 1] of 8 pixels and their neighbours
+ALWAYS_INLINE uint16x8_t blur_horz(uint8x8_t left, uint8x8_t cur, uint8x8_t right)
+{
+    return vaddq_u16(vaddl_u8(left, cur), vaddl_u8(cur, right));
+}
+
+// Add the horizontally blurred block of a new row to the state of its columns
+// and output the block of the row above
+ALWAYS_INLINE void blur_vert(uint8_t *dst, uint16_t *col_pix_buf, uint16_t *col_sum_buf,
+                             uint16x8_t old_pix, uint16x8_t old_sum, uint16x8_t col_pix)
+{
+    uint16x8_t col_sum = vaddq_u16(old_pix, col_pix);
+    vst1q_u16(col_pix_buf, col_pix);
+    vst1q_u16(col_sum_buf, col_sum);
+    vst1_u8(dst, vshrn_n_u16(vaddq_u16(old_sum, col_sum), 4));
+}
+
+// One row of the image: src is the new row, dst the one above it,
+// last is the offset of the last block, first is set for the first row,
+// which only initializes the state
+ALWAYS_INLINE void blur_row(uint8_t *dst, const uint8_t *src,
+                            uint16_t *col_pix_buf, uint16_t *col_sum_buf,
+                            size_t last, const int first)
+{
+    const uint8x8_t zero = vdup_n_u8(0);
+    uint16x8_t last_pix = vdupq_n_u16(0), last_sum = last_pix;
+    if (!first) {
+        last_pix = vld1q_u16(col_pix_buf + last);
+        last_sum = vld1q_u16(col_sum_buf + last);
+    }
+
+    for (size_t x = 0; x < last; x += 8) {
+        uint8x8_t cur = vld1_u8(src + x);
+        uint8x8_t left = x ? vld1_u8(src + x - 1) : vext_u8(zero, cur, 7);
+        uint16x8_t col_pix = blur_horz(left, cur, vld1_u8(src + x + 1));
+        if (first) {
+            vst1q_u16(col_pix_buf + x, col_pix);
+            vst1q_u16(col_sum_buf + x, col_pix);
+        } else {
+            blur_vert(dst + x, col_pix_buf + x, col_sum_buf + x,
+                      vld1q_u16(col_pix_buf + x), vld1q_u16(col_sum_buf + x), col_pix);
+        }
+    }
+
+    uint8x8_t cur = vld1_u8(src + last);
+    uint8x8_t left = last ? vld1_u8(src + last - 1) : vext_u8(zero, cur, 7);
+    uint16x8_t col_pix = blur_horz(left, cur, vext_u8(cur, zero, 1));
+    if (first) {
+        vst1q_u16(col_pix_buf + last, col_pix);
+        vst1q_u16(col_sum_buf + last, col_pix);
+    } else {
+        blur_vert(dst + last, col_pix_buf + last, col_sum_buf + last,
+                  last_pix, last_sum, col_pix);
+    }
+}
+
+/**
+ * \brief Blur with [[1,2,1], [2,4,2], [1,2,1]] kernel
+ */
+void ass_be_blur_neon(uint8_t *restrict buf, ptrdiff_t stride,
+                      size_t width, size_t height, uint16_t *restrict tmp)
+{
+    if (width < 8) {
+        ass_be_blur_c(buf, stride, width, height, tmp);
+        return;
+    }
+
+    uint16_t *col_pix_buf = tmp;
+    uint16_t *col_sum_buf = tmp + stride;
+    const size_t last = width - 8;
+
+    blur_row(NULL, buf, col_pix_buf, col_sum_buf, last, 1);
+
+    for (size_t y = 1; y < height; y++) {
+        uint8_t *dst = buf;
+        buf += stride;
+        blur_row(dst, buf, col_pix_buf, col_sum_buf, last, 0);
+    }
+
+    for (size_t x = 0; x < last; x += 8) {
+        uint16x8_t sum = vaddq_u16(vld1q_u16(col_sum_buf + x), vld1q_u16(col_pix_buf + x));
+        vst1_u8(buf + x, vshrn_n_u16(sum, 4));
+    }
+    uint16x8_t sum = vaddq_u16(vld1q_u16(col_sum_buf + last), vld1q_u16(col_pix_buf + last));
+    vst1_u8(buf + last, vshrn_n_u16(sum, 4));
+}
diff --git a/libass/arm/blend_bitmaps.c b/libass/arm/blend_bitmaps.c
new file mode 100644
index 0000000..aad0315
--- /dev/null
+++ b/libass/arm/blend_bitmaps.c
@@ -0,0 +1,167 @@
+/*
+ * Copyright (C) 2026 libass contributors
+ *
+ * This file is part of libass.
+ *
+ * Permission to use, copy, modify, and distribute this software for any
+ * purpose with or without fee is hereby granted, provided that the above
+ * copyright notice and this permission notice appear in all copies.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES
+ * WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
+ * MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR
+ * ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
+ * WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN
+ * ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF
+ * OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+/*
+ * NEON versions of c/c_blend_bitmaps.c for 32-bit ARM.
+ *
+ * Unlike aarch64/blend_bitmaps.S these touch nothing beyond the width of a
+ * row: its end is covered by a last vector that overlaps the one before it.
+ * Where the destination is also a source that vector is computed before the
+ * others are stored.
+ *
+ * The multiplications go two vectors at a time, so that an in-order core has
+ * something to do while it waits for the products.
+ */
+
+#include "config.h"
+#include "ass_compat.h"
+
+#include <arm_neon.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "ass_utils.h"
+
+
+#define ALWAYS_INLINE  static inline __attribute__((always_inline))
+
+enum { BLEND_ADD, BLEND_IMUL, BLEND_MUL };
+
+
+// (a * b + 255) >> 8
+ALWAYS_INLINE uint8x8_t mul8(uint8x8_t a, uint8x8_t b)
+{
+    return vaddhn_u16(vmull_u8(a, b), vdupq_n_u16(255));
+}
+
+ALWAYS_INLINE uint8x16_t mul16(uint8x16_t a, uint8x16_t b)
+{
+    return vcombine_u8(mul8(vget_low_u8(a), vget_low_u8(b)),
+                       mul8(vget_high_u8(a), vget_high_u8(b)));
+}
+
+// What the pixels at src1 and src2 make
+ALWAYS_INLINE uint8x8_t blend8(const uint8_t *src1, const uint8_t *src2, const int op)
+{
+    uint8x8_t a = vld1_u8(src1), b = vld1_u8(src2);
+    return op == BLEND_ADD ? vqadd_u8(a, b) : mul8(a, op == BLEND_MUL ? b : vmvn_u8(b));
+}
+
+ALWAYS_INLINE uint8x16_t blend16(const uint8_t *src1, const uint8_t *src2, const int op)
+{
+    uint8x16_t a = vld1q_u8(src1), b = vld1q_u8(src2);
+    return op == BLEND_ADD ? vqaddq_u8(a, b) : mul16(a, op == BLEND_MUL ? b : vmvnq_u8(b));
+}
+
+// Two vectors at once, stored at dst
+ALWAYS_INLINE void blend32(uint8_t *dst, const uint8_t *src1, const uint8_t *src2,
+                           const int op)
+{
+    uint8x16_t a0 = vld1q_u8(src1), b0 = vld1q_u8(src2);
+    uint8x16_t a1 = vld1q_u8(src1 + 16), b1 = vld1q_u8(src2 + 16);
+    if (op == BLEND_ADD) {
+        vst1q_u8(dst, vqaddq_u8(a0, b0));
+        vst1q_u8(dst + 16, vqaddq_u8(a1, b1));
+        return;
+    }
+    if (op == BLEND_IMUL) {
+        b0 = vmvnq_u8(b0);
+        b1 = vmvnq_u8(b1);
+    }
+    const uint16x8_t round = vdupq_n_u16(255);
+    uint16x8_t lo0 = vmull_u8(vget_low_u8(a0), vget_low_u8(b0));
+    uint16x8_t hi0 = vmull_u8(vget_high_u8(a0), vget_high_u8(b0));
+    uint16x8_t lo1 = vmull_u8(vget_low_u8(a1), vget_low_u8(b1));
+    uint16x8_t hi1 = vmull_u8(vget_high_u8(a1), vget_high_u8(b1));
+    vst1q_u8(dst, vcombine_u8(vaddhn_u16(lo0, round), vaddhn_u16(hi0, round)));
+    vst1q_u8(dst + 16, vcombine_u8(vaddhn_u16(lo1, round), vaddhn_u16(hi1, round)));
+}
+
+// dst = src1 (which may be dst) combined with src2
+ALWAYS_INLINE void blend_bitmaps(uint8_t *dst, ptrdiff_t dst_stride,
+                                 const uint8_t *src1, ptrdiff_t src1_stride,
+                                 const uint8_t *src2, ptrdiff_t src2_stride,
+                                 size_t width, size_t height, const int op)
+{
+    uint8_t *end = dst + dst_stride * height;
+    if (width >= 16) {
+        const size_t last = width - 16;
+        while (dst < end) {
+            uint8x16_t tail = blend16(src1 + last, src2 + last, op);
+            size_t x = 0;
+            for (; x + 16 < last; x += 32)
+                blend32(dst + x, src1 + x, src2 + x, op);
+            if (x < last)
+                vst1q_u8(dst + x, blend16(src1 + x, src2 + x, op));
+            vst1q_u8(dst + last, tail);
+            dst  += dst_stride;
+            src1 += src1_stride;
+            src2 += src2_stride;
+        }
+    } else if (width >= 8) {
+        const size_t last = width - 8;
+        while (dst < end) {
+            uint8x8_t tail = blend8(src1 + last, src2 + last, op);
+            vst1_u8(dst, blend8(src1, src2, op));
+            vst1_u8(dst + last, tail);
+            dst  += dst_stride;
+            src1 += src1_stride;
+            src2 += src2_stride;
+        }
+    } else {
+        while (dst < end) {
+            for (size_t x = 0; x < width; x++) {
+                if (op == BLEND_ADD) {
+                    unsigned out = src1[x] + src2[x];
+                    dst[x] = FFMIN(out, 255);
+                } else {
+                    unsigned mul = op == BLEND_MUL ? src2[x] : 255 - src2[x];
+                    dst[x] = (src1[x] * mul + 255) >> 8;
+                }
+            }
+            dst  += dst_stride;
+            src1 += src1_stride;
+            src2 += src2_stride;
+        }
+    }
+}
+
+void ass_add_bitmaps_neon(uint8_t *restrict dst, ptrdiff_t dst_stride,
+                          const uint8_t *restrict src, ptrdiff_t src_stride,
+                          size_t width, size_t height)
+{
+    blend_bitmaps(dst, dst_stride, dst, dst_stride, src, src_stride,
+                  width, height, BLEND_ADD);
+}
+
+void ass_imul_bitmaps_neon(uint8_t *restrict dst, ptrdiff_t dst_stride,
+                           const uint8_t *restrict src, ptrdiff_t src_stride,
+                           size_t width, size_t height)
+{
+    blend_bitmaps(dst, dst_stride, dst, dst_stride, src, src_stride,
+                  width, height, BLEND_IMUL);
+}
+
+void ass_mul_bitmaps_neon(uint8_t *restrict dst, ptrdiff_t dst_stride,
+                          const uint8_t *restrict src1, ptrdiff_t src1_stride,
+                          const uint8_t *restrict src2, ptrdiff_t src2_stride,
+                          size_t width, size_t height)
+{
+    blend_bitmaps(dst, dst_stride, src1, src1_stride, src2, src2_stride,
+                  width, height, BLEND_MUL);
+}
