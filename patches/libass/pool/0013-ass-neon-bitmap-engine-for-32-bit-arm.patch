index 0000000..09327fd
--- /dev/null
+++ b/libass/arm/blur.c
@@ -0,0 +1,856 @@
+/*
+ * Copyright (C) 2026 libass contributors
+ *
+ * This file is part of libass.
+ *
+ * Permission to use, copy, modify, and distribute this software for any
+ * purpose with or without fee is hereby granted, provided that the above
+ * copyright notice and this permission notice appear in all copies.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES
+ * WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
+ * MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR
+ * ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
+ * WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN
+ * ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF
+ * OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+/*
+ * NEON versions of the stripe functions of c/blur_template.h for 32-bit ARM,
+ * with stripes of 8 pixels, after aarch64/blur.S.
+ *
+ * Like the assembly versions, the shrink and expand filters rely on the pixel
+ * range of the internal format, and so do the blurs here, except for the
+ * horizontal ones of radius 1 and 2: they match the C versions for pixels in
+ * [0, 0x7FFF] (the format only uses [0, 0x4000]). The other functions match
+ * for any input.
+ *
+ * The cores these functions are for (Cortex-A53, A55) run NEON instructions
+ * in order, one 128-bit operation per cycle, most of which take 2 to 4
+ * cycles. A loop over single lines is one long dependency chain, hence the
+ * loops that go two lines or two stripes at a time: these give the core
+ * independent work to interleave. Which of the forms is used where is
+ * what measured fastest with what clang makes of them.
+ */
+
+#include "config.h"
+#include "ass_compat.h"
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include <arm_neon.h>
+
+#define STRIPE_WIDTH  8
+
+#ifdef __GNUC__
+#define ALWAYS_INLINE  static inline __attribute__((always_inline))
+#else
+#define ALWAYS_INLINE  static inline
+#endif
+
+// read in place of lines that are outside of the image
+static const int16_t zero_lines[4 * STRIPE_WIDTH] = {0};
+
+/*
+ * Horizontal filters read the same line of several neighboring stripes.
+ * A stripe outside of the image reads as zeros: its pointer stays on zero_lines.
+ */
+ALWAYS_INLINE const int16_t *get_stripe(const int16_t *src, size_t index, size_t count,
+                                        size_t step, size_t *inc)
+{
+    if (index < count) {
+        *inc = STRIPE_WIDTH;
+        return src + index * step;
+    }
+    *inc = 0;
+    return zero_lines;
+}
+
+ALWAYS_INLINE uint16x8_t load_line(const int16_t *ptr)
+{
+    return vld1q_u16((const uint16_t *) ptr);
+}
+
+ALWAYS_INLINE void store_line(int16_t *ptr, uint16x8_t val)
+{
+    vst1q_u16((uint16_t *) ptr, val);
+}
+
+/*
+ * Unpack/Pack Functions
+ */
+
+// (0x4000 * x + 127) / 255 == (0x101 * x + 2) >> 2, a doubled byte is 0x101 * x
+ALWAYS_INLINE void unpack_line(int16_t *dst, size_t step, const uint8_t *src)
+{
+    uint8x16_t val = vld1q_u8(src);
+    uint8x16x2_t res = vzipq_u8(val, val);
+    store_line(dst, vrshrq_n_u16(vreinterpretq_u16_u8(res.val[0]), 2));
+    store_line(dst + step, vrshrq_n_u16(vreinterpretq_u16_u8(res.val[1]), 2));
+}
+
+void ass_stripe_unpack16_neon(int16_t *restrict dst, const uint8_t *restrict src,
+                              ptrdiff_t src_stride, size_t width, size_t height)
+{
+    size_t step = STRIPE_WIDTH * height;
+    size_t stripes = (width + STRIPE_WIDTH - 1) / STRIPE_WIDTH;
+
+    for (; stripes >= 2; stripes -= 2) {
+        const uint8_t *ptr = src;
+        size_t y = height;
+        for (; y >= 2; y -= 2) {
+            unpack_line(dst, step, ptr);
+            unpack_line(dst + STRIPE_WIDTH, step, ptr + src_stride);
+            dst += 2 * STRIPE_WIDTH;
+            ptr += 2 * src_stride;
+        }
+        if (y) {
+            unpack_line(dst, step, ptr);
+            dst += STRIPE_WIDTH;
+        }
+        dst += step;
+        src += 2 * STRIPE_WIDTH;
+    }
+    if (stripes) {
+        for (size_t y = 0; y < height; y++) {
+            uint8x8_t val = vld1_u8(src);
+            uint8x8x2_t res = vzip_u8(val, val);
+            uint8x16_t doubled = vcombine_u8(res.val[0], res.val[1]);
+            store_line(dst, vrshrq_n_u16(vreinterpretq_u16_u8(doubled), 2));
+            dst += STRIPE_WIDTH;
+            src += src_stride;
+        }
+    }
+}
+
+ALWAYS_INLINE uint8x8_t pack_line(const int16_t *src, int16x8_t dither)
+{
+    int16x8_t val = vld1q_s16(src);
+    val = vaddq_s16(vsubq_s16(val, vshrq_n_s16(val, 8)), dither);
+    return vshrn_n_u16(vreinterpretq_u16_s16(val), 6);
+}
+
+void ass_stripe_pack16_neon(uint8_t *restrict dst, ptrdiff_t dst_stride,
+                            const int16_t *restrict src, size_t width, size_t height)
+{
+    size_t step = STRIPE_WIDTH * height;
+    size_t stripes = (width + STRIPE_WIDTH - 1) / STRIPE_WIDTH;
+    size_t left = dst_stride - STRIPE_WIDTH * stripes;
+
+    // dither is {8, 40, ...} in even rows and {56, 24, ...} in odd ones
+    const int16x8_t dither_even = vreinterpretq_s16_u32(vdupq_n_u32(40 << 16 | 8));
+    const int16x8_t dither_flip = vdupq_n_s16(8 ^ 56);
+
+    for (; stripes >= 2; stripes -= 2) {
+        uint8_t *ptr = dst;
+        int16x8_t dither = dither_even;
+        for (size_t y = 0; y < height; y++) {
+            vst1q_u8(ptr, vcombine_u8(pack_line(src, dither), pack_line(src + step, dither)));
+            dither = veorq_s16(dither, dither_flip);
+            ptr += dst_stride;
+            src += STRIPE_WIDTH;
+        }
+        dst += 2 * STRIPE_WIDTH;
+        src += step;
+    }
+    if (stripes) {
+        // the stride is a multiple of 16: the other half of the store is padding
+        uint8_t *ptr = dst;
+        int16x8_t dither = dither_even;
+        for (size_t y = 0; y < height; y++) {
+            vst1q_u8(ptr, vcombine_u8(pack_line(src, dither), vdup_n_u8(0)));
+            dither = veorq_s16(dither, dither_flip);
+            ptr += dst_stride;
+            src += STRIPE_WIDTH;
+        }
+        dst += 2 * STRIPE_WIDTH;
+        left -= STRIPE_WIDTH;
+    }
+    if (!left)
+        return;
+    for (size_t y = 0; y < height; y++) {
+        memset(dst, 0, left);
+        dst += dst_stride;
+    }
+}
+
+/*
+ * Contract Filters
+ *
+ * Contract image by factor 2 with kernel [1, 5, 10, 10, 5, 1].
+ */
+
+ALWAYS_INLINE uint16x8_t shrink_func(uint16x8_t p1p, uint16x8_t p1n,
+                                     uint16x8_t z0p, uint16x8_t z0n,
+                                     uint16x8_t n1p, uint16x8_t n1n)
+{
+    uint16x8_t p1p_n1n = vaddq_u16(p1p, n1n);
+    uint16x8_t p1n_n1p = vaddq_u16(p1n, n1p);
+    uint16x8_t z0p_z0n = vaddq_u16(z0p, z0n);
+    uint16x8_t r = vhaddq_u16(p1p_n1n, p1n_n1p);
+    r = vhaddq_u16(r, z0p_z0n);
+    r = vhaddq_u16(r, p1n_n1p);
+    r = vhaddq_u16(r, z0p_z0n);
+    return vrshrq_n_u16(r, 1);
+}
+
+ALWAYS_INLINE uint16x8_t shrink_horz_line(const int16_t *ptr_p, const int16_t *ptr_z,
+                                          const int16_t *ptr_n)
+{
+    uint16x8_t line_p = load_line(ptr_p);
+    // even and odd pixels: {-8, -6, -4, -2} twice, {0, 2, ..., 14}
+    uint16x8x2_t prev = vuzpq_u16(line_p, line_p);
+    uint16x8x2_t next = vuzpq_u16(load_line(ptr_z), load_line(ptr_n));
+    return shrink_func(vextq_u16(prev.val[0], next.val[0], 6),
+                       vextq_u16(prev.val[1], next.val[1], 6),
+                       vextq_u16(prev.val[0], next.val[0], 7),
+                       vextq_u16(prev.val[1], next.val[1], 7),
+                       next.val[0], next.val[1]);
+}
+
+void ass_shrink_horz16_neon(int16_t *restrict dst, const int16_t *restrict src,
+                            size_t src_width, size_t src_height)
+{
+    size_t dst_width = (src_width + 5) >> 1;
+    size_t dst_stripes = (dst_width + STRIPE_WIDTH - 1) / STRIPE_WIDTH;
+    size_t src_stripes = (src_width + STRIPE_WIDTH - 1) / STRIPE_WIDTH;
+    size_t step = STRIPE_WIDTH * src_height;
+
+    for (size_t x = 0; x < dst_stripes; x++) {
+        size_t inc_p, inc_z, inc_n;
+        const int16_t *ptr_p = get_stripe(src, 2 * x - 1, src_stripes, step, &inc_p);
+        const int16_t *ptr_z = get_stripe(src, 2 * x + 0, src_stripes, step, &inc_z);
+        const int16_t *ptr_n = get_stripe(src, 2 * x + 1, src_stripes, step, &inc_n);
+        size_t y = src_height;
+        for (; y >= 2; y -= 2) {
+            uint16x8_t res0 = shrink_horz_line(ptr_p, ptr_z, ptr_n);
+            uint16x8_t res1 = shrink_horz_line(ptr_p + inc_p, ptr_z + inc_z, ptr_n + inc_n);
+            store_line(dst, res0);
+            store_line(dst + STRIPE_WIDTH, res1);
+            dst += 2 * STRIPE_WIDTH;
+            ptr_p += 2 * inc_p;
+            ptr_z += 2 * inc_z;
+            ptr_n += 2 * inc_n;
+        }
+        if (y) {
+            store_line(dst, shrink_horz_line(ptr_p, ptr_z, ptr_n));
+            dst += STRIPE_WIDTH;
+        }
+    }
+}
+
+void ass_shrink_vert16_neon(int16_t *restrict dst, const int16_t *restrict src,
+                            size_t src_width, size_t src_height)
+{
+    const uint16x8_t zero = vdupq_n_u16(0);
+
+    for (size_t x = 0; x < src_width; x += STRIPE_WIDTH) {
+        // the four lines above the two that the next output line adds
+        uint16x8_t p1p = zero, p1n = zero, z0p = zero, z0n = zero;
+        for (size_t y = src_height / 4; y > 0; y--) {
+            uint16x8_t line0 = load_line(src + 0 * STRIPE_WIDTH);
+            uint16x8_t line1 = load_line(src + 1 * STRIPE_WIDTH);
+            uint16x8_t line2 = load_line(src + 2 * STRIPE_WIDTH);
+            uint16x8_t line3 = load_line(src + 3 * STRIPE_WIDTH);
+            uint16x8_t res0 = shrink_func(p1p, p1n, z0p, z0n, line0, line1);
+            uint16x8_t res1 = shrink_func(z0p, z0n, line0, line1, line2, line3);
+            store_line(dst, res0);
+            store_line(dst + STRIPE_WIDTH, res1);
+            p1p = line0;
+            p1n = line1;
+            z0p = line2;
+            z0n = line3;
+            dst += 2 * STRIPE_WIDTH;
+            src += 4 * STRIPE_WIDTH;
+        }
+        // up to three lines are left, and zeros below them:
+        // (src_height + 5) / 2 output lines in total
+        size_t left = src_height & 3;
+        uint16x8_t line0 = zero, line1 = zero, line2 = zero;
+        if (left > 0)
+            line0 = load_line(src + 0 * STRIPE_WIDTH);
+        if (left > 1)
+            line1 = load_line(src + 1 * STRIPE_WIDTH);
+        if (left > 2)
+            line2 = load_line(src + 2 * STRIPE_WIDTH);
+        src += left * STRIPE_WIDTH;
+        store_line(dst, shrink_func(p1p, p1n, z0p, z0n, line0, line1));
+        store_line(dst + STRIPE_WIDTH, shrink_func(z0p, z0n, line0, line1, line2, zero));
+        dst += 2 * STRIPE_WIDTH;
+        if (left > 0) {
+            store_line(dst, shrink_func(line0, line1, line2, zero, zero, zero));
+            dst += STRIPE_WIDTH;
+        }
+        if (left > 2) {
+            store_line(dst, shrink_func(line2, zero, zero, zero, zero, zero));
+            dst += STRIPE_WIDTH;
+        }
+    }
+}
+
+/*
+ * Expand Filters
+ *
+ * Expand image by factor 2 with kernel [5, 10, 1], [1, 10, 5].
+ */
+
+ALWAYS_INLINE void expand_func(uint16x8_t *rp, uint16x8_t *rn,
+                               uint16x8_t p1, uint16x8_t z0, uint16x8_t n1)
+{
+    uint16x8_t r = vhaddq_u16(vhaddq_u16(p1, n1), z0);
+    *rp = vrhaddq_u16(vhaddq_u16(r, p1), z0);
+    *rn = vrhaddq_u16(vhaddq_u16(r, n1), z0);
+}
+
+ALWAYS_INLINE uint16x8x2_t expand_horz_line(const int16_t *ptr_p, const int16_t *ptr_z)
+{
+    uint16x8_t line_p = load_line(ptr_p);
+    uint16x8_t line_z = load_line(ptr_z);
+    uint16x8_t rp, rn;
+    expand_func(&rp, &rn, vextq_u16(line_p, line_z, 6), vextq_u16(line_p, line_z, 7), line_z);
+    return vzipq_u16(rp, rn);
+}
+
+void ass_expand_horz16_neon(int16_t *restrict dst, const int16_t *restrict src,
+                            size_t src_width, size_t src_height)
+{
+    size_t dst_width = 2 * src_width + 4;
+    size_t src_stripes = (src_width + STRIPE_WIDTH - 1) / STRIPE_WIDTH;
+    size_t step = STRIPE_WIDTH * src_height;
+
+    // each source stripe makes two stripes, the last one may only make one
+    size_t index = 0;
+    for (size_t x = STRIPE_WIDTH; x < dst_width; x += 2 * STRIPE_WIDTH) {
+        size_t inc_p, inc_z;
+        const int16_t *ptr_p = get_stripe(src, index - 1, src_stripes, step, &inc_p);
+        const int16_t *ptr_z = get_stripe(src, index - 0, src_stripes, step, &inc_z);
+        size_t y = src_height;
+        for (; y >= 2; y -= 2) {
+            uint16x8x2_t res0 = expand_horz_line(ptr_p, ptr_z);
+            uint16x8x2_t res1 = expand_horz_line(ptr_p + inc_p, ptr_z + inc_z);
+            store_line(dst, res0.val[0]);
+            store_line(dst + STRIPE_WIDTH, res1.val[0]);
+            store_line(dst + step, res0.val[1]);
+            store_line(dst + step + STRIPE_WIDTH, res1.val[1]);
+            dst += 2 * STRIPE_WIDTH;
+            ptr_p += 2 * inc_p;
+            ptr_z += 2 * inc_z;
+        }
+        if (y) {
+            uint16x8x2_t res = expand_horz_line(ptr_p, ptr_z);
+            store_line(dst, res.val[0]);
+            store_line(dst + step, res.val[1]);
+            dst += STRIPE_WIDTH;
+        }
+        dst += step;
+        index++;
+    }
+    if ((dst_width - 1) & STRIPE_WIDTH)
+        return;
+
+    size_t inc_p, inc_z;
+    const int16_t *ptr_p = get_stripe(src, index - 1, src_stripes, step, &inc_p);
+    const int16_t *ptr_z = get_stripe(src, index - 0, src_stripes, step, &inc_z);
+    for (size_t y = 0; y < src_height; y++) {
+        store_line(dst, expand_horz_line(ptr_p, ptr_z).val[0]);
+        dst += STRIPE_WIDTH;
+        ptr_p += inc_p;
+        ptr_z += inc_z;
+    }
+}
+
+void ass_expand_vert16_neon(int16_t *restrict dst, const int16_t *restrict src,
+                            size_t src_width, size_t src_height)
+{
+    const uint16x8_t zero = vdupq_n_u16(0);
+
+    for (size_t x = 0; x < src_width; x += STRIPE_WIDTH) {
+        uint16x8_t p1 = zero, z0 = zero, rp0, rn0, rp1, rn1;
+        if (src_height & 1) {
+            // make the rest an even number of lines
+            z0 = load_line(src);
+            expand_func(&rp0, &rn0, zero, zero, z0);
+            store_line(dst, rp0);
+            store_line(dst + STRIPE_WIDTH, rn0);
+            dst += 2 * STRIPE_WIDTH;
+            src += STRIPE_WIDTH;
+        }
+        // the lines of the stripe, then two zero lines
+        const int16_t *line = src;
+        size_t pairs = src_height / 2;
+        src += 2 * STRIPE_WIDTH * pairs;
+        for (int part = 0; part < 2; part++) {
+            for (; pairs > 0; pairs--) {
+                uint16x8_t n1 = load_line(line);
+                uint16x8_t n2 = load_line(line + STRIPE_WIDTH);
+                expand_func(&rp0, &rn0, p1, z0, n1);
+                expand_func(&rp1, &rn1, z0, n1, n2);
+                store_line(dst + 0 * STRIPE_WIDTH, rp0);
+                store_line(dst + 1 * STRIPE_WIDTH, rn0);
+                store_line(dst + 2 * STRIPE_WIDTH, rp1);
+                store_line(dst + 3 * STRIPE_WIDTH, rn1);
+                p1 = n1;
+                z0 = n2;
+                dst += 4 * STRIPE_WIDTH;
+                line += 2 * STRIPE_WIDTH;
+            }
+            line = zero_lines;
+            pairs = 1;
+        }
+    }
+}
+
+/*
+ * Main Parametric Filters
+ *
+ * Perform 1D convolution with kernel [..., c2, c1, c0, d, c0, c1, c2, ...],
+ * cN = param[N], d = 1 - 2 * (c0 + c1 + c2 + ...),
+ * number of parameters is part of the function name.
+ *
+ * The radius n is a constant in every instance: the taps are spelled out
+ * with FOR_EACH_TAP rather than left to the loop unroller.
+ *
+ * Up to radius 2 the taps are those of the C version,
+ *     center + ((sum(cN * (pixel - center)) + 0x8000) >> 16).
+ * Beyond that the pixels are multiplied as they are,
+ *     (sum(cN * pixel) + d * center + 0x8000) >> 16,
+ * which saves the subtractions and is the same as long as the differences
+ * fit into 16 bits, that is for pixels in [0, 0x7FFF].
+ */
+
+#define FOR_EACH_TAP(TAP) \
+    TAP(1) TAP(2) TAP(3) TAP(4) TAP(5) TAP(6) TAP(7) TAP(8)
+
+typedef struct {
+    int16x4_t coeff[8];
+    int32x4_t center;  // d, for n > 2
+} BlurParam;
+
+ALWAYS_INLINE BlurParam load_param(const int16_t *param, const int n)
+{
+    BlurParam res;
+    int32_t center = 0x10000;
+#define TAP(i) \
+    if (n >= i) { \
+        res.coeff[i - 1] = vdup_n_s16(param[i - 1]); \
+        center -= 2 * param[i - 1]; \
+    }
+    FOR_EACH_TAP(TAP)
+#undef TAP
+    res.center = vdupq_n_s32(center);
+    return res;
+}
+
+// sums of products for 8 pixels
+typedef struct {
+    int32x4_t lo, hi;
+} BlurAcc;
+
+// center only matters for n <= 2
+ALWAYS_INLINE void blur_tap(BlurAcc *acc, int16x8_t line, int16x8_t center,
+                            int16x4_t coeff, const int n)
+{
+    if (n <= 2)
+        line = vsubq_s16(line, center);
+    acc->lo = vmlal_s16(acc->lo, vget_low_s16(line), coeff);
+    acc->hi = vmlal_s16(acc->hi, vget_high_s16(line), coeff);
+}
+
+// the rounding of the narrowing shift is the 0x8000 the C version starts from
+ALWAYS_INLINE int16x8_t round_acc(BlurAcc acc)
+{
+    return vcombine_s16(vrshrn_n_s32(acc.lo, 16), vrshrn_n_s32(acc.hi, 16));
+}
+
+ALWAYS_INLINE void blur_center(BlurAcc *acc, int16x8_t center, const BlurParam *param)
+{
+    acc->lo = vmlaq_s32(acc->lo, vmovl_s16(vget_low_s16(center)), param->center);
+    acc->hi = vmlaq_s32(acc->hi, vmovl_s16(vget_high_s16(center)), param->center);
+}
+
+ALWAYS_INLINE int16x8_t blur_result(BlurAcc acc, int16x8_t center,
+                                    const BlurParam *param, const int n)
+{
+    if (n <= 2)
+        return vaddq_s16(center, round_acc(acc));
+    blur_center(&acc, center, param);
+    return round_acc(acc);
+}
+
+/*
+ * Pixels [k - pos] for k in a line of the current stripe (line2),
+ * line1 and line0 being the same line of the two stripes before it.
+ */
+ALWAYS_INLINE int16x8_t shift_line(int16x8_t line0, int16x8_t line1, int16x8_t line2,
+                                   const int pos)
+{
+    switch (pos) {
+    case  0: return line2;
+    case  1: return vextq_s16(line1, line2, 7);
+    case  2: return vextq_s16(line1, line2, 6);
+    case  3: return vextq_s16(line1, line2, 5);
+    case  4: return vextq_s16(line1, line2, 4);
+    case  5: return vextq_s16(line1, line2, 3);
+    case  6: return vextq_s16(line1, line2, 2);
+    case  7: return vextq_s16(line1, line2, 1);
+    case  8: return line1;
+    case  9: return vextq_s16(line0, line1, 7);
+    case 10: return vextq_s16(line0, line1, 6);
+    case 11: return vextq_s16(line0, line1, 5);
+    case 12: return vextq_s16(line0, line1, 4);
+    case 13: return vextq_s16(line0, line1, 3);
+    case 14: return vextq_s16(line0, line1, 2);
+    case 15: return vextq_s16(line0, line1, 1);
+    default: return line0;
+    }
+}
+
+ALWAYS_INLINE int16x8_t blur_horz_line(int16x8_t line0, int16x8_t line1, int16x8_t line2,
+                                       const BlurParam *param, const int n)
+{
+    int16x8_t center = shift_line(line0, line1, line2, n);
+    BlurAcc acc = { vdupq_n_s32(0), vdupq_n_s32(0) };
+#define TAP(i) \
+    if (n >= i) { \
+        blur_tap(&acc, shift_line(line0, line1, line2, n - i), center, param->coeff[i - 1], n); \
+        blur_tap(&acc, shift_line(line0, line1, line2, n + i), center, param->coeff[i - 1], n); \
+    }
+    FOR_EACH_TAP(TAP)
+#undef TAP
+    return blur_result(acc, center, param, n);
+}
+
+ALWAYS_INLINE void blur_horz(int16_t *restrict dst, const int16_t *restrict src,
+                             size_t src_width, size_t src_height,
+                             const int16_t *restrict param, const int n)
+{
+    size_t dst_width = src_width + 2 * n;
+    size_t dst_stripes = (dst_width + STRIPE_WIDTH - 1) / STRIPE_WIDTH;
+    size_t src_stripes = (src_width + STRIPE_WIDTH - 1) / STRIPE_WIDTH;
+    size_t step = STRIPE_WIDTH * src_height;
+    const BlurParam kernel = load_param(param, n);
+
+    /*
+     * A line of stripe x takes the same line of stripes x - 2 (n > 4), x - 1
+     * and x. Two stripes at a time, except for radius 8: that is as fast
+     * one by one, as the compiler runs out of registers.
+     */
+    size_t x = 0;
+    for (; n < 8 && x + 2 <= dst_stripes; x += 2) {
+        size_t inc0 = 0, inc1, inc2, inc3;
+        const int16_t *ptr0 = zero_lines;
+        if (n > 4)
+            ptr0 = get_stripe(src, x - 2, src_stripes, step, &inc0);
+        const int16_t *ptr1 = get_stripe(src, x - 1, src_stripes, step, &inc1);
+        const int16_t *ptr2 = get_stripe(src, x + 0, src_stripes, step, &inc2);
+        const int16_t *ptr3 = get_stripe(src, x + 1, src_stripes, step, &inc3);
+        for (size_t y = 0; y < src_height; y++) {
+            int16x8_t line1 = vld1q_s16(ptr1);
+            int16x8_t line2 = vld1q_s16(ptr2);
+            int16x8_t line3 = vld1q_s16(ptr3);
+            int16x8_t line0 = line1;
+            if (n > 4)
+                line0 = vld1q_s16(ptr0);
+            vst1q_s16(dst, blur_horz_line(line0, line1, line2, &kernel, n));
+            vst1q_s16(dst + step, blur_horz_line(line1, line2, line3, &kernel, n));
+            dst += STRIPE_WIDTH;
+            ptr0 += inc0;
+            ptr1 += inc1;
+            ptr2 += inc2;
+            ptr3 += inc3;
+        }
+        dst += step;
+    }
+    for (; x < dst_stripes; x++) {
+        size_t inc0 = 0, inc1, inc2;
+        const int16_t *ptr0 = zero_lines;
+        if (n > 4)
+            ptr0 = get_stripe(src, x - 2, src_stripes, step, &inc0);
+        const int16_t *ptr1 = get_stripe(src, x - 1, src_stripes, step, &inc1);
+        const int16_t *ptr2 = get_stripe(src, x - 0, src_stripes, step, &inc2);
+        for (size_t y = 0; y < src_height; y++) {
+            int16x8_t line1 = vld1q_s16(ptr1);
+            int16x8_t line2 = vld1q_s16(ptr2);
+            int16x8_t line0 = line1;
+            if (n > 4)
+                line0 = vld1q_s16(ptr0);
+            vst1q_s16(dst, blur_horz_line(line0, line1, line2, &kernel, n));
+            dst += STRIPE_WIDTH;
+            ptr0 += inc0;
+            ptr1 += inc1;
+            ptr2 += inc2;
+        }
+    }
+}
+
+// filters the line in the middle of 2 * n + 1 consecutive lines
+ALWAYS_INLINE int16x8_t blur_vert_line(const int16_t *line, const BlurParam *param, const int n)
+{
+    int16x8_t center = vld1q_s16(line + n * STRIPE_WIDTH);
+    BlurAcc acc = { vdupq_n_s32(0), vdupq_n_s32(0) };
+#define TAP(i) \
+    if (n >= i) { \
+        blur_tap(&acc, vld1q_s16(line + (n - i) * STRIPE_WIDTH), center, param->coeff[i - 1], n); \
+        blur_tap(&acc, vld1q_s16(line + (n + i) * STRIPE_WIDTH), center, param->coeff[i - 1], n); \
+    }
+    FOR_EACH_TAP(TAP)
+#undef TAP
+    return blur_result(acc, center, param, n);
+}
+
+typedef struct {
+    int16x8_t line[2];
+} BlurPair;
+
+/*
+ * Two lines at a time share all but two of the lines they load.
+ * Radius 3 is faster as two separate filters, the wider ones with
+ * each line multiplied for both of them right after it is loaded.
+ */
+ALWAYS_INLINE BlurPair blur_vert_pair(const int16_t *line, const BlurParam *param, const int n)
+{
+    BlurPair res;
+    if (n <= 3) {
+        res.line[0] = blur_vert_line(line, param, n);
+        res.line[1] = blur_vert_line(line + STRIPE_WIDTH, param, n);
+        return res;
+    }
+
+    BlurAcc acc0 = { vdupq_n_s32(0), vdupq_n_s32(0) }, acc1 = acc0;
+    // line k is tap k - n of the first filter and tap k - n - 1 of the second
+#define LINE(k) \
+    if (k <= 2 * n + 1) { \
+        int16x8_t cur = vld1q_s16(line + k * STRIPE_WIDTH); \
+        if (k < n) \
+            blur_tap(&acc0, cur, cur, param->coeff[n - k - 1], n); \
+        if (k == n) \
+            blur_center(&acc0, cur, param); \
+        if (k > n && k <= 2 * n) \
+            blur_tap(&acc0, cur, cur, param->coeff[k - n - 1], n); \
+        if (k >= 1 && k <= n) \
+            blur_tap(&acc1, cur, cur, param->coeff[n - k], n); \
+        if (k == n + 1) \
+            blur_center(&acc1, cur, param); \
+        if (k > n + 1) \
+            blur_tap(&acc1, cur, cur, param->coeff[k - n - 2], n); \
+    }
+    LINE(0) LINE(1) LINE(2) LINE(3) LINE(4) LINE(5) LINE(6) LINE(7) LINE(8)
+    LINE(9) LINE(10) LINE(11) LINE(12) LINE(13) LINE(14) LINE(15) LINE(16) LINE(17)
+#undef LINE
+    res.line[0] = round_acc(acc0);
+    res.line[1] = round_acc(acc1);
+    return res;
+}
+
+ALWAYS_INLINE void blur_vert(int16_t *restrict dst, const int16_t *restrict src,
+                             size_t src_width, size_t src_height,
+                             const int16_t *restrict param, const int n)
+{
+    size_t step = STRIPE_WIDTH * src_height;
+    const BlurParam kernel = load_param(param, n);
+
+    /*
+     * Every output line takes 2 * n + 1 consecutive lines, of which those
+     * outside of the image are zeros. Lines close to the top and the bottom
+     * of a stripe are filtered from a padded copy, the lines between them
+     * right from the stripe:
+     *     [2 * n zero lines] [first 2 * n + 1 lines]
+     *     [last 2 * n lines] [2 * n zero lines]
+     * With the first copy taking one more line of a stripe of odd height,
+     * each of the three parts is an even number of lines.
+     * A stripe of up to 2 * n lines takes the place of the first lines,
+     * what follows it stays zero.
+     */
+    enum { MAX_TAPS = 2 * 8 };
+    int16_t buf[(4 * MAX_TAPS + 1) * STRIPE_WIDTH];
+    const size_t taps = 2 * n, edge = taps * STRIPE_WIDTH;
+    int16_t *const top = buf + edge, *const bottom = top + edge + STRIPE_WIDTH;
+    memset(buf, 0, (4 * edge + STRIPE_WIDTH) * sizeof(buf[0]));
+
+    for (size_t x = 0; x < src_width; x += STRIPE_WIDTH) {
+        const int16_t *ptr[3];
+        size_t len[3];
+        int count;
+        if (src_height > taps) {
+            size_t odd = src_height & 1;
+            memcpy(top, src, (edge + STRIPE_WIDTH) * sizeof(buf[0]));
+            memcpy(bottom, src + step - edge, edge * sizeof(buf[0]));
+            ptr[0] = buf;
+            len[0] = taps + odd;
+            ptr[1] = src + odd * STRIPE_WIDTH;
+            len[1] = src_height - taps - odd;
+            ptr[2] = bottom;
+            len[2] = taps;
+            count = 3;
+        } else {
+            memcpy(top, src, step * sizeof(buf[0]));
+            ptr[0] = buf;
+            len[0] = src_height + taps;
+            count = 1;
+        }
+        for (int part = 0; part < count; part++) {
+            const int16_t *line = ptr[part];
+            size_t y = len[part];
+            for (; y >= 2; y -= 2) {
+                BlurPair res = blur_vert_pair(line, &kernel, n);
+                vst1q_s16(dst, res.line[0]);
+                vst1q_s16(dst + STRIPE_WIDTH, res.line[1]);
+                dst += 2 * STRIPE_WIDTH;
+                line += 2 * STRIPE_WIDTH;
+            }
+            for (; y > 0; y--) {
+                vst1q_s16(dst, blur_vert_line(line, &kernel, n));
+                dst += STRIPE_WIDTH;
+                line += STRIPE_WIDTH;
+            }
+        }
+        src += step;
+    }
+}
+
+/*
+ * The vertical filters of radius 1 and 2 walk down a stripe and keep
+ * the products of the lines above. With
+ *     a[y] = param[0] * (line[y - 1] - line[y - 2]),
+ *     b[y] = param[1] * (line[y - 0] - line[y - 2]),
+ * the four taps of out[y], which is centered at line[y - 2], add up to
+ *     a[y] - a[y - 1] + b[y] - b[y - 2]:
+ * a line above the center gives the negative of a difference that is
+ * multiplied already (for pixels in [0, 0x7FFF], where no difference
+ * is -0x8000). Radius 1 has
+ *     a[y] = param[0] * (line[y] - line[y - 1]), out[y] from a[y] - a[y - 1].
+ * The lines of a stripe are followed by 2 * n zero lines.
+ */
+
+ALWAYS_INLINE BlurAcc mul_line(int16x8_t line, int16x4_t coeff)
+{
+    BlurAcc res = { vmull_s16(vget_low_s16(line), coeff), vmull_s16(vget_high_s16(line), coeff) };
+    return res;
+}
+
+/*
+ * A sum of two products cannot saturate for pixels in [0, 0x7FFF].
+ * A regular addition would be merged with the multiplications,
+ * and every product would be calculated once per use.
+ */
+ALWAYS_INLINE BlurAcc add_products(BlurAcc a, BlurAcc b)
+{
+    BlurAcc res = { vqaddq_s32(a.lo, b.lo), vqaddq_s32(a.hi, b.hi) };
+    return res;
+}
+
+// center + ((a - b + 0x8000) >> 16)
+ALWAYS_INLINE int16x8_t blur_diff_result(BlurAcc a, BlurAcc b, int16x8_t center)
+{
+    return vaddq_s16(center, vcombine_s16(vrsubhn_s32(a.lo, b.lo), vrsubhn_s32(a.hi, b.hi)));
+}
+
+void ass_blur1_vert16_neon(int16_t *restrict dst, const int16_t *restrict src,
+                           size_t src_width, size_t src_height,
+                           const int16_t *restrict param)
+{
+    const int16x4_t coeff = vdup_n_s16(param[0]);
+    const BlurAcc zero = { vdupq_n_s32(0), vdupq_n_s32(0) };
+
+    for (size_t x = 0; x < src_width; x += STRIPE_WIDTH) {
+        int16x8_t prev = vdupq_n_s16(0);  // line[y - 1]
+        BlurAcc a = zero;                 // a[y - 1]
+        if (src_height & 1) {
+            // make the rest an even number of lines
+            prev = vld1q_s16(src);
+            a = mul_line(prev, coeff);
+            vst1q_s16(dst, round_acc(a));
+            dst += STRIPE_WIDTH;
+            src += STRIPE_WIDTH;
+        }
+        const int16_t *line = src;
+        size_t pairs = src_height / 2;
+        src += 2 * STRIPE_WIDTH * pairs;
+        for (int part = 0; part < 2; part++) {
+            for (; pairs > 0; pairs--) {
+                int16x8_t line0 = vld1q_s16(line);
+                int16x8_t line1 = vld1q_s16(line + STRIPE_WIDTH);
+                BlurAcc a0 = mul_line(vsubq_s16(line0, prev), coeff);
+                BlurAcc a1 = mul_line(vsubq_s16(line1, line0), coeff);
+                vst1q_s16(dst, blur_diff_result(a0, a, prev));
+                vst1q_s16(dst + STRIPE_WIDTH, blur_diff_result(a1, a0, line0));
+                prev = line1;
+                a = a1;
+                dst += 2 * STRIPE_WIDTH;
+                line += 2 * STRIPE_WIDTH;
+            }
+            line = zero_lines;
+            pairs = 1;
+        }
+    }
+}
+
+void ass_blur2_vert16_neon(int16_t *restrict dst, const int16_t *restrict src,
+                           size_t src_width, size_t src_height,
+                           const int16_t *restrict param)
+{
+    const int16x4_t coeff0 = vdup_n_s16(param[0]), coeff1 = vdup_n_s16(param[1]);
+    const BlurAcc zero = { vdupq_n_s32(0), vdupq_n_s32(0) };
+
+    for (size_t x = 0; x < src_width; x += STRIPE_WIDTH) {
+        int16x8_t prev2 = vdupq_n_s16(0), prev1 = prev2;  // line[y - 2], line[y - 1]
+        BlurAcc neg = zero, b = zero;  // a[y - 1] + b[y - 2], b[y - 1]
+        if (src_height & 1) {
+            // make the rest an even number of lines
+            prev1 = vld1q_s16(src);
+            b = mul_line(prev1, coeff1);
+            vst1q_s16(dst, round_acc(b));
+            dst += STRIPE_WIDTH;
+            src += STRIPE_WIDTH;
+        }
+        const int16_t *line = src;
+        size_t pairs = src_height / 2;
+        src += 2 * STRIPE_WIDTH * pairs;
+        for (int part = 0; part < 2; part++) {
+            for (; pairs > 0; pairs--) {
+                int16x8_t line0 = vld1q_s16(line);
+                int16x8_t line1 = vld1q_s16(line + STRIPE_WIDTH);
+                BlurAcc a0 = mul_line(vsubq_s16(prev1, prev2), coeff0);
+                BlurAcc b0 = mul_line(vsubq_s16(line0, prev2), coeff1);
+                BlurAcc a1 = mul_line(vsubq_s16(line0, prev1), coeff0);
+                BlurAcc b1 = mul_line(vsubq_s16(line1, prev1), coeff1);
+                vst1q_s16(dst, blur_diff_result(add_products(a0, b0), neg, prev2));
+                neg = add_products(a0, b);
+                vst1q_s16(dst + STRIPE_WIDTH, blur_diff_result(add_products(a1, b1), neg, prev1));
+                neg = add_products(a1, b0);
+                b = b1;
+                prev2 = line0;
+                prev1 = line1;
+                dst += 2 * STRIPE_WIDTH;
+                line += 2 * STRIPE_WIDTH;
+            }
+            line = zero_lines;
+            pairs = 2;
+        }
+    }
+}
+
+#define DEFINE_BLUR(dir, n) \
+    void ass_blur ## n ## _ ## dir ## 16_neon(int16_t *restrict dst, const int16_t *restrict src, \
+                                              size_t src_width, size_t src_height, \
+                                              const int16_t *restrict param) \
+    { \
+        blur_ ## dir(dst, src, src_width, src_height, param, n); \
+    }
+
+DEFINE_BLUR(horz, 1)
+DEFINE_BLUR(horz, 2)
+DEFINE_BLUR(horz, 3)
+DEFINE_BLUR(vert, 3)
+DEFINE_BLUR(horz, 4)
+DEFINE_BLUR(vert, 4)
+DEFINE_BLUR(horz, 5)
+DEFINE_BLUR(vert, 5)
+DEFINE_BLUR(horz, 6)
+DEFINE_BLUR(vert, 6)
+DEFINE_BLUR(horz, 7)
+DEFINE_BLUR(vert, 7)
+DEFINE_BLUR(horz, 8)
+DEFINE_BLUR(vert, 8)
