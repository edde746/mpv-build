+
+/**
+ * \brief Copy the shaped glyphs out of buf.
+ */
+static ShapedGlyph *copy_shaped_glyphs(hb_buffer_t *buf, unsigned *count)
+{
+    unsigned n = hb_buffer_get_length(buf);
+    hb_glyph_info_t *glyph_info = hb_buffer_get_glyph_infos(buf, NULL);
+    hb_glyph_position_t *pos = hb_buffer_get_glyph_positions(buf, NULL);
+
+    ShapedGlyph *shaped = malloc(FFMAX(n, 1) * sizeof(*shaped));
+    if (!shaped)
+        return NULL;
+    for (unsigned j = 0; j < n; j++) {
+        shaped[j] = (ShapedGlyph) {
+            .glyph_index = glyph_info[j].codepoint,
+            .cluster = glyph_info[j].cluster,
+            .x_advance = pos[j].x_advance,
+            .y_advance = pos[j].y_advance,
+            .x_offset = pos[j].x_offset,
+            .y_offset = pos[j].y_offset,
+        };
+    }
+    *count = n;
+    return shaped;
