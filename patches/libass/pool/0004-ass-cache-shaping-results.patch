+static bool feature_bits(ASS_Shaper *shaper, unsigned *bits)
+{
+    unsigned b = 0;
+    for (int i = 0; i < shaper->n_features; i++) {
+        if (shaper->features[i].value > 1)
+            return false;
+        b |= shaper->features[i].value << i;
+    }
+    *bits = b;
+    return true;
