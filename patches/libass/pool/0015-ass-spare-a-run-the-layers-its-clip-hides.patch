diff --git a/libass/ass_blur.c b/libass/ass_blur.c
index c663802..e649646 100644
--- a/libass/ass_blur.c
+++ b/libass/ass_blur.c
@@ -191,6 +191,23 @@ static void find_best_method(BlurMethod *blur, double r2, bool fast)
             blur->radius--;
 }
 
+/**
+ * \brief How far ass_gaussian_blur() can spread a bitmap, in pixels a side
+ * \param r2 in: desired standard deviation squared
+ *
+ * An upper bound, without the cost of the method itself: that of the widest
+ * kernel at the level find_best_method() picks.
+ */
+int ass_blur_reach(double r2)
+{
+    int level = 0;
+    if (r2 >= 0.5)
+        frexp(sqrt(0.11569 * r2 + 0.20591047), &level);
+    // (radius + 4 << level) - 4 before the bitmap, no more than
+    // (radius + 5 << level) - 5 after
+    return (8 + 5) << level;
+}
+
