+static inline bool rect_in_clip(const ASS_Rect *rect, const ASS_Rect *clip)
+{
+    return rect->x_min < clip->x_max && rect->x_max > clip->x_min &&
+           rect->y_min < clip->y_max && rect->y_max > clip->y_min;
+}
+
+/**
+ * \brief Spare a run the layers its clip hides whole
+ *
+ * render_glyph() makes no image of a bitmap that lies outside the clip
+ * rectangle, but by then the run has been combined and blurred, and its shadow
+ * copied and shifted. Text that has left the screen under a \move, and a
+ * shadow that an effect throws far off (\t(\yshad-4500)) to leave the next
+ * three seconds to a fill of alpha FE, cost that for every frame.
+ *
+ * With all of the run outside the clip it gets no composite (the run's
+ * bitmap_count is set to 0), with only its shadow outside none of that:
+ * fill and border are the same bitmaps with a shadow and without.
+ */
+static void drop_clipped_layers(RenderContext *state, CombinedBitmapInfo *info)
+{
+    ASS_Renderer *render_priv = state->renderer;
+    FilterDesc *filter = &info->filter;
+    if (state->clip_mode)   // \iclip: what is outside the rectangle is what shows
+        return;
+
+    // the clip as render_glyph() applies it
+    ASS_Rect clip = {
+        FFMINMAX(state->clip_x0, 0, render_priv->width),
+        FFMINMAX(state->clip_y0, 0, render_priv->height),
+        FFMINMAX(state->clip_x1, 0, render_priv->width),
+        FFMINMAX(state->clip_y1, 0, render_priv->height),
+    };
+    ASS_Rect rect;
+    rectangle_reset(&rect);
+    for (int i = 0; i < info->bitmap_count; i++) {
+        BitmapRef *ref = &info->bitmaps[i];
+        if (ref->bm)
+            rectangle_combine(&rect, ref->bm, ref->pos);
+        if (ref->bm_o)
+            rectangle_combine(&rect, ref->bm_o, ref->pos_o);
+    }
+    rect.x_min += info->x;  rect.x_max += info->x;
+    rect.y_min += info->y;  rect.y_max += info->y;
+
+    bool shadow = filter->flags & FILTER_NONZERO_SHADOW;
+    // the shift by the fraction of a pixel stays inside the bitmap
+    int shadow_x = filter->shadow.x >> 6, shadow_y = filter->shadow.y >> 6;
+    ASS_Rect rect_s = {
+        rect.x_min + shadow_x, rect.y_min + shadow_y,
+        rect.x_max + shadow_x, rect.y_max + shadow_y,
+    };
+    if (rect_in_clip(&rect, &clip) && (!shadow || rect_in_clip(&rect_s, &clip)))
+        return;
+
+    // Outside as they are: and with what \be and the blur add around them?
+    double r2x = restore_blur(filter->blur_x), r2y = restore_blur(filter->blur_y);
+    int pad_x = ass_be_padding(filter->be), pad_y = pad_x;
+    if (ass_blur_is_gaussian(r2x, r2y)) {
+        pad_x += ass_blur_reach(r2x);
+        pad_y += ass_blur_reach(r2y);
+    }
+    rect.x_min -= pad_x;  rect.x_max += pad_x;
+    rect.y_min -= pad_y;  rect.y_max += pad_y;
+    rect_s.x_min -= pad_x;  rect_s.x_max += pad_x;
+    rect_s.y_min -= pad_y;  rect_s.y_max += pad_y;
+
+    bool seen = rect_in_clip(&rect, &clip);
+    bool shadow_seen = shadow && rect_in_clip(&rect_s, &clip);
+    if (!seen && !shadow_seen) {
+        info->bitmap_count = 0;
+    } else if (shadow && !shadow_seen && !(filter->flags & FILTER_BORDER_STYLE_3)) {
+        // (an opaque box without a border is drawn as its own shadow)
+        filter->flags &= ~(FILTER_NONZERO_SHADOW | FILTER_FILL_IN_SHADOW);
+        filter->shadow.x = filter->shadow.y = 0;
+    }
+}
+
 // One of a composite's two bitmaps (the glyphs or their outlines): the key's
 // bitmaps of that kind added up, then blurred if `blur` is set.
 //
