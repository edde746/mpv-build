+#if defined(__linux__) && HAVE_SCHED_GETAFFINITY && defined(CPU_COUNT)
+// How fast a CPU is next to the others: the scheduler's capacity where the
+// kernel has one (ARM), else its highest frequency. 0 if unknown.
+static inline long cpu_capacity(int cpu)
+{
+    static const char *const files[] = { "cpu_capacity", "cpufreq/cpuinfo_max_freq" };
+    for (int i = 0; i < 2; i++) {
+        char path[80];
+        snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%d/%s", cpu, files[i]);
+        FILE *fp = fopen(path, "r");
+        if (!fp)
+            continue;
+        long value = 0;
+        if (fscanf(fp, "%ld", &value) != 1)
+            value = 0;
+        fclose(fp);
+        if (value > 0)
+            return value;
+    }
+    return 0;
+}
+
+// The CPUs of the set that are at least three quarters as fast as its
+// fastest, or 0 if that cannot be told. A frame is done when its slowest
+// event is, and with a thread per core that is whichever event a little core
+// picked up, at whatever frequency that core idles: on a phone with 2 big,
+// 2 medium and 4 little cores, 8 threads finish fewer frames in time than 2
+// do, on half as much CPU time again. Medium cores close to the big ones
+// do count.
+static inline unsigned cpus_near_fastest(const cpu_set_t *cpuset)
+{
+    enum { MAX_CPUS = 256 };
+    long highest = 0;
+    unsigned count = 0;
+    for (int pass = 0; pass < 2; pass++) {
+        for (int cpu = 0; cpu < MAX_CPUS && cpu < CPU_SETSIZE; cpu++) {
+            if (!CPU_ISSET(cpu, cpuset))
+                continue;
+            long capacity = cpu_capacity(cpu);
+            if (capacity <= 0)
+                return 0;
+            if (!pass && capacity > highest)
+                highest = capacity;
+            if (pass && capacity >= highest - highest / 4)
+                count++;
+        }
+    }
+    return count;
+}
+#endif
+
 static inline unsigned default_threads(void)
 {
     if (getenv("LIBASS_NO_THREADS"))
@@ -330,8 +382,14 @@ static inline unsigned default_threads(void)
 #if HAVE_SCHED_GETAFFINITY && defined(CPU_COUNT)
     cpu_set_t cpuset;
     CPU_ZERO(&cpuset);
-    if (!sched_getaffinity(0, sizeof(cpuset), &cpuset))
+    if (!sched_getaffinity(0, sizeof(cpuset), &cpuset)) {
+#ifdef __linux__
+        unsigned fast = cpus_near_fastest(&cpuset);
+        if (fast)
+            return fast;
+#endif
         return CPU_COUNT(&cpuset);
+    }
