+// Whether ass_render_event() will only clone the image list the event's
+// snapshot holds (its own checks, without the restore).
+static bool event_images_cached(ASS_Renderer *render_priv, ASS_Event *event)
+{
+    RenderPriv *rp = event->render_priv;
+    return rp && rp->render_id == render_priv->render_id && rp->layout &&
+        rp->layout->owner == render_priv &&
+        rp->layout->gen == render_priv->layout_gen && rp->layout->images_cached;
+}
