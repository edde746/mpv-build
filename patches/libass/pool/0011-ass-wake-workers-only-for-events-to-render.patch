-    bool parallel = cnt >= MIN_THREADED_EVENTS;
+    // Worth other threads only with two or more events to actually render.
+    // An event whose images are cached from its last frame is handed out
+    // again in microseconds, and a still sign with a line of dialogue over
+    // it, the common frame, would otherwise wake a worker 24 times a second
+    // for nothing.
+    int to_render = 0;
+    for (int i = 0; i < cnt; i++)
