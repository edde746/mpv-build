+// Undo the ass_alloc_event() that returned the last event.
+static void discard_last_event(ASS_Track *track)
+{
+    ass_free_event(track, track->n_events - 1);
+    track->n_events--;
+    track->parser_priv->seen_events = track->n_events;
+}
+
+static void describe_events(const ASS_Event *events, int count, EventBlock *block)
+{
+    long long min_start = LLONG_MAX, max_end = LLONG_MIN;
+    for (int i = 0; i < count; i++) {
+        long long start = events[i].Start, end = start + events[i].Duration;
+        if (start < min_start)
+            min_start = start;
+        if (end > max_end)
+            max_end = end;
+    }
+    block->min_start = min_start;
+    block->max_end = max_end;
+}
+
+// Shorter tracks are walked whole: the blocks would save nothing.
+#define EVENT_INDEX_MIN_EVENTS (8 * EVENT_BLOCK_SIZE)
+// Share of the blocks described anew by every call.
+#define EVENT_RECHECK_SHIFT 5
+
+const EventBlock *ass_event_blocks(ASS_Track *track)
+{
+    ASS_ParserPriv *priv = track->parser_priv;
+    int n_events = track->n_events;
+
+    if (n_events < EVENT_INDEX_MIN_EVENTS) {
+        priv->indexed_events = 0;
+        priv->seen_events = n_events;
+        return NULL;
+    }
+
+    int n_blocks = (n_events + EVENT_BLOCK_SIZE - 1) >> EVENT_BLOCK_ORDER;
+    if (n_blocks > priv->event_blocks_size) {
+        int size = FFMAX(n_blocks, 2 * priv->event_blocks_size);
+        EventBlock *blocks = ass_try_realloc_array(priv->event_blocks, size, sizeof(*blocks));
+        if (!blocks) {
+            priv->indexed_events = 0;
+            priv->seen_events = n_events;
+            return NULL;
+        }
+        priv->event_blocks = blocks;
+        priv->event_blocks_size = size;
+    }
+
+    // Events come and go through libass (which counts them) or by the caller
+    // editing the array, which shows as another array or another count.
+    if (track->events != priv->indexed_array || n_events != priv->seen_events ||
+            n_events < priv->indexed_events)
+        priv->indexed_events = 0;
+    priv->indexed_array = track->events;
+    priv->seen_events = n_events;
+
+    // New events, and always the last two blocks: a caller that fills in
+    // an event after ass_alloc_event(), or settles the duration of the
+    // newest ones later, does it there.
+    int first = priv->indexed_events >> EVENT_BLOCK_ORDER;
+    first = FFMIN(first, FFMAX(n_blocks - 2, 0));
+    for (int b = first; b < n_blocks; b++) {
+        int start = b << EVENT_BLOCK_ORDER;
+        describe_events(track->events + start,
+                        FFMIN(EVENT_BLOCK_SIZE, n_events - start),
+                        priv->event_blocks + b);
+    }
+    priv->indexed_events = n_events;
+
+    // ASS_Track is a public struct, and nothing tells libass of a write to an
+    // older event's Start or Duration. A span that got shorter only costs a
+    // look at its block; for one that grew or moved, describe a share of the
+    // blocks again each time, so that such a write is honored after
+    // (1 << EVENT_RECHECK_SHIFT) frames at the latest.
+    int recheck = (first >> EVENT_RECHECK_SHIFT) + 1;
+    for (int i = 0; i < recheck && first > 0; i++) {
+        int b = priv->recheck_block % first;
+        priv->recheck_block = b + 1;
+        describe_events(track->events + (b << EVENT_BLOCK_ORDER),
+                        EVENT_BLOCK_SIZE, priv->event_blocks + b);
+    }
+
+    return priv->event_blocks;
+}
+
