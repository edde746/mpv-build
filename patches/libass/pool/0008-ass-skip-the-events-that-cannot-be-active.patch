diff --git a/libass/ass_priv.h b/libass/ass_priv.h
index ac6ec50..1f425cb 100644
--- a/libass/ass_priv.h
+++ b/libass/ass_priv.h
@@ -68,6 +68,35 @@ struct parser_priv {
 
     long long prune_delay;
     long long prune_next_ts;
+
+    // Time index over the events array, see ass_event_blocks().
+    struct event_block *event_blocks;
+    int event_blocks_size;      // allocated entries
+    int indexed_events;         // leading events the blocks describe
+    ASS_Event *indexed_array;   // track->events when they were described
+    int seen_events;            // n_events as libass itself last left it
+    int recheck_block;          // where the next frame's recheck starts
 };
 
+// The events array in blocks of EVENT_BLOCK_SIZE, each with the time span its
+// events cover, so that a frame only walks the blocks that can hold an active
+// event: a track of frame-by-frame typesetting has tens of thousands of
+// events, and reading all of them for every frame costs more than rendering
+// the two or three that are visible.
+#define EVENT_BLOCK_ORDER 6
+#define EVENT_BLOCK_SIZE (1 << EVENT_BLOCK_ORDER)
+
+typedef struct event_block {
+    long long min_start, max_end;
+} EventBlock;
+
+/**
+ * \brief The track's event blocks, brought up to date.
+ * Block b describes events [b * EVENT_BLOCK_SIZE, (b + 1) * EVENT_BLOCK_SIZE):
+ * none of them is active at a time outside [min_start, max_end).
+ * \return the blocks, or NULL if every event has to be looked at
+ * (a short track, or no memory)
+ */
+const EventBlock *ass_event_blocks(ASS_Track *track);
+
 #endif /* LIBASS_PRIV_H */
