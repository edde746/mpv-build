ass: shift shadows without a dependency from pixel to pixel

ass_shift_bitmap moves a shadow by the fraction of a pixel: every pixel
passes shift/64 of its value on to its right, then to its lower neighbor.
It did so in place, pixel by pixel, each step reading what the step before
had written, and for the vertical pass column by column, a cache line per
pixel. No target has SIMD for it. A shadow that moves (\t with \xshad or
\yshad) or sits under frame-by-frame typesetting is shifted anew for every
frame; over the ten heaviest seconds of one episode, a block of text with
an animated shadow, it was 43% of the host's rendering time.

The result of a pass is out[i] = in[i] - (in[i] * shift >> 6) +
(in[i - 1] * shift >> 6) in 8-bit arithmetic, without the second term for
the first pixel and without the first for the last. Written that way, from
the last pixel (row) to the first, each direction is one pass over the
rows with nothing carried from one pixel to the next, which every compiler
vectorizes. Byte-identical with the old loops over 400000 random bitmaps
of every size and shift.

diff --git a/libass/ass_bitmap.c b/libass/ass_bitmap.c
index fbad654..42d89cc 100644
--- a/libass/ass_bitmap.c
+++ b/libass/ass_bitmap.c
@@ -263,6 +263,16 @@ void ass_fix_outline(Bitmap *bm_g, Bitmap *bm_o)
 /**
  * \brief Shift a bitmap by the fraction of a pixel in x and y direction
  * expressed in 26.6 fixed point
+ *
+ * Every pixel passes shift / 64 of its value on to its right (lower)
+ * neighbor, in 8-bit arithmetic:
+ *     out[i] = in[i] - (in[i] * shift >> 6) + (in[i - 1] * shift >> 6),
+ * where the first pixel of a row (column) receives nothing and the last one
+ * passes nothing on. Each direction is one pass over the rows from the last
+ * pixel (row) to the first, which only ever reads pixels (rows) that are
+ * still unchanged, so the loops have no dependency from one pixel to the
+ * next and compile to vector code. A shadow that moves, or sits under
+ * frame-by-frame typesetting, is shifted anew for every frame.
  */
 void ass_shift_bitmap(Bitmap *bm, int shift_x, int shift_y)
 {
@@ -276,22 +286,30 @@ void ass_shift_bitmap(Bitmap *bm, int shift_x, int shift_y)
     uint8_t *buf = bm->buffer;
 
     // Shift in x direction
-    if (shift_x)
+    if (shift_x && w > 1)
         for (int32_t y = 0; y < h; y++) {
-            for (int32_t x = w - 1; x > 0; x--) {
-                uint8_t b = buf[x + y * s - 1] * shift_x >> 6;
-                buf[x + y * s - 1] -= b;
-                buf[x + y * s] += b;
-            }
+            uint8_t *row = buf + y * s;
+            row[w - 1] += (uint8_t) (row[w - 2] * shift_x >> 6);
+            for (int32_t x = w - 2; x > 0; x--)
+                row[x] += (uint8_t) (row[x - 1] * shift_x >> 6) -
+                          (uint8_t) (row[x] * shift_x >> 6);
+            row[0] -= (uint8_t) (row[0] * shift_x >> 6);
         }
 
     // Shift in y direction
-    if (shift_y)
-        for (int32_t x = 0; x < w; x++) {
-            for (int32_t y = h - 1; y > 0; y--) {
-                uint8_t b = buf[x + y * s - s] * shift_y >> 6;
-                buf[x + y * s - s] -= b;
-                buf[x + y * s] += b;
-            }
+    if (shift_y && h > 1) {
+        uint8_t *restrict last = buf + (h - 1) * s;
+        const uint8_t *restrict above = last - s;
+        for (int32_t x = 0; x < w; x++)
+            last[x] += (uint8_t) (above[x] * shift_y >> 6);
+        for (int32_t y = h - 2; y > 0; y--) {
+            uint8_t *restrict row = buf + y * s;
+            const uint8_t *restrict prev = row - s;
+            for (int32_t x = 0; x < w; x++)
+                row[x] += (uint8_t) (prev[x] * shift_y >> 6) -
+                          (uint8_t) (row[x] * shift_y >> 6);
         }
+        for (int32_t x = 0; x < w; x++)
+            buf[x] -= (uint8_t) (buf[x] * shift_y >> 6);
+    }
 }
