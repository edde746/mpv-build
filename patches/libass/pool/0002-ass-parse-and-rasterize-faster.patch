+static inline bool parse_simple_hex_tag(char *str, int32_t *value)
+{
+    char *p = str;
+    while (*p == ' ' || *p == '\t' || *p == '\n' ||
+            *p == '\v' || *p == '\f' || *p == '\r')
+        p++;
+    if (*p == '+' || *p == '-' || (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')))
+        return false;
+
+    int32_t result = 0;
+    while (1) {
+        int digit;
+        if (*p >= '0' && *p <= '9')
+            digit = *p - '0';
+        else if (*p >= 'a' && *p <= 'f')
+            digit = *p - 'a' + 10;
+        else if (*p >= 'A' && *p <= 'F')
+            digit = *p - 'A' + 10;
+        else
+            break;
+        if (result > (INT32_MAX - digit) / 16)
+            return false;
+        result = 16 * result + digit;
+        p++;
+    }
+    *value = result;
+    return true;
+}
