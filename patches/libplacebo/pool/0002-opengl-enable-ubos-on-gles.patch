diff --git a/src/dispatch.c b/src/dispatch.c
index a593f25..9efb4f4 100644
--- a/src/dispatch.c
+++ b/src/dispatch.c
@@ -207,16 +207,30 @@ static bool add_pass_var(pl_dispatch dp, void *tmp, struct pass *pass,
         return true;
 
     int num_locs = sv->var.dim_v * sv->var.dim_m * sv->var.dim_a;
+    // GLSL ES packing (spec appendix A) gives every array element and matrix
+    // column a full vec4 row, so count 4 components per row for those; e.g.
+    // a uint[2160] costs 2160 rows, not 540 (Tegra's row budget is 1024)
+    if (gpu->glsl.gles && (sv->var.dim_a > 1 || sv->var.dim_m > 1))
+        num_locs = 4 * sv->var.dim_m * sv->var.dim_a;
     bool can_var = pass->num_var_locs + num_locs <= gpu->limits.max_variable_comps;
 
     // Attempt using uniform buffer next. The GLSL version 440 check is due
     // to explicit offsets on UBO entries. In theory we could leave away
     // the offsets and support UBOs for older GL as well, but this is a nice
     // safety net for driver bugs (and also rules out potentially buggy drivers)
+    // On GLES there is no explicit-offset support at all, but std140 layout
+    // is well-defined from 3.0, so rely on it there (add_buffer_vars already
+    // emits the members offset-sorted and without explicit offsets)
     // Also avoid UBOs for highly dynamic stuff since that requires synchronizing
     // the UBO writes every frame
-    bool try_ubo = !can_var || !sv->dynamic;
-    if (try_ubo && gpu->glsl.version >= 440 && gpu->limits.max_ubo_size) {
+    //
+    // On GLES, additionally prefer plain uniforms whenever they fit: mobile
+    // drivers have historically only seen the plain-uniform path from GL
+    // video renderers, so route only oversized arrays through the UBO
+    bool try_ubo = !can_var || (!sv->dynamic && !gpu->glsl.gles);
+    bool ubo_ok = gpu->glsl.version >= 440 ||
+                  (gpu->glsl.gles && gpu->glsl.version >= 300);
+    if (try_ubo && ubo_ok && gpu->limits.max_ubo_size) {
         if (sh_buf_desc_append(tmp, gpu, &pass->ubo_desc, &pv->layout, sv->var)) {
             pv->type = PASS_VAR_UBO;
             return true;
