diff --git a/libavcodec/mediacodec_wrapper.h b/libavcodec/mediacodec_wrapper.h
index 2170f33..1552491 100644
--- a/libavcodec/mediacodec_wrapper.h
+++ b/libavcodec/mediacodec_wrapper.h
@@ -115,6 +115,12 @@ static inline int ff_AMediaFormat_getFloat(FFAMediaFormat* format, const char *n
     return format->getFloat(format, name, out);
 }
 
+/**
+ * Copy out the byte buffer stored under name. On success *data is an
+ * av_malloc()ed copy of its remaining bytes, which the caller frees with
+ * av_free(), and *size their count. Returns 0, leaving *data NULL, when the
+ * key is missing, the buffer is empty or it cannot be read.
+ */
 static inline int ff_AMediaFormat_getBuffer(FFAMediaFormat* format, const char *name, void** data, size_t *size)
 {
     return format->getBuffer(format, name, data, size);
diff --git a/libavcodec/mediacodecdec_common.c b/libavcodec/mediacodecdec_common.c
index 0afdc0b..3c29287 100644
--- a/libavcodec/mediacodecdec_common.c
+++ b/libavcodec/mediacodecdec_common.c
@@ -26,6 +26,7 @@
 #include "libavutil/avassert.h"
 #include "libavutil/common.h"
 #include "libavutil/hwcontext_mediacodec.h"
+#include "libavutil/intreadwrite.h"
 #include "libavutil/mem.h"
 #include "libavutil/log.h"
 #include "libavutil/pixfmt.h"
@@ -453,6 +454,73 @@ static int64_t mediacodec_dec_input_time_find(const MediaCodecDecContext *s, int
     return best_ns;
 }
 
+// Whether the caller prefers the container's side data of this type over what
+// the decoder reads from the bitstream: AVCodecContext.side_data_prefer_packet,
+// where a lone -1 means every type.
+static int mediacodec_dec_prefer_packet(const AVCodecContext *avctx, enum AVPacketSideDataType type)
+{
+    if (avctx->nb_side_data_prefer_packet == 1 && avctx->side_data_prefer_packet[0] == -1)
+        return 1;
+    for (unsigned i = 0; i < avctx->nb_side_data_prefer_packet; i++)
+        if (avctx->side_data_prefer_packet[i] == (int)type)
+            return 1;
+    return 0;
+}
+
+static int mediacodec_dec_copy_coded(AVFrame *frame, enum AVFrameSideDataType type,
+                                     const AVPacketSideData *src)
+{
+    AVFrameSideData *dst = av_frame_new_side_data(frame, type, src->size);
+
+    if (!dst)
+        return AVERROR(ENOMEM);
+    memcpy(dst->data, src->data, src->size);
+    return 0;
+}
+
+// Tag a decoded frame with its static HDR metadata the way FFmpeg's own
+// decoders do: what the decoder reports over the container's (coded side
+// data), unless the caller prefers the container's. A copied frame already
+// holds the container's from ff_get_buffer, and ff_decode_*_new settle the
+// preference against it; a surface frame (add_coded) holds none, so it gets
+// only the one that wins.
+static int mediacodec_dec_export_hdr(AVCodecContext *avctx, MediaCodecDecContext *s,
+                                     AVFrame *frame, int add_coded)
+{
+    const AVPacketSideData *coded;
+    int ret;
+
+    coded = add_coded ? ff_get_coded_side_data(avctx, AV_PKT_DATA_MASTERING_DISPLAY_METADATA) : NULL;
+    if ((s->hdr_mastering.has_primaries || s->hdr_mastering.has_luminance) &&
+        !(coded && mediacodec_dec_prefer_packet(avctx, AV_PKT_DATA_MASTERING_DISPLAY_METADATA))) {
+        AVMasteringDisplayMetadata *mastering;
+
+        if ((ret = ff_decode_mastering_display_new(avctx, frame, &mastering)) < 0)
+            return ret;
+        if (mastering)
+            *mastering = s->hdr_mastering;
+    } else if (coded) {
+        if ((ret = mediacodec_dec_copy_coded(frame, AV_FRAME_DATA_MASTERING_DISPLAY_METADATA, coded)) < 0)
+            return ret;
+    }
+
+    coded = add_coded ? ff_get_coded_side_data(avctx, AV_PKT_DATA_CONTENT_LIGHT_LEVEL) : NULL;
+    if ((s->hdr_light.MaxCLL || s->hdr_light.MaxFALL) &&
+        !(coded && mediacodec_dec_prefer_packet(avctx, AV_PKT_DATA_CONTENT_LIGHT_LEVEL))) {
+        AVContentLightMetadata *light;
+
+        if ((ret = ff_decode_content_light_new(avctx, frame, &light)) < 0)
+            return ret;
+        if (light)
+            *light = s->hdr_light;
+    } else if (coded) {
+        if ((ret = mediacodec_dec_copy_coded(frame, AV_FRAME_DATA_CONTENT_LIGHT_LEVEL, coded)) < 0)
+            return ret;
+    }
+
+    return 0;
+}
+
 static int mediacodec_wrap_hw_buffer(AVCodecContext *avctx,
                                   MediaCodecDecContext *s,
                                   ssize_t index,
@@ -512,6 +580,13 @@ static int mediacodec_wrap_hw_buffer(AVCodecContext *avctx,
             "Wrapping output buffer %zd (%p) ts=%"PRId64" [%d pending]\n",
             buffer->index, buffer, buffer->pts, atomic_load(&s->hw_buffer_count));
 
+    ret = mediacodec_dec_export_hdr(avctx, s, frame, 1);
+    if (ret < 0) {
+        // The frame owns the buffer now: unref releases it unrendered.
+        av_frame_unref(frame);
+        return ret;
+    }
+
     return 0;
 fail:
     av_freep(&buffer);
@@ -621,6 +696,9 @@ static int mediacodec_wrap_sw_video_buffer(AVCodecContext *avctx,
     frame->pts = mediacodec_dec_frame_pts(avctx, s, info->presentationTimeUs);
     frame->pkt_dts = AV_NOPTS_VALUE;
 
+    if ((ret = mediacodec_dec_export_hdr(avctx, s, frame, 0)) < 0)
+        goto done;
+
     av_log(avctx, AV_LOG_TRACE,
             "Frame: width=%d stride=%d height=%d slice-height=%d "
             "crop-top=%d crop-bottom=%d crop-left=%d crop-right=%d encoder=%s "
@@ -692,6 +770,61 @@ static int mediacodec_wrap_sw_buffer(AVCodecContext *avctx,
     }                                                                                  \
 } while (0)                                                                            \
 
+// MediaFormat's "hdr-static-info": a CTA-861.3 Static Metadata Descriptor as
+// Android lays it out (ColorUtils' HDRStaticInfo, Media3's ColorInfo): the
+// descriptor ID, 0 for Type 1, then twelve little-endian uint16 -- the red,
+// green, blue and white point chromaticities in units of 0.00002, the
+// mastering display's maximum luminance in cd/m2 and minimum in 0.0001
+// cd/m2, MaxCLL and MaxFALL in cd/m2. A decoder may report the key all zero:
+// OMX.Nvidia.h265.decode does before its first frame, and for ByteBuffer
+// output throughout. The mastering display counts as known by the ranges
+// FFmpeg's own decoders hold the same SEI to (h2645_sei.c), so a frame carries
+// the same metadata whichever decoder read it; zero light levels are unknown.
+// Returns whether anything is known.
+#define MEDIACODEC_HDR_STATIC_INFO_SIZE 25
+
+static int mediacodec_dec_hdr_static_info(const AVCodecContext *avctx,
+                                          const uint8_t *data, size_t size,
+                                          AVMasteringDisplayMetadata *mastering,
+                                          AVContentLightMetadata *light)
+{
+    unsigned value[12];
+
+    memset(mastering, 0, sizeof(*mastering));
+    memset(light, 0, sizeof(*light));
+
+    if (!data || size < MEDIACODEC_HDR_STATIC_INFO_SIZE || data[0] != 0)
+        return 0;
+
+    for (int i = 0; i < 12; i++)
+        value[i] = AV_RL16(data + 1 + 2 * i);
+
+    // Every x within [5, 37000] and every y within [5, 42000].
+    mastering->has_primaries = 1;
+    for (int i = 0; i < 8; i++)
+        mastering->has_primaries &= value[i] >= 5 && value[i] <= (i & 1 ? 42000 : 37000);
+    for (int i = 0; i < 3; i++) {
+        mastering->display_primaries[i][0] = av_make_q(value[2 * i],     50000);
+        mastering->display_primaries[i][1] = av_make_q(value[2 * i + 1], 50000);
+    }
+    mastering->white_point[0] = av_make_q(value[6], 50000);
+    mastering->white_point[1] = av_make_q(value[7], 50000);
+
+    // A peak of 5 to 10000 cd/m2 over a floor of at most 5 cd/m2 below it. A
+    // zero floor passes unless strict: real (Blu-ray) releases carry it.
+    mastering->max_luminance = av_make_q(value[8], 1);
+    mastering->min_luminance = av_make_q(value[9], 10000);
+    mastering->has_luminance = value[8] >= 5 && value[8] <= 10000 &&
+                               value[9] <= 50000 && value[9] < value[8] * 10000 &&
+                               (value[9] >= 1 || avctx->strict_std_compliance < FF_COMPLIANCE_STRICT);
+
+    light->MaxCLL  = value[10];
+    light->MaxFALL = value[11];
+
+    return mastering->has_primaries || mastering->has_luminance ||
+           light->MaxCLL || light->MaxFALL;
+}
+
 static int mediacodec_dec_parse_video_format(AVCodecContext *avctx, MediaCodecDecContext *s,
                                             int output_format_changed)
 {
@@ -791,6 +924,25 @@ static int mediacodec_dec_parse_video_format(AVCodecContext *avctx, MediaCodecDe
     if (color_transfer)
         avctx->color_trc = ff_AMediaFormatColorTransfer_to_AVColorTransfer(color_transfer);
 
+    // MediaCodec parses the bitstream's mastering display and content light
+    // SEI itself and FFmpeg never sees them: the output format is the only
+    // place they surface.
+    {
+        void *hdr = NULL;
+        size_t hdr_size = 0;
+
+        ff_AMediaFormat_getBuffer(s->format, "hdr-static-info", &hdr, &hdr_size);
+        if (mediacodec_dec_hdr_static_info(avctx, hdr, hdr_size, &s->hdr_mastering, &s->hdr_light))
+            av_log(avctx, AV_LOG_INFO,
+                   "Output HDR static metadata: primaries %s, mastering luminance %.4f-%.0f cd/m2 (%s), "
+                   "MaxCLL %u, MaxFALL %u (0 = unknown)\n",
+                   s->hdr_mastering.has_primaries ? "known" : "unknown",
+                   av_q2d(s->hdr_mastering.min_luminance), av_q2d(s->hdr_mastering.max_luminance),
+                   s->hdr_mastering.has_luminance ? "known" : "unknown",
+                   s->hdr_light.MaxCLL, s->hdr_light.MaxFALL);
+        av_free(hdr);
+    }
+
     av_log(avctx, AV_LOG_INFO,
         "Output crop parameters top=%d bottom=%d left=%d right=%d, "
         "resulting dimensions width=%d height=%d\n",
diff --git a/libavcodec/mediacodecdec_common.h b/libavcodec/mediacodecdec_common.h
index ce8b589..19c5cd9 100644
--- a/libavcodec/mediacodecdec_common.h
+++ b/libavcodec/mediacodecdec_common.h
@@ -30,6 +30,7 @@
 
 #include "libavutil/fifo.h"
 #include "libavutil/frame.h"
+#include "libavutil/mastering_display_metadata.h"
 #include "libavutil/pixfmt.h"
 #include "libavutil/thread.h"
 
@@ -83,6 +84,13 @@ typedef struct MediaCodecDecContext {
     int display_width;
     int display_height;
 
+    // The static HDR metadata of the last output format ("hdr-static-info"):
+    // what the decoder read from the bitstream or was configured with.
+    // Nothing is known when has_primaries, has_luminance and both light
+    // levels are zero; each decoded frame carries what is known.
+    AVMasteringDisplayMetadata hdr_mastering;
+    AVContentLightMetadata hdr_light;
+
     uint64_t output_buffer_count;
     ssize_t current_input_buffer;
     // An input buffer was taken from the codec since it started or was last
