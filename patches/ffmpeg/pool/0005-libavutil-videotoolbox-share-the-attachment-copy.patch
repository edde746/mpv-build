Subject: [PATCH] avutil/videotoolbox: share the attachment copy helper

VideoToolbox's Dolby Vision HDR tagging needs the attachments of a decoded
pixel buffer as a dictionary of its own, which libavcodec then grew a second
copy of: the same CVBufferCopyAttachments()/CVBufferGetAttachments()
availability dance, in videotoolbox.c.

av_vt_cv_buffer_copy_attachments() is that helper, exported from the
hwcontext code that already had it privately, so one implementation serves
both. No behavior change.

diff --git a/libavutil/hwcontext_videotoolbox.c b/libavutil/hwcontext_videotoolbox.c
index 102fa48..51e79a8 100644
--- a/libavutil/hwcontext_videotoolbox.c
+++ b/libavutil/hwcontext_videotoolbox.c
@@ -534,11 +534,8 @@ CFStringRef av_map_videotoolbox_color_trc_from_av(enum AVColorTransferCharacteri
     }
 }
 
-/**
- * Copy all attachments for the specified mode from the given buffer.
- */
-static CFDictionaryRef vt_cv_buffer_copy_attachments(CVBufferRef buffer,
-                                                     CVAttachmentMode attachment_mode)
+CFDictionaryRef av_vt_cv_buffer_copy_attachments(CVBufferRef buffer,
+                                                 CVAttachmentMode attachment_mode)
 {
     // Check that our SDK is at least macOS 12 / iOS 15 / tvOS 15
     #if (TARGET_OS_OSX  && defined(__MAC_12_0)    && __MAC_OS_X_VERSION_MAX_ALLOWED  >= __MAC_12_0)     || \
@@ -623,7 +620,7 @@ static int vt_pixbuf_set_colorspace(void *log_ctx,
     (TARGET_OS_IOS && __IPHONE_OS_VERSION_MAX_ALLOWED >= 100000)
     if (__builtin_available(macOS 10.8, iOS 10, *)) {
         CFDictionaryRef attachments =
-            vt_cv_buffer_copy_attachments(pixbuf, kCVAttachmentMode_ShouldPropagate);
+            av_vt_cv_buffer_copy_attachments(pixbuf, kCVAttachmentMode_ShouldPropagate);
 
         if (attachments) {
             colorspace =
diff --git a/libavutil/hwcontext_videotoolbox.h b/libavutil/hwcontext_videotoolbox.h
index d35cfbb..3daa54d 100644
--- a/libavutil/hwcontext_videotoolbox.h
+++ b/libavutil/hwcontext_videotoolbox.h
@@ -89,6 +89,16 @@ CFStringRef av_map_videotoolbox_color_primaries_from_av(enum AVColorPrimaries pr
  */
 CFStringRef av_map_videotoolbox_color_trc_from_av(enum AVColorTransferCharacteristic trc);
 
+/**
+ * Copy all attachments for the specified mode from the given buffer, so they
+ * can be inspected without holding the buffer, and so a caller on an SDK or
+ * runtime older than macOS 12 / iOS 15 / tvOS 15 (where CVBufferCopyAttachments()
+ * does not exist) can still get them. Returns NULL when there is nothing to
+ * copy or nothing can be allocated; CFRelease() the result.
+ */
+CFDictionaryRef av_vt_cv_buffer_copy_attachments(CVBufferRef buffer,
+                                                 CVAttachmentMode attachment_mode);
+
 /**
  * Set CVPixelBufferRef's metadata based on an AVFrame.
  *
