+#include "config_components.h"
+
+#include <stdint.h>
+#include <string.h>
+
+#include "libavutil/log.h"
+#include "libavutil/mem.h"
+
+#include "avcodec.h"
+#if CONFIG_AV1_MEDIACODEC_DECODER
+#include "av1.h"
+#include "cbs.h"
+#include "cbs_av1.h"
+#endif
+#include "h264.h"
+#include "hevc/hevc.h"
+#include "mediacodec_shed.h"
+#include "packet.h"
+
+// --- H.264 / HEVC ------------------------------------------------------------
+//
+// The packets a MediaCodec decoder is fed are Annex B (the wrapper's bitstream
+// filter converts length-prefixed streams). Only the NAL headers are read, and
+// those bytes can never hold an emulation prevention byte, so no unescaping.
+
+// The offset of the NAL unit that starts at or after *pos, with *pos moved
+// past it; -1 when there is none.
+static int annexb_next_nal(const uint8_t *data, int size, int *pos)
+{
+    int i = *pos;
+    while (i + 3 <= size) {
+        if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1) {
+            *pos = i + 3;
+            return i + 3;
+        }
+        i++;
+    }
+    *pos = size;
+    return -1;
+}
+
+int ff_mediacodec_shed_h264_droppable(const uint8_t *data, int size)
+{
+    int pos = 0, nal, slices = 0;
+
+    while ((nal = annexb_next_nal(data, size, &pos)) >= 0) {
+        int ref_idc, type;
+        if (nal >= size)
+            return 0;
+        ref_idc = (data[nal] >> 5) & 3;
+        type    =  data[nal] & 0x1f;
+        switch (type) {
+        case H264_NAL_SLICE:
+        case H264_NAL_DPA:
+        case H264_NAL_DPB:
+        case H264_NAL_DPC:
+        case H264_NAL_IDR_SLICE:
+            if (ref_idc)
+                return 0;
+            slices++;
+            break;
+        // Parameter sets and the SVC/MVC extension carriers ride along
+        // with pictures: never lose them, and never reason about layered
+        // streams from the base layer's ref_idc alone.
+        case H264_NAL_SPS:
+        case H264_NAL_PPS:
+        case H264_NAL_SPS_EXT:
+        case H264_NAL_PREFIX:
+        case H264_NAL_SUB_SPS:
+        case H264_NAL_DPS:
+        case H264_NAL_AUXILIARY_SLICE:
+        case H264_NAL_EXTEN_SLICE:
+        case H264_NAL_DEPTH_EXTEN_SLICE:
+            return 0;
+        default:
+            break;
+        }
+    }
+    return slices > 0;
+}
+
+// Table 7-1's sub-layer non-reference types: samples of these pictures are
+// never used for inter prediction by later pictures of the same sub-layer.
+// (Mirrors ff_hevc_nal_is_nonref; kept local so the classifier stays free
+// of the decoder's headers.)
+static int hevc_nal_is_sub_layer_nonref(int type)
+{
+    switch (type) {
+    case HEVC_NAL_TRAIL_N:
+    case HEVC_NAL_TSA_N:
+    case HEVC_NAL_STSA_N:
+    case HEVC_NAL_RADL_N:
+    case HEVC_NAL_RASL_N:
+    case HEVC_NAL_VCL_N10:
+    case HEVC_NAL_VCL_N12:
+    case HEVC_NAL_VCL_N14:
+        return 1;
+    default:
+        return 0;
+    }
+}
+
+// A sub-layer non-reference picture may still be referenced by pictures of
+// a *higher* sub-layer, so only pictures of the highest sub-layer the SPS
+// declares are safe to shed. *max_sub_layers_minus1 follows any SPS in the
+// access unit (and an access unit carrying parameter sets is always kept).
+int ff_mediacodec_shed_hevc_droppable(const uint8_t *data, int size,
+                                      int *max_sub_layers_minus1)
+{
+    int pos = 0, nal, slices = 0;
+
+    while ((nal = annexb_next_nal(data, size, &pos)) >= 0) {
+        int type, layer_id, temporal_id;
+        if (nal + 2 > size)
+            return 0;
+        type        = (data[nal] >> 1) & 0x3f;
+        layer_id    = ((data[nal] & 1) << 5) | (data[nal + 1] >> 3);
+        temporal_id = (data[nal + 1] & 7) - 1;
+        if (temporal_id < 0)
+            return 0;
+        if (type == HEVC_NAL_SPS) {
+            // sps_video_parameter_set_id(4) sps_max_sub_layers_minus1(3) ...
+            if (nal + 3 <= size && layer_id == 0)
+                *max_sub_layers_minus1 = (data[nal + 2] >> 1) & 7;
+            return 0;
+        }
+        if (type == HEVC_NAL_VPS || type == HEVC_NAL_PPS)
+            return 0;
+        if (type <= HEVC_NAL_RSV_VCL31) {
+            if (layer_id != 0)
+                return 0;
+            if (!hevc_nal_is_sub_layer_nonref(type))
+                return 0;
+            if (*max_sub_layers_minus1 < 0 || temporal_id != *max_sub_layers_minus1)
+                return 0;
+            slices++;
+        }
+    }
+    return slices > 0;
+}
+
+// --- VP9 -----------------------------------------------------------------------
+
+typedef struct ShedBits {
+    const uint8_t *data;
+    int size;
+    int pos; // in bits
+} ShedBits;
+
+static unsigned shed_bits_read(ShedBits *b, int n, int *ok)
+{
+    unsigned v = 0;
+    while (n-- > 0) {
+        if (b->pos >= b->size * 8) {
+            *ok = 0;
+            return 0;
+        }
+        v = (v << 1) | ((b->data[b->pos >> 3] >> (7 - (b->pos & 7))) & 1);
+        b->pos++;
+    }
+    return v;
+}
+
+// Whether the frame starting at data is a shown inter frame that refreshes
+// no reference slot: uncompressed_header() up to refresh_frame_flags, which
+// for a shown non-intra frame follows reset_frame_context directly.
+int ff_mediacodec_shed_vp9_frame_droppable(const uint8_t *data, int size)
+{
+    ShedBits b = { data, size, 0 };
+    int ok = 1, profile, frame_type, show_frame, error_resilient;
+    unsigned refresh;
+
+    if (shed_bits_read(&b, 2, &ok) != 2 || !ok)  // frame_marker
+        return 0;
+    profile  = shed_bits_read(&b, 1, &ok);
+    profile |= shed_bits_read(&b, 1, &ok) << 1;
+    if (profile == 3 && shed_bits_read(&b, 1, &ok)) // reserved_zero
+        return 0;
+    if (shed_bits_read(&b, 1, &ok))                 // show_existing_frame
+        return 0;
+    frame_type      = shed_bits_read(&b, 1, &ok);
+    show_frame      = shed_bits_read(&b, 1, &ok);
+    error_resilient = shed_bits_read(&b, 1, &ok);
+    if (!ok || frame_type == 0 || !show_frame)      // key frame; hidden frame
+        return 0;
+    // intra_only is only signalled for hidden frames, so this shown inter
+    // frame reads reset_frame_context (unless error resilient) and then
+    // refresh_frame_flags.
+    if (!error_resilient)
+        shed_bits_read(&b, 2, &ok);
+    refresh = shed_bits_read(&b, 8, &ok);
+    return ok && refresh == 0;
+}
+
+// A superframe index (Annex B of the VP9 spec) trails the frames it lists:
+// marker byte, N sizes of M bytes each (little endian), the same marker.
+static int vp9_superframe_index(const uint8_t *data, int size,
+                                int *frames, int *mag, int *index_size)
+{
+    uint8_t marker;
+    if (size < 1)
+        return 0;
+    marker = data[size - 1];
+    if ((marker & 0xe0) != 0xc0)
+        return 0;
+    *frames = (marker & 7) + 1;
+    *mag = ((marker >> 3) & 3) + 1;
+    *index_size = 2 + *mag * *frames;
+    if (size < *index_size || data[size - *index_size] != marker)
+        return 0;
+    return 1;
+}
+
+// Shed the shown frame of a VP9 packet. A superframe keeps its leading
+// (hidden reference) frames and gets its index rewritten in place for one
+// frame fewer; a plain frame packet is emptied.
+int ff_mediacodec_shed_vp9_packet(AVPacket *pkt)
+{
+    int frames = 1, mag = 0, index_size = 0;
+    int i, kept = 0, last_offset, last_size;
+    uint32_t sizes[8];
+
+    if (pkt->size <= 0)
+        return 0;
+    if (vp9_superframe_index(pkt->data, pkt->size, &frames, &mag, &index_size)) {
+        const uint8_t *idx = pkt->data + pkt->size - index_size + 1;
+        int total = 0;
+        for (i = 0; i < frames; i++) {
+            uint32_t sz = 0;
+            for (int j = 0; j < mag; j++)
+                sz |= (uint32_t)idx[i * mag + j] << (8 * j);
+            sizes[i] = sz;
+            total += sz;
+            if (sz == 0 || total > pkt->size - index_size)
+                return 0;
+        }
+        if (total != pkt->size - index_size)
+            return 0;
+        for (i = 0; i < frames - 1; i++)
+            kept += sizes[i];
+        last_offset = kept;
+        last_size = sizes[frames - 1];
+    } else {
+        last_offset = 0;
+        last_size = pkt->size;
+    }
+
+    if (!ff_mediacodec_shed_vp9_frame_droppable(pkt->data + last_offset, last_size))
+        return 0;
+
+    if (frames == 1) {
+        pkt->size = 0;
+        return 1;
+    }
+    if (frames == 2) {
+        // The packet's buffer may be shared with the demuxer: shorten the
+        // view, never touch the bytes past it.
+        pkt->size = kept;
+        return 1;
+    }
+    // Rebuild the index for frames - 1 entries behind the kept frames. It is
+    // shorter than the old one and the removed frame freed at least a byte,
+    // so it fits in place.
+    if (av_packet_make_writable(pkt) < 0)
+        return AVERROR(ENOMEM);
+    {
+        int n = frames - 1;
+        uint8_t marker = 0xc0 | ((mag - 1) << 3) | (n - 1);
+        uint8_t *w = pkt->data + kept;
+        *w++ = marker;
+        for (i = 0; i < n; i++)
+            for (int j = 0; j < mag; j++)
+                *w++ = (sizes[i] >> (8 * j)) & 0xff;
+        *w++ = marker;
+        pkt->size = (int)(w - pkt->data);
+    }
+    return 1;
+}
+
+#if CONFIG_AV1_MEDIACODEC_DECODER
+// --- AV1 -----------------------------------------------------------------------
+//
+// The coded-bitstream reader decomposes every OBU of a temporal unit and
+// keeps the sequence header and reference state the frame headers of later
+// units need, so it must see every packet, not only the ones being judged.
+
+static const AV1RawFrameHeader *av1_unit_frame_header(const CodedBitstreamUnit *unit)
+{
+    const AV1RawOBU *obu = unit->content;
+    if (!obu)
+        return NULL;
+    if (unit->type == AV1_OBU_FRAME)
+        return &obu->obu.frame.header;
+    if (unit->type == AV1_OBU_FRAME_HEADER)
+        return &obu->obu.frame_header;
+    return NULL;
+}
+
+// A stream the reader keeps failing on is one it will never shed; stop
+// asking after this many consecutive units rather than log every one.
+#define AV1_READ_FAILURES_TO_GIVE_UP 8
+
+// Decompose pkt into sh->frag. 0 on success; the fragment is reset on failure.
+static int av1_read(MediaCodecShedContext *sh, AVCodecContext *avctx,
+                    const AVPacket *pkt)
+{
+    int err;
+    if (!sh->cbs)
+        return AVERROR(ENOSYS);
+    err = ff_cbs_read_packet(sh->cbs, sh->frag, pkt);
+    if (err < 0) {
+        ff_cbs_fragment_reset(sh->frag);
+        if (++sh->cbs_failures >= AV1_READ_FAILURES_TO_GIVE_UP) {
+            av_log(avctx, AV_LOG_WARNING,
+                   "AV1 temporal units not decomposed (%d); frame shedding "
+                   "is off for this stream\n", err);
+            ff_cbs_close(&sh->cbs);
+        }
+        return err;
+    }
+    sh->cbs_failures = 0;
+    return 0;
+}
+
+// Shed the temporal unit's last frame when it is shown and refreshes no
+// reference slot. Earlier OBUs -- the temporal delimiter, hidden reference
+// frames, a sequence header -- are kept, so the decoder still consumes a
+// valid (if now frame-less) temporal unit; a unit that held nothing but the
+// shed frame is emptied instead.
+static int av1_shed(MediaCodecShedContext *sh, AVCodecContext *avctx, AVPacket *pkt)
+{
+    CodedBitstreamFragment *frag = sh->frag;
+    const AV1RawFrameHeader *hdr = NULL;
+    int last = -1, keep_units = 0, offset;
+
+    if (av1_read(sh, avctx, pkt) < 0)
+        return 0;
+
+    for (int i = frag->nb_units - 1; i >= 0; i--) {
+        CodedBitstreamUnitType type = frag->units[i].type;
+        if (type == AV1_OBU_FRAME || type == AV1_OBU_FRAME_HEADER) {
+            last = i;
+            break;
+        }
+        if (type == AV1_OBU_TILE_GROUP || type == AV1_OBU_METADATA ||
+            type == AV1_OBU_PADDING || type == AV1_OBU_REDUNDANT_FRAME_HEADER)
+            continue;
+        break; // a tile list or something newer than this reader: keep
+    }
+    if (last >= 0)
+        hdr = av1_unit_frame_header(&frag->units[last]);
+    if (!hdr || hdr->show_existing_frame || !hdr->show_frame ||
+        hdr->refresh_frame_flags != 0 ||
+        hdr->frame_type == AV1_FRAME_KEY || hdr->frame_type == AV1_FRAME_SWITCH)
+        goto keep;
+
+    offset = (int)(frag->units[last].data - frag->data);
+    if (offset < 0 || offset > pkt->size)
+        goto keep;
+    for (int i = 0; i < last; i++) {
+        CodedBitstreamUnitType type = frag->units[i].type;
+        if (type == AV1_OBU_FRAME || type == AV1_OBU_FRAME_HEADER ||
+            type == AV1_OBU_TILE_GROUP || type == AV1_OBU_TILE_LIST ||
+            type == AV1_OBU_SEQUENCE_HEADER)
+            keep_units = 1;
+    }
+    ff_cbs_fragment_reset(frag);
+    // The buffer may be shared with the demuxer's cache: shorten the view,
+    // never write past it.
+    pkt->size = keep_units ? offset : 0;
+    return 1;
+
+keep:
+    ff_cbs_fragment_reset(frag);
+    return 0;
+}
+
+#endif /* CONFIG_AV1_MEDIACODEC_DECODER */
+
+// --- Entry points --------------------------------------------------------------
+
+int ff_mediacodec_shed_init(MediaCodecShedContext *sh, AVCodecContext *avctx)
+{
+    memset(sh, 0, sizeof(*sh));
+    sh->codec_id = avctx->codec_id;
+    sh->hevc_max_sub_layers_minus1 = -1;
+
+#if CONFIG_AV1_MEDIACODEC_DECODER
+    if (avctx->codec_id == AV_CODEC_ID_AV1) {
+        int err;
+        sh->frag = av_mallocz(sizeof(*sh->frag));
+        if (!sh->frag)
+            return AVERROR(ENOMEM);
+        err = ff_cbs_init(&sh->cbs, AV_CODEC_ID_AV1, avctx);
+        if (err < 0) {
+            av_freep(&sh->frag);
+            return 0;
+        }
+        if (avctx->extradata && avctx->extradata_size > 0) {
+            // The av1C sequence header, when the container carries one; the
+            // first temporal unit repeats it anyway.
+            if (ff_cbs_read_extradata_from_codec(sh->cbs, sh->frag, avctx) < 0)
+                av_log(avctx, AV_LOG_VERBOSE, "AV1 extradata not decomposed\n");
+            ff_cbs_fragment_reset(sh->frag);
+        }
+    }
+#endif
+    return 0;
+}
+
+void ff_mediacodec_shed_flush(MediaCodecShedContext *sh)
+{
+#if CONFIG_AV1_MEDIACODEC_DECODER
+    if (sh->cbs)
+        ff_cbs_flush(sh->cbs);
+#endif
+}
+
+void ff_mediacodec_shed_uninit(MediaCodecShedContext *sh)
+{
+#if CONFIG_AV1_MEDIACODEC_DECODER
+    if (sh->frag) {
+        ff_cbs_fragment_free(sh->frag);
+        av_freep(&sh->frag);
+    }
+    ff_cbs_close(&sh->cbs);
+#endif
+}
+
+void ff_mediacodec_shed_observe(MediaCodecShedContext *sh, AVCodecContext *avctx,
+                                const AVPacket *pkt)
+{
+#if CONFIG_AV1_MEDIACODEC_DECODER
+    if (sh->codec_id == AV_CODEC_ID_AV1 && sh->cbs && pkt->size > 0) {
+        if (av1_read(sh, avctx, pkt) >= 0)
+            ff_cbs_fragment_reset(sh->frag);
+    }
+#endif
+}
+
+int ff_mediacodec_shed_packet(MediaCodecShedContext *sh, AVCodecContext *avctx,
+                              AVPacket *pkt)
+{
+    if (pkt->size <= 0)
+        return 0;
+
+#if CONFIG_AV1_MEDIACODEC_DECODER
+    // The AV1 reader must see every unit, key frames first of all: that is
+    // where the sequence header it needs for everything after arrives.
+    if (sh->codec_id == AV_CODEC_ID_AV1)
+        return av1_shed(sh, avctx, pkt);
+#endif
+
+    // A key frame is a reference by construction, and the cheapest test.
+    if (pkt->flags & AV_PKT_FLAG_KEY)
+        return 0;
+
+    switch (sh->codec_id) {
+    case AV_CODEC_ID_H264:
+        if (!ff_mediacodec_shed_h264_droppable(pkt->data, pkt->size))
+            return 0;
+        pkt->size = 0;
+        return 1;
+    case AV_CODEC_ID_HEVC:
+        if (!ff_mediacodec_shed_hevc_droppable(pkt->data, pkt->size,
+                                               &sh->hevc_max_sub_layers_minus1))
+            return 0;
+        pkt->size = 0;
+        return 1;
+    case AV_CODEC_ID_VP9:
+        return ff_mediacodec_shed_vp9_packet(pkt);
+    default:
+        return 0;
+    }
+}
