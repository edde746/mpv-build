Subject: [PATCH] avcodec/mediacodec: bring the Java wrapper to parity with the NDK one

The Java MediaCodec wrapper decodes synchronously, reports no rendered
frames and cannot update a running codec, because MediaCodec.Callback and
OnFrameRenderedListener need a Java object a library cannot ship and
setParameters takes a Bundle. Those three are exactly what the fork built
on the NDK wrapper, which below API 28 cannot read the decoder's crop
rectangle (AMediaFormat_getRect is API 28; the crop-* keys exist only in the
Java MediaFormat) and so sizes padded output buffers as the picture.

Let the application register a callback bridge class
(av_jni_set_mediacodec_callback_class, contract in jni.h): the wrapper
instantiates it per codec, binds the natives with RegisterNatives, and
routes MediaCodec.setCallback and setOnFrameRenderedListener through it on
a Looper thread the object owns. setParameters copies the keys MediaCodec
accepts as parameters into a Bundle. The decoder no longer gates
asynchronous mode and rendered-frame feedback on ndk_codec; the feedback
source is "jni" or "ndk", and consumers treat anything but "off:*" as on.
The option is `async`, since it no longer names a wrapper.

diff --git a/libavcodec/ffjni.h b/libavcodec/ffjni.h
index d1e86f8..84b14d7 100644
--- a/libavcodec/ffjni.h
+++ b/libavcodec/ffjni.h
@@ -83,6 +83,16 @@ int ff_jni_exception_get_summary(JNIEnv *env, jthrowable exception, char **error
  */
 int ff_jni_exception_check(JNIEnv *env, int log, void *log_ctx);
 
+/*
+ * The application's MediaCodec callback bridge class registered with
+ * av_jni_set_mediacodec_callback_class, or NULL when none is: the Java
+ * MediaCodec wrapper then has no asynchronous mode and no rendered-frame
+ * feedback.
+ *
+ * @return global JNI reference to the class, or NULL
+ */
+void *ff_jni_get_mediacodec_callback_class(void);
+
 /*
  * Jni field type.
  */
diff --git a/libavcodec/jni.c b/libavcodec/jni.c
index fcb4837..1e3fe2a 100644
--- a/libavcodec/jni.c
+++ b/libavcodec/jni.c
@@ -36,6 +36,7 @@
 
 static void *java_vm;
 static void *android_app_ctx;
+static void *mediacodec_callback_class;
 static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
 
 int av_jni_set_java_vm(void *vm, void *log_ctx)
@@ -121,4 +122,44 @@ void *av_jni_get_android_app_ctx(void)
 #endif
 }
 
+int av_jni_set_mediacodec_callback_class(void *callback_class, void *log_ctx)
+{
+#if CONFIG_JNI
+    jobjectRefType type;
+
+    JNIEnv *env = ff_jni_get_env(log_ctx);
+    if (!env)
+        return AVERROR(EINVAL);
+
+    type = (*env)->GetObjectRefType(env, callback_class);
+    if (type != JNIGlobalRefType) {
+        av_log(log_ctx, AV_LOG_ERROR, "MediaCodec callback class must be passed as a global reference");
+        return AVERROR(EINVAL);
+    }
+
+    pthread_mutex_lock(&lock);
+    mediacodec_callback_class = callback_class;
+    pthread_mutex_unlock(&lock);
+
+    return 0;
+#else
+    return AVERROR(ENOSYS);
+#endif
+}
+
+void *ff_jni_get_mediacodec_callback_class(void)
+{
+#if CONFIG_JNI
+    void *cls;
+
+    pthread_mutex_lock(&lock);
+    cls = mediacodec_callback_class;
+    pthread_mutex_unlock(&lock);
+
+    return cls;
+#else
+    return NULL;
+#endif
+}
+
 #endif
diff --git a/libavcodec/jni.h b/libavcodec/jni.h
index 955cd28..e4ba8ea 100644
--- a/libavcodec/jni.h
+++ b/libavcodec/jni.h
@@ -64,4 +64,44 @@ int av_jni_set_android_app_ctx(void *app_ctx, void *log_ctx);
  */
 void *av_jni_get_android_app_ctx(void);
 
+/*
+ * Register the application's MediaCodec callback bridge class. The Java
+ * MediaCodec wrapper needs a Java object to receive MediaCodec.Callback and
+ * MediaCodec.OnFrameRenderedListener events, and a library cannot ship one;
+ * without this class the Java wrapper decodes synchronously and reports no
+ * rendered frames (the NDK wrapper is unaffected).
+ *
+ * The class extends android.media.MediaCodec.Callback, implements
+ * android.media.MediaCodec.OnFrameRenderedListener and declares:
+ *
+ *   <init>(long codec)                creates the object and the Looper thread
+ *                                     its callbacks run on
+ *   android.os.Handler handler()      the Handler on that thread
+ *   void release()                    returns only once no callback will
+ *                                     touch native again; stops the thread
+ *
+ * and forwards every callback to these static natives, which libavcodec
+ * registers on the class (RegisterNatives) when the first codec uses it:
+ *
+ *   static native void nativeOnInputAvailable(long codec, int index)
+ *   static native void nativeOnOutputAvailable(long codec, int index,
+ *           int offset, int size, long presentationTimeUs, int flags)
+ *   static native void nativeOnFormatChanged(long codec,
+ *           android.media.MediaFormat format)
+ *   static native void nativeOnError(long codec, int errorCode,
+ *           String diagnosticInfo)
+ *   static native void nativeOnFrameRendered(long codec,
+ *           long presentationTimeUs, long nanoTime)
+ *
+ * `codec` is the value the constructor received. release() must serialize
+ * against the callbacks (a callback that observes release is dropped), since
+ * the native side frees `codec` right after release() returns.
+ *
+ * This function is only available on Android.
+ *
+ * @param callback_class global JNI reference to the class
+ * @return 0 on success, < 0 otherwise
+ */
+int av_jni_set_mediacodec_callback_class(void *callback_class, void *log_ctx);
+
 #endif /* AVCODEC_JNI_H */
