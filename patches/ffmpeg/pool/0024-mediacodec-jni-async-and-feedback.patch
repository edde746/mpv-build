+        { "android/os/Bundle", "putInt", "(Ljava/lang/String;I)V", FF_JNI_METHOD, OFFSET(bundle_put_int_id), 1 },
+        { "android/os/Bundle", "putLong", "(Ljava/lang/String;J)V", FF_JNI_METHOD, OFFSET(bundle_put_long_id), 1 },
+
     { NULL }
 };
 #undef OFFSET
@@ -279,6 +300,15 @@ typedef struct FFAMediaCodecJni {
     jobject input_buffers;
     jobject output_buffers;
 
+    // The application's callback bridge object (jni.h), created on the first
+    // asynchronous or rendered-frame registration and released with the
+    // codec; NULL until then.
+    jobject callback;
+    FFAMediaCodecOnAsyncNotifyCallback async_cb;
+    void *async_userdata;
+    FFAMediaCodecOnFrameRendered rendered_cb;
+    void *rendered_userdata;
+
     int INFO_TRY_AGAIN_LATER;
     int INFO_OUTPUT_BUFFERS_CHANGED;
     int INFO_OUTPUT_FORMAT_CHANGED;
@@ -1340,6 +1370,8 @@ DECLARE_FF_AMEDIACODEC_CREATE_FUNC(createCodecByName,   CREATE_CODEC_BY_NAME)
 DECLARE_FF_AMEDIACODEC_CREATE_FUNC(createDecoderByType, CREATE_DECODER_BY_TYPE)
 DECLARE_FF_AMEDIACODEC_CREATE_FUNC(createEncoderByType, CREATE_ENCODER_BY_TYPE)
 
+static void mediacodec_jni_bridge_release(JNIEnv *env, FFAMediaCodecJni *codec);
+
 static int mediacodec_jni_delete(FFAMediaCodec* ctx)
 {
     int ret = 0;
@@ -1357,6 +1389,10 @@ static int mediacodec_jni_delete(FFAMediaCodec* ctx)
         ret = AVERROR_EXTERNAL;
     }
 
+    // The codec no longer produces events; a callback still in flight
+    // finishes inside release() before the struct goes away.
+    mediacodec_jni_bridge_release(env, codec);
+
     (*env)->DeleteGlobalRef(env, codec->input_buffers);
     codec->input_buffers = NULL;
 
@@ -1813,12 +1849,354 @@ static int mediacodec_jni_setOutputSurface(FFAMediaCodec *ctx, FFANativeWindow *
     return 0;
 }
 
-static int mediacodec_jni_setAsyncNotifyCallback(FFAMediaCodec *codec,
+// The application's callback bridge class (jni.h): resolved once per
+// process from the class av_jni_set_mediacodec_callback_class registered,
+// with the natives below bound to it. The class reference stays the
+// application's.
+struct JNIMediaCodecCallbackBridge {
+    jclass cls;
+    jmethodID init_id;
+    jmethodID handler_id;
+    jmethodID release_id;
+    int state; // 0 unresolved, 1 ready, -1 unusable
+};
+
+static struct JNIMediaCodecCallbackBridge callback_bridge;
+static pthread_mutex_t callback_bridge_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static void JNICALL mediacodec_jni_onInputAvailable(JNIEnv *env, jclass cls,
+                                                    jlong handle, jint index)
+{
+    FFAMediaCodecJni *codec = (FFAMediaCodecJni *)(intptr_t)handle;
+    codec->async_cb.onAsyncInputAvailable(&codec->api, codec->async_userdata, index);
+}
+
+static void JNICALL mediacodec_jni_onOutputAvailable(JNIEnv *env, jclass cls,
+                                                     jlong handle, jint index,
+                                                     jint offset, jint size,
+                                                     jlong presentation_time_us,
+                                                     jint flags)
+{
+    FFAMediaCodecJni *codec = (FFAMediaCodecJni *)(intptr_t)handle;
+    FFAMediaCodecBufferInfo info = {
+        .offset = offset,
+        .size = size,
+        .presentationTimeUs = presentation_time_us,
+        .flags = flags,
+    };
+    codec->async_cb.onAsyncOutputAvailable(&codec->api, codec->async_userdata,
+                                           index, &info);
+}
+
+static void JNICALL mediacodec_jni_onFormatChanged(JNIEnv *env, jclass cls,
+                                                   jlong handle, jobject format)
+{
+    FFAMediaCodecJni *codec = (FFAMediaCodecJni *)(intptr_t)handle;
+    FFAMediaFormat *media_format = mediaformat_jni_newFromObject(format);
+    if (!media_format)
+        return;
+    codec->async_cb.onAsyncFormatChanged(&codec->api, codec->async_userdata,
+                                         media_format);
+    ff_AMediaFormat_delete(media_format);
+}
+
+static void JNICALL mediacodec_jni_onError(JNIEnv *env, jclass cls,
+                                           jlong handle, jint error_code,
+                                           jstring diagnostic)
+{
+    FFAMediaCodecJni *codec = (FFAMediaCodecJni *)(intptr_t)handle;
+    char *detail = diagnostic ? ff_jni_jstring_to_utf_chars(env, diagnostic, codec) : NULL;
+    // CodecException carries a vendor error code, not a status the platform
+    // maps for us; the diagnostic string is what names it.
+    codec->async_cb.onAsyncError(&codec->api, codec->async_userdata,
+                                 AVERROR_EXTERNAL, detail ? detail : "CodecException");
+    av_free(detail);
+}
+
+static void JNICALL mediacodec_jni_onFrameRendered(JNIEnv *env, jclass cls,
+                                                   jlong handle,
+                                                   jlong presentation_time_us,
+                                                   jlong nano_time)
+{
+    FFAMediaCodecJni *codec = (FFAMediaCodecJni *)(intptr_t)handle;
+    FFAMediaCodecOnFrameRendered cb = codec->rendered_cb;
+    if (cb)
+        cb(&codec->api, codec->rendered_userdata, presentation_time_us, nano_time);
+}
+
+static const JNINativeMethod callback_bridge_natives[] = {
+    { "nativeOnInputAvailable", "(JI)V", (void *)mediacodec_jni_onInputAvailable },
+    { "nativeOnOutputAvailable", "(JIIIJI)V", (void *)mediacodec_jni_onOutputAvailable },
+    { "nativeOnFormatChanged", "(JLandroid/media/MediaFormat;)V", (void *)mediacodec_jni_onFormatChanged },
+    { "nativeOnError", "(JILjava/lang/String;)V", (void *)mediacodec_jni_onError },
+    { "nativeOnFrameRendered", "(JJJ)V", (void *)mediacodec_jni_onFrameRendered },
+};
+
+// ENOSYS when the application registered no class; a class that does not
+// meet the jni.h contract is reported once and treated the same.
+static int mediacodec_jni_bridge_resolve(JNIEnv *env, void *log_ctx)
+{
+    struct JNIMediaCodecCallbackBridge *bridge = &callback_bridge;
+    int ret = AVERROR(ENOSYS);
+
+    pthread_mutex_lock(&callback_bridge_lock);
+    if (bridge->state == 1) {
+        ret = 0;
+        goto done;
+    }
+    if (bridge->state < 0)
+        goto done;
+
+    bridge->cls = ff_jni_get_mediacodec_callback_class();
+    if (!bridge->cls) {
+        av_log(log_ctx, AV_LOG_VERBOSE,
+               "No MediaCodec callback bridge class registered (av_jni_set_mediacodec_callback_class)\n");
+        goto done;
+    }
+
+    bridge->init_id = (*env)->GetMethodID(env, bridge->cls, "<init>", "(J)V");
+    if (ff_jni_exception_check(env, 1, log_ctx) < 0)
+        goto unusable;
+    bridge->handler_id = (*env)->GetMethodID(env, bridge->cls, "handler", "()Landroid/os/Handler;");
+    if (ff_jni_exception_check(env, 1, log_ctx) < 0)
+        goto unusable;
+    bridge->release_id = (*env)->GetMethodID(env, bridge->cls, "release", "()V");
+    if (ff_jni_exception_check(env, 1, log_ctx) < 0)
+        goto unusable;
+
+    if ((*env)->RegisterNatives(env, bridge->cls, callback_bridge_natives,
+                                FF_ARRAY_ELEMS(callback_bridge_natives)) < 0 ||
+        ff_jni_exception_check(env, 1, log_ctx) < 0)
+        goto unusable;
+
+    bridge->state = 1;
+    ret = 0;
+    goto done;
+
+unusable:
+    av_log(log_ctx, AV_LOG_ERROR,
+           "MediaCodec callback bridge class does not meet the jni.h contract\n");
+    bridge->state = -1;
+done:
+    pthread_mutex_unlock(&callback_bridge_lock);
+    return ret;
+}
+
+// The codec's bridge object, created on first use; its Handler is what the
+// platform delivers callbacks on.
+static int mediacodec_jni_bridge_object(JNIEnv *env, FFAMediaCodecJni *codec,
+                                        jobject *handler)
+{
+    jobject object;
+    int ret;
+
+    ret = mediacodec_jni_bridge_resolve(env, codec);
+    if (ret < 0)
+        return ret;
+
+    if (!codec->callback) {
+        object = (*env)->NewObject(env, callback_bridge.cls, callback_bridge.init_id,
+                                   (jlong)(intptr_t)codec);
+        if (ff_jni_exception_check(env, 1, codec) < 0 || !object)
+            return AVERROR_EXTERNAL;
+        codec->callback = (*env)->NewGlobalRef(env, object);
+        (*env)->DeleteLocalRef(env, object);
+        if (!codec->callback)
+            return AVERROR(ENOMEM);
+    }
+
+    *handler = (*env)->CallObjectMethod(env, codec->callback, callback_bridge.handler_id);
+    if (ff_jni_exception_check(env, 1, codec) < 0 || !*handler) {
+        (*env)->DeleteLocalRef(env, *handler);
+        *handler = NULL;
+        return AVERROR_EXTERNAL;
+    }
+    return 0;
+}
+
+static void mediacodec_jni_bridge_release(JNIEnv *env, FFAMediaCodecJni *codec)
+{
+    if (!codec->callback)
+        return;
+    (*env)->CallVoidMethod(env, codec->callback, callback_bridge.release_id);
+    ff_jni_exception_check(env, 1, codec);
+    (*env)->DeleteGlobalRef(env, codec->callback);
+    codec->callback = NULL;
+    codec->rendered_cb = NULL;
+    codec->rendered_userdata = NULL;
+}
+
+static int mediacodec_jni_setAsyncNotifyCallback(FFAMediaCodec *ctx,
                                                  const FFAMediaCodecOnAsyncNotifyCallback *callback,
                                                  void *userdata)
 {
-    av_log(codec, AV_LOG_ERROR, "Doesn't support aync mode with JNI, please try ndk_codec=1\n");
-    return AVERROR(ENOSYS);
+    FFAMediaCodecJni *codec = (FFAMediaCodecJni *)ctx;
+    JNIEnv *env = NULL;
+    jobject handler = NULL;
+    int ret;
+
+    if (!codec->jfields.set_callback_id) {
+        av_log(codec, AV_LOG_ERROR, "setCallback(Callback, Handler) unavailable (API 23)\n");
+        return AVERROR(ENOSYS);
+    }
+    if (!callback ||
+        !callback->onAsyncInputAvailable ||
+        !callback->onAsyncOutputAvailable ||
+        !callback->onAsyncFormatChanged ||
+        !callback->onAsyncError)
+        return AVERROR(EINVAL);
+
+    JNI_GET_ENV_OR_RETURN(env, codec, AVERROR_EXTERNAL);
+
+    ret = mediacodec_jni_bridge_object(env, codec, &handler);
+    if (ret < 0)
+        return ret;
+
+    // Set before the platform can deliver: events follow start(), but the
+    // callback thread has no other guard.
+    codec->async_cb = *callback;
+    codec->async_userdata = userdata;
+
+    (*env)->CallVoidMethod(env, codec->object, codec->jfields.set_callback_id,
+                           codec->callback, handler);
+    (*env)->DeleteLocalRef(env, handler);
+    if (ff_jni_exception_check(env, 1, codec) < 0)
+        return AVERROR_EXTERNAL;
+
+    return 0;
+}
+
+static int mediacodec_jni_setOnFrameRenderedCallback(FFAMediaCodec *ctx,
+        FFAMediaCodecOnFrameRendered callback, void *userdata)
+{
+    FFAMediaCodecJni *codec = (FFAMediaCodecJni *)ctx;
+    JNIEnv *env = NULL;
+    jobject handler = NULL;
+    int ret;
+
+    if (!codec->jfields.set_on_frame_rendered_listener_id)
+        return AVERROR(ENOSYS);
+
+    JNI_GET_ENV_OR_RETURN(env, codec, AVERROR_EXTERNAL);
+
+    if (!callback) {
+        codec->rendered_cb = NULL;
+        codec->rendered_userdata = NULL;
+        if (!codec->callback)
+            return 0;
+        (*env)->CallVoidMethod(env, codec->object,
+                               codec->jfields.set_on_frame_rendered_listener_id, NULL, NULL);
+        if (ff_jni_exception_check(env, 1, codec) < 0)
+            return AVERROR_EXTERNAL;
+        return 0;
+    }
+
+    ret = mediacodec_jni_bridge_object(env, codec, &handler);
+    if (ret < 0)
+        return ret;
+
+    codec->rendered_cb = callback;
+    codec->rendered_userdata = userdata;
+
+    (*env)->CallVoidMethod(env, codec->object,
+                           codec->jfields.set_on_frame_rendered_listener_id,
+                           codec->callback, handler);
+    (*env)->DeleteLocalRef(env, handler);
+    if (ff_jni_exception_check(env, 1, codec) < 0) {
+        codec->rendered_cb = NULL;
+        codec->rendered_userdata = NULL;
+        return AVERROR_EXTERNAL;
+    }
+
+    return 0;
+}
+
+// MediaCodec.setParameters takes a Bundle, and a MediaFormat cannot be
+// enumerated before API 29, so the bridge copies the keys a running codec
+// accepts as parameters (MediaCodec.PARAMETER_KEY_*, operating-rate and
+// priority), typed as the platform declares them. hdr10-plus-info is a
+// ByteBuffer and has no caller here.
+static const struct {
+    const char *key;
+    int is_long;
