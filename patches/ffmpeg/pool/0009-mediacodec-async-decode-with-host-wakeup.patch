+/**
+ * Let a MediaCodec decoder answer EAGAIN on both ports instead of blocking
+ * inside avcodec_send_packet()/avcodec_receive_frame() while the codec is
+ * busy, and call `wakeup` (on a codec-owned thread, never blocking) when it
+ * can make progress again. Without a callback the decoder keeps libavcodec's
+ * contract of never returning EAGAIN from both calls, by waiting on the codec.
+ *
+ * @return 1 when the codec delivers wakeups itself (asynchronous mode), 0 when
+ * it does not and the caller has to poll — `wakeup` is then never called and
+ * a both-EAGAIN answer means "try again shortly" — or AVERROR(ENOSYS) when
+ * `avctx` is not an opened MediaCodec decoder. A NULL `wakeup` unregisters.
+ */
+int av_mediacodec_set_wakeup_callback(AVCodecContext *avctx,
+                                      void (*wakeup)(void *opaque), void *opaque);
+
 #endif /* AVCODEC_MEDIACODEC_H */
