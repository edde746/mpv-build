+// --- Asynchronous MediaCodec -------------------------------------------------
+//
+// With AMediaCodec_setAsyncNotifyCallback the codec pushes free input slots
+// and finished output to these callbacks on its own thread; the decoding
+// thread only pops them, so a codec that has fallen behind never stalls its
+// caller. Flush is where the two threads meet: notifications posted before
+// the flush may still be delivered after it, and nothing in them says so.
+// Two rules make them harmless. A stale input index is refused by
+// getInputBuffer (the codec owns it again after the flush) or, if the codec
+// has meanwhile re-offered the same index, is simply that offer consumed
+// early and its later twin refused the same way. Stale output is recognised
+// by its timestamp: every timestamp handed to the codec carries the flush
+// generation in its upper bits, the codec passes timestamps through, and a
+// buffer from an earlier generation is returned unrendered.
+// Called with async_lock held; the host runs outside it, so nothing it does
+// in response can deadlock against a decoding thread that is about to take
+// the lock. Unregistering through av_mediacodec_set_wakeup_callback waits
+// for a call in flight, so the host may free its opaque once that returns.
+static void mediacodec_dec_wake_host(MediaCodecDecContext *s)
+{
+    void (*wakeup)(void *opaque) = s->wakeup;
+    void *opaque = s->wakeup_opaque;
+
+    if (!wakeup)
+        return;
+    s->wakeup_in_flight++;
+    ff_mutex_unlock(&s->async_lock);
+    wakeup(opaque);
+    ff_mutex_lock(&s->async_lock);
+    if (!--s->wakeup_in_flight)
+        ff_cond_broadcast(&s->async_cond);
+}
+
+static void mediacodec_dec_on_input_available(FFAMediaCodec *codec, void *userdata,
+                                              int32_t index)
+{
+    MediaCodecDecContext *s = userdata;
+
+    ff_mutex_lock(&s->async_lock);
+    if (av_fifo_write(s->async_input, &index, 1) < 0 && !s->async_error)
+        s->async_error = AVERROR(ENOMEM);
+    ff_cond_signal(&s->async_cond);
+    mediacodec_dec_wake_host(s);
+    ff_mutex_unlock(&s->async_lock);
+}
+
+static void mediacodec_dec_on_output_available(FFAMediaCodec *codec, void *userdata,
+                                               int32_t index,
+                                               FFAMediaCodecBufferInfo *info)
+{
+    MediaCodecDecContext *s = userdata;
+    MediaCodecAsyncOutput output = { .index = index, .info = *info };
+
+    ff_mutex_lock(&s->async_lock);
+    if (av_fifo_write(s->async_output, &output, 1) < 0 && !s->async_error)
+        s->async_error = AVERROR(ENOMEM);
+    ff_cond_signal(&s->async_cond);
+    mediacodec_dec_wake_host(s);
+    ff_mutex_unlock(&s->async_lock);
+}
+
+static void mediacodec_dec_on_format_changed(FFAMediaCodec *codec, void *userdata,
+                                             FFAMediaFormat *format)
+{
+    MediaCodecDecContext *s = userdata;
+    MediaCodecAsyncOutput output = { .index = MEDIACODEC_ASYNC_FORMAT_CHANGED };
+
+    // The format itself is read back from the codec when this marker is
+    // reached, so the queue keeps it in order with the buffers it precedes.
+    ff_mutex_lock(&s->async_lock);
+    if (av_fifo_write(s->async_output, &output, 1) < 0 && !s->async_error)
+        s->async_error = AVERROR(ENOMEM);
+    ff_cond_signal(&s->async_cond);
+    mediacodec_dec_wake_host(s);
+    ff_mutex_unlock(&s->async_lock);
+}
+
+static void mediacodec_dec_on_error(FFAMediaCodec *codec, void *userdata,
+                                    int error, const char *detail)
+{
+    MediaCodecDecContext *s = userdata;
+
+    av_log(codec, AV_LOG_ERROR, "Codec error %s (%s)\n", av_err2str(error), detail);
+    ff_mutex_lock(&s->async_lock);
+    if (!s->async_error)
+        s->async_error = error < 0 ? error : AVERROR_EXTERNAL;
+    ff_cond_signal(&s->async_cond);
+    mediacodec_dec_wake_host(s);
+    ff_mutex_unlock(&s->async_lock);
+}
+
+// Between configure and start, where the platform accepts the callback.
+// Failure is not an error: the decoder is complete in synchronous mode.
+static void mediacodec_dec_init_async(AVCodecContext *avctx, MediaCodecDecContext *s)
+{
+    static const FFAMediaCodecOnAsyncNotifyCallback cb = {
+        .onAsyncInputAvailable = mediacodec_dec_on_input_available,
+        .onAsyncOutputAvailable = mediacodec_dec_on_output_available,
+        .onAsyncFormatChanged = mediacodec_dec_on_format_changed,
+        .onAsyncError = mediacodec_dec_on_error,
+    };
+    int ret;
+
+    if (!s->use_async)
+        return;
+    if (!s->use_ndk_codec) {
+        av_log(avctx, AV_LOG_VERBOSE, "Asynchronous mode needs ndk_codec=1\n");
+        return;
+    }
+
+    ff_cond_init(&s->async_cond, NULL);
+    s->async_input = av_fifo_alloc2(16, sizeof(int32_t), AV_FIFO_FLAG_AUTO_GROW);
+    s->async_output = av_fifo_alloc2(16, sizeof(MediaCodecAsyncOutput),
+                                     AV_FIFO_FLAG_AUTO_GROW);
+    if (!s->async_input || !s->async_output) {
+        av_fifo_freep2(&s->async_input);
+        av_fifo_freep2(&s->async_output);
+        ff_cond_destroy(&s->async_cond);
+        return;
+    }
+
+    ret = ff_AMediaCodec_setAsyncNotifyCallback(s->codec, &cb, s);
+    if (ret < 0) {
+        av_log(avctx, AV_LOG_WARNING, "Asynchronous mode refused (%s); "
+               "decoding synchronously\n", av_err2str(ret));
+        av_fifo_freep2(&s->async_input);
+        av_fifo_freep2(&s->async_output);
+        ff_cond_destroy(&s->async_cond);
+        return;
+    }
+    s->async_mode = 1;
+    av_log(avctx, AV_LOG_VERBOSE, "Asynchronous MediaCodec mode\n");
+}
+
+static void mediacodec_dec_uninit_async(MediaCodecDecContext *s)
+{
+    if (!s->async_mode)
+        return;
+    av_fifo_freep2(&s->async_input);
+    av_fifo_freep2(&s->async_output);
+    ff_cond_destroy(&s->async_cond);
+    s->async_mode = 0;
+}
+
+// Whether a blocked caller should keep waiting: the host has no wakeup
+// source of its own, or the stream is being drained, where the reply is the
+// codec's last frames and a poll would spin the caller until they land.
+static int mediacodec_dec_may_block(MediaCodecDecContext *s)
+{
+    // async_lock held.
+    return !s->wakeup || s->draining;
+}
+
+// Wait for a queued notification for at most timeout_us. Returns 0 when
+// something was queued or the wait is over, the sticky codec error otherwise.
+static int mediacodec_dec_async_wait(MediaCodecDecContext *s, AVFifo *fifo,
+                                     int64_t timeout_us)
+{
+    // async_lock held.
+    int64_t deadline = av_gettime_relative() + timeout_us;
+
+    while (!s->async_error && !av_fifo_can_read(fifo)) {
+        int64_t now = av_gettime_relative();
+        struct timespec until;
+        if (now >= deadline || !mediacodec_dec_may_block(s))
+            break;
+        // pthread waits on an absolute CLOCK_REALTIME instant.
+        clock_gettime(CLOCK_REALTIME, &until);
+        until.tv_nsec += (deadline - now) * 1000;
+        until.tv_sec  += until.tv_nsec / 1000000000;
+        until.tv_nsec %= 1000000000;
+        ff_cond_timedwait(&s->async_cond, &s->async_lock, &until);
+    }
+    return s->async_error;
+}
+
+// Whether the host asked, through av_mediacodec_set_wakeup_callback, to be
+// answered EAGAIN on both ports rather than held while the codec is busy.
+int ff_mediacodec_dec_host_polls(MediaCodecDecContext *s)
+{
+    int polls;
+
+    ff_mutex_lock(&s->async_lock);
+    polls = s->wakeup != NULL;
+    ff_mutex_unlock(&s->async_lock);
+    return polls;
+}
+
+// A free input slot: the index, AVERROR(EAGAIN) when none is available within
+// timeout_us, another negative value on a codec error.
+ssize_t ff_mediacodec_dec_dequeue_input(MediaCodecDecContext *s, int64_t timeout_us)
+{
+    int32_t index;
+    int ret;
+
+    if (!s->async_mode) {
+        ssize_t idx = ff_AMediaCodec_dequeueInputBuffer(s->codec, timeout_us);
+        if (ff_AMediaCodec_infoTryAgainLater(s->codec, idx))
+            return AVERROR(EAGAIN);
+        return idx < 0 ? AVERROR_EXTERNAL : idx;
+    }
+
+    ff_mutex_lock(&s->async_lock);
+    ret = mediacodec_dec_async_wait(s, s->async_input, timeout_us);
+    if (ret >= 0)
+        ret = av_fifo_read(s->async_input, &index, 1) >= 0 ? 0 : AVERROR(EAGAIN);
+    ff_mutex_unlock(&s->async_lock);
+    return ret < 0 ? ret : index;
+}
+
+enum {
+    MEDIACODEC_OUTPUT_TRY_AGAIN = 1,
+    MEDIACODEC_OUTPUT_FORMAT_CHANGED,
+    MEDIACODEC_OUTPUT_BUFFERS_CHANGED,
+};
+
+// The next output event: 0 with *index and *info filled for a buffer, one of
+// the MEDIACODEC_OUTPUT_* values for anything else, negative on error.
+static int mediacodec_dec_dequeue_output(MediaCodecDecContext *s, ssize_t *index,
+                                         FFAMediaCodecBufferInfo *info,
+                                         int64_t timeout_us)
+{
+    MediaCodecAsyncOutput output;
+    int ret;
+
+    if (!s->async_mode) {
+        FFAMediaCodec *codec = s->codec;
+        ssize_t idx = ff_AMediaCodec_dequeueOutputBuffer(codec, info, timeout_us);
+        if (idx >= 0) {
+            *index = idx;
+            return 0;
+        }
+        if (ff_AMediaCodec_infoOutputFormatChanged(codec, idx))
+            return MEDIACODEC_OUTPUT_FORMAT_CHANGED;
+        if (ff_AMediaCodec_infoOutputBuffersChanged(codec, idx))
+            return MEDIACODEC_OUTPUT_BUFFERS_CHANGED;
+        if (ff_AMediaCodec_infoTryAgainLater(codec, idx))
+            return MEDIACODEC_OUTPUT_TRY_AGAIN;
+        av_log(s->codec, AV_LOG_ERROR, "Failed to dequeue output buffer (status=%zd)\n", idx);
+        return AVERROR_EXTERNAL;
+    }
+
+    for (;;) {
+        ff_mutex_lock(&s->async_lock);
+        ret = mediacodec_dec_async_wait(s, s->async_output, timeout_us);
+        if (ret >= 0)
+            ret = av_fifo_read(s->async_output, &output, 1) >= 0 ? 0 : MEDIACODEC_OUTPUT_TRY_AGAIN;
+        ff_mutex_unlock(&s->async_lock);
+        if (ret)
+            return ret;
+        if (output.index == MEDIACODEC_ASYNC_FORMAT_CHANGED)
+            return MEDIACODEC_OUTPUT_FORMAT_CHANGED;
+        if (mediacodec_dec_pts_generation(output.info.presentationTimeUs) == s->async_generation)
+            break;
+        // Finished before the flush and reported after it (see above).
+        av_log(s->codec, AV_LOG_DEBUG, "Discarding stale output buffer %" PRId32 "\n",
+               output.index);
+        ff_AMediaCodec_releaseOutputBuffer(s->codec, output.index, 0);
+        timeout_us = 0;
+    }
+    *index = output.index;
+    *info = output.info;
+    return 0;
