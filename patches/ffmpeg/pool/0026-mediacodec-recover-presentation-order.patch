diff --git a/libavcodec/mediacodec_reorder.c b/libavcodec/mediacodec_reorder.c
new file mode 100644
index 0000000..7b513e0
--- /dev/null
+++ b/libavcodec/mediacodec_reorder.c
@@ -0,0 +1,278 @@
+/*
+ * Android MediaCodec presentation-order recovery
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <string.h>
+
+#include "libavutil/avutil.h"
+
+#include "hevc/hevc.h"
+#include "mediacodec_reorder.h"
+
+enum {
+    SLOT_PENDING, // queued, not output yet
+    SLOT_OUTPUT,  // output
+    SLOT_LEADING, // a RASL picture the decoder is expected to skip
+    SLOT_GONE,    // written off: will not be output
+};
+
+// Whether a slot's timestamp belongs to a frame that is or will be output.
+static int expected(const MediaCodecReorderSlot *s)
+{
+    return s->state == SLOT_PENDING || s->state == SLOT_OUTPUT;
+}
+
+// The reorder bound when the stream states none, and how many later-decoded
+// frames may be output before a frame that is still coming: the largest DPB
+// either H.264 or HEVC allows, and the longest B-frame run x264 and x265 write.
+#define MAX_PICTURES 16
+
+static MediaCodecReorderSlot *slot_at(MediaCodecReorder *r, int i)
+{
+    return &r->slot[(r->head + i) % FF_MEDIACODEC_REORDER_SLOTS];
+}
+
+static void reorder_off(MediaCodecReorder *r, const char *reason)
+{
+    r->mode = FF_MEDIACODEC_REORDER_OFF;
+    r->off_reason = reason;
+    r->head = r->count = r->next = 0;
+}
+
+void ff_mediacodec_reorder_init(MediaCodecReorder *r, int depth, int hevc, int enabled)
+{
+    memset(r, 0, sizeof(*r));
+    r->depth = depth > 0 ? depth : MAX_PICTURES;
+    if (r->depth > MAX_PICTURES)
+        r->depth = MAX_PICTURES;
+    r->hevc = hevc;
+    ff_mediacodec_reorder_flush(r);
+    if (!enabled)
+        reorder_off(r, "not a reordering video decoder");
+}
+
+void ff_mediacodec_reorder_flush(MediaCodecReorder *r)
+{
+    r->head = r->count = r->next = 0;
+    r->last_in = r->last_out = AV_NOPTS_VALUE;
+    r->new_sequence = 1;
+    r->skip_rasl = 0;
+}
+
+// The offset of the NAL unit that starts at or after *pos, with *pos moved
+// past its start code; -1 when there is none. Only NAL headers are read,
+// which never hold an emulation prevention byte.
+static int next_nal(const uint8_t *data, int size, int *pos)
+{
+    for (int i = *pos; i + 3 <= size; i++) {
+        if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1) {
+            *pos = i + 3;
+            return i + 3;
+        }
+    }
+    *pos = size;
+    return -1;
+}
+
+// Follows random access through one HEVC access unit and returns whether it
+// is a RASL picture the decoder will not output: one associated with a BLA
+// picture, or with the CRA picture decoding started from (the first IRAP
+// after a flush or an end of sequence, where NoRaslOutputFlag is 1).
+static int hevc_rasl_not_output(MediaCodecReorder *r, const uint8_t *data, int size)
+{
+    int pos = 0, nal, picture = -1, end_of_sequence = 0, not_output = 0;
+
+    while ((nal = next_nal(data, size, &pos)) >= 0) {
+        int type, layer_id;
+        if (nal + 2 > size)
+            break;
+        type     = (data[nal] >> 1) & 0x3f;
+        layer_id = ((data[nal] & 1) << 5) | (data[nal + 1] >> 3);
+        if (type == HEVC_NAL_EOS_NUT || type == HEVC_NAL_EOB_NUT)
+            end_of_sequence = 1;
+        else if (picture < 0 && layer_id == 0 && type <= HEVC_NAL_RSV_VCL31)
+            picture = type;
+    }
+
+    if (picture >= HEVC_NAL_BLA_W_LP && picture <= HEVC_NAL_RSV_IRAP_VCL23) {
+        r->skip_rasl = picture <= HEVC_NAL_BLA_N_LP ||
+                       (picture == HEVC_NAL_CRA_NUT && r->new_sequence);
+        r->new_sequence = 0;
+    } else if (picture == HEVC_NAL_RASL_N || picture == HEVC_NAL_RASL_R) {
+        not_output = r->skip_rasl;
+    }
+    // An end of sequence ends this access unit; the next IRAP starts over.
+    if (end_of_sequence)
+        r->new_sequence = 1;
+    return not_output;
+}
+
+void ff_mediacodec_reorder_input(MediaCodecReorder *r, int64_t pts,
+                                 const uint8_t *data, int size)
+{
+    MediaCodecReorderSlot *s;
+    int not_output = 0;
+
+    if (r->mode == FF_MEDIACODEC_REORDER_OFF)
+        return;
+    if (r->hevc && data && !r->rasl_output)
+        not_output = hevc_rasl_not_output(r, data, size);
+    if (pts == AV_NOPTS_VALUE) {
+        reorder_off(r, "an access unit has no timestamp");
+        return;
+    }
+    // Well-formed B-frame timestamps step back in decode order; so does a
+    // discontinuity. Either way the container's own timestamps stand.
+    if (r->last_in != AV_NOPTS_VALUE && pts <= r->last_in) {
+        reorder_off(r, "timestamps do not increase in decode order");
+        return;
+    }
+    if (r->count == FF_MEDIACODEC_REORDER_SLOTS) {
+        reorder_off(r, "too many frames in flight");
+        return;
+    }
+    r->last_in = pts;
+    s = slot_at(r, r->count++);
+    s->pts   = pts;
+    s->state = not_output ? SLOT_LEADING : SLOT_PENDING;
+    r->leading += not_output;
+}
+
+// Ring position of the slot holding the timestamp of `rank` among the slots
+// still expected to be output; r->count when there is none.
+static int rank_position(MediaCodecReorder *r, int rank)
+{
+    for (int i = 0; i < r->count; i++) {
+        if (!expected(slot_at(r, i)))
+            continue;
+        if (!rank--)
+            return i;
+    }
+    return r->count;
+}
+
+// Writes off the pending frames that can no longer be output: more of the
+// frames before `found` in decode order are missing than may follow it in
+// output order, or more later-decoded frames have been output than may pass
+// a frame that is still coming.
+static void write_off_missing(MediaCodecReorder *r, int found, int missing)
+{
+    int later = 0;
+
+    for (int i = 0; i < found && missing > r->depth; i++) {
+        MediaCodecReorderSlot *s = slot_at(r, i);
+        if (s->state == SLOT_PENDING) {
+            s->state = SLOT_GONE;
+            missing--;
+            r->dropped++;
+        }
+    }
+    for (int i = r->count - 1; i >= 0; i--) {
+        MediaCodecReorderSlot *s = slot_at(r, i);
+        if (s->state == SLOT_OUTPUT) {
+            later++;
+        } else if (s->state == SLOT_PENDING && later > MAX_PICTURES) {
+            s->state = SLOT_GONE;
+            r->dropped++;
+        }
+    }
+}
+
+// Drops the front slots no output needs any more: written off, or output with
+// their timestamp already handed out.
+static void trim(MediaCodecReorder *r)
+{
+    while (r->count) {
+        MediaCodecReorderSlot *s = slot_at(r, 0);
+        if (s->state == SLOT_PENDING)
+            break;
+        if (s->state == SLOT_OUTPUT) {
+            // The front slot expected to be output has rank 0.
+            if (!r->next)
+                break;
+            r->next--;
+        }
+        r->head = (r->head + 1) % FF_MEDIACODEC_REORDER_SLOTS;
+        r->count--;
+    }
+}
+
+int64_t ff_mediacodec_reorder_output(MediaCodecReorder *r, int64_t pts)
+{
+    int found = -1, missing = 0, at;
+    int64_t out = pts;
+
+    if (r->mode == FF_MEDIACODEC_REORDER_OFF || pts == AV_NOPTS_VALUE)
+        return pts;
+
+    // Queued in increasing order yet output going backwards: the decoder
+    // reordered frames whose timestamps were in decode order.
+    if (r->mode == FF_MEDIACODEC_REORDER_ARMED &&
+        r->last_out != AV_NOPTS_VALUE && pts < r->last_out)
+        r->mode = FF_MEDIACODEC_REORDER_ON;
+    r->last_out = pts;
+
+    // This frame's slot: the first with its timestamp not yet output.
+    for (int i = 0; i < r->count; i++) {
+        MediaCodecReorderSlot *s = slot_at(r, i);
+        if (s->state != SLOT_OUTPUT && s->pts == pts) {
+            found = i;
+            break;
+        }
+    }
+    if (found >= 0) {
+        MediaCodecReorderSlot *s = slot_at(r, found);
+        int ranked = rank_position(r, r->next);
+
+        if (s->state == SLOT_LEADING) {
+            // The decoder outputs RASL pictures after all: every one taken
+            // out is coming, and none will be taken out from now on. Each
+            // lying before the slot the next timestamp comes from moves that
+            // rank up by one.
+            for (int i = 0; i < r->count; i++) {
+                MediaCodecReorderSlot *l = slot_at(r, i);
+                if (l->state == SLOT_LEADING) {
+                    l->state = SLOT_PENDING;
+                    r->next += i < ranked;
+                    r->readmitted++;
+                }
+            }
+            r->rasl_output = 1;
+        } else if (s->state == SLOT_GONE) {
+            // Written off, yet output: count it back in.
+            r->next += found < ranked;
+            r->readmitted++;
+        }
+        s->state = SLOT_OUTPUT;
+        for (int i = 0; i < found; i++)
+            missing += slot_at(r, i)->state == SLOT_PENDING;
+        write_off_missing(r, found, missing);
+    }
+
+    at = rank_position(r, r->next);
+    if (at < r->count) {
+        if (r->mode == FF_MEDIACODEC_REORDER_ON) {
+            out = slot_at(r, at)->pts;
+            r->recovered++;
+        }
+        r->next++;
+    }
+    trim(r);
+    return out;
+}
diff --git a/libavcodec/mediacodec_reorder.h b/libavcodec/mediacodec_reorder.h
new file mode 100644
index 0000000..16825cb
--- /dev/null
+++ b/libavcodec/mediacodec_reorder.h
@@ -0,0 +1,124 @@
+/*
+ * Android MediaCodec presentation-order recovery
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef AVCODEC_MEDIACODEC_REORDER_H
+#define AVCODEC_MEDIACODEC_REORDER_H
+
+#include <stdint.h>
+
+/*
+ * A container that stores B-frame video without composition offsets (an MP4
+ * with no ctts box, the product of remuxing a raw H.264/HEVC stream with
+ * generated timestamps) hands every access unit a timestamp in decode order.
+ * MediaCodec echoes each frame's queued timestamp back with the frame, so in
+ * presentation order those timestamps run backwards on every reordered frame.
+ * A libavcodec decoder recovers because its frames also carry the packet DTS
+ * and the player falls back to it; a MediaCodec frame has no DTS, so the
+ * player drops the frames it sees going backwards and falls ever further
+ * behind its audio.
+ *
+ * The module watches for exactly that stream: timestamps strictly increasing
+ * in decode order while the decoder's output steps backwards. Once seen, each
+ * frame is presented at the queued timestamps taken in increasing order, the
+ * order a decoder outputs frames in, which is what VLC does for the same
+ * files. A stream that ever queues a timestamp at or below its predecessor
+ * orders its own timestamps (or is discontinuous), and the module then stays
+ * out of the way for the rest of the session.
+ *
+ * Frames the decoder never outputs would shift every later assignment, so
+ * they are taken out of the timeline: HEVC RASL pictures that follow the
+ * random access point decoding started from are known not to be output when
+ * they are queued, and any other frame is written off once more frames that
+ * precede it in decode order are missing than the stream's reorder bound
+ * allows to follow a frame in output order.
+ *
+ * Timestamps are in microseconds as queued to the codec, untagged;
+ * AV_NOPTS_VALUE marks an access unit without one. The decoding thread owns
+ * the state.
+ */
+
+#define FF_MEDIACODEC_REORDER_SLOTS 64
+
+enum MediaCodecReorderMode {
+    FF_MEDIACODEC_REORDER_OFF   = -1, // settled: timestamps pass through
+    FF_MEDIACODEC_REORDER_ARMED =  0, // watching; timestamps pass through
+    FF_MEDIACODEC_REORDER_ON    =  1, // frames get the queued timestamps in order
+};
+
+typedef struct MediaCodecReorderSlot {
+    int64_t pts;
+    uint8_t state;   // pending, output, taken out as a RASL picture, or written off
+} MediaCodecReorderSlot;
+
+typedef struct MediaCodecReorder {
+    int mode;
+    const char *off_reason;  // why the mode is OFF, NULL otherwise
+    int depth;               // frames that may follow a later-decoded one in output
+    int hevc;                // recognise HEVC leading pictures
+    int64_t last_in;         // last queued timestamp since the flush
+    int64_t last_out;        // last output timestamp since the flush
+
+    // HEVC random access: the next IRAP picture starts decoding (first after a
+    // flush or an end of sequence), whether the current IRAP's RASL pictures
+    // are output, and whether this decoder outputs the RASL pictures it should
+    // skip (then none are taken out when queued).
+    int new_sequence;
+    int skip_rasl;
+    int rasl_output;
+
+    // Queued frames in decode order, which is also timestamp order. `next` is
+    // the rank, among the slots still expected to be output, of the timestamp
+    // the next output frame is given.
+    MediaCodecReorderSlot slot[FF_MEDIACODEC_REORDER_SLOTS];
+    int head, count;
+    int next;
+
+    // Lifetime counters.
+    uint64_t recovered;  // frames given a recovered timestamp
+    uint64_t leading;    // RASL pictures taken out when queued
+    uint64_t dropped;    // frames written off by the reorder bounds
+    uint64_t readmitted; // frames taken or written off that were output after all
+} MediaCodecReorder;
+
+/**
+ * @param depth    the stream's reorder bound (sps_max_num_reorder_pics,
+ *                 num_reorder_frames, has_b_frames); <= 0 when unknown
+ * @param hevc     the stream is HEVC (leading pictures are recognised)
+ * @param enabled  0 leaves the module off for the whole session
+ */
+void ff_mediacodec_reorder_init(MediaCodecReorder *r, int depth, int hevc, int enabled);
+
+/** The codec was flushed: every queued frame is gone. The mode is kept. */
+void ff_mediacodec_reorder_flush(MediaCodecReorder *r);
+
+/**
+ * An access unit was queued to the codec with timestamp `pts`. `data`/`size`
+ * is the Annex B access unit (used for HEVC leading pictures; may be NULL).
+ */
+void ff_mediacodec_reorder_input(MediaCodecReorder *r, int64_t pts,
+                                 const uint8_t *data, int size);
+
+/**
+ * The codec output a frame with timestamp `pts`; call once per frame, in
+ * output order. Returns the timestamp to present it at.
+ */
+int64_t ff_mediacodec_reorder_output(MediaCodecReorder *r, int64_t pts);
+
+#endif /* AVCODEC_MEDIACODEC_REORDER_H */
