         if ((ret = h2645_ps_to_nalu(vps->data, vps->data_size, &vps_data, &vps_data_size)) < 0 ||
             (ret = h2645_ps_to_nalu(sps->data, sps->data_size, &sps_data, &sps_data_size)) < 0 ||
@@ -986,6 +992,15 @@ static av_cold int mediacodec_decode_init(AVCodecContext *avctx)
     s->ctx->profile_override = profile_override;
     s->ctx->codec_name = codec_name;
     codec_name = NULL;
+    // Presentation order for decode-order container timestamps, on the
+    // decoders whose output can come out reordered.
+    ff_mediacodec_reorder_init(&s->ctx->reorder,
+                               FFMAX(s->reorder_depth, avctx->has_b_frames),
+                               avctx->codec_id == AV_CODEC_ID_HEVC,
+                               avctx->codec_id == AV_CODEC_ID_H264 ||
+                               avctx->codec_id == AV_CODEC_ID_HEVC ||
+                               avctx->codec_id == AV_CODEC_ID_MPEG2VIDEO ||
+                               avctx->codec_id == AV_CODEC_ID_MPEG4);
 
     if ((ret = ff_mediacodec_dec_init(avctx, s->ctx, codec_mime, format)) < 0) {
         s->ctx = NULL;
diff --git a/libavcodec/mediacodecdec_common.c b/libavcodec/mediacodecdec_common.c
index d597294..f130825 100644
--- a/libavcodec/mediacodecdec_common.c
+++ b/libavcodec/mediacodecdec_common.c
@@ -114,6 +114,56 @@ static int64_t mediacodec_dec_untag_pts(const MediaCodecDecContext *s, int64_t t
                      << MEDIACODEC_GENERATION_SHIFT);
 }
 
+// Reports presentation-order recovery switching on, or off after it was on.
+static void mediacodec_dec_reorder_changed(AVCodecContext *avctx, MediaCodecDecContext *s,
+                                           int was)
+{
+    if (s->reorder.mode == FF_MEDIACODEC_REORDER_ON)
+        av_log(avctx, AV_LOG_INFO,
+               "Timestamps arrive in decode order but frames come out reordered "
+               "(B-frames muxed without composition offsets); presenting frames "
+               "at the queued timestamps in presentation order\n");
+    else if (was == FF_MEDIACODEC_REORDER_ON)
+        av_log(avctx, AV_LOG_WARNING, "Presentation-order recovery stopped: %s\n",
+               s->reorder.off_reason);
+}
+
