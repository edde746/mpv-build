     MediaCodecShedContext shed;
     int shed_inited;
+    // The SPS reorder bound, for presentation-order recovery
+    // (mediacodec_reorder.h); 0 when the extradata carries no SPS.
+    int reorder_depth;
 } MediaCodecH264DecContext;
 
 // convert: rewrite UNSPEC62 to profile 8.1 and drop UNSPEC63; strip: drop both
@@ -203,6 +206,7 @@ static int h264_set_extradata(AVCodecContext *avctx, FFAMediaFormat *format)
 
         avctx->profile = ff_h264_get_profile(sps);
         avctx->level = sps->level_idc;
+        ((MediaCodecH264DecContext *)avctx->priv_data)->reorder_depth = sps->num_reorder_frames;
 
         if ((ret = h2645_ps_to_nalu(sps->data, sps->data_size, &data, &data_size)) < 0) {
             goto done;
@@ -287,6 +291,8 @@ static int hevc_set_extradata(AVCodecContext *avctx, FFAMediaFormat *format)
         // The highest temporal sub-layer, for the shedding classifier.
         ((MediaCodecH264DecContext *)avctx->priv_data)->shed.hevc_max_sub_layers_minus1 =
             sps->max_sub_layers - 1;
+        ((MediaCodecH264DecContext *)avctx->priv_data)->reorder_depth =
