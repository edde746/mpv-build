From: edde746 <86283021+edde746@users.noreply.github.com>
Date: Thu, 5 Nov 2026 14:00:00 +0100
Subject: [PATCH] h2645_parse: find escapes and start codes a zero pair at a
 time

ff_h2645_extract_rbsp() scans every byte of every H.264/HEVC NAL for
00 00 01 / 00 00 03. Its 64-bit scan stops at each single zero byte,
about one in 256 bytes of coded slice data, and after the first escape
it copies the rest of the NAL one or two bytes per iteration. Under
VideoToolbox the decoder only parses slice headers and hands VT the raw
NAL, so at 4K HEVC 90 Mb/s on an iPhone this scan was 11% of the
player's CPU samples, the largest single FFmpeg leaf.

Look for zero pairs instead: 16 bytes per iteration with NEON on
aarch64, 8 with an exact SWAR test on fast-unaligned 64-bit targets,
and only the rare pair is checked bytewise. After the first escape, the
bytes up to the next escape or start code are copied as one memcpy run.
On an M5 Max host the NEON scan reads HEVC 4K NALs at 44.4 GB/s against
12.5 before (SWAR 19.2); on an iPhone Air, 4K HEVC 90 Mb/s playback
under VideoToolbox spends 9.7% less process CPU. Input dense with zero
pairs is the one case it loses: at ~310 escapes per KB (long zero runs)
the NEON scan reads 0.5 GB/s against 2.5 before, still ~40x a 100 Mb/s
stream; coded slice data carries 0-12 escapes per KB.

Only those builds take the new scan. Without NEON or fast 64-bit loads
its bytewise loop is 1.85-2.5x slower than the original scan, and every
Apple x86_64 and Mac Catalyst slice is configured --disable-asm, which
drops both; those builds keep the original function unchanged.

The result is bit-identical to the original for every input: the same
NAL end (00 00 01 before the first escape; 00 00 01 or 00 00 02 after
it), the same unescaped bytes and padding, and the same
skipped_bytes_pos. Checked by differential testing against the n8.0.1
function in the NEON, SWAR and plain configurations (54M cases each:
exhaustive short inputs over small byte alphabets, start codes and
escapes at every position and block boundary, 2M random buffers; both
padding modes, with and without skipped_bytes_pos), under ASan/UBSan
with buffers sized exactly to the data, and by identical framemd5 of
H.264/HEVC/DV test streams decoded in software and with VideoToolbox.

diff --git a/libavcodec/h2645_parse.c b/libavcodec/h2645_parse.c
index fa57911..eb69d86 100644
--- a/libavcodec/h2645_parse.c
+++ b/libavcodec/h2645_parse.c
@@ -22,6 +22,10 @@
 
 #include "config.h"
 
+#if HAVE_INTRINSICS_NEON && ARCH_AARCH64
+#include <arm_neon.h>
+#endif
+
 #include "libavutil/error.h"
 #include "libavutil/intmath.h"
 #include "libavutil/intreadwrite.h"
@@ -34,6 +38,140 @@
 
 #include "hevc/hevc.h"
 
+/* The zero-pair scan wins only where it tests 16 (NEON) or 8 (SWAR) bytes
+ * per step. Elsewhere its bytewise loop is slower than the original scan
+ * (every Apple x86_64 and Mac Catalyst slice is configured --disable-asm,
+ * which also drops fast_64bit), so those builds keep the original. */
+#define H2645_ZERO_PAIR_SCAN ((HAVE_INTRINSICS_NEON && ARCH_AARCH64) || \
+                              (HAVE_FAST_64BIT && HAVE_FAST_UNALIGNED))
+
+#if H2645_ZERO_PAIR_SCAN
+/**
+ * Return the first position q in [from, length - 3] where src[q] and
+ * src[q + 1] are zero and src[q + 2] is in set (bit n set: byte value n,
+ * for n in 1..3), or -1 if there is none. Reads only src[from, length).
+ *
+ * A zero pair is rare in coded slice data, so a block without one costs
+ * one load pair and a compare; only the pairs found are looked at bytewise.
+ */
+static av_always_inline int find_zero_pair(const uint8_t *src, int from,
+                                           int length, unsigned set)
+{
+    const int last = length - 3;
+    int q = from;
+
+#if HAVE_INTRINSICS_NEON && ARCH_AARCH64
+    for (; q + 17 <= length; q += 16) {
+        uint8x16_t pair = vceqzq_u8(vorrq_u8(vld1q_u8(src + q),
+                                             vld1q_u8(src + q + 1)));
+        /* Four mask bits per byte: bits 4k..4k+3 are set iff src[q + k]
+         * starts a zero pair. */
+        uint64_t m = vget_lane_u64(vreinterpret_u64_u8(
+                         vshrn_n_u16(vreinterpretq_u16_u8(pair), 4)), 0);
+        while (m) {
+            int bit = ff_ctzll(m);
+            int k   = q + (bit >> 2);
+            if (k <= last && src[k + 2] <= 3 && (set >> src[k + 2] & 1))
+                return k;
+            m &= ~(UINT64_C(0xf) << (bit & ~3));
+        }
+    }
+#elif HAVE_FAST_64BIT && HAVE_FAST_UNALIGNED
+    for (; q + 9 <= length; q += 8) {
+        uint64_t a = AV_RL64(src + q) | AV_RL64(src + q + 1);
+        /* High bit of byte k set iff byte k of a is zero, i.e. iff
+         * src[q + k] starts a zero pair; exact, no false positives. */
+        uint64_t m = ~(((a & UINT64_C(0x7f7f7f7f7f7f7f7f)) + UINT64_C(0x7f7f7f7f7f7f7f7f)) |
+                       a | UINT64_C(0x7f7f7f7f7f7f7f7f));
+        while (m) {
+            int k = q + (ff_ctzll(m) >> 3);
+            if (k <= last && src[k + 2] <= 3 && (set >> src[k + 2] & 1))
+                return k;
+            m &= m - 1;
+        }
+    }
+#endif
+    for (; q <= last; q++)
+        if (!src[q] && !src[q + 1] && src[q + 2] <= 3 && (set >> src[q + 2] & 1))
+            return q;
+    return -1;
+}
+
+int ff_h2645_extract_rbsp(const uint8_t *src, int length,
+                          H2645RBSP *rbsp, H2645NAL *nal, int small_padding)
+{
+    int i, si, di;
+    uint8_t *dst;
+
+    nal->skipped_bytes = 0;
+
+    /* Up to the first escape (00 00 03) the NAL is its own RBSP; a start
+     * code (00 00 01) before any escape ends the NAL there. */
+    i = find_zero_pair(src, 0, length, 1 << 1 | 1 << 3);
+    if (i < 0 || src[i + 2] == 1) {
+        if (i >= 0)
+            length = i; // startcode, so we must be past the end
+        if (small_padding) { // no escaped 0
+            nal->data     =
+            nal->raw_data = src;
+            nal->size     =
+            nal->raw_size = length;
+            return length;
+        }
+        i = length;
+    }
+
+    dst = &rbsp->rbsp_buffer[rbsp->rbsp_buffer_size];
+
+    memcpy(dst, src, i);
+    si = di = i;
+    while (si < length) {
+        /* From the first escape on, 00 00 01 and 00 00 02 both end the NAL;
+         * the bytes up to the next escape or end are copied as one run. */
+        int q   = find_zero_pair(src, si, length, 1 << 1 | 1 << 2 | 1 << 3);
+        int end = q < 0 ? length : q;
+
+        memcpy(dst + di, src + si, end - si);
+        di += end - si;
+        si  = end;
+        if (q < 0 || src[q + 2] != 3) // end of the NAL, or next start code
+            break;
+
+        // escape
+        dst[di++] = 0;
+        dst[di++] = 0;
+        si       += 3;
+
+        if (nal->skipped_bytes_pos) {
+            nal->skipped_bytes++;
+            if (nal->skipped_bytes_pos_size < nal->skipped_bytes) {
+                nal->skipped_bytes_pos_size *= 2;
+                av_assert0(nal->skipped_bytes_pos_size >= nal->skipped_bytes);
+                av_reallocp_array(&nal->skipped_bytes_pos,
+                        nal->skipped_bytes_pos_size,
+                        sizeof(*nal->skipped_bytes_pos));
+                if (!nal->skipped_bytes_pos) {
+                    nal->skipped_bytes_pos_size = 0;
+                    return AVERROR(ENOMEM);
+                }
+            }
+            if (nal->skipped_bytes_pos)
+                nal->skipped_bytes_pos[nal->skipped_bytes-1] = di - 1;
+        }
+    }
+
+    memset(dst + di, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+
+    nal->data = dst;
+    nal->size = di;
+    nal->raw_data = src;
+    nal->raw_size = si;
+    rbsp->rbsp_buffer_size += si;
+
+    return si;
+}
+#else /* !H2645_ZERO_PAIR_SCAN */
+
 int ff_h2645_extract_rbsp(const uint8_t *src, int length,
                           H2645RBSP *rbsp, H2645NAL *nal, int small_padding)
 {
@@ -148,6 +286,7 @@ nsc:
 
     return si;
 }
+#endif /* H2645_ZERO_PAIR_SCAN */
 
 static const char *const vvc_nal_type_name[32] = {
     "TRAIL_NUT", // VVC_TRAIL_NUT
