+// Media3 declares the operating rate once its frame-rate estimate settles,
+// which for a container without a frame rate is after the codec's first
+// frames. Use the stream rate rounded to the integer the JNI API accepts.
+static void apply_media3_rate(AVCodecContext *avctx, MediaCodecContext *s)
+{
+    const int rate = lrintf(s->frame_rate);
+    FFAMediaFormat *params;
+    int ret = AVERROR(ENOMEM);
+
+    s->media3_rate_pending = 0;
+    if (rate <= 0) {
+        av_log(avctx, AV_LOG_INFO, "No frame rate: operating-rate stays unset "
+               "(media3_rate)\n");
+        return;
+    }
+    params = ff_AMediaFormat_new(s->use_ndk_codec);
+    if (params) {
+        ff_AMediaFormat_setInt32(params, "operating-rate", rate);
+        ret = ff_AMediaCodec_setParameters(s->ctx->codec, params);
+        ff_AMediaFormat_delete(params);
+    }
+    av_log(avctx, ret < 0 ? AV_LOG_WARNING : AV_LOG_INFO,
+           "Operating rate %d after the first frame %s (media3_rate)\n",
+           rate, ret < 0 ? "refused" : "set");
+}
+
+static int mediacodec_receive_frame_cb(AVCodecContext *avctx, AVFrame *frame)
+{
+    MediaCodecContext *s = avctx->priv_data;
+    int ret = mediacodec_receive_frame(avctx, frame);
+
+    if (ret >= 0 && s->media3_rate_pending)
+        apply_media3_rate(avctx, s);
+    return ret;
+}
