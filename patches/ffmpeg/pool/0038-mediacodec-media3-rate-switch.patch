+// media3_rate's auto: on for MediaTek's decoders and the MStar line it took
+// over (OMX.MS., the MT9630's AV1 decoder), where the declared rate reaches
+// the display's motion processing. On an MT9655 projector with motion
+// processing on (Plezy #2654), 24 fps stuttered with a rate at configure
+// and played smoothly with Media3's keys or with no rate at all; Media3's
+// keys also fixed an MT9630. Everywhere else the rate at configure stays:
+// on a Pixel 7 without it, a 40 Mbps 1080p24 AV1 stream showed about one
+// frame in ten, under Media3 as well (Plezy #2361).
+static int media3_rate_resolve(AVCodecContext *avctx, int option,
+                               const char *codec_name)
+{
+    static const char *const vendors[] = { "c2.mtk.", "OMX.MTK.", "OMX.MS." };
+
+    if (option >= 0)
+        return option;
+    for (int i = 0; codec_name && i < FF_ARRAY_ELEMS(vendors); i++) {
+        if (av_strstart(codec_name, vendors[i], NULL)) {
+            av_log(avctx, AV_LOG_INFO, "media3_rate on by default for %s\n",
+                   codec_name);
+            return 1;
+        }
+    }
+    return 0;
+}
