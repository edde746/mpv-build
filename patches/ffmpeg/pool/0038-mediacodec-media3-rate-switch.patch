+char *ff_mediacodec_dec_codec_name(AVCodecContext *avctx, const char *mime,
+                                   int profile_override)
+{
+    const int profile = profile_override > 0
+        ? profile_override
+        : ff_AMediaCodecProfile_getProfileFromAVCodecContext(avctx);
+    char *name;
+
+    if (profile < 0)
+        av_log(avctx, AV_LOG_WARNING, "Unsupported or unknown profile\n");
+    name = ff_AMediaCodecList_getCodecNameByType(mime, profile, 0,
+                                                 profile_override > 0, avctx);
+    if (!name && (avctx->hwaccel_flags & AV_HWACCEL_FLAG_ALLOW_PROFILE_MISMATCH))
+        name = ff_AMediaCodecList_getCodecNameByType(mime, -1, 0,
+                                                     profile_override > 0, avctx);
+    return name;
+}
