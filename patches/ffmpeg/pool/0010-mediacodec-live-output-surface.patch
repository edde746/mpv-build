+// Repoint the decoder's output. The codec acquires its own reference to the
+// new window's producer; the one wrapped here replaces the configure-time
+// window so release drops exactly what is still attached.
+static int mediacodec_ndk_setOutputSurface(FFAMediaCodec *ctx, FFANativeWindow *window)
+{
+    FFAMediaCodecNdk *codec = (FFAMediaCodecNdk *)ctx;
+    ANativeWindow *native_window = NULL;
+    int owned = 0;
+    media_status_t status;
+
+    if (!codec->setOutputSurface)
+        return AVERROR(ENOSYS);
+    if (!window)
+        return AVERROR(EINVAL);
+
+    if (window->surface) {
+        JNIEnv *env = NULL;
+        JNI_GET_ENV_OR_RETURN(env, ctx, AVERROR_EXTERNAL);
+        native_window = ANativeWindow_fromSurface(env, window->surface);
+        owned = 1;
+    } else if (window->native_window) {
+        native_window = window->native_window;
+    }
+    if (!native_window)
+        return AVERROR(EINVAL);
+
+    status = codec->setOutputSurface(codec->impl, native_window);
+    if (status != AMEDIA_OK) {
+        if (owned)
+            ANativeWindow_release(native_window);
+        av_log(codec, AV_LOG_ERROR, "setOutputSurface failed, %d\n", status);
+        return AVERROR_EXTERNAL;
+    }
+
+    if (codec->window)
+        ANativeWindow_release(codec->window);
+    codec->window = owned ? native_window : NULL;
+    return 0;
+}
