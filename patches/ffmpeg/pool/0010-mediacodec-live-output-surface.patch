+// Every open MediaCodec decoder, so a hardware device's surface can be
+// swapped underneath the ones it created. Decoders register once their codec
+// exists and leave on close; a closed decoder's in-flight buffers still hold
+// the context, but nothing renders through them any more.
+static AVMutex registry_lock = AV_MUTEX_INITIALIZER;
+static MediaCodecDecContext **registry;
+static int registry_count;
+
+void ff_mediacodec_dec_register(MediaCodecDecContext *s)
+{
+    ff_mutex_lock(&registry_lock);
+    if (av_dynarray_add_nofree(&registry, &registry_count, s) < 0)
+        av_log(s->codec, AV_LOG_WARNING, "Decoder not registered for surface swaps\n");
+    ff_mutex_unlock(&registry_lock);
+}
+
+void ff_mediacodec_dec_unregister(MediaCodecDecContext *s)
+{
+    ff_mutex_lock(&registry_lock);
+    for (int i = 0; i < registry_count; i++) {
+        if (registry[i] != s)
+            continue;
+        registry[i] = registry[--registry_count];
+        break;
+    }
+    if (!registry_count)
+        av_freep(&registry);
+    ff_mutex_unlock(&registry_lock);
+}
+
 AVMediaCodecContext *av_mediacodec_alloc_context(void)
 {
     return av_mallocz(sizeof(AVMediaCodecContext));
@@ -171,6 +203,31 @@ int av_mediacodec_set_wakeup_callback(AVCodecContext *avctx,
     return s->async_mode ? 1 : 0;
 }
 
+int av_mediacodec_hwdevice_set_surface(AVBufferRef *device_ref, void *surface)
+{
+    AVHWDeviceContext *device = device_ref ? (AVHWDeviceContext *)device_ref->data : NULL;
+    AVMediaCodecDeviceContext *hwctx;
+    int ret = 0;
+
+    if (!device || device->type != AV_HWDEVICE_TYPE_MEDIACODEC || !surface)
+        return AVERROR(EINVAL);
+    hwctx = device->hwctx;
+
+    ff_mutex_lock(&registry_lock);
+    for (int i = 0; i < registry_count; i++) {
+        MediaCodecDecContext *s = registry[i];
+        if (!s->device_ref || s->device_ref->data != device_ref->data)
+            continue;
+        ret = ff_mediacodec_dec_set_surface(s->avctx, s, surface, NULL);
+        if (ret < 0)
+            break;
+    }
+    if (ret >= 0)
+        hwctx->surface = surface;
+    ff_mutex_unlock(&registry_lock);
+    return ret;
+}
+
 #else
 
 #include <stdlib.h>
@@ -221,4 +278,9 @@ int av_mediacodec_set_wakeup_callback(AVCodecContext *avctx,
     return AVERROR(ENOSYS);
 }
 
+int av_mediacodec_hwdevice_set_surface(AVBufferRef *device_ref, void *surface)
+{
+    return AVERROR(ENOSYS);
+}
+
 #endif
