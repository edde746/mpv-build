 {
     MediaCodecH264DecContext *s = avctx->priv_data;
@@ -313,54 +332,215 @@ static int common_set_extradata(AVCodecContext *avctx, FFAMediaFormat *format)
  * only when a "video/dolby-vision" MediaCodec decodes the stream. For the
  * single-layer profiles (dvhe.05, dvhe.08) the HEVC bitstream - with its
  * in-band RPU NALs - is fed to the DV decoder unchanged; only the MIME and
- * the profile/level format keys differ. The dual-layer profile 7 would need
- * enhancement-layer handling and stays on the plain HEVC decoder (base
- * layer only).
+ * the profile/level format keys differ.
+ *
+ * The dual-layer profile 7 has three outcomes, mirroring the decision tree
+ * of Plezy's ExoPlayer DoviBridge:
+ *   - a decoder advertising exact profile 7 gets the muxed BL+EL+RPU
+ *     stream unchanged (native);
+ *   - otherwise, with libdovi available and a profile 8 decoder present,
+ *     the RPU is converted to profile 8.1 per packet and the enhancement
+ *     layer dropped (convert);
+ *   - otherwise the plain HEVC decoder renders the base layer, optionally
+ *     with the DV NALs stripped (strip / fallback).
  */
+static int dv_probe_profile(AVCodecContext *avctx, const char *mime, int profile)
+{
+    /* Requires a JVM (JNI MediaCodecList); returns NULL otherwise, which
+     * keeps the plain HEVC decoder - as does the absence of a hardware DV
+     * decoder advertising this profile. */
+    char *codec_name = ff_AMediaCodecList_getCodecNameByType(mime, profile, 0, avctx);
+    if (!codec_name)
+        return 0;
+    av_freep(&codec_name);
+    return 1;
+}
+
 static void dolby_vision_override(AVCodecContext *avctx, FFAMediaFormat *format,
                                   const char **mime, int *profile_override)
 {
     static const char dv_mime[] = "video/dolby-vision";
+    MediaCodecH264DecContext *s = avctx->priv_data;
     const AVPacketSideData *sd =
         av_packet_side_data_get(avctx->coded_side_data, avctx->nb_coded_side_data,
                                 AV_PKT_DATA_DOVI_CONF);
     const AVDOVIDecoderConfigurationRecord *cfg;
-    char *codec_name;
-    int profile, level;
+    int profile = 0, level, convert = 0;
 
     if (!sd || sd->size < sizeof(*cfg))
         return;
     cfg = (const AVDOVIDecoderConfigurationRecord *)sd->data;
-    if (!cfg->rpu_present_flag || cfg->el_present_flag)
-        return;
-    if (cfg->dv_profile != 5 && cfg->dv_profile != 8)
+    if (!cfg->rpu_present_flag)
         return;
+    level = cfg->dv_level > 0 ? 1 << (cfg->dv_level - 1) : 0;
 
     /* MediaCodecInfo.CodecProfileLevel: DolbyVisionProfile* == 1 << dv_profile,
      * DolbyVisionLevel* == 1 << (dv_level - 1). */
-    profile = 1 << cfg->dv_profile;
-    level = cfg->dv_level > 0 ? 1 << (cfg->dv_level - 1) : 0;
-
-    /* Requires a JVM (JNI MediaCodecList); returns NULL otherwise, which
-     * keeps the plain HEVC decoder - as does the absence of a hardware DV
-     * decoder advertising this profile. */
-    codec_name = ff_AMediaCodecList_getCodecNameByType(dv_mime, profile, 0, avctx);
-    if (!codec_name) {
-        av_log(avctx, AV_LOG_VERBOSE,
-               "No hardware decoder for %s profile 0x%x, using the base layer\n",
-               dv_mime, profile);
+    if (!cfg->el_present_flag) {
+        if (!s->dolby_vision)
+            return;
+        if (cfg->dv_profile != 5 && cfg->dv_profile != 8)
+            return;
+        if (!dv_probe_profile(avctx, dv_mime, 1 << cfg->dv_profile)) {
+            av_log(avctx, AV_LOG_VERBOSE,
+                   "No hardware decoder for %s profile 0x%x, using the base layer\n",
+                   dv_mime, 1 << cfg->dv_profile);
+            return;
+        }
+        profile = 1 << cfg->dv_profile;
+    } else if (cfg->dv_profile == 7) {
+        int mode = s->dv_p7_mode;
+
+        /* With the DV decoder path disabled entirely, the only useful action
+         * for profile 7 is sparing the plain HEVC decoder the DV NALs. */
+        if (!s->dolby_vision)
+            mode = DV_P7_STRIP;
+        if (mode == DV_P7_STRIP) {
+            av_log(avctx, AV_LOG_INFO,
+                   "Dolby Vision profile 7: stripping DV metadata for the HEVC base layer\n");
+            s->dv_filter = DV_FILTER_STRIP;
+            return;
+        }
+        if ((mode == DV_P7_AUTO || mode == DV_P7_NATIVE) &&
+            dv_probe_profile(avctx, dv_mime, 1 << 7)) {
+            profile = 1 << 7;
+        }
+#if CONFIG_LIBDOVI
+        if (!profile && mode != DV_P7_NATIVE &&
+            dv_probe_profile(avctx, dv_mime, 1 << 8)) {
+            profile = 1 << 8;
+            convert = 1;
+        }
+#endif
+        if (!profile) {
+            av_log(avctx, AV_LOG_VERBOSE,
+                   "No usable Dolby Vision profile 7 path, using the base layer\n");
+            return;
+        }
+    } else {
         return;
     }
-    av_log(avctx, AV_LOG_INFO, "Dolby Vision profile %d.%d: using %s (%s)\n",
-           cfg->dv_profile, cfg->dv_bl_signal_compatibility_id, dv_mime, codec_name);
-    av_freep(&codec_name);
 
+    av_log(avctx, AV_LOG_INFO, "Dolby Vision profile %d.%d: using %s (0x%x%s)\n",
+           cfg->dv_profile, cfg->dv_bl_signal_compatibility_id, dv_mime, profile,
+           convert ? ", converting RPU to profile 8.1" : "");
+
+    if (convert)
+        s->dv_filter = DV_FILTER_CONVERT;
     *mime = dv_mime;
     *profile_override = profile;
     ff_AMediaFormat_setInt32(format, "profile", profile);
     if (level)
         ff_AMediaFormat_setInt32(format, "level", level);
 }
