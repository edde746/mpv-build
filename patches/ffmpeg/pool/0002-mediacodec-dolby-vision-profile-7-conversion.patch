+// Dolby Vision profile 7 packet filters: convert rewrites the RPU (UNSPEC62)
+// to profile 8.1 and drops the enhancement layer (UNSPEC63); strip drops both.
+#define DV_FILTER_NONE    0
+#define DV_FILTER_CONVERT 1
+#define DV_FILTER_STRIP   2
+
+// dv_p7_mode option values.
+#define DV_P7_AUTO    0
+#define DV_P7_NATIVE  1
+#define DV_P7_CONVERT 2
+#define DV_P7_STRIP   3
+
