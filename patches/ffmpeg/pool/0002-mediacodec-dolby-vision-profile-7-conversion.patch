+static const uint8_t *dv_next_startcode(const uint8_t *p, const uint8_t *end)
+{
+    for (; p + 3 <= end; p++) {
+        if (p[0] == 0 && p[1] == 0 && p[2] == 1)
+            return p;
+    }
+    return end;
+}
+
+/*
+ * Rewrite one annex-B access unit according to s->dv_filter: drop UNSPEC63
+ * (enhancement layer) NALs and either drop or convert-to-8.1 the UNSPEC62
+ * (RPU) NALs. Runs on every packet of a profile 7 stream; the packet buffer
+ * is only replaced when something actually changed.
+ */
+static int dv_filter_packet(AVCodecContext *avctx, AVPacket *pkt)
+{
+    MediaCodecH264DecContext *s = avctx->priv_data;
+    const uint8_t *data = pkt->data, *end = pkt->data + pkt->size;
+    const uint8_t *sc;
+    AVBufferRef *buf;
+    uint8_t *out;
+    size_t out_size = 0, out_cap;
+    int changed = 0;
+
+    if (!pkt->size)
+        return 0;
+
+    /* Converted RPUs are ~2 KiB; generous headroom avoids a sizing pass. */
+    out_cap = (size_t)pkt->size + 8192 + AV_INPUT_BUFFER_PADDING_SIZE;
+    buf = av_buffer_alloc(out_cap);
+    if (!buf)
+        return AVERROR(ENOMEM);
+    out = buf->data;
+
+    sc = dv_next_startcode(data, end);
+    memcpy(out, data, sc - data);
+    out_size += sc - data;
+
+    while (sc < end) {
+        const uint8_t *nal = sc + 3;
+        const uint8_t *region = sc, *next_sc, *next_region;
+        int type;
+
+        if (region > data && region[-1] == 0)
+            region--;
+        next_sc = dv_next_startcode(nal, end);
+        next_region = next_sc;
+        if (next_region > nal && next_region < end && next_region[-1] == 0)
+            next_region--;
+
+        type = nal < end ? (nal[0] >> 1) & 0x3f : -1;
+
+        if (type == 63) {
+            changed = 1;
+        } else if (type == 62 && s->dv_filter == DV_FILTER_STRIP) {
+            changed = 1;
+        } else if (type == 62 && s->dv_filter == DV_FILTER_CONVERT) {
+#if CONFIG_LIBDOVI
+            static const uint8_t sc4[4] = { 0, 0, 0, 1 };
+            DoviRpuOpaque *rpu = dovi_parse_unspec62_nalu(nal, next_region - nal);
+            const DoviData *rpu_out = NULL;
+
+            /* Mode 2: profile 8.1 compatible, mapping curves set to no-op -
+             * the same conversion Plezy's ExoPlayer DoviBridge applies. */
+            if (rpu && !dovi_rpu_get_error(rpu) && !dovi_convert_rpu_with_mode(rpu, 2))
+                rpu_out = dovi_write_unspec62_nalu(rpu);
+
+            if (rpu_out && rpu_out->data && rpu_out->len &&
+                out_size + 4 + rpu_out->len + AV_INPUT_BUFFER_PADDING_SIZE <= out_cap) {
+                memcpy(out + out_size, sc4, 4);
+                out_size += 4;
+                memcpy(out + out_size, rpu_out->data, rpu_out->len);
+                out_size += rpu_out->len;
+            } else if (!s->dv_filter_warned) {
+                av_log(avctx, AV_LOG_WARNING,
+                       "Dolby Vision RPU conversion failed, dropping RPU NAL\n");
+                s->dv_filter_warned = 1;
+            }
+            if (rpu_out)
+                dovi_data_free(rpu_out);
+            if (rpu)
+                dovi_rpu_free(rpu);
+            changed = 1;
+#else
+            memcpy(out + out_size, region, next_region - region);
+            out_size += next_region - region;
+#endif
+        } else {
+            memcpy(out + out_size, region, next_region - region);
+            out_size += next_region - region;
+        }
+        sc = next_sc;
+    }
+
+    if (!changed) {
+        av_buffer_unref(&buf);
+        return 0;
+    }
+
+    memset(out + out_size, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+    av_buffer_unref(&pkt->buf);
+    pkt->buf = buf;
+    pkt->data = out;
+    pkt->size = out_size;
+    return 0;
+}
 #endif
 
