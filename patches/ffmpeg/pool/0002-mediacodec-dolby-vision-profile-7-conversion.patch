+static const uint8_t *dv_next_startcode(const uint8_t *p, const uint8_t *end)
+{
+    for (; end - p >= 3; p++) {
+        if (p[0] == 0 && p[1] == 0 && p[2] == 1)
+            return p;
+    }
+    return end;
+}
+
+/* All output paths, including unchanged NALs after expanded RPUs, share this
+ * capacity check. AVPacket.size and its required padding must fit in int. */
+static int dv_packet_reserve(AVBufferRef **buf, size_t used, size_t extra)
+{
+    const size_t limit = INT_MAX - AV_INPUT_BUFFER_PADDING_SIZE;
+    size_t needed, capacity;
+
+    if (used > limit || extra > limit - used)
+        return AVERROR(ENOMEM);
+    needed = used + extra + AV_INPUT_BUFFER_PADDING_SIZE;
+    if (*buf && needed <= (*buf)->size)
+        return 0;
+    capacity = *buf ? (*buf)->size : 0;
+    capacity = FFMAX(needed, FFMIN((size_t)INT_MAX, capacity + capacity / 2));
+    return av_buffer_realloc(buf, capacity);
+}
+
+static int dv_packet_append(AVBufferRef **buf, size_t *used,
+                            const uint8_t *data, size_t size)
+{
+    int ret = dv_packet_reserve(buf, *used, size);
+    if (ret < 0)
+        return ret;
+    memcpy((*buf)->data + *used, data, size);
+    *used += size;
+    return 0;
+}
+
+static int dv_sei_value(const uint8_t **p, const uint8_t *end, size_t *value)
+{
+    *value = 0;
+    while (*p < end) {
+        unsigned byte = *(*p)++;
+        if (*value > SIZE_MAX - byte)
+            return 0;
+        *value += byte;
+        if (byte != 255)
+            return 1;
+    }
+    return 0;
+}
+
+/*
+ * Filter individual ST 2094-40 messages, not their enclosing prefix/suffix
+ * SEI NAL. Validate the complete RBSP before committing any output: malformed
+ * headers, sizes, trailing bits or emulation prevention preserve the original
+ * NAL, including messages after an otherwise recognizable HDR10+ payload.
+ * Return 1 when rewritten/removed, 0 when unchanged, or an allocation error.
+ */
+static int dv_filter_sei(AVBufferRef **buf, size_t *used,
+                         const uint8_t *region, const uint8_t *nal,
+                         const uint8_t *end)
+{
+    const uint8_t *p, *payload_end;
+    uint8_t *rbsp, *dst;
+    size_t rbsp_size = 0, kept = 0, escaped_size = 0;
+    unsigned zeros = 0;
+    int removed = 0, ret = 0;
+
+    if (end - nal < 3)
+        return 0;
+    /* Annex-B trailing_zero_8bits are outside the RBSP. */
+    while (end > nal + 2 && end[-1] == 0)
+        end--;
+    rbsp = av_malloc(end - nal);
+    if (!rbsp)
+        return AVERROR(ENOMEM);
+    for (p = nal + 2; p < end; p++) {
+        if (zeros == 2) {
+            if (*p == 3) {
+                if (end - p < 2 || p[1] > 3)
+                    goto done;
+                zeros = 0;
+                continue;
+            }
+            if (*p < 3)
+                goto done;
+        }
+        rbsp[rbsp_size++] = *p;
+        zeros = *p == 0 ? zeros + 1 : 0;
+    }
+    if (!rbsp_size || rbsp[rbsp_size - 1] != 0x80)
+        goto done;
+    p = rbsp;
+    payload_end = rbsp + rbsp_size - 1;
+    while (p < payload_end) {
+        const uint8_t *message = p;
+        size_t type, size;
+        if (!dv_sei_value(&p, payload_end, &type) ||
+            !dv_sei_value(&p, payload_end, &size) ||
+            size > (size_t)(payload_end - p))
+            goto done;
+        if (type == 4 && size >= 7 &&
+            p[0] == 0xB5 && p[1] == 0 && p[2] == 0x3C &&
+            p[3] == 0 && p[4] == 1 && p[5] == 4 &&
+            (p[6] == 0 || p[6] == 1)) {
+            removed = 1;
+        } else {
+            size_t message_size = p - message + size;
+            memmove(rbsp + kept, message, message_size);
+            kept += message_size;
+        }
+        p += size;
+    }
+    if (!removed)
+        goto done;
+    if (!kept) {
+        ret = 1;
+        goto done;
+    }
+    rbsp[kept++] = 0x80;
+    /* Re-escape across newly adjacent message boundaries as well. */
+    zeros = 0;
+    for (size_t i = 0; i < kept; i++) {
+        if (zeros == 2 && rbsp[i] <= 3) {
+            escaped_size++;
+            zeros = 0;
+        }
+        escaped_size++;
+        zeros = rbsp[i] == 0 ? zeros + 1 : 0;
+    }
+    ret = dv_packet_reserve(buf, *used, nal + 2 - region + escaped_size);
+    if (ret < 0)
+        goto done;
+    dst = (*buf)->data + *used;
+    memcpy(dst, region, nal + 2 - region);
+    dst += nal + 2 - region;
+    zeros = 0;
+    for (size_t i = 0; i < kept; i++) {
+        if (zeros == 2 && rbsp[i] <= 3) {
+            *dst++ = 3;
+            zeros = 0;
+        }
+        *dst++ = rbsp[i];
+        zeros = rbsp[i] == 0 ? zeros + 1 : 0;
+    }
+    *used = dst - (*buf)->data;
+    ret = 1;
+done:
+    av_free(rbsp);
+    return ret;
+}
+
+/*
+ * Rewrite an Annex-B access unit. Only convert/strip modes remove UNSPEC63;
+ * native DV preserves BL+EL+RPU even when HDR10+ SEI filtering is armed.
+ */
+static int dv_filter_packet(AVCodecContext *avctx, AVPacket *pkt)
+{
+    MediaCodecH264DecContext *s = avctx->priv_data;
+    const uint8_t *data, *end, *sc;
+    AVBufferRef *buf = NULL;
+    size_t out_size = 0, head_size;
+    int changed = 0, ret;
+
+    if (!pkt->size)
+        return 0;
+    data = pkt->data;
+    end = data + pkt->size;
+    ret = dv_packet_reserve(&buf, 0, pkt->size);
+    if (ret < 0)
+        return ret;
+
+    sc = dv_next_startcode(data, end);
+    head_size = sc - data;
+    if (sc > data && sc < end && sc[-1] == 0)
+        head_size--;
+    ret = dv_packet_append(&buf, &out_size, data, head_size);
+    if (ret < 0)
+        goto fail;
+
+    while (sc < end) {
+        const uint8_t *nal = sc + 3;
+        const uint8_t *region = sc, *next_sc, *next_region;
+        int type;
+
+        if (region > data && region[-1] == 0)
+            region--;
+        next_sc = dv_next_startcode(nal, end);
+        next_region = next_sc;
+        if (next_region > nal && next_region < end && next_region[-1] == 0)
+            next_region--;
+        type = next_region - nal >= 2 ? (nal[0] >> 1) & 0x3f : -1;
+
+        if ((type == 63 && s->dv_filter != DV_FILTER_NONE) ||
+            (type == 62 && s->dv_filter == DV_FILTER_STRIP)) {
+            changed = 1;
+        } else if ((type == 39 || type == 40) && s->dv_strip_hdr10plus) {
+            ret = dv_filter_sei(&buf, &out_size, region, nal, next_region);
+            if (ret < 0)
+                goto fail;
+            if (ret)
+                changed = 1;
+            else if ((ret = dv_packet_append(&buf, &out_size, region,
+                                             next_region - region)) < 0)
+                goto fail;
+        } else if (type == 62 && s->dv_filter == DV_FILTER_CONVERT) {
+#if CONFIG_LIBDOVI
+            static const uint8_t sc4[4] = { 0, 0, 0, 1 };
+            DoviRpuOpaque *rpu = dovi_parse_unspec62_nalu(nal, next_region - nal);
+            const DoviData *rpu_out = NULL;
+
+            /* Mode 2: profile 8.1 compatible, mapping curves set to no-op. */
+            if (rpu && !dovi_rpu_get_error(rpu) && !dovi_convert_rpu_with_mode(rpu, 2))
+                rpu_out = dovi_write_unspec62_nalu(rpu);
+
+            ret = 0;
+            if (rpu_out && rpu_out->data && rpu_out->len) {
+                ret = dv_packet_append(&buf, &out_size, sc4, sizeof(sc4));
+                if (ret >= 0)
+                    ret = dv_packet_append(&buf, &out_size, rpu_out->data, rpu_out->len);
+            } else if (!s->dv_filter_warned) {
+                av_log(avctx, AV_LOG_WARNING,
+                       "Dolby Vision RPU conversion failed, dropping RPU NAL\n");
+                s->dv_filter_warned = 1;
+            }
+            if (rpu_out)
+                dovi_data_free(rpu_out);
+            if (rpu)
+                dovi_rpu_free(rpu);
+            if (ret < 0)
+                goto fail;
+            changed = 1;
+#else
+            ret = dv_packet_append(&buf, &out_size, region, next_region - region);
+            if (ret < 0)
+                goto fail;
+#endif
+        } else {
+            ret = dv_packet_append(&buf, &out_size, region, next_region - region);
+            if (ret < 0)
+                goto fail;
+        }
+        sc = next_sc;
+    }
+
+    if (!changed) {
+        av_buffer_unref(&buf);
+        return 0;
+    }
+    if (!out_size) {
+        av_buffer_unref(&buf);
+        av_packet_unref(pkt);
+        return 0;
+    }
+    memset(buf->data + out_size, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+    av_buffer_unref(&pkt->buf);
+    pkt->buf = buf;
+    pkt->data = buf->data;
+    pkt->size = out_size;
+    return 0;
+fail:
+    av_buffer_unref(&buf);
+    return ret;
+}
 #endif
 
