Subject: [PATCH] dovi: rewrite a profile 7 RPU as profile 8.1 in one place

Both decode paths that can only take Dolby Vision profile 8.1 did the
conversion themselves: the MediaCodec packet filter and the VideoToolbox
sample appender. The same libdovi parse, convert and write sequence existed
twice, with two different failure policies -- one warned once per stream and
dropped the RPU, the other warned on every failure -- and nowhere to fix it
once.

libdovi's mode 2 conversion and its error handling now live in one helper,
and both call sites use it. A failure is logged there, and the caller drops
the NAL; the frame decodes through its base layer either way.

It also refuses the one RPU shape libdovi before 3.4.0 cannot survive: a
payload that, with its emulation prevention bytes cleared and its trailing
zero bytes trimmed, is shorter than the prefix, CRC32 and final byte libdovi
then indexes. libdovi 3.3.2 panics there, which aborts the process through
its C API. Android builds libdovi from source with its own bounds patch, but
the apple group links the prebuilt 3.3.2, which has none, so the check lives
here where both reach it, with libdovi 3.4.0's bound (7 bytes). Everything
else libdovi rejects keeps going through its error path.

The helper is only built where a caller is (MediaCodec or VideoToolbox), so
it sits in series.common and costs the other groups one configure entry.
The libdovi configure registration travels with it: a series that enabled
the helper without enabling the library would build the stub below and fail
every profile 7 conversion at runtime.

diff --git a/configure b/configure
index 083bd652c4..eec1c1c441 100755
--- a/configure
+++ b/configure
@@ -2061,6 +2061,7 @@ EXTERNAL_LIBRARY_LIST="
     libcaca
     libcodec2
     libdav1d
+    libdovi
     libdc1394
     libflite
     libfontconfig
@@ -7240,6 +7241,7 @@ enabled libcaca           && require_pkg_config libcaca caca caca.h caca_create_
 enabled libcodec2         && require libcodec2 codec2/codec2.h codec2_create -lcodec2
 enabled libcurl           && check_pkg_config libcurl "libcurl >= 7.88.0" curl/curl.h curl_easy_init
 enabled libdav1d          && require_pkg_config libdav1d "dav1d >= 1.0.0" "dav1d/dav1d.h" dav1d_version
+enabled libdovi           && require libdovi libdovi/rpu_parser.h dovi_parse_unspec62_nalu -ldovi
 enabled libdavs2          && require_pkg_config libdavs2 "davs2 >= 1.6.0" davs2.h davs2_decoder_open
 enabled libdc1394         && require_pkg_config libdc1394 libdc1394-2 dc1394/dc1394.h dc1394_new
 enabled libdrm            && check_pkg_config libdrm libdrm xf86drm.h drmGetVersion
diff --git a/libavcodec/Makefile b/libavcodec/Makefile
index 2ea4f9417e..0130207438 100644
--- a/libavcodec/Makefile
+++ b/libavcodec/Makefile
@@ -103,6 +103,8 @@ OBJS-$(CONFIG_D3D12VA_ENCODE)          += d3d12va_encode.o hw_base_encode.o
 OBJS-$(CONFIG_DEFLATE_WRAPPER)         += zlib_wrapper.o
 OBJS-$(CONFIG_DOVI_RPUDEC)             += dovi_rpu.o dovi_rpudec.o
 OBJS-$(CONFIG_DOVI_RPUENC)             += dovi_rpu.o dovi_rpuenc.o
+OBJS-$(CONFIG_MEDIACODEC)              += dovi_convert.o
+OBJS-$(CONFIG_VIDEOTOOLBOX)            += dovi_convert.o
 OBJS-$(CONFIG_ERROR_RESILIENCE)        += error_resilience.o
 OBJS-$(CONFIG_EVCPARSE)                += evc_parse.o evc_ps.o
 OBJS-$(CONFIG_FAANDCT)                 += faandct.o
@@ -1381,6 +1383,8 @@ SKIPHEADERS-$(CONFIG_VULKAN)           += ffv1_vulkan.h prores_vulkan.h vulkan_v
                                           vulkan_encode.h vulkan_decode.h
 SKIPHEADERS-$(CONFIG_V4L2_M2M)         += v4l2_buffers.h v4l2_context.h v4l2_m2m.h
 SKIPHEADERS-$(CONFIG_ZLIB)             += zlib_wrapper.h
+SKIPHEADERS-$(CONFIG_MEDIACODEC)       += dovi_convert.h
+SKIPHEADERS-$(CONFIG_VIDEOTOOLBOX)     += dovi_convert.h
 
 TESTPROGS = avcodec                                                     \
             avpacket                                                    \
diff --git a/libavcodec/dovi_convert.c b/libavcodec/dovi_convert.c
new file mode 100644
index 0000000000..33e27449dd
--- /dev/null
+++ b/libavcodec/dovi_convert.c
@@ -0,0 +1,132 @@
+/*
+ * Dolby Vision profile 7 to profile 8.1 RPU conversion, for the hardware
+ * decoders that only take profile 8.1.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "config.h"
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "libavutil/error.h"
+#include "libavutil/log.h"
+#include "libavutil/mem.h"
+
+#include "dovi_convert.h"
+
+// --- dovi p7 conversion core
+
+#if CONFIG_LIBDOVI
+
+#include <string.h>
+
+#include <libdovi/rpu_parser.h>
+
+/*
+ * libdovi before 3.4.0 panics -- an abort through its C API -- on an RPU
+ * whose payload, once its emulation prevention bytes are cleared and its
+ * trailing zero bytes trimmed, is shorter than the prefix, CRC32 and final
+ * byte it then indexes. The apple group links a prebuilt libdovi 3.3.2 with
+ * no such check, so refuse that shape here, at the bound libdovi 3.4.0 uses:
+ * the prefix byte, one payload byte, the CRC32 and the final byte. Anything
+ * libdovi rejects on its own -- shorter than 25 bytes, or not starting with
+ * the NAL header and RPU prefix below -- is left to its error path.
+ */
+static int dovi_rpu_long_enough(const uint8_t *nal, size_t size)
+{
+    static const uint8_t start[] = { 0x7C, 0x01, 0x19, 0x08, 0x09 };
+    const uint8_t *rpu = nal + 2;
+    size_t len, kept = 0, end = 0;
+
+    if (size < 25 || memcmp(nal, start, sizeof(start)))
+        return 1;
+    len = size - 2;
+    for (size_t i = 0; i < len; i++) {
+        // libdovi drops every 3 that follows two zero bytes of the input.
+        if (i >= 2 && !rpu[i - 2] && !rpu[i - 1] && rpu[i] == 3)
+            continue;
+        kept++;
+        if (rpu[i])
+            end = kept;
+    }
+    return end >= 7;
+}
+
+int ff_dovi_convert_p7_rpu_to_p81(const uint8_t *nal, size_t size,
+                                  uint8_t **out, size_t *out_size, void *logctx)
+{
+    DoviRpuOpaque *rpu;
+    const DoviData *data;
+    const char *error;
+    int ret = 0;
+
+    *out = NULL;
+    *out_size = 0;
+
+    if (!dovi_rpu_long_enough(nal, size)) {
+        av_log(logctx, AV_LOG_WARNING,
+               "Dolby Vision RPU conversion failed: RPU data too short\n");
+        return AVERROR_INVALIDDATA;
+    }
+
+    rpu = dovi_parse_unspec62_nalu(nal, size);
+    if (!rpu) {
+        av_log(logctx, AV_LOG_WARNING, "Failed to allocate a Dolby Vision RPU\n");
+        return AVERROR(ENOMEM);
+    }
+    error = dovi_rpu_get_error(rpu);
+    /* Mode 2: profile 8.1 compatible, mapping curves set to no-op. */
+    if (!error && dovi_convert_rpu_with_mode(rpu, 2) < 0)
+        error = dovi_rpu_get_error(rpu);
+    data = error ? NULL : dovi_write_unspec62_nalu(rpu);
+    if (!data) {
+        av_log(logctx, AV_LOG_WARNING, "Dolby Vision RPU conversion failed: %s\n",
+               error ? error : "unknown error");
+        ret = AVERROR_INVALIDDATA;
+    } else if (data->len > UINT32_MAX) {
+        // Every caller passes the converted size on as a uint32_t length;
+        // refuse a NAL that cannot survive that instead of truncating it.
+        ret = AVERROR_INVALIDDATA;
+    } else {
+        *out = av_memdup(data->data, data->len);
+        if (*out)
+            *out_size = data->len;
+        else
+            ret = AVERROR(ENOMEM);
+    }
+    if (data)
+        dovi_data_free(data);
+    dovi_rpu_free(rpu);
+    return ret;
+}
+
+#else
+
+int ff_dovi_convert_p7_rpu_to_p81(const uint8_t *nal, size_t size,
+                                  uint8_t **out, size_t *out_size, void *logctx)
+{
+    *out = NULL;
+    *out_size = 0;
+    av_log(logctx, AV_LOG_WARNING, "Dolby Vision profile 7 conversion needs libdovi\n");
+    return AVERROR(ENOSYS);
+}
+
+#endif
+
+// --- end dovi p7 conversion core
diff --git a/libavcodec/dovi_convert.h b/libavcodec/dovi_convert.h
new file mode 100644
index 0000000000..35177185d4
--- /dev/null
+++ b/libavcodec/dovi_convert.h
@@ -0,0 +1,47 @@
