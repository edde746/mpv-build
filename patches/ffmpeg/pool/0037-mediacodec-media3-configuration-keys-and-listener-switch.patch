+// The colour description the stream's own parameter sets carry (H.264 and
+// HEVC SPS VUI, AV1 sequence header), for color_keys when the demuxer passed
+// none in the codec context.
+typedef struct MediaCodecStreamColour {
+    int description; // primaries and transfer below were signalled
+    enum AVColorPrimaries primaries;
+    enum AVColorTransferCharacteristic trc;
+    enum AVColorRange range; // AVCOL_RANGE_UNSPECIFIED when unsignalled
+} MediaCodecStreamColour;
+
 typedef struct MediaCodecH264DecContext {
 
     AVClass *avclass;
@@ -85,6 +99,15 @@ typedef struct MediaCodecH264DecContext {
     // The SPS reorder bound, for presentation-order recovery
     // (mediacodec_reorder.h); 0 when the extradata carries no SPS.
     int reorder_depth;
+    // Media3's configuration keys, which FFmpeg otherwise leaves unset:
+    // max-width/max-height at the stream's size and the colour description
+    // (see set_media3_video_keys). Off by default; switches for telling
+    // apart a vendor decoder that times its output differently with them.
+    int max_size;
+    int color_keys;
+    MediaCodecStreamColour stream_colour;
+    // Register the frame-rendered listener (on by default).
+    int rendered_feedback;
 } MediaCodecH264DecContext;
 
 // convert: rewrite UNSPEC62 to profile 8.1 and drop UNSPEC63; strip: drop both
@@ -169,6 +192,22 @@ done:
 }
 #endif
 
+#if CONFIG_H264_MEDIACODEC_DECODER || CONFIG_HEVC_MEDIACODEC_DECODER
+static void stream_colour_from_vui(AVCodecContext *avctx, const H2645VUI *vui)
+{
+    MediaCodecStreamColour *c = &((MediaCodecH264DecContext *)avctx->priv_data)->stream_colour;
+
+    if (!vui->video_signal_type_present_flag)
+        return;
+    c->range = vui->video_full_range_flag ? AVCOL_RANGE_JPEG : AVCOL_RANGE_MPEG;
+    if (vui->colour_description_present_flag) {
+        c->description = 1;
+        c->primaries = vui->colour_primaries;
+        c->trc = vui->transfer_characteristics;
+    }
+}
+#endif
+
 #if CONFIG_H264_MEDIACODEC_DECODER
 static int h264_set_extradata(AVCodecContext *avctx, FFAMediaFormat *format)
 {
@@ -207,6 +246,7 @@ static int h264_set_extradata(AVCodecContext *avctx, FFAMediaFormat *format)
         avctx->profile = ff_h264_get_profile(sps);
         avctx->level = sps->level_idc;
         ((MediaCodecH264DecContext *)avctx->priv_data)->reorder_depth = sps->num_reorder_frames;
+        stream_colour_from_vui(avctx, &sps->vui);
 
         if ((ret = h2645_ps_to_nalu(sps->data, sps->data_size, &data, &data_size)) < 0) {
             goto done;
@@ -293,6 +333,7 @@ static int hevc_set_extradata(AVCodecContext *avctx, FFAMediaFormat *format)
             sps->max_sub_layers - 1;
         ((MediaCodecH264DecContext *)avctx->priv_data)->reorder_depth =
             sps->temporal_layer[sps->max_sub_layers - 1].num_reorder_pics;
+        stream_colour_from_vui(avctx, &sps->vui.common);
 
         if ((ret = h2645_ps_to_nalu(vps->data, vps->data_size, &vps_data, &vps_data_size)) < 0 ||
             (ret = h2645_ps_to_nalu(sps->data, sps->data_size, &sps_data, &sps_data_size)) < 0 ||
@@ -404,6 +445,40 @@ static int av1_check_profile(AVCodecContext *avctx)
 
     return 0;
 }
+
+// The colour description of the av1C sequence header. Only color_keys
+// asks: a decode that does not send the keys never parses it.
+static void av1_stream_colour(AVCodecContext *avctx)
+{
+    MediaCodecStreamColour *c = &((MediaCodecH264DecContext *)avctx->priv_data)->stream_colour;
+    static const CodedBitstreamUnitType decompose[] = { AV1_OBU_SEQUENCE_HEADER };
+    CodedBitstreamContext *cbc = NULL;
+    CodedBitstreamFragment frag = { 0 };
+
+    if (!avctx->extradata || avctx->extradata_size <= 0 ||
+        ff_cbs_init(&cbc, AV_CODEC_ID_AV1, avctx) < 0)
+        return;
+    cbc->decompose_unit_types    = decompose;
+    cbc->nb_decompose_unit_types = FF_ARRAY_ELEMS(decompose);
+    if (ff_cbs_read_extradata_from_codec(cbc, &frag, avctx) >= 0) {
+        for (int i = 0; i < frag.nb_units; i++) {
+            const AV1RawOBU *obu = frag.units[i].content;
+            const AV1RawColorConfig *cc;
+            if (frag.units[i].type != AV1_OBU_SEQUENCE_HEADER || !obu)
+                continue;
+            cc = &obu->obu.sequence_header.color_config;
+            c->range = cc->color_range ? AVCOL_RANGE_JPEG : AVCOL_RANGE_MPEG;
+            if (cc->color_description_present_flag) {
+                c->description = 1;
+                c->primaries = cc->color_primaries;
+                c->trc = cc->transfer_characteristics;
+            }
+            break;
+        }
+    }
+    ff_cbs_fragment_free(&frag);
+    ff_cbs_close(&cbc);
+}
 #endif
 
 #if CONFIG_HEVC_MEDIACODEC_DECODER
@@ -811,6 +886,82 @@ static int video_max_input_size(const AVCodecContext *avctx)
     return size > INT32_MAX ? 0 : (int)size;
 }
 
+// Media3's colour-key values (ColorInfo.isoColorPrimariesToColorSpace and
+// isoTransferCharacteristicsToColorTransfer), which differ from FFmpeg's
+// encoder mapping: the standard follows the primaries, not the matrix, every
+// BT.601 flavour is sent as BT601_PAL, and SDR transfers are sent as
+// SDR_VIDEO. The ISO codes are AVColorPrimaries/AVColorTransferCharacteristic.
+static int media3_color_standard(enum AVColorPrimaries primaries)
+{
+    switch (primaries) {
+    case AVCOL_PRI_BT709:     return COLOR_STANDARD_BT709;
+    case AVCOL_PRI_BT470M:
+    case AVCOL_PRI_BT470BG:
+    case AVCOL_PRI_SMPTE170M:
+    case AVCOL_PRI_SMPTE240M: return COLOR_STANDARD_BT601_PAL;
+    case AVCOL_PRI_BT2020:    return COLOR_STANDARD_BT2020;
+    default:                  return COLOR_STANDARD_UNSPECIFIED;
+    }
+}
+
+static int media3_color_transfer(enum AVColorTransferCharacteristic trc)
+{
+    switch (trc) {
+    case AVCOL_TRC_BT709:
+    case AVCOL_TRC_SMPTE170M:
+    case AVCOL_TRC_SMPTE240M:    return COLOR_TRANSFER_SDR_VIDEO;
+    case AVCOL_TRC_GAMMA22:      return 10; // C.COLOR_TRANSFER_GAMMA_2_2
+    case AVCOL_TRC_IEC61966_2_1: return 2;  // C.COLOR_TRANSFER_SRGB
+    case AVCOL_TRC_SMPTE2084:    return COLOR_TRANSFER_ST2084;
+    case AVCOL_TRC_ARIB_STD_B67: return COLOR_TRANSFER_HLG;
+    default:                     return COLOR_TRANSFER_UNSPECIFIED;
+    }
+}
+
+// What Media3's MediaCodecVideoRenderer configures and FFmpeg does not: for a
+// single stream, max-width/max-height at its size (getCodecMaxValues), and
+// the colour description (MediaFormatUtil.maybeSetColorInfo). The container's
+// description wins where the demuxer passed one, as Media3's does; the
+// parameter sets' fill in the rest. Both switches are off by default and
+// logged when on, so a log shows which configuration a decode ran with.
+static void set_media3_video_keys(AVCodecContext *avctx, FFAMediaFormat *format)
+{
+    MediaCodecH264DecContext *s = avctx->priv_data;
+    const MediaCodecStreamColour *ps = &s->stream_colour;
+
+    if (s->max_size && avctx->width > 0 && avctx->height > 0) {
+        ff_AMediaFormat_setInt32(format, "max-width", avctx->width);
+        ff_AMediaFormat_setInt32(format, "max-height", avctx->height);
+        av_log(avctx, AV_LOG_INFO, "Configured max-width=%d max-height=%d\n",
+               avctx->width, avctx->height);
+    }
+    if (s->color_keys) {
+        enum AVColorPrimaries primaries = avctx->color_primaries;
+        enum AVColorTransferCharacteristic trc = avctx->color_trc;
+        enum AVColorRange range = avctx->color_range;
+        int standard, transfer, mf_range;
+
+        if (primaries == AVCOL_PRI_UNSPECIFIED && ps->description)
+            primaries = ps->primaries;
+        if (trc == AVCOL_TRC_UNSPECIFIED && ps->description)
+            trc = ps->trc;
+        if (range == AVCOL_RANGE_UNSPECIFIED)
+            range = ps->range;
+        standard = media3_color_standard(primaries);
+        transfer = media3_color_transfer(trc);
+        mf_range = ff_AMediaFormatColorRange_from_AVColorRange(range);
+        if (standard != COLOR_STANDARD_UNSPECIFIED)
+            ff_AMediaFormat_setInt32(format, "color-standard", standard);
+        if (transfer != COLOR_TRANSFER_UNSPECIFIED)
+            ff_AMediaFormat_setInt32(format, "color-transfer", transfer);
+        if (mf_range != COLOR_RANGE_UNSPECIFIED)
+            ff_AMediaFormat_setInt32(format, "color-range", mf_range);
+        av_log(avctx, AV_LOG_INFO,
+               "Configured color-standard=%d color-transfer=%d color-range=%d "
+               "(0: not sent)\n", standard, transfer, mf_range);
+    }
+}
+
 static av_cold int mediacodec_decode_init(AVCodecContext *avctx)
 {
     int ret;
@@ -854,6 +1005,8 @@ static av_cold int mediacodec_decode_init(AVCodecContext *avctx)
         ret = common_set_extradata(avctx, format);
         if (ret < 0)
             goto done;
+        if (s->color_keys)
+            av1_stream_colour(avctx);
         break;
 #endif
 #if CONFIG_H264_MEDIACODEC_DECODER
@@ -962,6 +1115,7 @@ static av_cold int mediacodec_decode_init(AVCodecContext *avctx)
         ff_AMediaFormat_setInt32(format, "height", avctx->height);
         if (max_input_size > 0)
             ff_AMediaFormat_setInt32(format, "max-input-size", max_input_size);
+        set_media3_video_keys(avctx, format);
     } else {
         ff_AMediaFormat_setInt32(format, "channel-count", avctx->ch_layout.nb_channels);
         ff_AMediaFormat_setInt32(format, "sample-rate", avctx->sample_rate);
@@ -989,6 +1143,7 @@ static av_cold int mediacodec_decode_init(AVCodecContext *avctx)
     s->ctx->delay_flush = s->delay_flush;
     s->ctx->use_ndk_codec = s->use_ndk_codec;
     s->ctx->use_async = s->use_async;
+    s->ctx->rendered_feedback = s->rendered_feedback;
     s->ctx->profile_override = profile_override;
     s->ctx->codec_name = codec_name;
     codec_name = NULL;
@@ -1223,6 +1378,12 @@ static const AVOption ff_mediacodec_vdec_options[] = {
             OFFSET(frame_rate), AV_OPT_TYPE_FLOAT, {.dbl = 0}, 0, 1000, VD },
     { "priority", "Codec priority: 0 realtime, 1 best effort (MediaFormat priority), -1 for the platform default",
             OFFSET(priority), AV_OPT_TYPE_INT, {.i64 = -1}, -1, 1, VD },
+    { "max_size", "Configure max-width/max-height at the stream's size, as Media3 does for a single stream",
+            OFFSET(max_size), AV_OPT_TYPE_BOOL, {.i64 = 0}, 0, 1, VD },
+    { "color_keys", "Configure color-standard/color-transfer/color-range from the stream's colour description, as Media3 does",
+            OFFSET(color_keys), AV_OPT_TYPE_BOOL, {.i64 = 0}, 0, 1, VD },
+    { "rendered_feedback", "Register a frame-rendered listener for presentation feedback (av_mediacodec_drain_rendered)",
+            OFFSET(rendered_feedback), AV_OPT_TYPE_BOOL, {.i64 = 1}, 0, 1, VD },
     { "dolby_vision", "Prefer a Dolby Vision decoder for single-layer DV streams",
                       OFFSET(dolby_vision), AV_OPT_TYPE_BOOL, {.i64 = 1}, 0, 1, VD },
     { "dv_p7_mode", "Dolby Vision profile 7 handling",
diff --git a/libavcodec/mediacodecdec_common.c b/libavcodec/mediacodecdec_common.c
index 27e2eb0..2c7e65b 100644
--- a/libavcodec/mediacodecdec_common.c
+++ b/libavcodec/mediacodecdec_common.c
@@ -1355,6 +1355,10 @@ static void mediacodec_dec_register_rendered(AVCodecContext *avctx,
         s->rendered_source = "off:surface";
         return;
     }
+    if (!s->rendered_feedback) {
+        s->rendered_source = "off:option";
+        return;
+    }
     ret = ff_AMediaCodec_setOnFrameRenderedCallback(s->codec,
             mediacodec_dec_on_frame_rendered, s);
     if (ret == AVERROR(ENOSYS)) {
diff --git a/libavcodec/mediacodecdec_common.h b/libavcodec/mediacodecdec_common.h
index 6d278db..ec13221 100644
--- a/libavcodec/mediacodecdec_common.h
+++ b/libavcodec/mediacodecdec_common.h
@@ -125,7 +125,10 @@ typedef struct MediaCodecDecContext {
     // registry in mediacodec.c keys on it.
     AVBufferRef *device_ref;
 
-    // Frame-rendered feedback; see av_mediacodec_drain_rendered.
+    // Frame-rendered feedback; see av_mediacodec_drain_rendered. Requested
+    // unless the caller turned the listener off (the rendered_feedback
+    // option), to compare a decoder's timing without it.
+    bool rendered_feedback;
     const char *rendered_source;      // "jni", "ndk" or an "off:" reason, never NULL
     AVMediaCodecRendered rendered[FF_MEDIACODEC_RENDERED_RING];
     atomic_uint rendered_head;        // consumer
