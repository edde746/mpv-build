 static av_cold int mediacodec_decode_close(AVCodecContext *avctx)
@@ -305,12 +307,69 @@ static int common_set_extradata(AVCodecContext *avctx, FFAMediaFormat *format)
 }
 #endif
 
+#if CONFIG_HEVC_MEDIACODEC_DECODER
+/*
+ * Dolby Vision is decoder-led on Android: the display pipeline engages DV
+ * only when a "video/dolby-vision" MediaCodec decodes the stream. For the
+ * single-layer profiles (dvhe.05, dvhe.08) the HEVC bitstream - with its
+ * in-band RPU NALs - is fed to the DV decoder unchanged; only the MIME and
+ * the profile/level format keys differ. The dual-layer profile 7 would need
+ * enhancement-layer handling and stays on the plain HEVC decoder (base
+ * layer only).
+ */
+static void dolby_vision_override(AVCodecContext *avctx, FFAMediaFormat *format,
+                                  const char **mime, int *profile_override)
+{
+    static const char dv_mime[] = "video/dolby-vision";
+    const AVPacketSideData *sd =
+        av_packet_side_data_get(avctx->coded_side_data, avctx->nb_coded_side_data,
+                                AV_PKT_DATA_DOVI_CONF);
+    const AVDOVIDecoderConfigurationRecord *cfg;
+    char *codec_name;
+    int profile, level;
+
+    if (!sd || sd->size < sizeof(*cfg))
+        return;
+    cfg = (const AVDOVIDecoderConfigurationRecord *)sd->data;
+    if (!cfg->rpu_present_flag || cfg->el_present_flag)
+        return;
+    if (cfg->dv_profile != 5 && cfg->dv_profile != 8)
+        return;
+
+    /* MediaCodecInfo.CodecProfileLevel: DolbyVisionProfile* == 1 << dv_profile,
+     * DolbyVisionLevel* == 1 << (dv_level - 1). */
+    profile = 1 << cfg->dv_profile;
+    level = cfg->dv_level > 0 ? 1 << (cfg->dv_level - 1) : 0;
+
+    /* Requires a JVM (JNI MediaCodecList); returns NULL otherwise, which
+     * keeps the plain HEVC decoder - as does the absence of a hardware DV
+     * decoder advertising this profile. */
+    codec_name = ff_AMediaCodecList_getCodecNameByType(dv_mime, profile, 0, avctx);
+    if (!codec_name) {
+        av_log(avctx, AV_LOG_VERBOSE,
+               "No hardware decoder for %s profile 0x%x, using the base layer\n",
+               dv_mime, profile);
+        return;
+    }
+    av_log(avctx, AV_LOG_INFO, "Dolby Vision profile %d.%d: using %s (%s)\n",
+           cfg->dv_profile, cfg->dv_bl_signal_compatibility_id, dv_mime, codec_name);
+    av_freep(&codec_name);
+
+    *mime = dv_mime;
+    *profile_override = profile;
+    ff_AMediaFormat_setInt32(format, "profile", profile);
+    if (level)
+        ff_AMediaFormat_setInt32(format, "level", level);
+}
+#endif
+
 static av_cold int mediacodec_decode_init(AVCodecContext *avctx)
 {
     int ret;
     int sdk_int;
 
     const char *codec_mime = NULL;
+    int profile_override = 0;
 
     FFAMediaFormat *format = NULL;
     MediaCodecH264DecContext *s = avctx->priv_data;
@@ -351,6 +410,8 @@ static av_cold int mediacodec_decode_init(AVCodecContext *avctx)
         ret = hevc_set_extradata(avctx, format);
         if (ret < 0)
             goto done;
+        if (s->dolby_vision)
+            dolby_vision_override(avctx, format, &codec_mime, &profile_override);
         break;
 #endif
 #if CONFIG_MPEG2_MEDIACODEC_DECODER
@@ -450,6 +511,7 @@ static av_cold int mediacodec_decode_init(AVCodecContext *avctx)
 
     s->ctx->delay_flush = s->delay_flush;
     s->ctx->use_ndk_codec = s->use_ndk_codec;
+    s->ctx->profile_override = profile_override;
 
     if ((ret = ff_mediacodec_dec_init(avctx, s->ctx, codec_mime, format)) < 0) {
         s->ctx = NULL;
@@ -600,6 +662,8 @@ static const AVOption ff_mediacodec_vdec_options[] = {
                    OFFSET(use_ndk_codec), AV_OPT_TYPE_BOOL, {.i64 = -1}, -1, 1, VD },
     { "operating_rate", "The desired operating rate that the codec will need to operate at, zero for unspecified",
             OFFSET(operating_rate), AV_OPT_TYPE_INT, {.i64 = 0}, 0, INT_MAX, VD },
+    { "dolby_vision", "Prefer a Dolby Vision decoder for single-layer DV streams",
+                      OFFSET(dolby_vision), AV_OPT_TYPE_BOOL, {.i64 = 1}, 0, 1, VD },
     { NULL }
 };
 
